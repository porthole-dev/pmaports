From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sun, 9 Aug 2026 17:10:33 +0200
Subject: [PATCH] iio: qcom_smgr: fix last_values data race and samp_freq slot
 routing

Two defects found in a sensor-path audit:

1. qcom_smgr_buffering_report_handler() wrote sensor->last_values,
   ->have_report and ->last_event_ns without holding sensor->lock,
   while qcom_smgr_read_one() takes that lock to read last_values. On
   a preemptible SMP kernel a reader could observe a torn or stale
   value.

   The handler runs via qmi_data_ready_work(), a plain WQ_UNBOUND
   workqueue work function (see drivers/soc/qcom/qmi_interface.c) --
   ordinary process context, not atomic/softirq/RCU context -- so a
   mutex is a valid choice there, and it is the same sensor->lock
   already used to guard these fields everywhere else in the file.
   No new lock is introduced and no ordering inversion results: the
   handler only ever takes this one per-sensor lock, the same way
   postenable/predisable/read_one/write_event_config already do, and
   it never holds it across another sensor's lock (the accelerometer
   read for compass tilt-compensation stays outside the locked
   region, as it already was).

   The per-data-type completions added just before this are
   unaffected -- complete() is still called with the same value, now
   simply under the mutex, which is safe since complete() does not
   sleep.

2. IIO_CHAN_INFO_SAMP_FREQ read/write always indexed data_types[0]
   (PRIMARY) regardless of which channel the caller asked about, so
   reading or setting the ambient-light sample rate on
   qcom-smgr-prox-light actually read/set proximity's rate instead.
   Route both paths through qcom_smgr_secondary_scan_index() the same
   way qcom_smgr_read_one() already does, including the `sec >= 0`
   guard so event-only sensors (scan_index == -1, same as "no
   secondary") are not misrouted to SECONDARY.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 44 ++++++++++++++++++++----
 1 file changed, 37 insertions(+), 7 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index 49509637bf13..2c9dabc38a0a 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -689,21 +689,37 @@ static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
 		 * step". The real fix is in the subscription's report rate,
 		 * which is set for continuous sensors.
 		 */
+		mutex_lock(&sensor->lock);
 		if (sensor->last_event_ns &&
 		    now - sensor->last_event_ns < 100 * NSEC_PER_MSEC) {
 			sensor->have_report = true;
 			complete(&sensor->report[is_secondary]);
+			mutex_unlock(&sensor->lock);
 			return;
 		}
 		sensor->last_event_ns = now;
+		mutex_unlock(&sensor->lock);
 
 		iio_push_event(sensor->iio_dev, code, now);
 
+		mutex_lock(&sensor->lock);
 		sensor->have_report = true;
 		complete(&sensor->report[is_secondary]);
+		mutex_unlock(&sensor->lock);
 		return;
 	}
 
+	/*
+	 * last_values is read by qcom_smgr_read_one() under sensor->lock, so
+	 * the merge-and-publish below has to run under it too, or a reader
+	 * can observe a torn or stale value. qcom_smgr_buffering_report_handler()
+	 * runs on the QMI handle's own workqueue (process context, see
+	 * qmi_data_ready_work() in qmi_interface.c) -- not atomic context --
+	 * so a mutex is valid here, and it is the same lock already used for
+	 * this field everywhere else in the file.
+	 */
+	mutex_lock(&sensor->lock);
+
 	sec = qcom_smgr_secondary_scan_index(sensor->type);
 	if (sec >= 0) {
 		u32 merged[ARRAY_SIZE(iio_data.values)];
@@ -723,17 +739,19 @@ static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
 			iio_data.values[j] = cpu_to_le32(merged[j]);
 	}
 
+	memcpy(sensor->last_values, iio_data.values,
+	       sizeof(sensor->last_values));
+	sensor->have_report = true;
+	complete(&sensor->report[is_secondary]);
+
+	mutex_unlock(&sensor->lock);
+
 	/*
 	 * Not iio_push_to_buffers(): the struct is laid out for a 3-axis
 	 * sensor, but pressure and prox/light have fewer channels and so a
 	 * shorter scan, which puts their timestamp somewhere else entirely.
 	 * The _with_timestamp() helper places it per the device's own scan.
 	 */
-	memcpy(sensor->last_values, iio_data.values,
-	       sizeof(sensor->last_values));
-	sensor->have_report = true;
-	complete(&sensor->report[is_secondary]);
-
 	iio_push_to_buffers_with_timestamp(sensor->iio_dev, &iio_data,
 					   iio_get_time_ns(sensor->iio_dev));
 }
@@ -936,13 +954,19 @@ static int qcom_smgr_iio_read_raw(struct iio_dev *iio_dev,
 				  int *val2, long mask)
 {
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_sensor *sensor = priv->sensor;
+	int sec, data_type;
 
 	switch (mask) {
 	case IIO_CHAN_INFO_RAW:
 	case IIO_CHAN_INFO_PROCESSED:
 		return qcom_smgr_read_one(iio_dev, chan, val);
 	case IIO_CHAN_INFO_SAMP_FREQ:
-		*val = priv->sensor->data_types[0].cur_sample_rate;
+		/* sec == -1 for event-only sensors too; both PRIMARY then. */
+		sec = qcom_smgr_secondary_scan_index(sensor->type);
+		data_type = (sec >= 0 && sec == chan->scan_index)
+			    ? SNS_SMGR_DATA_TYPE_SECONDARY : SNS_SMGR_DATA_TYPE_PRIMARY;
+		*val = sensor->data_types[data_type].cur_sample_rate;
 		return IIO_VAL_INT;
 	case IIO_CHAN_INFO_CALIBBIAS:
 		*val = priv->sensor->calibbias[chan->scan_index];
@@ -975,13 +999,19 @@ static int qcom_smgr_iio_write_raw(struct iio_dev *iio_dev,
 				   int val2, long mask)
 {
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_sensor *sensor = priv->sensor;
+	int sec, data_type;
 
 	switch (mask) {
 	case IIO_CHAN_INFO_SAMP_FREQ:
 		if (!iio_device_claim_direct(iio_dev))
 			return -EBUSY;
 
-		priv->sensor->data_types[0].cur_sample_rate = val;
+		/* sec == -1 for event-only sensors too; both PRIMARY then. */
+		sec = qcom_smgr_secondary_scan_index(sensor->type);
+		data_type = (sec >= 0 && sec == chan->scan_index)
+			    ? SNS_SMGR_DATA_TYPE_SECONDARY : SNS_SMGR_DATA_TYPE_PRIMARY;
+		sensor->data_types[data_type].cur_sample_rate = val;
 
 		iio_device_release_direct(iio_dev);
 		return 0;
