--- /dev/null
+++ b/src/tests/test-mobile-providers.c
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: LGPL-2.1+
+/*
+ * Provider lookup for MCC/MNC pairs that several providers share.
+ */
+
+#include "nm-default.h"
+
+#include <glib/gstdio.h>
+
+#include "nma-mobile-providers.h"
+
+/* Two countries' worth of the shapes the real database contains:
+ *  - it: a host network and two MVNOs on one MCC/MNC, one of the MVNOs tagged
+ *        and one not, which is how mobile-broadband-provider-info looks in
+ *        practice -- the tagging is incomplete.
+ *  - de: an MVNO that states a <gid1>, sharing its MCC/MNC with the host.
+ *  - gb: no MVNO information at all, and a 2-digit and a 3-digit MNC to check
+ *        the pre-existing preference still holds.
+ */
+static const char *service_providers_xml =
+"<?xml version=\"1.0\"?>"
+"<serviceproviders format=\"2.0\">"
+"  <country code=\"it\">"
+"    <provider primary=\"true\">"
+"      <name>Vodafone</name>"
+"      <gsm><network-id mcc=\"222\" mnc=\"10\"/>"
+"           <apn value=\"mobile.vodafone.it\"/></gsm>"
+"    </provider>"
+"    <provider primary=\"false\">"
+"      <name>PosteMobile</name>"
+"      <gsm><network-id mcc=\"222\" mnc=\"10\"/>"
+"           <apn value=\"internet.postemobile.it\"/></gsm>"
+"    </provider>"
+"    <provider>"
+"      <name>ho.</name>"
+"      <gsm><network-id mcc=\"222\" mnc=\"10\"/>"
+"           <apn value=\"web.ho-mobile.it\"/></gsm>"
+"    </provider>"
+"  </country>"
+"  <country code=\"de\">"
+"    <provider primary=\"false\">"
+"      <name>winSIM</name>"
+"      <gsm><network-id mcc=\"262\" mnc=\"23\"/>"
+"           <gid1>d3e35801</gid1>"
+"           <apn value=\"internet.winsim\"/></gsm>"
+"    </provider>"
+"    <provider primary=\"true\">"
+"      <name>o2</name>"
+"      <gsm><network-id mcc=\"262\" mnc=\"23\"/>"
+"           <apn value=\"internet\"/></gsm>"
+"    </provider>"
+"  </country>"
+"  <country code=\"gb\">"
+"    <provider>"
+"      <name>Two Digit</name>"
+"      <gsm><network-id mcc=\"234\" mnc=\"15\"/>"
+"           <apn value=\"two.digit\"/></gsm>"
+"    </provider>"
+"    <provider>"
+"      <name>Three Digit</name>"
+"      <gsm><network-id mcc=\"234\" mnc=\"015\"/>"
+"           <apn value=\"three.digit\"/></gsm>"
+"    </provider>"
+"  </country>"
+"</serviceproviders>";
+
+static const char *country_codes_xml =
+"<?xml version=\"1.0\"?>"
+"<iso_3166_entries>"
+"  <iso_3166_entry alpha_2_code=\"IT\" name=\"Italy\"/>"
+"  <iso_3166_entry alpha_2_code=\"DE\" name=\"Germany\"/>"
+"  <iso_3166_entry alpha_2_code=\"GB\" name=\"United Kingdom\"/>"
+"</iso_3166_entries>";
+
+typedef struct {
+	char *dir;
+	NMAMobileProvidersDatabase *db;
+} Fixture;
+
+static void
+fixture_set_up (Fixture *f, gconstpointer user_data)
+{
+	gs_free_error GError *error = NULL;
+	gs_free char *providers_path = NULL;
+	gs_free char *countries_path = NULL;
+
+	f->dir = g_dir_make_tmp ("nma-mobile-providers-XXXXXX", &error);
+	g_assert_no_error (error);
+
+	providers_path = g_build_filename (f->dir, "serviceproviders.xml", NULL);
+	countries_path = g_build_filename (f->dir, "iso_3166.xml", NULL);
+
+	g_assert (g_file_set_contents (providers_path, service_providers_xml, -1, &error));
+	g_assert_no_error (error);
+	g_assert (g_file_set_contents (countries_path, country_codes_xml, -1, &error));
+	g_assert_no_error (error);
+
+	f->db = nma_mobile_providers_database_new_sync (countries_path, providers_path, NULL, &error);
+	g_assert_no_error (error);
+	g_assert (NMA_IS_MOBILE_PROVIDERS_DATABASE (f->db));
+}
+
+static void
+fixture_tear_down (Fixture *f, gconstpointer user_data)
+{
+	gs_free char *providers_path = g_build_filename (f->dir, "serviceproviders.xml", NULL);
+	gs_free char *countries_path = g_build_filename (f->dir, "iso_3166.xml", NULL);
+
+	g_clear_object (&f->db);
+	g_unlink (providers_path);
+	g_unlink (countries_path);
+	g_rmdir (f->dir);
+	g_free (f->dir);
+}
+
+static void
+assert_lookup (Fixture *f,
+               const char *mccmnc,
+               const char *spn,
+               const char *gid1,
+               const char *expected_name)
+{
+	NMAMobileProvider *provider;
+
+	provider = nma_mobile_providers_database_lookup_3gpp_sim (f->db, mccmnc, spn, gid1);
+	if (!expected_name) {
+		g_assert_null (provider);
+		return;
+	}
+	g_assert_nonnull (provider);
+	g_assert_cmpstr (nma_mobile_provider_get_name (provider), ==, expected_name);
+}
+
+/* Without SIM data the host network has to win, or the APN offered to a
+ * host-network subscriber is some reseller's. Which reseller depends on hash
+ * iteration order, which is the whole bug.
+ */
+static void
+test_primary_wins (Fixture *f, gconstpointer user_data)
+{
+	assert_lookup (f, "22210", NULL, NULL, "Vodafone");
+
+	/* An untagged provider still beats one tagged primary="false": the
+	 * database tags MVNOs far more consistently than host networks. */
+	assert_lookup (f, "26223", NULL, NULL, "o2");
+}
+
+/* The MVNO's own subscribers must not be given the host network's APN. */
+static void
+test_spn_identifies_mvno (Fixture *f, gconstpointer user_data)
+{
+	assert_lookup (f, "22210", "PosteMobile", NULL, "PosteMobile");
+	assert_lookup (f, "22210", "ho.",         NULL, "ho.");
+	assert_lookup (f, "22210", "POSTEMOBILE", NULL, "PosteMobile");
+}
+
+/* A host network's SIMs commonly carry no service provider name at all, and an
+ * SPN nobody is named after must not throw the lookup away.
+ */
+static void
+test_spn_falls_back (Fixture *f, gconstpointer user_data)
+{
+	assert_lookup (f, "22210", "",                 NULL, "Vodafone");
+	assert_lookup (f, "22210", "Some Reseller Ltd", NULL, "Vodafone");
+}
+
+/* <gid1> is stated deliberately, so unlike a name it rules a provider out. */
+static void
+test_gid1 (Fixture *f, gconstpointer user_data)
+{
+	/* Matches, and outranks the host network's primary="true". */
+	assert_lookup (f, "26223", NULL, "d3e35801", "winSIM");
+	/* SIMs pad EF_GID1; Android matches a case-insensitive prefix. */
+	assert_lookup (f, "26223", NULL, "D3E35801FFFFFFFF", "winSIM");
+	/* Stated and contradicted: winSIM is not a candidate at all. */
+	assert_lookup (f, "26223", NULL, "FF", "o2");
+	/* Not stated by the caller: a wildcard, not a rejection. */
+	assert_lookup (f, "26223", NULL, NULL, "o2");
+}
+
+/* Whatever else changes, the MNC width preference and the old entry point must
+ * behave as they always have.
+ */
+static void
+test_unchanged_behaviour (Fixture *f, gconstpointer user_data)
+{
+	NMAMobileProvider *old, *new;
+
+	assert_lookup (f, "234015", NULL, NULL, "Three Digit");
+	assert_lookup (f, "23415",  NULL, NULL, "Three Digit");
+	assert_lookup (f, "234099", NULL, NULL, NULL);
+	assert_lookup (f, "2341",   NULL, NULL, NULL);
+	assert_lookup (f, "2340155", NULL, NULL, NULL);
+
+	old = nma_mobile_providers_database_lookup_3gpp_mcc_mnc (f->db, "22210");
+	new = nma_mobile_providers_database_lookup_3gpp_sim (f->db, "22210", NULL, NULL);
+	g_assert (old == new);
+}
+
+int
+main (int argc, char **argv)
+{
+	g_test_init (&argc, &argv, NULL);
+
+#define ADD(path, func) \
+	g_test_add (path, Fixture, NULL, fixture_set_up, func, fixture_tear_down)
+
+	ADD ("/mobile-providers/primary-wins", test_primary_wins);
+	ADD ("/mobile-providers/spn-identifies-mvno", test_spn_identifies_mvno);
+	ADD ("/mobile-providers/spn-falls-back", test_spn_falls_back);
+	ADD ("/mobile-providers/gid1", test_gid1);
+	ADD ("/mobile-providers/unchanged-behaviour", test_unchanged_behaviour);
+
+	return g_test_run ();
+}
