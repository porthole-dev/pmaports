7f89609ca57f4696cc40a284ed57600b70f86551b8b602ea454ae1b50c35d7ae827931e819c51dfa1b9f6f996ed446f06d97ae8e4dca1b8eb07a825eba18073b  dbus-activation-and-wantedby.patch
6e28ffa74687cc409856d8966d9e794e523254781133e61adb81007ed00b7f057122ca8dfa967684312a613e9a3898865844320e4302990046d871a0a9b66eb5  neard.initd
"
