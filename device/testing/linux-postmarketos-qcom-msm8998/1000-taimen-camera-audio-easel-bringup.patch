+/*
+ * mnh_mipi_gen3_device() quantizes the requested rate to a fixed ladder
+ * BEFORE deriving anything (mnh-mipi.c:490). This is why a link the HAL
+ * asks for at 648 Mbps is actually driven at 685 -- and why our port, which
+ * skipped this step, drove 650 with a 600-bucket D-PHY range.
+ */
+static u32 easel_quantize_rate(u32 rate)
+{
+	static const u16 ladder[] = { 360, 550, 685, 720, 984,
+				      1104, 1200, 1368, 1850 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ladder); i++)
+		if (rate <= ladder[i])
+			return ladder[i];
+	return rate;
+}
+
+static int easel_freq_code(u32 rate)
+{
+	int i;
+
+	if (rate < easel_rates[0].rate)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(easel_rates); i++)
+		if (rate < easel_rates[i].rate)
+			return i - 1;
+
+	return ARRAY_SIZE(easel_rates) - 1;
+}
