+	ret = v4l2_ctrl_handler_init(&imx362->ctrls, 10);
 	if (ret)
 		goto err_power_off;
+	/* set_fmt updates control ranges with __v4l2_ctrl_*(), under this lock */
+	imx362->ctrls.lock = &imx362->lock;
 
 	imx362->pixel_rate = v4l2_ctrl_new_std(&imx362->ctrls, NULL,
 					       V4L2_CID_PIXEL_RATE, 1,
@@ -735,31 +1014,33 @@ static int imx362_probe(struct i2c_client *client)
 	if (imx362->link_freq)
 		imx362->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
 
-	/* libcamera-mandatory quartet; single mode so the ranges are fixed */
-	ret = 0;
-	{
-		struct v4l2_ctrl *hblank;
-
-		hblank = v4l2_ctrl_new_std(&imx362->ctrls, &imx362_ctrl_ops,
+	/* libcamera-mandatory quartet; set_fmt moves the blanking ranges */
+	mode = imx362->cur_mode;
+	imx362->hblank = v4l2_ctrl_new_std(&imx362->ctrls, &imx362_ctrl_ops,
 					   V4L2_CID_HBLANK,
-					   IMX362_LLP - IMX362_NATIVE_WIDTH,
-					   IMX362_LLP - IMX362_NATIVE_WIDTH, 1,
-					   IMX362_LLP - IMX362_NATIVE_WIDTH);
-		if (hblank)
-			hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
-	}
-
-	v4l2_ctrl_new_std(&imx362->ctrls, &imx362_ctrl_ops, V4L2_CID_VBLANK,
-			  IMX362_FLL - IMX362_NATIVE_HEIGHT,
-			  IMX362_FLL_MAX - IMX362_NATIVE_HEIGHT, 1,
-			  IMX362_FLL - IMX362_NATIVE_HEIGHT);
+					   mode->llp - mode->width,
+					   mode->llp - mode->width, 1,
+					   mode->llp - mode->width);
+	if (imx362->hblank)
+		imx362->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx362->vblank = v4l2_ctrl_new_std(&imx362->ctrls, &imx362_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   mode->fll_min - mode->height,
+					   IMX362_FLL_MAX - mode->height, 1,
+					   mode->fll - mode->height);
 
 	imx362->exposure = v4l2_ctrl_new_std(&imx362->ctrls, &imx362_ctrl_ops,
 					     V4L2_CID_EXPOSURE,
 					     IMX362_EXPOSURE_MIN,
-					     IMX362_FLL - IMX362_EXPOSURE_MARGIN,
+					     mode->fll - IMX362_EXPOSURE_MARGIN,
 					     1,
-					     IMX362_FLL - IMX362_EXPOSURE_MARGIN);
+					     mode->fll - IMX362_EXPOSURE_MARGIN);
