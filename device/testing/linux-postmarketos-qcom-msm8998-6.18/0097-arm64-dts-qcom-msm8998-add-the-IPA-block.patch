From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Mon, 10 Aug 2026 10:46:47 +0200
Subject: [PATCH] arm64: dts: qcom: msm8998: add the IPA block

msm8998.dtsi reserves the two IPA memory regions but never describes the
block itself, so drivers/net/ipa never binds and the modem has no data
path at all. The visible symptom is one layer up: every QMI service the
modem exports is present on QRTR, yet ModemManager refuses to create a
modem object, because its 77-mm-qcom-soc.rules keys the SoC modem's
physdev UID on SUBSYSTEM=="net", DRIVERS=="ipa" and there is no rmnet
netdev to match ("Failed to find a net port in the QMI modem").

Add the block, plus the two smp2p entries the modem uses to negotiate
the IPA clock vote and to signal setup-ready.

The interconnect paths the binding requires are deliberately left out
for now: msm8998 has no interconnect provider in tree, so pointing at
one would park the driver in -EPROBE_DEFER forever - the same "no netdev
ever appears" failure this is meant to fix. of_icc_bulk_get() treats an
absent "interconnects" property as a set of NULL paths, and every icc
operation on a NULL path is a no-op, so IPA works without bus votes.
The paths belong in the same change as the provider.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 arch/arm64/boot/dts/qcom/msm8998.dtsi | 44 +++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index 33d888c8fe7a..8afe41b286b6 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -887,6 +887,17 @@ modem_smp2p_in: slave-kernel {
 			interrupt-controller;
 			#interrupt-cells = <2>;
 		};
+
+		ipa_smp2p_out: ipa-ap-to-modem {
+			qcom,entry-name = "ipa";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		ipa_smp2p_in: ipa-modem-to-ap {
+			qcom,entry-name = "ipa";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
 	};
 
 	smp2p-slpi {
@@ -1790,6 +1801,39 @@ ufsphy: phy@1da7000 {
 			status = "disabled";
 		};
 
+		ipa: ipa@1e40000 {
+			compatible = "qcom,msm8998-ipa";
+
+			reg = <0x01e40000 0x7000>,
+			      <0x01e47000 0x2000>,
+			      <0x01e04000 0x2c000>;
+			reg-names = "ipa-reg",
+				    "ipa-shared",
+				    "gsi";
+
+			iommus = <&anoc2_smmu 0x18e0 0x0>,
+				 <&anoc2_smmu 0x18e2 0x0>;
+
+			clocks = <&rpmcc RPM_SMD_IPA_CLK>;
+			clock-names = "core";
+
+			interrupts-extended = <&intc GIC_SPI 333 IRQ_TYPE_EDGE_RISING>,
+					      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
+					      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+					      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "ipa",
+					  "gsi",
+					  "ipa-clock-query",
+					  "ipa-setup-ready";
+
+			qcom,smem-states = <&ipa_smp2p_out 0>,
+					   <&ipa_smp2p_out 1>;
+			qcom,smem-state-names = "ipa-clock-enabled-valid",
+						"ipa-clock-enabled";
+
+			status = "disabled";
+		};
+
 		tcsr_mutex: hwlock@1f40000 {
 			compatible = "qcom,tcsr-mutex";
 			reg = <0x01f40000 0x20000>;
