#!/bin/sh
# Disable cpuidle retention (state1) and power-collapse (state2) for the
# duration of an s2idle transition. psci_cpu_suspend_enter() hangs the SoC
# when either is entered from s2idle -- proven by a matched A/B, same
# kernel, both states independently: see docs/HANDOFF-6.18-CAMPAIGN.md §0.3
# and docs/campaign/ws-05-suspend.md. WFI-only (both disabled) is the only
# arm that returns SUSPEND_RETURN rc=0.
#
# This buys CORRECTNESS, not battery: WFI never power-collapses and RPM
# never reaches its sleep set either way. Do not read a passing cycle as a
# power fix -- see the idle-draw measurement in docs/campaign/ws-05-suspend.md.
#
# Installed identically at:
#   /usr/lib/systemd/system-sleep/10-taimen-cpuidle    (systemd)
#   /usr/libexec/elogind/system-sleep/10-taimen-cpuidle (OpenRC/elogind)
# Both directories share the same pre|post + suspend|hibernate|... argv
# contract and are read unconditionally by their respective init, so one
# script installed twice is the whole OpenRC twin -- no separate enablement
# step, no install_if. See ws-05-suspend.md Finding 3.
#
# $1 is pre or post; $2 is suspend/hibernate/hybrid-sleep/suspend-then-hibernate.
# Anything else (a future sleep verb this hook does not own) falls through
# the case below and exits 0 without touching cpuidle.
set -u

case "$1" in
pre)
	for f in /sys/devices/system/cpu/cpu*/cpuidle/state[12]/disable; do
		[ -w "$f" ] && echo 1 > "$f"
	done
	command -v logger >/dev/null 2>&1 && logger -t taimen-cpuidle "pre $2: state1/state2 disabled"
	;;
post)
	for f in /sys/devices/system/cpu/cpu*/cpuidle/state[12]/disable; do
		[ -w "$f" ] && echo 0 > "$f"
	done
	command -v logger >/dev/null 2>&1 && logger -t taimen-cpuidle "post $2: state1/state2 re-enabled"
	;;
esac

exit 0
