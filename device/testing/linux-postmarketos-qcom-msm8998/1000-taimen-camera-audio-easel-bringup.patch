+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sony IMX362 sensor driver -- Pixel 2 (taimen) REAR camera bring-up.
+ *
+ * Written as the discriminator for the front-camera blocker (HANDOFF §35/§37):
+ * a completely separate CSI link (CSIPHY0/CSID0/MCLK0/CCI0). Everything in
+ * here that could be extracted from the vendor was: register tables, power
+ * sequence, timing -- all from libmmcamera_imx362.so, decoded exactly as §37
+ * did for imx179 (same struct layouts, same tooling, scratchpad
+ * decode_powerseq.py / find_regtables.py).
+ *
+ * Structure is a lean clone of imx179.c; see that file for the msm8998 CCI /
+ * CAMSS_TOP runtime-PM traps -- they all apply here unchanged.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/easel-mipi.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+static bool no_stream;
+module_param(no_stream, bool, 0644);
+MODULE_PARM_DESC(no_stream, "bring-up: program the mode but never write MODE_SELECT=1");
+
+#define IMX362_REG_MODE_SELECT		0x0100
+#define IMX362_MODE_STANDBY		0x00
+#define IMX362_MODE_STREAMING		0x01
+
+/*
+ * SMIA exposure/timing registers; libcamera-mandatory controls hang off
+ * these (see the imx179 note -- same requirement, same layout, except the
+ * analog gain here is the 16-bit 0x0204/0x0205 pair, G = 1024/(1024-code)).
+ */
+#define IMX362_REG_FRM_LENGTH		0x0340	/* u16, lines */
+#define IMX362_REG_COARSE_INTEG		0x0202	/* u16, lines */
+#define IMX362_REG_ANALOG_GAIN		0x0204	/* u16 */
+#define IMX362_FLL_MAX			0xffff
+/* ponytail: margin 10 is the conservative Sony value; datasheet may say less */
+#define IMX362_EXPOSURE_MARGIN		10
+#define IMX362_EXPOSURE_MIN		1
+/* ponytail: 896 = 8x, vendor tuning ceiling */
+#define IMX362_ANA_GAIN_MAX		896
+
+/* vendor sensor_lib_out_info_t timing for the single mode */
+#define IMX362_LLP			5856
+#define IMX362_FLL			3112
+
+#define IMX362_NATIVE_WIDTH		4032U
+#define IMX362_NATIVE_HEIGHT		3032U
+
+/*
+ * From the vendor slave_info (libmmcamera_imx362.so .data +0x20):
+ * slave_addr 0x34 (8-bit) -> 0x1a 7-bit, i2c_freq_mode 3, addr_type 2,
+ * sensor_id_reg_addr 0x0016, sensor_id 0x0362, mask 0 (full compare).
+ */
+#define IMX362_REG_CHIP_ID		0x0016
+#define IMX362_CHIP_ID			0x0362
+
+#define IMX362_XCLK_FREQ		24000000
+
+struct imx362_reg {
+	u16 addr;
+	u8 val;
+};
+
+/*
+ * Extracted byte-for-byte from libmmcamera_imx362.so: init_settings at .data
+ * file offset 0x5134 (54 entries), res0 snapshot mode at 0x57290 (63 entries).
+ * The mode table's first record is the vendor's literal { 0x0000, 0x00,
+ * delay 2 ms } entry -- imx362_write_regs() reproduces the delay.
+ */
+static const struct imx362_reg imx362_init[] = {
+	{ 0x0136, 0x18 },
+	{ 0x0137, 0x00 },
+	{ 0x31a3, 0x00 },
+	{ 0x4b5f, 0x00 },
+	{ 0x5812, 0x04 },
+	{ 0x5813, 0x04 },
+	{ 0x58d0, 0x08 },
+	{ 0x5f20, 0x01 },
+	{ 0x5ff0, 0x00 },
+	{ 0x5ff1, 0xfe },
+	{ 0x5ff2, 0x00 },
+	{ 0x5ff3, 0x52 },
+	{ 0x720a, 0x24 },
+	{ 0x720b, 0x89 },
+	{ 0x720c, 0x85 },
+	{ 0x720d, 0xa1 },
+	{ 0x720e, 0x6e },
+	{ 0x729c, 0x59 },
+	{ 0x729d, 0x69 },
+	{ 0x729e, 0x85 },
