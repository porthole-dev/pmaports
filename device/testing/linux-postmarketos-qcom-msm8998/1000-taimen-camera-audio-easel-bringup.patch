+/*
+ * Timing taken from the VENDOR's own sensor_lib_out_info_t, not re-derived.
+ *
+ * The array lives at 0xa8bc8 in libmmcamera_imx179.so (count 3 at 0xa8bc0,
+ * 0x60 bytes per entry) and carries, per mode: x_output, y_output,
+ * line_length_pclk, frame_length_lines as u16, then vt_pixel_clk and
+ * op_pixel_clk as u32, then min/max fps as doubles (7.5 and 30.0).
+ *
+ *   res2_video_qtr  1640x922   ll 3444  fl 1316  op_pixel_clk 136000000
+ *   res1_video_30   3280x1846  ll 3450  fl 2086  op_pixel_clk 216000000
+ *   res0_snapshot   3280x2464  ll 3450  fl 2504  op_pixel_clk 259200000
+ *
+ *   link_freq = op_pixel_clk * 10 bpp / (2 * 4 lanes)
+ *
+ * These are all exactly DOUBLE what this driver used to declare. The old
+ * comment derived pixel_rate = pll_op / 5 and observed that link_freq then
+ * "lands on pll_multiplier MHz exactly for all three modes" -- it lands on
+ * 2 * pll_multiplier, and the coincidence made the factor-of-two look like
+ * confirmation instead of the error it was.
+ *
+ * Consequence: csiphy_settle_cnt_calc() was fed half the real link rate and
+ * produced settle 18 where 14 is correct for the binned mode. (Correcting it
+ * does NOT by itself make the sensor transmit -- sweeping settle over 12..18
+ * changes nothing -- but everything downstream that sizes a clock from
+ * PIXEL_RATE or LINK_FREQ was being told half the truth.)
+ */
+struct imx179_mode {
+	u32 width;
+	u32 height;
+	const struct imx179_reg *regs;
+	u32 num_regs;
+	u64 pixel_rate;
+	s64 link_freq;
+	/* vendor sensor_lib_out_info_t timing, pixels/lines */
+	u32 llp;
+	u32 fll;
+	/* analog crop (0x0344..0x034b in the mode table), full-array pixels */
+	struct v4l2_rect crop;
+};
