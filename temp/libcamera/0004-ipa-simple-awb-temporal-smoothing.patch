From: taimen camera bring-up
Subject: [PATCH] ipa: simple: awb: smooth gains over time

The gray-world AWB applies each frame's measured gains instantly, so the
colour temperature (and with it the interpolated CCM) jumps abruptly and
panning the camera produces momentary green casts. Vendor 3A filters the
gains over roughly a second. Apply an exponential moving average with 0.9
per-frame retention (~0.6 s time constant at 15 fps) before publishing the
gains; the smoothed gains also feed estimateCCT(), so the colour
temperature and CCM interpolation glide instead of stepping.

--- a/src/ipa/simple/algorithms/awb.h
+++ b/src/ipa/simple/algorithms/awb.h
@@ -29,6 +29,10 @@
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
 		     ControlList &metadata) override;
+
+private:
+	RGB<float> smoothedGains_;
+	bool smoothedValid_ = false;
 };
 
 } /* namespace ipa::soft::algorithms */
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -78,12 +78,25 @@
 	 * Clamp max gain at 4.0, this also avoids 0 division.
 	 */
 	auto &gains = context.activeState.awb.gains;
-	gains = { {
+	const RGB<float> measured = { {
 		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
 		1.0,
 		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
 	} };
 
+	/*
+	 * Temporally smooth the gains so the colour temperature (and the CCM
+	 * interpolated from it) transitions gradually, as vendor 3A does,
+	 * instead of stepping per frame and flashing green while panning.
+	 */
+	if (!smoothedValid_) {
+		smoothedGains_ = measured;
+		smoothedValid_ = true;
+	} else {
+		smoothedGains_ = smoothedGains_ * 0.9f + measured * 0.1f;
+	}
+	gains = smoothedGains_;
+
 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
 	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
