+/* ------------------------------------------------------------------
+ * /dev/fpc_tee: open() drives the one-time bring-up; the ioctl is a
+ * dumb pipe after that; poll()/read() expose the same interrupt latch
+ * the sysfs "irq" attribute already does.
+ * ------------------------------------------------------------------ */
+
+static int fpc1020_chardev_open(struct inode *inode, struct file *filp)
+{
+	struct miscdevice *miscdev = filp->private_data;
+	struct fpc1020 *fpc1020 = container_of(miscdev, struct fpc1020, miscdev);
+	int ret = 0;
+
+	filp->private_data = fpc1020;
+
+	ret = mutex_lock_interruptible(&fpc1020->lock);
+	if (ret)
+		return ret;
+	if (!fpc1020->ready)
+		ret = fpc1020_bring_up_locked(fpc1020);
+	mutex_unlock(&fpc1020->lock);
+
+	return ret;
+}
+
+static long fpc1020_chardev_ioctl(struct file *filp, unsigned int cmd,
+				  unsigned long arg)
+{
+	struct fpc1020 *fpc1020 = filp->private_data;
+	struct fpc1020_tee_xfer x;
+	void *cmdbuf;
+	int ret;
+
+	if (cmd != FPC1020_TEE_IOC_XFER)
+		return -ENOTTY;
+	if (copy_from_user(&x, (void __user *)arg, sizeof(x)))
+		return -EFAULT;
+	if (x.len == 0 || x.len > FPC1020_TZ_CMDBUF_SIZE)
+		return -EMSGSIZE;
+
+	ret = mutex_lock_interruptible(&fpc1020->lock);
+	if (ret)
+		return ret;
+
+	cmdbuf = qcom_tzmem_alloc(fpc1020->tzpool, FPC1020_TZ_CMDBUF_SIZE,
+				  GFP_KERNEL | GFP_DMA32);
+	if (!cmdbuf) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+
+	memset(cmdbuf, 0, FPC1020_TZ_CMDBUF_SIZE);
+	if (copy_from_user(cmdbuf, (void __user *)(uintptr_t)x.buf, x.len)) {
+		ret = -EFAULT;
+		goto free;
+	}
+
+	ret = fpc1020_tz_xfer_locked(fpc1020, cmdbuf, x.len);
+	if (ret)
+		goto free;
+
+	if (copy_to_user((void __user *)(uintptr_t)x.buf, cmdbuf, x.len))
+		ret = -EFAULT;
+
+free:
+	qcom_tzmem_free(cmdbuf);
+unlock:
+	mutex_unlock(&fpc1020->lock);
+	return ret;
+}
+
+static __poll_t fpc1020_chardev_poll(struct file *filp, poll_table *wait)
+{
+	struct fpc1020 *fpc1020 = filp->private_data;
+
+	poll_wait(filp, &fpc1020->irq_wq, wait);
+	return atomic_read(&fpc1020->latched) ? (EPOLLIN | EPOLLRDNORM) : 0;
+}
+
+/* One byte per finger IRQ, matching fpctee.c's fpc_tee_wait_event(): a
+ * successful read means "the latch was set" and, unlike the sysfs
+ * attribute (cleared only by a write), clears it as part of the read --
+ * the single-fd poll()+read() contract libfprint's transport expects. */
+static ssize_t fpc1020_chardev_read(struct file *filp, char __user *buf,
+				    size_t count, loff_t *ppos)
+{
+	struct fpc1020 *fpc1020 = filp->private_data;
+	u8 val;
+
+	if (count < 1)
+		return -EINVAL;
+
+	if (!atomic_read(&fpc1020->latched)) {
+		if (filp->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		if (wait_event_interruptible(fpc1020->irq_wq,
+					     atomic_read(&fpc1020->latched)))
+			return -EINTR;
+	}
+
+	val = (u8)atomic_xchg(&fpc1020->latched, 0);
+	if (put_user(val, buf))
+		return -EFAULT;
+
+	return 1;
+}
