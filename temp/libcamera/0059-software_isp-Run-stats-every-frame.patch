From 729fb1db26acbefc23f0341fe88260f40f4472f0 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Mon, 14 Sep 2026 17:37:54 +0200
Subject: [PATCH 59/68] software_isp: Run stats every frame

Every IPA algorithm returns early when stats are not valid, so
autofocus can only advance its scan on a frame that carries stats.
Measured on msm8998 (Pixel 2 XL, imx362): 13 scan steps at a median of
exactly 4.0 delivered frames each, on a pipeline running a solid
30.0 fps, which is the entirety of AF's 3.18 s convergence. At one stat
per frame it converged in 1.49 s.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../internal/software_isp/swstats_cpu.h        | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/include/libcamera/internal/software_isp/swstats_cpu.h b/include/libcamera/internal/software_isp/swstats_cpu.h
index 551870921..78a2f6481 100644
--- a/include/libcamera/internal/software_isp/swstats_cpu.h
+++ b/include/libcamera/internal/software_isp/swstats_cpu.h
@@ -39,12 +39,20 @@ public:
 	~SwStatsCpu() = default;
 
 	/*
-	 * The combination of pipeline + sensor delays means that
-	 * exposure changes can take up to 3 frames to get applied,
-	 * Run stats once every 4 frames to ensure any previous
-	 * exposure changes have been applied.
+	 * Every frame. Autofocus can only step on a frame that carries stats,
+	 * so a cadence of 4 quadruples AF convergence: measured on msm8998
+	 * 2026-08-21, 13 scan steps at a median of exactly 4.0 delivered
+	 * frames each on a solid 30.0 fps pipeline, which is the whole of its
+	 * 3.18 s. ~0.8 s expected at 1.
+	 *
+	 * The 4 existed for AGC: pipeline + sensor delays mean an exposure
+	 * change takes up to 3 frames to apply, and this sensor reports no
+	 * delay model. So judge AE stability and CPU cost alongside AF speed.
+	 * If AE oscillates, the fix is a per-algorithm cadence -- stats every
+	 * frame, AGC/AWB skipping frames off the 4-boundary -- not one global
+	 * constant serving two different requirements.
 	 */
-	static constexpr uint32_t kStatPerNumFrames = 4;
+	static constexpr uint32_t kStatPerNumFrames = 1;
 
 	bool isValid() const { return sharedStats_.fd().isValid(); }
 
