diff --git a/src/fingerprint-unlock.c b/src/fingerprint-unlock.c
new file mode 100644
index 0000000..072f025
--- /dev/null
+++ b/src/fingerprint-unlock.c
@@ -0,0 +1,493 @@
+/*
+ * Copyright (C) 2026 Giuseppe Maggio
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Author: Giuseppe Maggio <jertlok@proton.me>
+ */
+
+#define G_LOG_DOMAIN "phosh-fingerprint-unlock"
+
+#include "phosh-config.h"
+#include "fingerprint-unlock.h"
+
+#include <glib/gi18n.h>
+#include <gio/gio.h>
+
+#define FPRINT_BUS_NAME         "net.reactivated.Fprint"
+#define FPRINT_MANAGER_PATH     "/net/reactivated/Fprint/Manager"
+#define FPRINT_MANAGER_IFACE    "net.reactivated.Fprint.Manager"
+#define FPRINT_DEVICE_IFACE     "net.reactivated.Fprint.Device"
+
+/* Like a phone: after this many unrecognised fingers, only the passcode. */
+#define MAX_FAILURES            5
+#define RESTART_DELAY_MS        500
+
+/**
+ * PhoshFingerprintUnlock:
+ *
+ * Unlock with a fingerprint through fprintd
+ *
+ * While started, keeps fprintd's default device claimed for the current user
+ * and verifying against any of their enrolled fingers, and emits
+ * [signal@FingerprintUnlock::matched] once one matches. Hints and failures
+ * are reported through [signal@FingerprintUnlock::status]. Does nothing when
+ * there is no fprintd, no device, or no enrolled finger.
+ */
+
+enum {
+  PROP_0,
+  PROP_ACTIVE,
+  PROP_LAST_PROP
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+enum {
+  MATCHED,
+  STATUS,
+  N_SIGNALS
+};
+static guint signals[N_SIGNALS];
+
+struct _PhoshFingerprintUnlock {
+  GObject       parent;
+
+  GCancellable *cancel;
+  GDBusProxy   *device;
+  gboolean      claim_sent;
+  gboolean      verify_sent;
+  guint         failures;
+  guint         restart_id;
+  gboolean      active;
+};
+
+G_DEFINE_TYPE (PhoshFingerprintUnlock, phosh_fingerprint_unlock, G_TYPE_OBJECT)
+
+
+static void
+set_active (PhoshFingerprintUnlock *self, gboolean active)
+{
+  if (self->active == active)
+    return;
+
+  self->active = active;
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_ACTIVE]);
+}
+
+
+static gboolean
+check_error (GError *error, const char *what)
+{
+  if (error == NULL)
+    return FALSE;
+
+  if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_debug ("%s failed: %s", what, error->message);
+
+  return TRUE;
+}
+
+
+static void on_verify_start_ready (GObject *source, GAsyncResult *res, gpointer user_data);
+
+static void
+verify_start (PhoshFingerprintUnlock *self)
+{
+  self->verify_sent = TRUE;
+  g_dbus_proxy_call (self->device, "VerifyStart", g_variant_new ("(s)", "any"),
+                     G_DBUS_CALL_FLAGS_NONE, -1, self->cancel,
+                     on_verify_start_ready, self);
+}
+
+
+static gboolean
+on_restart_timeout (gpointer user_data)
+{
+  PhoshFingerprintUnlock *self = PHOSH_FINGERPRINT_UNLOCK (user_data);
+
+  self->restart_id = 0;
+  verify_start (self);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+on_verify_stop_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+  PhoshFingerprintUnlock *self;
+
+  ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (err && g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  self = PHOSH_FINGERPRINT_UNLOCK (user_data);
+  self->verify_sent = FALSE;
+  self->restart_id = g_timeout_add (RESTART_DELAY_MS, on_restart_timeout, self);
+  g_source_set_name_by_id (self->restart_id, "[phosh-fingerprint-unlock] restart");
+}
+
+
+static const char *
+hint_for_result (const char *result)
+{
+  if (g_str_equal (result, "verify-swipe-too-short") || g_str_equal (result, "verify-too-fast"))
+    return _("Keep your finger on the sensor");
+  if (g_str_equal (result, "verify-finger-not-centered"))
+    return _("Center your finger on the sensor");
+  if (g_str_equal (result, "verify-remove-and-retry"))
+    return _("Lift your finger and try again");
+  if (g_str_equal (result, "verify-retry-scan"))
+    return _("Try again");
+
+  return NULL;
+}
+
+
+static void
+on_device_signal (GDBusProxy *proxy,
+                  const char *sender,
+                  const char *signal_name,
+                  GVariant   *params,
+                  gpointer    user_data)
+{
+  PhoshFingerprintUnlock *self = PHOSH_FINGERPRINT_UNLOCK (user_data);
+  const char *result;
+  gboolean done;
+
+  if (!g_str_equal (signal_name, "VerifyStatus"))
+    return;
+
+  g_variant_get (params, "(&sb)", &result, &done);
+  g_debug ("VerifyStatus %s, done %d", result, done);
+
+  if (!done) {
+    const char *hint = hint_for_result (result);
+
+    if (hint)
+      g_signal_emit (self, signals[STATUS], 0, hint);
+    return;
+  }
+
+  if (g_str_equal (result, "verify-match")) {
+    phosh_fingerprint_unlock_stop (self);
+    g_signal_emit (self, signals[MATCHED], 0);
+    return;
+  }
+
+  if (!g_str_equal (result, "verify-no-match")) {
+    g_debug ("Fingerprint verification ended: %s", result);
+    phosh_fingerprint_unlock_stop (self);
+    return;
+  }
+
+  self->failures++;
+  if (self->failures >= MAX_FAILURES) {
+    phosh_fingerprint_unlock_stop (self);
+    g_signal_emit (self, signals[STATUS], 0, _("Too many attempts, use your passcode"));
+    return;
+  }
+
+  g_signal_emit (self, signals[STATUS], 0, _("Fingerprint not recognized"));
+  g_dbus_proxy_call (self->device, "VerifyStop", NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                     self->cancel, on_verify_stop_ready, self);
+}
+
+
+static void
+on_verify_start_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+
+  ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (check_error (err, "VerifyStart")) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      phosh_fingerprint_unlock_stop (PHOSH_FINGERPRINT_UNLOCK (user_data));
+    return;
+  }
+
+  g_debug ("Waiting for a finger");
+  set_active (PHOSH_FINGERPRINT_UNLOCK (user_data), TRUE);
+}
+
+
+static void
+on_claim_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+
+  ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (check_error (err, "Claim")) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      phosh_fingerprint_unlock_stop (PHOSH_FINGERPRINT_UNLOCK (user_data));
+    return;
+  }
+
+  verify_start (PHOSH_FINGERPRINT_UNLOCK (user_data));
+}
+
+
+static void
+on_list_fingers_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+  PhoshFingerprintUnlock *self;
+
+  ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (check_error (err, "ListEnrolledFingers")) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      phosh_fingerprint_unlock_stop (PHOSH_FINGERPRINT_UNLOCK (user_data));
+    return;
+  }
+
+  self = PHOSH_FINGERPRINT_UNLOCK (user_data);
+  self->claim_sent = TRUE;
+  g_dbus_proxy_call (self->device, "Claim", g_variant_new ("(s)", g_get_user_name ()),
+                     G_DBUS_CALL_FLAGS_NONE, -1, self->cancel, on_claim_ready, self);
+}
+
+
+static void
+on_device_proxy_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  PhoshFingerprintUnlock *self;
+  GDBusProxy *device;
+
+  device = g_dbus_proxy_new_for_bus_finish (res, &err);
+  if (check_error (err, "Device proxy")) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      phosh_fingerprint_unlock_stop (PHOSH_FINGERPRINT_UNLOCK (user_data));
+    return;
+  }
+
+  self = PHOSH_FINGERPRINT_UNLOCK (user_data);
+  self->device = device;
+  g_signal_connect_object (self->device, "g-signal", G_CALLBACK (on_device_signal), self, 0);
+
+  g_dbus_proxy_call (self->device, "ListEnrolledFingers",
+                     g_variant_new ("(s)", g_get_user_name ()),
+                     G_DBUS_CALL_FLAGS_NONE, -1, self->cancel, on_list_fingers_ready, self);
+}
+
+
+static void
+on_default_device_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+  PhoshFingerprintUnlock *self;
+  const char *path;
+
+  ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (check_error (err, "GetDefaultDevice")) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      phosh_fingerprint_unlock_stop (PHOSH_FINGERPRINT_UNLOCK (user_data));
+    return;
+  }
+
+  self = PHOSH_FINGERPRINT_UNLOCK (user_data);
+  g_variant_get (ret, "(&o)", &path);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+                            NULL, FPRINT_BUS_NAME, path, FPRINT_DEVICE_IFACE,
+                            self->cancel, on_device_proxy_ready, self);
+}
+
+
+static void
+on_manager_proxy_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GDBusProxy) manager = NULL;
+  g_autoptr (GError) err = NULL;
+  PhoshFingerprintUnlock *self;
+
+  manager = g_dbus_proxy_new_for_bus_finish (res, &err);
+  if (check_error (err, "Manager proxy")) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      phosh_fingerprint_unlock_stop (PHOSH_FINGERPRINT_UNLOCK (user_data));
+    return;
+  }
+
+  self = PHOSH_FINGERPRINT_UNLOCK (user_data);
+  g_dbus_proxy_call (manager, "GetDefaultDevice", NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                     self->cancel, on_default_device_ready, self);
+}
+
+
+/* Teardown outlives the object: it only holds the proxy. */
+static void
+on_release_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+
+  /* Releasing a device whose claim never completed fails; that is fine. */
+  ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+}
+
+
+static void
+on_teardown_stop_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+
+  ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (GPOINTER_TO_INT (user_data))
+    g_dbus_proxy_call (G_DBUS_PROXY (source), "Release", NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                       NULL, on_release_ready, NULL);
+}
+
+
+/**
+ * phosh_fingerprint_unlock_start:
+ * @self: The fingerprint unlock
+ *
+ * Start waiting for an enrolled finger. Does nothing if already started.
+ */
+void
+phosh_fingerprint_unlock_start (PhoshFingerprintUnlock *self)
+{
+  g_return_if_fail (PHOSH_IS_FINGERPRINT_UNLOCK (self));
+
+  if (self->cancel)
+    return;
+
+  self->cancel = g_cancellable_new ();
+  self->failures = 0;
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+                            NULL, FPRINT_BUS_NAME, FPRINT_MANAGER_PATH, FPRINT_MANAGER_IFACE,
+                            self->cancel, on_manager_proxy_ready, self);
+}
+
+
+/**
+ * phosh_fingerprint_unlock_stop:
+ * @self: The fingerprint unlock
+ *
+ * Stop waiting and give the device back to fprintd.
+ */
+void
+phosh_fingerprint_unlock_stop (PhoshFingerprintUnlock *self)
+{
+  g_return_if_fail (PHOSH_IS_FINGERPRINT_UNLOCK (self));
+
+  g_clear_handle_id (&self->restart_id, g_source_remove);
+
+  if (self->cancel) {
+    g_cancellable_cancel (self->cancel);
+    g_clear_object (&self->cancel);
+  }
+
+  if (self->device) {
+    g_signal_handlers_disconnect_by_data (self->device, self);
+
+    if (self->verify_sent)
+      g_dbus_proxy_call (self->device, "VerifyStop", NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                         NULL, on_teardown_stop_ready, GINT_TO_POINTER (self->claim_sent));
+    else if (self->claim_sent)
+      g_dbus_proxy_call (self->device, "Release", NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                         NULL, on_release_ready, NULL);
+
+    g_clear_object (&self->device);
+  }
+
+  self->verify_sent = FALSE;
+  self->claim_sent = FALSE;
+  set_active (self, FALSE);
+}
+
+
+static void
+phosh_fingerprint_unlock_get_property (GObject    *object,
+                                      guint       property_id,
+                                      GValue     *value,
+                                      GParamSpec *pspec)
+{
+  PhoshFingerprintUnlock *self = PHOSH_FINGERPRINT_UNLOCK (object);
+
+  switch (property_id) {
+  case PROP_ACTIVE:
+    g_value_set_boolean (value, self->active);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_fingerprint_unlock_dispose (GObject *object)
+{
+  phosh_fingerprint_unlock_stop (PHOSH_FINGERPRINT_UNLOCK (object));
+
+  G_OBJECT_CLASS (phosh_fingerprint_unlock_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_fingerprint_unlock_class_init (PhoshFingerprintUnlockClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = phosh_fingerprint_unlock_dispose;
+  object_class->get_property = phosh_fingerprint_unlock_get_property;
+
+  /**
+   * PhoshFingerprintUnlock:active:
+   *
+   * Whether an enrolled finger on the sensor would unlock right now.
+   */
+  props[PROP_ACTIVE] = g_param_spec_boolean ("active", "", "", FALSE,
+                                             G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY |
+                                             G_PARAM_STATIC_STRINGS);
+  g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+
+  /**
+   * PhoshFingerprintUnlock::matched:
+   *
+   * An enrolled finger of the current user was recognized.
+   */
+  signals[MATCHED] = g_signal_new ("matched",
+                                   G_TYPE_FROM_CLASS (klass),
+                                   G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL,
+                                   G_TYPE_NONE, 0);
+  /**
+   * PhoshFingerprintUnlock::status:
+   * @message: A translated message for the user
+   *
+   * Something the user should know about the scan: a hint or a failure.
+   */
+  signals[STATUS] = g_signal_new ("status",
+                                  G_TYPE_FROM_CLASS (klass),
+                                  G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL,
+                                  G_TYPE_NONE, 1, G_TYPE_STRING);
+}
+
+
+static void
+phosh_fingerprint_unlock_init (PhoshFingerprintUnlock *self)
+{
+}
+
+
+gboolean
+phosh_fingerprint_unlock_get_active (PhoshFingerprintUnlock *self)
+{
+  g_return_val_if_fail (PHOSH_IS_FINGERPRINT_UNLOCK (self), FALSE);
+
+  return self->active;
+}
+
+
+PhoshFingerprintUnlock *
+phosh_fingerprint_unlock_new (void)
+{
+  return g_object_new (PHOSH_TYPE_FINGERPRINT_UNLOCK, NULL);
+}
