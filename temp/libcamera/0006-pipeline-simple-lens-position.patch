From: Giuseppe Maggio <jertlok@proton.me>
Subject: [PATCH] pipeline: simple: advertise LensPosition for focus-lens cameras

Expose LensPosition (raw actuator units) when the sensor has a
lens-focus link. The control is consumed by the soft IPA's Af
algorithm; the pipeline does not drive the lens directly.

Assisted-by: Claude

--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -35,6 +35,8 @@
 #include "libcamera/internal/camera.h"
 #include "libcamera/internal/camera_manager.h"
 #include "libcamera/internal/camera_sensor.h"
+#include "libcamera/internal/camera_lens.h"
+#include "libcamera/internal/camera_sensor.h"
 #include "libcamera/internal/camera_sensor_properties.h"
 #include "libcamera/internal/converter.h"
 #include "libcamera/internal/delayed_controls.h"
@@ -664,6 +666,22 @@
 
 	properties_ = sensor_->properties();
 
+	/*
+	 * If the sensor has an associated focus lens, expose LensPosition in
+	 * raw actuator units. The control is consumed by the soft IPA's Af
+	 * algorithm (manual override / auto), which is the single writer of
+	 * the lens via its metadata; the pipeline deliberately does not set
+	 * the lens directly to avoid competing writers.
+	 */
+	if (sensor_->focusLens()) {
+		ControlInfoMap::Map ctrls(controlInfo_.begin(),
+					  controlInfo_.end());
+		ctrls[&controls::LensPosition] = ControlInfo(0.0f, 4095.0f,
+							     0.0f);
+		controlInfo_ = ControlInfoMap(std::move(ctrls),
+					      controls::controls);
+	}
+
 	/* Find the first subdev that can generate a frame start signal, if any. */
 	frameStartEmitter_ = nullptr;
 	for (const Entity &entity : entities_) {
