#!/bin/sh
# Userspace half of the UI-stutter fix (kernel half: CONFIG_UCLAMP_TASK{,_GROUP}
# in linux-postmarketos-qcom-msm8998). Measured on this device: every UI hitch
# begins with a CPU cluster sitting at its 257 MHz floor and ramping to 710.
# Pinning scaling_min_freq on BOTH clusters was a clean 10x (baseline 3.1-3.3%
# dropped frames / max frame 83-85ms / 6-7 jank -> pinned 0.2-0.6% / 33-34ms /
# 0-1 jank at 59.7fps), with the big cluster (policy4) alone doing almost all
# of the work and the little cluster (policy0) alone doing nothing.
#
# A global scaling_min_freq pin must NOT ship -- it destroys idle battery,
# same reason an earlier 710MHz GPU floor was deliberately removed from this
# project. uclamp_min is the targeted equivalent: it raises the scheduler's
# utilisation floor only for the tasks that need it.
#
# systemd has no native unit directive for uclamp (verified: no "uclamp"
# string anywhere in libsystemd-core-261.so, the version this device ships),
# so this writes the cgroup v2 interface file directly -- exactly what
# CONFIG_UCLAMP_TASK_GROUP exists to expose (see kernel
# Documentation/admin-guide/cgroup-v2.rst, "cpu.uclamp.min").
#
# The target is user-<uid>.slice, NOT session.slice. session.slice was tried
# first and is WRONG: it was measured live on-device (read-only) that phoc
# (the compositor -- the process actually doing frame submission) runs in
#     0::/user.slice/user-10000.slice/session-c1.scope
# a SIBLING branch of
#     0::/user.slice/user-10000.slice/user@10000.service/session.slice/mobi.phosh.Shell.service
# where phosh (the shell) lives. session.slice only ever covers phosh, never
# phoc. user-<uid>.slice is the nearest common ancestor of both, so it is
# the smallest single write that actually reaches the compositor. This is
# broader than "just the compositor + shell" -- it covers everything the
# user runs, including app.slice/background.slice under user@.service -- but
# on a single-user phone the interactive session more or less IS the
# workload, and this is still far narrower than the global scaling_min_freq
# pin this fix exists to avoid.
#
# For cpu.uclamp.min to exist at user-<uid>.slice at all, the "cpu"
# cgroup-v2 controller must be enabled in user.slice's cgroup.subtree_control
# (a cgroup's own controller-interface files exist only if its PARENT pushed
# that controller down to it). Measured live: it currently is NOT --
# `cat /sys/fs/cgroup/user.slice/user-10000.slice/cgroup.controllers` reads
# "memory pids", no cpu. taimen-user-cpu-delegate.conf (a drop-in on the
# system unit user@.service, see its own header) adds "cpu" to that unit's
# Delegate=, which is what causes systemd to push "cpu" up through every
# ancestor -- user.slice and user-<uid>.slice included -- exactly the same
# mechanism that already makes "memory pids" show up there today. Once that
# lands, the value written here to user-<uid>.slice applies to every
# descendant task, including phoc in session-c1.scope, even though
# session-c1.scope never separately enables "cpu" itself: a cgroup with no
# controller of its own is scheduled as part of the nearest ancestor that
# has one.
#
# 25 is a conservative opening value (20-30% was judged reasonable to keep
# the big cluster off its floor during interaction without pinning it high).
# It is a tuning knob, not a validated constant: it needs an on-device A/B
# against tools/tk-fps.py before being trusted as final.
#
# The uid is read with `id -u`, never hardcoded, so this keeps working for
# whatever user actually owns the session.
#
# FAILS LOUDLY on purpose: this device does not have the uclamp kernel
# flashed yet, so cpu.uclamp.min will not exist until it is, and the cpu
# delegation above is unconfirmed until then too. A silent no-op here would
# be the exact failure mode this fix exists to avoid, so a missing file or a
# failed write is reported to stderr (systemd journals it under this unit's
# name) and the unit is left FAILED -- `systemctl --user status
# taimen-uclamp-session.service` / `journalctl --user -u
# taimen-uclamp-session.service` must be checked after the kernel is flashed
# to confirm this actually applied.
set -e

UCLAMP_MIN_PCT=25

uid=$(id -u)
target="/sys/fs/cgroup/user.slice/user-${uid}.slice/cpu.uclamp.min"

if [ ! -e "$target" ]; then
	echo "taimen-uclamp-session: $target does not exist -- cpu controller not delegated to user-${uid}.slice (needs the uclamp kernel + taimen-user-cpu-delegate.conf) or the cgroup layout changed. uclamp_min NOT applied." >&2
	exit 1
fi

if ! echo "$UCLAMP_MIN_PCT" > "$target"; then
	echo "taimen-uclamp-session: write to $target failed. uclamp_min NOT applied." >&2
	exit 1
fi

echo "taimen-uclamp-session: uclamp_min=$UCLAMP_MIN_PCT applied to user-${uid}.slice ($target)"
