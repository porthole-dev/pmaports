# TEMPORARY FORK of community/xdg-desktop-portal.
#
# Adds org.freedesktop.portal.NFC: AccessNFC, OpenNFCRemote, IsNFCPresent,
# modelled member for member on the Camera portal. OpenNFCRemote hands a
# permitted app a filtered connection to neard's system-bus API via
# xdg-dbus-proxy -- the app can poll, enumerate and read tags, but cannot
# call Properties.Set on the adapter. That stays the user's switch, in
# Settings ▸ Privacy & Security ▸ NFC. Full design:
# docs/superpowers/specs/2026-09-10-nfc-toggle-and-portal-design.md.
#
# Built with -Dnfc=enabled explicitly. It is a meson `feature` option that
# defaults to `auto`; a builder without xdg-dbus-proxy present at configure
# time would silently produce a package missing the portal entirely, which
# is why xdg-dbus-proxy is also pinned in makedepends below, not left to
# auto-detection. It is a RUNTIME dependency too -- the portal execs it by
# absolute path on every OpenNFCRemote call -- hence depends=, not just
# makedepends=.
#
# pkgrel is 50 so this build outranks Alpine's 1.22.1-r0 from any repo.
#
# NOT YET SUBMITTED upstream. Drop this fork once org.freedesktop.portal.NFC
# lands in xdg-desktop-portal proper.

maintainer="Giuseppe Maggio <jertlok@proton.me>"
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
pkgname=xdg-desktop-portal
pkgver=1.22.1
pkgrel=50
# NOTE: Upgrade only to even-numbered versions (e.g. 1.18.x, 1.20.x)!
pkgdesc="Desktop integration portal"
url="https://github.com/flatpak/xdg-desktop-portal"
arch="all"
license="LGPL-2.1-or-later"
depends="bubblewrap xdg-dbus-proxy"
depends_dev="$pkgname=$pkgver-r$pkgrel"
_depends_document_portal="cmd:fusermount3"
makedepends="
	$_depends_document_portal
	flatpak
	flatpak-dev
	fontconfig-dev
	fuse3-dev
	geoclue-dev
	gettext-dev
	glib-dev
	gst-plugins-base-dev
	json-glib-dev
	libportal-dev
	meson
	pipewire-dev
	py3-docutils
	xdg-dbus-proxy
	xmlto
	"
checkdepends="
	py3-dbusmock
	py3-gobject3
	py3-pytest
	umockdev-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-openrc
	$pkgname-systemd
	xdg-document-portal:_document_portal
	xdg-document-portal-openrc:_document_portal_openrc
	"
source="https://github.com/flatpak/xdg-desktop-portal/releases/download/$pkgver/xdg-desktop-portal-$pkgver.tar.xz
	add-an-nfc-portal.patch
	xdg-desktop-portal.initd
	xdg-document-portal.initd
	xdg-permission-store.initd
	"
# check: requires geoclue to be running as a system service.
options="!check"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dsystemd=disabled \
		-Dman-pages=enabled \
		-Ddocumentation=disabled \
		-Ddebug=true \
		-Dnfc=enabled \
		-Dtests="$(want_check && echo enabled || echo disabled)" \
		. output
	meson compile -C output
}

check() {
	TEST_IN_CI=true meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	cd "$pkgdir"

	mkdir -p usr/lib
	mv usr/share/pkgconfig usr/lib/

	install -Dm755 "$srcdir"/xdg-desktop-portal.initd etc/user/init.d/xdg-desktop-portal
	install -Dm755 "$srcdir"/xdg-permission-store.initd etc/user/init.d/xdg-permission-store
}

_document_portal() {
	pkgdesc="$pkgdesc (document portal)"
	depends=$_depends_document_portal
	install_if="$pkgname=$pkgver-r$pkgrel"

	amove usr/libexec/xdg-document-portal
	amove usr/share/dbus-1/*/org.freedesktop.portal.Documents.*
	amove usr/share/dbus-1/*/org.freedesktop.portal.FileTransfer.*
}

_document_portal_openrc() {
	pkgdesc="$pkgdesc (document portal)"
	default_openrc

	install -Dm755 "$srcdir"/xdg-document-portal.initd "$subpkgdir"/etc/user/init.d/xdg-document-portal
}

