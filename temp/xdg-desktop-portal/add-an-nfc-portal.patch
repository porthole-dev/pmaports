+        app_con = dbus.bus.BusConnection(os.environ["DBUS_SESSION_BUS_ADDRESS"])
+        nfc_intf = xdp.get_portal_iface(app_con, "NFC")
+        for _ in range(4):
+            fd = nfc_intf.OpenNFCRemote({}, dbus_interface="org.freedesktop.portal.NFC")
+            os.close(fd.take())
