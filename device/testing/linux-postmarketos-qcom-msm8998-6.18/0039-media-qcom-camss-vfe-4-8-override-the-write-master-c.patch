From 754bc2e04f751ecda49a1819d12873fd8bb51326 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 8 Aug 2026 18:16:48 +0200
Subject: [PATCH 039/115] media: qcom: camss: vfe-4-8: override the write
 master clock gating

vfe_set_cgc_override() is a stub here, so the RDI path calls it from
vfe_enable_output() and nothing happens. The vendor driver does not skip
it on this hardware: it sets the master's bit in CGC_OVERRIDE_1 exactly
the way VFE 4.1 does.

A write master left clock gated is not a subtle failure. It accepts pixel
data and fills its slice of the unified buffer, then overflows on every
frame, never raises a ping-pong completion and never issues a single AXI
transaction - pointing its ping and pong addresses at an unmapped IOVA
does not even raise an SMMU fault.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/media/platform/qcom/camss/camss-vfe-4-8.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
index b2f7d855d8dd..3c98f686143a 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
@@ -29,6 +29,9 @@
 #define VFE_0_GLOBAL_RESET_CMD_DSP	BIT(8)
 #define VFE_0_GLOBAL_RESET_CMD_IDLE_CGC	BIT(9)
 
+#define VFE_0_CGC_OVERRIDE_1		0x03c
+#define VFE_0_CGC_OVERRIDE_1_IMAGE_Mx_CGC_OVERRIDE(x)	BIT(x)
+
 #define VFE_0_MODULE_LENS_EN		0x040
 #define VFE_0_MODULE_LENS_EN_DEMUX		BIT(2)
 #define VFE_0_MODULE_LENS_EN_CHROMA_UPSAMPLE	BIT(3)
@@ -854,7 +857,15 @@ static void vfe_set_clamp_cfg(struct vfe_device *vfe)
 
 static void vfe_set_cgc_override(struct vfe_device *vfe, u8 wm, u8 enable)
 {
-	/* empty */
+	u32 val = VFE_0_CGC_OVERRIDE_1_IMAGE_Mx_CGC_OVERRIDE(wm);
+
+	if (enable)
+		vfe_reg_set(vfe, VFE_0_CGC_OVERRIDE_1, val);
+	else
+		vfe_reg_clr(vfe, VFE_0_CGC_OVERRIDE_1, val);
+
+	/* The clock has to be on before the master is handed any data */
+	wmb();
 }
 
 static void vfe_set_camif_cfg(struct vfe_device *vfe, struct vfe_line *line)
