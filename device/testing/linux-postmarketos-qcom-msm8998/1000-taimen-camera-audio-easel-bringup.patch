+ */
+static const struct iio_chan_spec qcom_smgr_elmyra_iio_channels[] = {
+	QCOM_SMGR_INDEX_CHANNEL(0),
+	QCOM_SMGR_INDEX_CHANNEL(1),
+	QCOM_SMGR_INDEX_CHANNEL(2),
+	QCOM_SMGR_TIMESTAMP_CHANNEL(3)
+};
+
+/*
+ * The LSM6DSM step counter. IIO_CHAN_INFO_PROCESSED, so in_steps_input: the
+ * count arrives as a plain integer, NOT in the Q16.16 everything else here
+ * uses. Measured -- it read 25 after a 25 step walk, where fixed point would
+ * have read 1638400.
+ */
+static const struct iio_chan_spec qcom_smgr_step_count_iio_channels[] = {
+	{
+		.type = IIO_STEPS,
+		.scan_index = 0,
+		.scan_type = {
+			.sign = 'u',
+			.realbits = 32,
+			.storagebits = 32,
+			.endianness = IIO_LE,
+		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED)
+	},
+	QCOM_SMGR_TIMESTAMP_CHANNEL(3)
+};
+
+/*
+ * Step detection, activity, inactivity and the three FTM4 wake gestures report
+ * ONLY when the event fires -- measured: a raw read of any of them blocks
+ * until the subscription times out, because no report is produced on subscribe
+ * the way every other sensor here does one. There is no level to sample, so
+ * they carry no IIO_CHAN_INFO_RAW and are exposed as IIO events instead.
+ *
+ * IIO_EV_TYPE_CHANGE, not INSTANCE: this kernel's uapi has no
+ * IIO_EV_TYPE_INSTANCE, which would otherwise be the closer fit for a
+ * momentary detection.
+ *
+ * Enabling the event is what starts the subscription -- these devices have no
+ * buffer worth enabling, so without that hook nothing would ever ask SMGR for
+ * the sensor and no event could arrive.
+ */
+static const struct iio_event_spec qcom_smgr_change_event = {
+	.type = IIO_EV_TYPE_CHANGE,
+	.dir = IIO_EV_DIR_NONE,
+	.mask_separate = BIT(IIO_EV_INFO_ENABLE),
+};
+
+#define QCOM_SMGR_EVENT_CHANNELS(name, chan_type, ...)			\
+	static const struct iio_chan_spec name[] = {			\
+		{							\
+			.type = (chan_type),				\
+			__VA_ARGS__					\
+			.scan_index = -1,				\
+			.event_spec = &qcom_smgr_change_event,		\
+			.num_event_specs = 1,				\
+		}							\
+	}
+
+/* A step was taken. */
+QCOM_SMGR_EVENT_CHANNELS(qcom_smgr_step_detect_iio_channels, IIO_STEPS);
+
+/*
+ * The LSM6DSM's motion and no-motion interrupts. Inactivity is genuinely
+ * "still"; activity is "something moved" with no finer claim than that, so it
+ * gets an unmodified IIO_ACTIVITY channel rather than a walking or running
+ * modifier it has not earned.
+ */
+QCOM_SMGR_EVENT_CHANNELS(qcom_smgr_activity_iio_channels, IIO_ACTIVITY);
+QCOM_SMGR_EVENT_CHANNELS(qcom_smgr_inactivity_iio_channels, IIO_ACTIVITY,
+			 .modified = 1, .channel2 = IIO_MOD_STILL,);
+
+/*
+ * The wake gestures. IIO has no gesture type and inventing one out of
+ * IIO_PROXIMITY or IIO_ACTIVITY would claim a meaning these do not have, so
+ * they are IIO_INDEX: the device name says which gesture, and the event says
+ * it happened. If something ever needs to act on these the idiomatic form is
+ * an input device emitting KEY_WAKEUP, which is a userspace-visible policy
+ * choice rather than a driver one.
+ */
+QCOM_SMGR_EVENT_CHANNELS(qcom_smgr_gesture_iio_channels, IIO_INDEX,
+			 .indexed = 1, .channel = 0,);
+
+static const char *const qcom_smgr_sensor_type_device_names[] = {
+	[SNS_SMGR_SENSOR_TYPE_ACCEL] = "qcom-smgr-accel",
+	[SNS_SMGR_SENSOR_TYPE_GYRO] = "qcom-smgr-gyro",
+	[SNS_SMGR_SENSOR_TYPE_MAG] = "qcom-smgr-mag",
+	[SNS_SMGR_SENSOR_TYPE_PROX_LIGHT] = "qcom-smgr-prox-light",
+	[SNS_SMGR_SENSOR_TYPE_PRESSURE] = "qcom-smgr-pressure",
+	[SNS_SMGR_SENSOR_TYPE_HALL_EFFECT] = "qcom-smgr-hall-effect",
+	[SNS_SMGR_SENSOR_TYPE_STEP_DETECTOR] = "qcom-smgr-step-detector",
+	[SNS_SMGR_SENSOR_TYPE_STEP_COUNT] = "qcom-smgr-step-count",
+	[SNS_SMGR_SENSOR_TYPE_ACTIVITY] = "qcom-smgr-activity",
+	[SNS_SMGR_SENSOR_TYPE_INACTIVITY] = "qcom-smgr-inactivity",
+	[SNS_SMGR_SENSOR_TYPE_ELMYRA] = "qcom-smgr-elmyra",
+	[SNS_SMGR_SENSOR_TYPE_DOUBLE_TAP] = "qcom-smgr-double-tap",
+	[SNS_SMGR_SENSOR_TYPE_LONG_PRESS] = "qcom-smgr-long-press",
+	[SNS_SMGR_SENSOR_TYPE_SWIPE_UP] = "qcom-smgr-swipe-up"
+};
+
+static const struct iio_chan_spec *const qcom_smgr_sensor_type_iio_channels[] = {
+	[SNS_SMGR_SENSOR_TYPE_ACCEL] = qcom_smgr_accel_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_GYRO] = qcom_smgr_gyro_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_MAG] = qcom_smgr_mag_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_PROX_LIGHT] = qcom_smgr_prox_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_PRESSURE] = qcom_smgr_pressure_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_HALL_EFFECT] = qcom_smgr_hall_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_STEP_DETECTOR] = qcom_smgr_step_detect_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_STEP_COUNT] = qcom_smgr_step_count_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_ACTIVITY] = qcom_smgr_activity_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_INACTIVITY] = qcom_smgr_inactivity_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_ELMYRA] = qcom_smgr_elmyra_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_DOUBLE_TAP] = qcom_smgr_gesture_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_LONG_PRESS] = qcom_smgr_gesture_iio_channels,
+	[SNS_SMGR_SENSOR_TYPE_SWIPE_UP] = qcom_smgr_gesture_iio_channels
+};
+
+static const size_t qcom_smgr_sensor_type_num_channels[] = {
+	[SNS_SMGR_SENSOR_TYPE_ACCEL] = ARRAY_SIZE(qcom_smgr_accel_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_GYRO] = ARRAY_SIZE(qcom_smgr_gyro_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_MAG] = ARRAY_SIZE(qcom_smgr_mag_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_PROX_LIGHT] = ARRAY_SIZE(qcom_smgr_prox_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_PRESSURE] = ARRAY_SIZE(qcom_smgr_pressure_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_HALL_EFFECT] = ARRAY_SIZE(qcom_smgr_hall_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_STEP_DETECTOR] = ARRAY_SIZE(qcom_smgr_step_detect_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_STEP_COUNT] = ARRAY_SIZE(qcom_smgr_step_count_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_ACTIVITY] = ARRAY_SIZE(qcom_smgr_activity_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_INACTIVITY] = ARRAY_SIZE(qcom_smgr_inactivity_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_ELMYRA] = ARRAY_SIZE(qcom_smgr_elmyra_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_DOUBLE_TAP] = ARRAY_SIZE(qcom_smgr_gesture_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_LONG_PRESS] = ARRAY_SIZE(qcom_smgr_gesture_iio_channels),
+	[SNS_SMGR_SENSOR_TYPE_SWIPE_UP] = ARRAY_SIZE(qcom_smgr_gesture_iio_channels)
+};
+
+static int qcom_smgr_register_sensor(struct qcom_smgr *smgr,
+				     struct qcom_smgr_sensor *sensor)
+{
+	struct iio_dev *iio_dev;
+	struct qcom_smgr_iio_priv *priv;
+	int ret;
+
+	iio_dev = devm_iio_device_alloc(smgr->dev, sizeof(*priv));
+	if (!iio_dev)
+		return -ENOMEM;
+
+	priv = iio_priv(iio_dev);
+	priv->sensor = sensor;
+
+	priv->samp_freq_vals[0] = 1;
+	priv->samp_freq_vals[1] = 1;
+	priv->samp_freq_vals[2] = priv->sensor->data_types[0].max_sample_rate;
+
+	iio_dev->name = qcom_smgr_sensor_type_device_names[sensor->type];
+	iio_dev->info = &qcom_smgr_iio_info;
+	iio_dev->channels = qcom_smgr_sensor_type_iio_channels[sensor->type];
+	iio_dev->num_channels = qcom_smgr_sensor_type_num_channels[sensor->type];
+
+	sensor->iio_dev = iio_dev;
+
+	ret = devm_iio_kfifo_buffer_setup(smgr->dev, iio_dev,
+					  &qcom_smgr_buffer_ops);
+	if (ret) {
+		dev_err(smgr->dev, "Failed to setup buffer: %pe\n",
+			ERR_PTR(ret));
+		return ret;
+	}
+
+	ret = devm_iio_device_register(smgr->dev, iio_dev);
+	if (ret) {
+		dev_err(smgr->dev, "Failed to register IIO device: %pe\n",
+			ERR_PTR(ret));
+		return ret;
+	}
+
+	return 0;
+}
+
+static int qcom_smgr_probe(struct qrtr_device *qdev)
+{
+	struct qcom_smgr *smgr;
+	int i, j;
+	int ret;
+
+	smgr = devm_kzalloc(&qdev->dev, sizeof(*smgr), GFP_KERNEL);
+	if (!smgr)
+		return -ENOMEM;
+
+	smgr->dev = &qdev->dev;
+
+	smgr->sns_smgr_info.sq_family = AF_QIPCRTR;
+	smgr->sns_smgr_info.sq_node = qdev->node;
+	smgr->sns_smgr_info.sq_port = qdev->port;
+
+	dev_set_drvdata(&qdev->dev, smgr);
+
+	ret = qmi_handle_init(&smgr->sns_smgr_hdl,
+			      SNS_SMGR_SINGLE_SENSOR_INFO_RESP_MAX_LEN, NULL,
+			      qcom_smgr_msg_handlers);
+	if (ret < 0)
+		return dev_err_probe(smgr->dev, ret,
+			"Failed to initialize sensor manager handle\n");
+
+	ret = devm_add_action_or_reset(smgr->dev,
+				       (void(*)(void *))qmi_handle_release,
+				       &smgr->sns_smgr_hdl);
+	if (ret)
+		return ret;
+
+	ret = qcom_smgr_request_all_sensor_info(smgr, &smgr->sensors);
+	if (ret < 0)
+		return dev_err_probe(smgr->dev, ret,
+			"Failed to get available sensors\n");
+
+	smgr->sensor_count = ret;
+
+	/* Get primary and secondary sensors from each sensor ID */
+	for (i = 0; i < smgr->sensor_count; i++) {
+		ret = qcom_smgr_request_single_sensor_info(smgr,
+							   &smgr->sensors[i]);
+		if (ret < 0)
+			return dev_err_probe(smgr->dev, ret,
+				"Failed to get sensors from ID 0x%02x\n",
+				smgr->sensors[i].id);
+
+		for (j = 0; j < smgr->sensors[i].data_type_count; j++) {
+			/* Default to maximum sample rate */
+			smgr->sensors[i].data_types->cur_sample_rate =
+				smgr->sensors[i].data_types->max_sample_rate;
+
+			/*
+			 * Worth keeping the range and rate: this is how the
+			 * prox/ALS ordering was confirmed against the vendor's
+			 * own naming rather than assumed.
+			 */
+			dev_dbg(smgr->dev,
+				"0x%02x,%d: vendor='%s' name='%s' range=%u max_rate=%u\n",
+				smgr->sensors[i].id, j,
+				smgr->sensors[i].data_types[j].vendor,
+				smgr->sensors[i].data_types[j].name,
+				smgr->sensors[i].data_types[j].range,
+				smgr->sensors[i].data_types[j].max_sample_rate);
+		}
+
+		/* Skip if sensor type is not supported */
+		if (smgr->sensors[i].type == SNS_SMGR_SENSOR_TYPE_UNKNOWN ||
+		    !qcom_smgr_sensor_type_iio_channels[smgr->sensors[i].type])
+			continue;
+
+		ret = qcom_smgr_register_sensor(smgr, &smgr->sensors[i]);
+		if (ret)
+			return dev_err_probe(smgr->dev, ret,
+				"Failed to register sensor 0x%02x\n",
+				smgr->sensors[i].id);
+	}
+
+	return 0;
+}
+
+static const struct qrtr_device_id qcom_smgr_qrtr_match[] = {
+	{
+		.service = SNS_SMGR_QMI_SVC_ID,
+		/* Found on MSM8953 */
+		.instance = QRTR_INSTANCE_CONST(0, 1)
+	},
+	{
+		.service = SNS_SMGR_QMI_SVC_ID,
+		/* Found on MSM8974 and MSM8226 */
+		.instance = QRTR_INSTANCE_CONST(1, 0)
+	},
+	{
+		.service = SNS_SMGR_QMI_SVC_ID,
+		/* Found on MSM8996 and SDM660 */
+		.instance = QRTR_INSTANCE_CONST(1, 50)
+	},
+	{ },
+};
+MODULE_DEVICE_TABLE(qrtr, qcom_smgr_qrtr_match);
+
+static struct qrtr_driver qcom_smgr_driver = {
+	.probe = qcom_smgr_probe,
+	.id_table = qcom_smgr_qrtr_match,
+	.driver	= {
+		.name = "qcom_smgr",
+	},
+};
+module_qrtr_driver(qcom_smgr_driver);
+
+MODULE_AUTHOR("Yassine Oudjana <y.oudjana@protonmail.com>");
+MODULE_DESCRIPTION("Qualcomm Sensor Manager driver");
+MODULE_LICENSE("GPL");
