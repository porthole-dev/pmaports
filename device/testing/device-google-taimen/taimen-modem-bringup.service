[Unit]
Description=taimen WLAN/modem bring-up ordering (IPA before MSS, rmtfs settled, diag-router)
# rmtfs must be running and settled before the MSS boots or the modem comes up
# with no EFS. The script waits as well, but let systemd order it properly.
Wants=rmtfs.service tqftpserv.service
After=rmtfs.service tqftpserv.service
# NetworkManager can only see the modem once rmnet_ipa0 exists, which requires
# IPA to be loaded -- which this unit does.
Before=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/taimen-modem-bringup
# The bring-up deliberately sleeps (rmtfs settle, waiting for wlan0).
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
