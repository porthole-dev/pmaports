From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 27 Aug 2026 12:29:08 +0200
Subject: [PATCH] ASoC: qdsp6: q6voice: a control for the vocproc's downlink
 volume

A call on this stack has two gains in series: the vocproc's, which the ADSP
applies to what the modem decodes, and the amplifier's 16-step DAC trim
after it. Only the second exists here, so the loudest a call can be is the
amplifier at full scale -- reported from the device as a loudspeaker that is
audible but far quieter than Android's, with the amplifier already at 14/15.

The first is where Android's in-call volume actually goes: downstream drives
it from "Voice Rx Gain" (msm-pcm-voice-v2.c) into VSS_IVOLUME_CMD_SET_STEP
on the CVP. Add the same command, re-sent whenever a session comes up since
each call builds a new vocproc.

Measured on a live carrier call, and it does NOT work yet: the ADSP refuses
every step with ADSP_EFAILED (0x1).

    qcom-q6voice: 0x000112c2 rejected: 0x1

which is what the command's own documentation predicts -- the step selects
"the best match index in the registered volume calibration table", and
nothing here registers one. EFAILED rather than EBADPARAM or EUNSUPPORTED
says the opcode and the payload are right and the table is what is missing,
so this is the near half of a two-part change and the far half is calibration
data. The error is returned to whoever writes the control rather than
swallowed: a knob that reports success and moves nothing is worse than no
knob. A rejected volume never fails the call.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 sound/soc/qcom/qdsp6/q6voice-dai.c | 42 ++++++++++++++++
 sound/soc/qcom/qdsp6/q6voice.c     | 81 ++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/q6voice.h     |  2 +
 3 files changed, 125 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
index f8653334d04c..7c71ec400f11 100644
--- a/sound/soc/qcom/qdsp6/q6voice-dai.c
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -206,6 +206,46 @@ static int q6voice_dai_pcm_new(struct snd_soc_component *component,
 	return 0;
 }
 
+/*
+ * The call's downlink volume. It is the vocproc's, not the amplifier's: see
+ * the comment on vss_ivolume_cmd_set_step in q6voice.c. The range is the
+ * control's own -- the ADSP matches the step against a calibration table, so
+ * there is no dB scale to declare here either.
+ */
+#define Q6VOICE_RX_VOL_MAX	100
+
+static int q6voice_rx_gain_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	int step = q6voice_get_rx_volume();
+
+	ucontrol->value.integer.value[0] = step < 0 ? 0 : step;
+
+	return 0;
+}
+
+static int q6voice_rx_gain_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	long step = ucontrol->value.integer.value[0];
+	int ret;
+
+	if (step < 0 || step > Q6VOICE_RX_VOL_MAX)
+		return -EINVAL;
+
+	if (step == q6voice_get_rx_volume())
+		return 0;
+
+	ret = q6voice_set_rx_volume(step);
+
+	return ret < 0 ? ret : 1;
+}
+
+static const struct snd_kcontrol_new q6voice_fe_controls[] = {
+	SOC_SINGLE_EXT("Voice Rx Gain", SND_SOC_NOPM, 0, Q6VOICE_RX_VOL_MAX, 0,
+		       q6voice_rx_gain_get, q6voice_rx_gain_put),
+};
+
 static const struct snd_soc_component_driver q6voice_fe_component = {
 	.name			= DRV_NAME,
 	.open			= q6voice_dai_open,
@@ -213,6 +253,8 @@ static const struct snd_soc_component_driver q6voice_fe_component = {
 	.prepare		= q6voice_dai_prepare,
 	.pointer		= q6voice_dai_pointer,
 	.pcm_construct		= q6voice_dai_pcm_new,
+	.controls		= q6voice_fe_controls,
+	.num_controls		= ARRAY_SIZE(q6voice_fe_controls),
 	.legacy_dai_naming	= 1,
 };
 
diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index af95107259d3..a71bc9a2fa7a 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -38,6 +38,7 @@
 #define VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION	0x00011140
 #define VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V2	0x000112BF
 #define VSS_IVOCPROC_CMD_ENABLE				0x000100C6
+#define VSS_IVOLUME_CMD_SET_STEP			0x000112C2
 #define VSS_IVOCPROC_CMD_DISABLE			0x000110E1
 #define APRV2_IBASIC_CMD_DESTROY_SESSION		0x0001003C
 
@@ -52,6 +53,8 @@
 #define VSS_ICOMMON_CAL_NETWORK_ID_NONE			0x0001135E
 #define VSS_IVOCPROC_VOCPROC_MODE_EC_INT_MIXING		0x00010F7C
 #define VSS_IVOCPROC_PORT_ID_NONE			0xFFFF
+#define VSS_IVOLUME_DIRECTION_RX			1
+#define Q6VOICE_VOLUME_RAMP_MS				20
 
 #define ADSP_EALREADY					0x9
 
@@ -74,6 +77,26 @@ struct vss_ivocproc_cmd_create_full_control_session_v2 {
 	char name[VSS_SESSION_NAME_LEN];
 } __packed;
 
+/*
+ * The downlink volume, which is the ADSP's and not the amplifier's.
+ *
+ * The vocproc applies its own gain to what the modem decodes, and on this
+ * stack that is where a phone's in-call volume actually lives -- downstream
+ * drives it from the "Voice Rx Gain" control and Android's slider ends up
+ * here. The amplifier's DAC gain is a 16-step trim after it, so with the
+ * vocproc left at whatever it defaults to, the amplifier at full scale is as
+ * loud as the call gets.
+ *
+ * The step is not a dB value: the ADSP matches it against a registered volume
+ * calibration table, which nothing here registers. What it does without one is
+ * the open question this control exists to answer.
+ */
+struct vss_ivolume_cmd_set_step {
+	u16 direction;
+	u32 value;
+	u16 ramp_duration_ms;
+} __packed;
+
 struct q6voice_svc {
 	struct apr_device *adev;
 	u16 handle;
@@ -95,6 +118,7 @@ struct q6voice {
 	bool got_rsp;
 
 	bool running;
+	int rx_vol_step;		/* -1 until userspace asks for one */
 };
 
 static struct q6voice *g_voice;
@@ -194,6 +218,58 @@ static int q6voice_cmd(struct q6voice *v, struct q6voice_svc *svc, u32 opcode,
 	return v->rsp_port;
 }
 
+/*
+ * Caller holds v->lock. Never fatal to the call -- a call is better than no
+ * call -- but the error IS returned to whoever set the control, because on
+ * this ADSP the command is refused: see the comment on the struct.
+ */
+static int q6voice_apply_rx_volume(struct q6voice *v)
+{
+	struct vss_ivolume_cmd_set_step cmd = {
+		.direction = VSS_IVOLUME_DIRECTION_RX,
+		.value = v->rx_vol_step,
+		.ramp_duration_ms = Q6VOICE_VOLUME_RAMP_MS,
+	};
+	int ret;
+
+	if (v->rx_vol_step < 0 || !v->running)
+		return 0;
+
+	ret = q6voice_cmd(v, &v->cvp, VSS_IVOLUME_CMD_SET_STEP, v->cvp.handle,
+			  &cmd, sizeof(cmd), NULL);
+	if (ret < 0) {
+		dev_warn(&v->cvp.adev->dev,
+			 "rx volume step %d not taken: %d\n", v->rx_vol_step,
+			 ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+int q6voice_set_rx_volume(int step)
+{
+	struct q6voice *v = g_voice;
+	int ret;
+
+	if (!v)
+		return -ENODEV;
+
+	mutex_lock(&v->lock);
+	v->rx_vol_step = step;
+	ret = q6voice_apply_rx_volume(v);
+	mutex_unlock(&v->lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_rx_volume);
+
+int q6voice_get_rx_volume(void)
+{
+	return g_voice ? g_voice->rx_vol_step : -ENODEV;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_rx_volume);
+
 static void q6voice_name(char *dst)
 {
 	memset(dst, 0, VSS_SESSION_NAME_LEN);
@@ -292,6 +368,10 @@ int q6voice_start(u16 rx_port, u16 tx_port)
 		goto err_cvp_attached;
 
 	v->running = true;
+
+	/* The vocproc is new, so its volume is the ADSP's default again. */
+	q6voice_apply_rx_volume(v);
+
 	dev_info(&v->mvm.adev->dev,
 		 "voice session up: mvm=0x%04x%s cvs=0x%04x%s cvp=0x%04x, rx=0x%04x tx=0x%04x\n",
 		 v->mvm.handle, v->mvm.joined ? " (joined)" : " (created)",
@@ -400,6 +480,7 @@ static int q6voice_probe(struct apr_device *adev)
 
 		mutex_init(&v->lock);
 		init_waitqueue_head(&v->wait);
+		v->rx_vol_step = -1;
 		g_voice = v;
 	}
 	v = g_voice;
diff --git a/sound/soc/qcom/qdsp6/q6voice.h b/sound/soc/qcom/qdsp6/q6voice.h
index 0a51d08cae8c..8147e6cdafc0 100644
--- a/sound/soc/qcom/qdsp6/q6voice.h
+++ b/sound/soc/qcom/qdsp6/q6voice.h
@@ -4,5 +4,7 @@
 
 int q6voice_start(u16 rx_port, u16 tx_port);
 int q6voice_stop(void);
+int q6voice_set_rx_volume(int step);
+int q6voice_get_rx_volume(void);
 
 #endif /* __Q6VOICE_H__ */
