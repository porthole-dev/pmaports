From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Tue, 18 Aug 2026 12:43:49 +0200
Subject: [PATCH] media: qcom: camss: vfe-4-8: write the write-master address
 limits

VFE 4.7 and 4.8 placed a per-buffer address limit register beside each
of the ping and pong address registers, which is why the write-master
stride grew from 0x24 to 0x2c. The 4.7/4.8 ports picked up the new
stride but kept the 4.1 register list, so neither limit is ever written
and both read zero.

A write master whose address limit is zero cannot emit a beat: it
accepts pixel data, fills its unified-buffer slice, raises BUS_OVERFLOW
and never completes a burst. On msm8998 that presents as a stream that
starts, reports no error and writes zero bytes.

Write both limits as downstream does, addr + sizeimage clamped to a
32-byte boundary, and keep the sizeimage of the active output on the
VFE so the address setters -- which are only handed an address -- can
compute it.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/media/platform/qcom/camss/camss-vfe-4-8.c | 15 +++++++++++++++
 .../media/platform/qcom/camss/camss-vfe-gen1.c    |  1 +
 drivers/media/platform/qcom/camss/camss-vfe.h     |  6 ++++++
 3 files changed, 22 insertions(+)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
index 3ed18b6b7744..ecc775729412 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
@@ -107,6 +107,17 @@
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_CFG_WR_PATH_SHIFT	0
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR(n)	(0x0a4 + 0x2c * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR(n)	(0x0ac + 0x2c * (n))
+/*
+ * VFE 4.7/4.8 added a per-buffer address limit beside each address register --
+ * that is why the write-master stride grew from 0x24 (4.0/4.4/4.6) to 0x2c.
+ * Downstream writes both, the limit as (addr + buf_size) & 0xffffffe0. The
+ * 4.7/4.8 ports bumped the stride but kept the 4.1 register list, so these two
+ * are never written and read zero -- and a write master whose address limit is
+ * zero cannot emit a single beat: it takes data in, fills its unified-buffer
+ * slice, raises BUS_OVERFLOW and never completes a burst.
+ */
+#define VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR_LIMIT(n)	(0x0a8 + 0x2c * (n))
+#define VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR_LIMIT(n)	(0x0b0 + 0x2c * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_ADDR_CFG(n)		(0x0b4 + 0x2c * (n))
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_ADDR_CFG_FRM_BASED_SHIFT	1
 #define VFE_0_BUS_IMAGE_MASTER_n_WR_ADDR_CFG_FRM_DROP_PER_SHIFT	2
@@ -447,12 +458,16 @@ static void vfe_wm_set_ping_addr(struct vfe_device *vfe, u8 wm, u32 addr)
 {
 	writel_relaxed(addr,
 		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR(wm));
+	writel_relaxed(addr ? (addr + vfe->sizeimage) & 0xffffffe0 : 0,
+		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR_LIMIT(wm));
 }
 
 static void vfe_wm_set_pong_addr(struct vfe_device *vfe, u8 wm, u32 addr)
 {
 	writel_relaxed(addr,
 		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR(wm));
+	writel_relaxed(addr ? (addr + vfe->sizeimage) & 0xffffffe0 : 0,
+		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR_LIMIT(wm));
 }
 
 static int vfe_wm_get_ping_pong_status(struct vfe_device *vfe, u8 wm)
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
index d84a375e3318..540ead9b94eb 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
@@ -138,6 +138,7 @@ static void vfe_output_init_addrs(struct vfe_device *vfe,
 		else
 			pong_addr = ping_addr;
 
+		vfe->sizeimage = line->video_out.active_fmt.fmt.pix_mp.plane_fmt[i].sizeimage;
 		vfe->ops_gen1->wm_set_ping_addr(vfe, output->wm_idx[i], ping_addr);
 		vfe->ops_gen1->wm_set_pong_addr(vfe, output->wm_idx[i], pong_addr);
 		if (sync)
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.h b/drivers/media/platform/qcom/camss/camss-vfe.h
index ae9dad353a37..d95659b840dd 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.h
+++ b/drivers/media/platform/qcom/camss/camss-vfe.h
@@ -148,6 +148,12 @@ struct vfe_device {
 	u8 id;
 	void __iomem *base;
 	void __iomem *vbif_base;
+	/*
+	 * sizeimage of the active output. VFE 4.7/4.8 need it to compute the
+	 * write-master address limits, and ops_gen1->wm_set_{ping,pong}_addr()
+	 * are only handed an address.
+	 */
+	u32 sizeimage;
 	u32 irq;
 	char irq_name[30];
 	struct camss_clock *clock;
