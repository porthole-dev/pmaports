#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Hold the voice front-end's uplink open for as long as a call is up.

A call carries no samples across the application processor: the modem exchanges
speech with the ADSP and the ADSP drives the codec. But in this stack only an
open PCM powers an AFE port, and q6voice starts the session once both
directions have prepared -- so something has to open the front-end and leave it
open. Android's audio HAL is what does that there.

The DOWNLINK is not this script's job: 52-taimen-voice.conf makes the sound
server hold that one open with node.always-process, which is the mechanism for
a device node nothing is linked to. Taking it here instead would work right up
until the sound server probed the profile, found the PCM busy and dropped the
profile entirely. The uplink has no such owner -- the verb declares no capture
device, deliberately -- so it falls to this.

WHY THIS WAITS FOR THE MODEM, rather than opening when the verb is enabled:
q6voice creates the session as soon as both directions have prepared, and a
CREATE_PASSIVE issued when the modem has no session of its own does not join
one -- it allocates a fresh session, answers status 0 to every command that
follows, and carries no call audio at all. The sound server enables this verb
once at startup merely to probe the profile, so opening on the verb alone
guarantees exactly that useless session. The modem reporting an ACTIVE call is
the signal that there is something to join.

Started from the Voice Call verb's EnableSequence and stopped from HiFi's --
NOT from Voice Call's DisableSequence. ACP models each UCM device as its own
card profile, so pressing the loudspeaker button cycles the whole verb
(measured: VERB-DISABLE, VERB-ENABLE, DEV-SPEAKER), and releasing there would
tear the route down under a live session.

Usage: taimen-voicehold watch|stop|selftest
"""
import ctypes
import os
import re
import signal
import subprocess
import sys
import time

PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/run",
                       "taimen-voicehold.pid")

SND_PCM_STREAM_CAPTURE = 1
SND_PCM_FORMAT_S16_LE = 2
SND_PCM_ACCESS_RW_INTERLEAVED = 3

CALL_PATH = re.compile(r"/org/freedesktop/ModemManager1/Call/\d+")
POLL_SECONDS = 1


def voice_pcm(lines, name="VoiceMMode1"):
    """hw:<card>,<device> of the named front-end, or None."""
    for line in lines:
        if name in line:
            card, device = line.split(":", 1)[0].split("-")
            return "hw:%d,%d" % (int(card), int(device))

    return None


def tx_pump(device):
    """Start an ASM capture on MultiMedia2 and keep it running for the call.

    The uplink does not reach the modem without one. The voice front-end
    powers the AFE TX port and the vocproc is created with tx=0x4001, and the
    carrier still hears nothing; start a MultiMedia capture on SLIMBUS_0_TX
    and the carrier hears immediately. Established 2026-08-26 by A/B/A on live
    calls, with the voice session byte-identical either way -- same handles,
    same ports, same topology -- so the vocproc is not the variable. Killing
    this mid-call silences the uplink again within seconds.

    WHAT THIS IS: scaffolding, not the fix. What the ADM client actually
    provides is still open -- q6routing.c:135 says "no ASM session, no ADM
    copp" for a voice front-end, and that is the line to go at. See
    docs/FINDING-uplink-needs-a-tx-adm-client.md. Delete this the day the
    voice front-end establishes it itself.

    arecord, not the ctypes dance hold() does, because unlike the voice PCM
    this is an ordinary ASM stream: it has to be STARTED and drained, and a
    read on it succeeds. The reading is the point -- an opened-but-idle stream
    gives the ADM nothing to do.
    """
    return subprocess.Popen(["arecord", "-D", device, "-c", "1",
                             "-f", "S16_LE", "-r", "48000", "/dev/null"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)


def _mmcli(*args):
    try:
        return subprocess.run(("mmcli",) + args, capture_output=True,
                              text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def call_active(states):
    """True if any of these mmcli call-state readings says active."""
    return any(state == "active" for state in states)


def call_states():
    """The state of every call the modem currently has."""
    states = []
    for path in CALL_PATH.findall(_mmcli("-m", "any", "--voice-list-calls")):
        out = _mmcli("-m", "any", "--call", path.rsplit("/", 1)[1],
                     "--output-keyvalue")
        for line in out.splitlines():
            key, _, value = line.partition(":")
            if key.strip() == "call.properties.state":
                states.append(value.strip())

    return states


def hold(asound, device):
    """Open and prepare the uplink. Never transfers -- see the header."""
    handle = ctypes.c_void_p()

    if asound.snd_pcm_open(ctypes.byref(handle), device.encode(),
                           SND_PCM_STREAM_CAPTURE, 0) < 0:
        return None

    if asound.snd_pcm_set_params(handle, SND_PCM_FORMAT_S16_LE,
                                 SND_PCM_ACCESS_RW_INTERLEAVED,
                                 1, 48000, 1, 500000) < 0 or \
       asound.snd_pcm_prepare(handle) < 0:
        asound.snd_pcm_close(handle)
        return None

    return handle


def running():
    try:
        with open(PIDFILE) as f:
            os.kill(int(f.read()), 0)
    except (OSError, ValueError):
        return False

    return True


def watch():
    # ponytail: check-then-fork, not a lock. The verb enables once per profile
    # change, so the window is theoretical; take a lock if that ever changes.
    if running():
        return 0

    pcms = list(open("/proc/asound/pcm"))
    device = voice_pcm(pcms)
    if not device:
        print("no VoiceMMode1 front-end on this card", file=sys.stderr)
        return 1

    # Not fatal on its own: the downlink still works without it, and saying so
    # once beats a call that is quietly half dead.
    pump_device = voice_pcm(pcms, "MultiMedia2")
    if not pump_device:
        print("no MultiMedia2 front-end -- the uplink will not reach the modem",
              file=sys.stderr)

    # UCM runs this from inside the sound server's sequence and waits for it,
    # so the watcher cannot be this process.
    if os.fork():
        return 0
    os.setsid()

    with open(PIDFILE, "w") as f:
        f.write("%d\n" % os.getpid())
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))

    asound = ctypes.CDLL("libasound.so.2")
    handle = None
    pump = None
    while True:
        wanted = call_active(call_states())
        if wanted:
            if handle is None:
                handle = hold(asound, device)
                if handle is None:
                    print("%s capture would not open -- is the verb routed?"
                          % device, file=sys.stderr)
            # Restarted rather than merely started, because the pump is a
            # child process and can die on its own -- a stale SLIMBUS_0_TX
            # route, or the stream being taken. Losing it silently loses the
            # uplink for the rest of the call.
            if pump_device and (pump is None or pump.poll() is not None):
                pump = tx_pump(pump_device)
        else:
            if handle is not None:
                asound.snd_pcm_close(handle)
                handle = None
            if pump is not None:
                pump.terminate()
                pump.wait()
                pump = None
        time.sleep(POLL_SECONDS)


def stop():
    try:
        with open(PIDFILE) as f:
            os.kill(int(f.read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass

    try:
        os.unlink(PIDFILE)
    except OSError:
        pass

    return 0


def selftest():
    assert voice_pcm(["00-00: MultiMedia1 (*) :  : playback 1 : capture 1",
                      "00-02: VoiceMMode1 (*) :  : playback 1 : capture 1"]) \
        == "hw:0,2"
    assert voice_pcm(["01-13: VoiceMMode1 (*) :  : playback 1"]) == "hw:1,13"
    assert voice_pcm(["00-00: MultiMedia1 (*) :  : playback 1"]) is None
    # MultiMedia1 must not be mistaken for MultiMedia2: the pump has to land
    # on the capture front-end wired to SLIMBUS_0_TX, and a substring match
    # against the wrong one would look like it worked and carry no uplink.
    assert voice_pcm(["00-00: MultiMedia1 (*) :  : playback 1 : capture 1",
                      "00-01: MultiMedia2 (*) :  : capture 1",
                      "00-02: VoiceMMode1 (*) :  : playback 1 : capture 1"],
                     "MultiMedia2") == "hw:0,1"
    assert voice_pcm(["00-00: MultiMedia1 (*) :  : capture 1"],
                     "MultiMedia2") is None
    assert call_active(["active"])
    assert call_active(["ringing-in", "active"])
    assert not call_active(["dialing"])
    assert not call_active([])
    print("ok")

    return 0


if __name__ == "__main__":
    verbs = {"watch": watch, "stop": stop, "selftest": selftest}
    verb = verbs.get(sys.argv[1] if len(sys.argv) > 1 else "")
    if not verb:
        sys.exit(__doc__.strip().splitlines()[-1])
    sys.exit(verb())
