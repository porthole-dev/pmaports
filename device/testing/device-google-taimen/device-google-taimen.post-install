#!/bin/sh
# WLAN/modem bring-up ordering (see /usr/bin/taimen-modem-bringup). Both
# wrappers ship; only the one matching the running init is ever read, so
# enabling both is harmless and survives switching between OpenRC and systemd.
ln -sf /etc/init.d/taimen-modem-bringup \
	/etc/runlevels/default/taimen-modem-bringup
ln -sf /usr/lib/systemd/system/taimen-modem-bringup.service \
	/etc/systemd/system/multi-user.target.wants/taimen-modem-bringup.service

# Sensors: sns-reg serves the SNS_REG QMI service that SLPI's Sensor Manager
# reads its configuration from. Without it SMGR never publishes and there are
# no IIO devices at all. Both inits: same "harmless" reasoning as above --
# main/sns-reg now ships /etc/init.d/sns-reg alongside sns-reg.service.
mkdir -p /etc/systemd/system/basic.target.wants
ln -sf /usr/lib/systemd/system/sns-reg.service \
	/etc/systemd/system/basic.target.wants/sns-reg.service

mkdir -p /etc/runlevels/default
ln -sf /etc/init.d/sns-reg /etc/runlevels/default/sns-reg

# NFC. neard's own [Install] has no WantedBy (see the drop-in we ship), so it
# would never start; the drop-in adds one but the symlink still has to exist.
ln -sf /usr/lib/systemd/system/neard.service \
	/etc/systemd/system/multi-user.target.wants/neard.service

# PAM-free rescue channel. It has to already be RUNNING before the PID-1 freeze
# it exists to diagnose, so it is enabled by default; its [Install] is
# WantedBy=sysinit.target. See taimen-rescue.py's header for why nothing on the
# normal login path can be used when PID 1 is frozen, and for why it binds the
# USB-gadget address only and must never be widened.
mkdir -p /etc/systemd/system/sysinit.target.wants
ln -sf /usr/lib/systemd/system/taimen-rescue.service \
	/etc/systemd/system/sysinit.target.wants/taimen-rescue.service

# OpenRC counterpart: the sysinit runlevel is OpenRC's earliest, matching
# DefaultDependencies=no + WantedBy=sysinit.target above.
mkdir -p /etc/runlevels/sysinit
ln -sf /etc/init.d/taimen-rescue /etc/runlevels/sysinit/taimen-rescue

# Phosh session environment (XDG_CURRENT_DESKTOP, GSK_RENDERER,
# G_RESOURCE_OVERLAYS -- see phosh-desktop-env.conf, taimen-gsk.conf and
# taimen-gmobile-overlay.conf for what each is for). Those three ship as
# environment.d drop-ins, which only systemd --user reads. greetd's PAM
# stack (/etc/pam.d/greetd -> base-auth) includes pam_env.so, which reads
# /etc/environment and applies it to every session greetd starts --
# including the initial_session autologin this device actually uses (see
# phosh-desktop-env.conf's header) -- so appending here reaches the same
# session under EITHER init. linux-pam is a hard dependency (see the
# APKBUILD) specifically so /etc/environment already exists by this point.
# Marker-guarded so a pkgrel bump does not duplicate the block.
if ! grep -qF '# taimen-session-env' /etc/environment 2>/dev/null; then
	cat >>/etc/environment <<-'EOF'
	# taimen-session-env
	XDG_CURRENT_DESKTOP=Phosh:GNOME
	GSK_RENDERER=gl
	G_RESOURCE_OVERLAYS=/mobi/phosh/gmobile/devices/display-panels=/usr/share/taimen-gmobile-overlay/display-panels
	EOF
fi

# NOTE: taimen-wifi-country was removed in pkgrel 18. The WiFi regulatory fix is
# now purely the ath.regd_override module param in /etc/modprobe.d -- cfg80211
# adopts the country from the AP beacon country IE on its own.

# Compile /etc/dconf/db/local.d into the binary database dconf actually reads.
# Nothing else does this: dconf ships no apk trigger, so without it the file
# installed above is inert and auto-brightness stays off (see
# taimen-dconf-profile for why a gschema override cannot do this job).
command -v dconf >/dev/null && dconf update

exit 0
