From 4c7f78fcd9a15f1769b9d531b2cf8b7cd0b482b6 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sun, 9 Aug 2026 17:11:18 +0200
Subject: [PATCH 068/115] drm/msm/dsi: route TE to the tearcheck on 6G v2.2.0

On msm8998 the panel's TE signal never reached the DPU tearcheck: the
pingpong line counter free-ran (raw INT_COUNT_VAL samples spread
uniformly over 0..sync_cfg_height and never reset), so every
command-mode kickoff started at an arbitrary phase of the panel scan.
When the write crossed the scan-out the torn slice came back out of the
DSC decoder as a thin band of RGB speckle, which is the tear seen during
fast scrolling.

The TE enable is TRIG_CTRL bit 31, and on this DSI revision TRIG_CTRL is
not where the register description says it is. Downstream
(mdss_dsi_host.c) programs te_sel, the trigger selects and the stream
bit at 0x084, and its neighbours are shifted by the same four bytes:
ACK_ERR_STATUS 0x068 vs 0x064, TIMEOUT_STATUS 0x0c0 vs 0x0bc,
CLKOUT_TIMING_CTRL 0x0c4 vs 0x0c0. Command DMA worked regardless only
because the real register resets with the SW DMA trigger already
selected, while TE routing resets off.

Write the value to the offset the hardware actually decodes, gated on
6G v2.2.0 so no other DSI revision is touched, and mask out
BLOCK_DMA_WITHIN_FRAME: downstream never sets bit 12 at 0x084 and its
meaning there is unknown.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 068f2b69e10b..d783897d0245 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -35,6 +35,9 @@
 
 #define DSI_RESET_TOGGLE_DELAY_MS 20
 
+/* Real TRIG_CTRL offset on 6G v2.2.0; see dsi_ctrl_enable() */
+#define DSI_6G_V2_2_0_TRIG_CTRL	0x084
+
 static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc_config *dsc);
 
 static int dsi_get_version(const void __iomem *base, u32 *major, u32 *minor)
@@ -879,6 +882,26 @@ static void dsi_ctrl_enable(struct msm_dsi_host *msm_host,
 		data |= DSI_TRIG_CTRL_BLOCK_DMA_WITHIN_FRAME;
 	dsi_write(msm_host, REG_DSI_TRIG_CTRL, data);
 
+	/*
+	 * On 6G v2.2.0 (msm8998) TRIG_CTRL really lives at 0x084, four bytes
+	 * above where the register description places it. Downstream
+	 * (mdss_dsi_host.c) programs te_sel/trigger selects/stream there, and
+	 * the same +4 offset holds for its neighbours: ACK_ERR_STATUS at 0x068
+	 * (here 0x064), TIMEOUT_STATUS at 0x0c0 (here 0x0bc), CLKOUT_TIMING_CTRL
+	 * at 0x0c4 (here 0x0c0). Command DMA survives the misplaced write only
+	 * because the real register resets with the SW DMA trigger selected, but
+	 * TE routing resets off: the panel's TE pulse never reaches the DPU
+	 * tearcheck, whose line counter then free-runs, and every command-mode
+	 * kickoff lands at a random phase of the panel scan -- visible as tear
+	 * bands during fast scrolling. Write the value where the hardware reads
+	 * it from, without BLOCK_DMA_WITHIN_FRAME: downstream never sets that
+	 * bit at 0x084 and its meaning there is unknown.
+	 */
+	if (cfg_hnd->major == MSM_DSI_VER_MAJOR_6G &&
+	    cfg_hnd->minor == MSM_DSI_6G_VER_MINOR_V2_2_0)
+		dsi_write(msm_host, DSI_6G_V2_2_0_TRIG_CTRL,
+			  data & ~DSI_TRIG_CTRL_BLOCK_DMA_WITHIN_FRAME);
+
 	data = DSI_CLKOUT_TIMING_CTRL_T_CLK_POST(phy_shared_timings->clk_post) |
 		DSI_CLKOUT_TIMING_CTRL_T_CLK_PRE(phy_shared_timings->clk_pre);
 	dsi_write(msm_host, REG_DSI_CLKOUT_TIMING_CTRL, data);
