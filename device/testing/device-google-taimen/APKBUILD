# Reference: <https://postmarketos.org/devicepkg>
maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=device-google-taimen
pkgdesc="Google Pixel 2 XL"
pkgver=0.1
pkgrel=8
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	diag-router.service
	kernel-cmdline.mainline.conf
	modules-initfs.mainline
	rmtfs.service
	sudoers-nopasswd
"
subpackages="
	$pkgname-kernel-mainline:kernel_mainline
	$pkgname-nonfree-firmware:nonfree_firmware
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# See the file's header: local bring-up convenience, not for upstream.
	install -Dm440 "$srcdir"/sudoers-nopasswd \
		"$pkgdir"/etc/sudoers.d/50-pmos-dev-nopasswd
}

kernel_mainline() {
	pkgdesc="Close to mainline kernel"
	depends="linux-postmarketos-qcom-msm8998 soc-qcom-msm8998"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

nonfree_firmware() {
	pkgdesc="Firmware for modem, GPU zap shader, WiFi, Bluetooth, ADSP and SLPI"
	# rmtfs and qcom-diag are named explicitly rather than pulled in via
	# soc-qcom-msm8998-nonfree-firmware: both are required for the modem, and
	# neither ships a systemd unit, so the units below are ours to provide.
	depends="
		firmware-google-taimen
		pd-mapper
		qcom-diag
		rmtfs
		tqftpserv
	"

	install -Dm644 "$srcdir"/rmtfs.service \
		"$subpkgdir"/usr/lib/systemd/system/rmtfs.service
	install -Dm644 "$srcdir"/diag-router.service \
		"$subpkgdir"/usr/lib/systemd/system/diag-router.service

	# No systemctl at build time, so enable them by shipping the .wants links.
	local unit
	for unit in rmtfs diag-router; do
		install -d "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
		ln -s ../$unit.service \
			"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/$unit.service
	done
}

