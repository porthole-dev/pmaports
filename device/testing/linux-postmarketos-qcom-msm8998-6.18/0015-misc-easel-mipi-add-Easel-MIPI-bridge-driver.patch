+	{ 1900, 0x58, 0x59, 0xCD, 0x0B, 0xC0, 0x59, 0xCE, 0x0B, 0x98, 0x1B, true },
+	{ 2000, 0x58, 0x59, 0xCD, 0x0B, 0xC0, 0x59, 0xCE, 0x0B, 0x98, 0x1B, true },
+	{ 2100, 0x9A, 0x9B, 0xD0, 0x0E, 0xC0, 0x39, 0xD3, 0x0C, 0xA7, 0x1E, true },
+};
+
+static const struct easel_ovr *easel_find_ovr(u32 rate)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(easel_ovrs); i++)
+		if (rate <= easel_ovrs[i].rate)
+			return &easel_ovrs[i];
+	return &easel_ovrs[ARRAY_SIZE(easel_ovrs) - 1];
+}
+
+/*
+ * mnh_mipi_gen3_device() quantizes the requested rate to a fixed ladder
+ * BEFORE deriving anything (mnh-mipi.c:490). This is why a link the HAL
+ * asks for at 648 Mbps is actually driven at 685 -- and why our port, which
+ * skipped this step, drove 650 with a 600-bucket D-PHY range.
+ */
+static u32 easel_quantize_rate(u32 rate)
+{
+	static const u16 ladder[] = { 360, 550, 685, 720, 984,
+				      1104, 1200, 1368, 1850 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ladder); i++)
+		if (rate <= ladder[i])
+			return ladder[i];
+	return rate;
+}
+
+static int easel_freq_code(u32 rate)
+{
+	int i;
+
+	if (rate < easel_rates[0].rate)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(easel_rates); i++)
+		if (rate < easel_rates[i].rate)
+			return i - 1;
+
+	return ARRAY_SIZE(easel_rates) - 1;
+}
+
+static const struct { u32 khz; u8 cntrl; } easel_vco[] = {
+	{   40000, 0x3f }, {   52500, 0x39 }, {   80000, 0x2f },
+	{  105000, 0x29 }, {  160000, 0x1f }, {  210000, 0x19 },
+	{  320000, 0x0f }, {  420000, 0x09 }, {  630000, 0x03 },
+	{ 1100000, 0x01 }, { 1150000, 0x01 },
+};
+
+static u8 easel_vco_cntrl(u32 rate)
+{
+	u32 khz = rate * 1000 / 2;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(easel_vco); i++)
+		if (khz < easel_vco[i].khz)
+			return easel_vco[i ? i - 1 : 0].cntrl;
+
+	return easel_vco[ARRAY_SIZE(easel_vco) - 1].cntrl;
+}
+
+/* mnh_mipi_get_pll_coeffs() */
+static void easel_pll_coeffs(u32 rate, u16 *m, u8 *n)
+{
+	u32 khz = rate * 1000 / 2;
+	int div, est, iter_n, iter_m, calc;
+	int best_err = INT_MAX, best_n = 0, best_m = 0;
+
+	if (khz < 80000)
+		div = 8;
+	else if (khz < 160000)
+		div = 4;
+	else if (khz < 320000)
+		div = 2;
+	else
+		div = 1;
+
+	est = khz * 1000 * div / REF_FREQ_KHZ;
+
+	for (iter_n = 4; iter_n <= 12; iter_n++) {
+		iter_m = (est * iter_n + 999) / 1000;
+		calc = iter_m * 1000 / iter_n;
+		if (iter_m < 64)
+			continue;
+		if (iter_m > 625)
+			break;
+		if ((calc - est) < best_err) {
+			best_n = iter_n;
+			best_m = iter_m;
+			best_err = calc - est;
+		}
+	}
+
+	*m = best_m;
+	*n = best_n;
+}
+
+/* mnh_mipi_gen3_lprxpon_wa() -- b/63578602 */
+static void easel_lprxpon_wa(struct easel *easel, unsigned int dev, bool on)
+{
+	static const u16 regs[] = { 0x1ae, 0x1ad, 0x305, 0x505,
+				    0x705, 0x905, 0xb05 };
+	static const u8 vals[] = { 0x07, 0xe0, 0x06, 0x06, 0x06, 0x06, 0x06 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		rx_dphy(easel, dev, regs[i], on ? vals[i] : 0x00);
+}
+
+/* mnh_mipi_gen3_host() */
+static int easel_config_rx(struct easel *easel, unsigned int dev, u32 rate)
+{
+	u32 base = easel_rx_base(dev);
+	int code;
+
+	if (dev > 2)
+		return -EINVAL;
+
+	code = easel_freq_code(rate);
+	if (code < 0)
+		return code;
+
+	easel_rmw(easel, base + RX_N_LANES, 0x7, 0);
+
+	easel_w(easel, base + RX_INT_MSK_PHY_FATAL, 0xffffffff);
+	easel_w(easel, base + RX_INT_MSK_PKT_FATAL, 0xffffffff);
+	easel_w(easel, base + RX_INT_MSK_FRAME_FATAL, 0xffffffff);
+	easel_w(easel, base + RX_INT_MSK_PHY, 0xffffffff);
+	easel_w(easel, base + RX_INT_MSK_PKT, 0xffffffff);
+	easel_w(easel, base + RX_INT_MSK_LINE, 0xffffffff);
+
+	/* ungate the controller clock (CG bit clear = running) */
+	easel_rmw(easel, EASEL_MIPI_TOP + TOP_CSI_CLK_CTRL,
+		  BIT(2 + dev), 0);
+
+	easel_rmw(easel, base + RX_PHY_SHUTDOWNZ, 0x1, 0);
+	easel_rmw(easel, base + RX_DPHY_RSTZ, 0x1, 0);
+	easel_w(easel, base + RX_PHY_TEST_CTRL0, 0x1);
+	udelay(1);
+	easel_w(easel, base + RX_PHY_TEST_CTRL0, 0x0);
+
+	easel_w(easel, EASEL_MIPI_TOP + TOP_RX0_DPHY_CONFIG + dev * 0x14,
+		0x8400 | easel_rates[code].code);
+
+	rx_dphy(easel, dev, 0xe2, easel_rates[code].osc & 0xff);
+	rx_dphy(easel, dev, 0xe3, easel_rates[code].osc >> 8);
+	rx_dphy(easel, dev, 0xe4, 0x01);
+	rx_dphy(easel, dev, 0x08, 0x20);
+	udelay(1);
+
+	easel_rmw(easel, base + RX_N_LANES, 0x7, 0x3);	/* 4 lanes */
+	udelay(1);
+
+	easel_lprxpon_wa(easel, dev, true);
+
+	easel_rmw(easel, base + RX_PHY_SHUTDOWNZ, 0x1, 0x1);
+	udelay(20);
+	easel_rmw(easel, base + RX_DPHY_RSTZ, 0x1, 0x1);
+	easel_rmw(easel, base + RX_CSI2_RESETN, 0x1, 0x1);
+	udelay(30);
+
+	easel_lprxpon_wa(easel, dev, false);
+
+	return 0;
+}
+
+/* mnh_mipi_gen3_device() -- bypass path only, no VPG, no timing overrides */
+static int easel_config_tx(struct easel *easel, unsigned int dev, u32 rate)
+{
+	u32 base = easel_tx_base(dev);
+	u32 pll = EASEL_MIPI_TOP +
+		  (dev ? TOP_TX1_DPHY_PLL_CNTRL : TOP_TX0_DPHY_PLL_CNTRL);
+	u32 cfg = EASEL_MIPI_TOP +
+		  (dev ? TOP_TX1_DPHY_CONFIG : TOP_TX0_DPHY_CONFIG);
+	const struct easel_ovr *ovr;
+	u8 vco, pll_n;
+	u16 pll_m;
+	u32 status = 0;
+	int code, i;
+
+	if (dev > 1)
+		return -EINVAL;
+
+	rate = easel_quantize_rate(rate);
+	ovr = easel_find_ovr(rate);
+
+	code = easel_freq_code(rate);
+	if (code < 0)
+		return code;
+
+	easel_rmw(easel, EASEL_MIPI_TOP + TOP_CSI_CLK_CTRL, BIT(dev), 0);
+
+	/*
+	 * Drop the continuous clock first. These registers survive a module
+	 * reload, and with it still set the clock lane never returns to LP,
+	 * so the INIT wait below can never see TXSTOPSTATE_CLK.
+	 */
+	easel_rmw(easel, base + TX_LPCLK_CTRL, 0x1, 0);
+
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_SHUTDOWNZ, TX_PHY_SHUTDOWNZ);
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_RSTZ_BIT, TX_PHY_RSTZ_BIT);
+	udelay(1000);
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_RSTZ_BIT, 0);
+	easel_w(easel, base + TX_CSI2_RESETN, 0x0);
+	udelay(1);
+	easel_w(easel, base + TX_CSI2_RESETN, 0x1);
+	easel_w(easel, base + TX_INT_MASK_N_VPG, 0xffffffff);
+	easel_w(easel, base + TX_INT_MASK_N_IDI, 0xffffffff);
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_SHUTDOWNZ, 0);
+
+	/* PLL shadow control + clk sel */
+	easel_rmw(easel, pll, 0x1, 0x1);
+	easel_rmw(easel, pll, 0xc0, 0x1 << 6);
+
+	easel_rmw(easel, base + TX_CSI2_RESETN, 0x1, 0x1);
+	easel_w(easel, base + TX_PHY_RSTZ, 0x0);
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_ENABLECLK, TX_PHY_ENABLECLK);
+	easel_w(easel, base + TX_PHY0_TST_CTRL0, 0x1);
+	udelay(1);
+	easel_w(easel, base + TX_PHY0_TST_CTRL0, 0x0);
+
+	easel_w(easel, cfg, 0x8400 | easel_rates[code].code);
+
+	vco = easel_vco_cntrl(rate);
+	easel_pll_coeffs(rate, &pll_m, &pll_n);
+	pll_m -= 2;
+	pll_n -= 1;
+
+	tx_dphy(easel, dev, 0x17b, ((vco & 0x3f) << 1) | 0x81);
+	tx_dphy(easel, dev, 0x178, 0x80 | ((pll_n & 0xf) << 3));
+	tx_dphy(easel, dev, 0x179, pll_m & 0xff);
+	tx_dphy(easel, dev, 0x17a, (pll_m >> 8) & 0x3);
+
+	tx_dphy(easel, dev, 0x15e, 0x10);
+	tx_dphy(easel, dev, 0x162, 0x04);
+	tx_dphy(easel, dev, 0x16e, 0x0c);
+	tx_dphy(easel, dev, 0x173, 0x02);
+	tx_dphy(easel, dev, 0x174, 0x00);
+	tx_dphy(easel, dev, 0x175, 0x60);
+	tx_dphy(easel, dev, 0x176, 0x03);
+	udelay(1);
+
+	/* slew rate calibration (mnh-mipi.c:583), always applied */
+	if (rate > 1500) {
+		tx_dphy(easel, dev, 0x26b, 0x44);
+		tx_dphy(easel, dev, 0x272, 0x00);
+	} else if (rate > 1000) {
+		tx_dphy(easel, dev, 0x270, 0xd0);
+		tx_dphy(easel, dev, 0x271, 0x07);
+		tx_dphy(easel, dev, 0x272, 0x10);
+	} else if (rate > 500) {
+		tx_dphy(easel, dev, 0x270, 0xe2);
+		tx_dphy(easel, dev, 0x271, 0x04);
+		tx_dphy(easel, dev, 0x272, 0x11);
+	} else {
+		tx_dphy(easel, dev, 0x270, 0x84);
+		tx_dphy(easel, dev, 0x271, 0x03);
+		tx_dphy(easel, dev, 0x272, 0x11);
+	}
+
+	/* per-rate timing overrides (mnh-mipi.c:641); 0x5E/0x64 stay unwritten */
+	if (ovr->use_ovrd) {
+		tx_dphy(easel, dev, 0x5a, ovr->r5a);
+		tx_dphy(easel, dev, 0x5b, ovr->r5b);
+		tx_dphy(easel, dev, 0x5c, ovr->r5c);
+		tx_dphy(easel, dev, 0x5d, ovr->r5d);
+		tx_dphy(easel, dev, 0x5f, ovr->r5f);
+		tx_dphy(easel, dev, 0x61, ovr->r61);
+		tx_dphy(easel, dev, 0x62, ovr->r62);
+		tx_dphy(easel, dev, 0x63, ovr->r63);
+		tx_dphy(easel, dev, 0x65, ovr->r65);
+	}
+
+	tx_dphy(easel, dev, 0x304, BIT(2) | BIT(3));
+	tx_dphy(easel, dev, 0x504, BIT(2) | BIT(3));
+	tx_dphy(easel, dev, 0x704, BIT(2) | BIT(3));
+	tx_dphy(easel, dev, 0x904, BIT(2) | BIT(3));
+	tx_dphy(easel, dev, 0xb04, BIT(2) | BIT(3));
+
+	easel_rmw(easel, base + TX_PHY_IF_CFG, 0x7, 3);		/* 4 lanes */
+	easel_rmw(easel, base + TX_PHY_IF_CFG, 0xff00, ovr->wait_time << 8);
+
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_ENABLECLK, TX_PHY_ENABLECLK);
+	udelay(1);
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_SHUTDOWNZ, TX_PHY_SHUTDOWNZ);
+	udelay(1);
+	easel_rmw(easel, base + TX_PHY_RSTZ, TX_PHY_RSTZ_BIT, TX_PHY_RSTZ_BIT);
+	udelay(10);
+
+	/*
+	 * D-PHY INIT: every lane must reach the LP stop state before the
+	 * continuous clock is enabled, then a full INIT period must elapse.
+	 * Skipping either leaves the transmitter driving a clock that no
+	 * receiver can lock to -- 0x1550 is TXSTOPSTATE for the clock lane
+	 * and all four data lanes (mnh-mipi.c:659-677).
+	 */
+	for (i = 0; i < 40; i++) {
+		status = easel_r(easel, base + TX_PHY_STATUS);
+		if ((status & 0x1550) == 0x1550)
+			break;
+		udelay(10);
+	}
+	if ((status & 0x1550) != 0x1550)
+		dev_warn(&easel->pdev->dev,
+			 "TX%u lanes never reached LP stop state, status 0x%08x\n",
+			 dev, status);
+
+	/* INIT period in continuous-clock mode is software timed. */
+	usleep_range(1000, 1200);
+
+	easel_rmw(easel, base + TX_LPCLK_CTRL, 0x1, 0x1);
+
+	dev_info(&easel->pdev->dev,
+		 "TX%u PHY_STATUS 0x%08x -> 0x%08x, DPHY_CFG 0x%08x, pll m=%u n=%u vco=0x%02x\n",
+		 dev, status, easel_r(easel, base + TX_PHY_STATUS),
+		 easel_r(easel, cfg), pll_m + 2, pll_n + 1, vco);
+
+	return 0;
+}
+
+/* mnh_mipi_config_mux_sel(), MIPI_MODE_BYPASS only */
+static void easel_config_mux(struct easel *easel, unsigned int rxdev,
+			     unsigned int txdev, u32 vc_en_mask)
+{
+	static const u32 rx_mode_off[] = { TOP_RX0_MODE, TOP_RX1_MODE,
+					   TOP_RX2_MODE };
+	u32 rx_mode, tx_mode;
+	int i;
+
+	/*
+	 * Clear every OTHER receiver's claim on THIS transmitter first. These
+	 * registers survive a module reload, so a stale RX0->TX0 from an
+	 * earlier run silently contends with the pairing being set up now --
+	 * which invalidated the first RX1->TX0 test (HANDOFF §44c).
+	 *
+	 * Only the claim on this TX: clearing the other RX's whole bypass
+	 * config (BYP_TX0|BYP_TX1|IPU) wiped the front link every time the
+	 * rear was configured after it -- the bug that broke the front the
+	 * moment bypass=0x3 became the default (2026-08-04 evening).
+	 */
+	for (i = 0; i < ARRAY_SIZE(rx_mode_off); i++) {
+		if (i == rxdev)
+			continue;
+		easel_rmw(easel, EASEL_MIPI_TOP + rx_mode_off[i],
+			  RX_MODE_BYP_TX0_EN << txdev, 0);
+	}
+
+	rx_mode = easel_r(easel, EASEL_MIPI_TOP + rx_mode_off[rxdev]);
+	rx_mode &= ~((0xf << RX_MODE_VC_EN_SHIFT) | RX_MODE_BYP_TX0_EN |
+		     (RX_MODE_BYP_TX0_EN << 1) | RX_MODE_IPU_EN);
+	rx_mode |= (vc_en_mask & 0xf) << RX_MODE_VC_EN_SHIFT;
+	rx_mode |= RX_MODE_BYP_TX0_EN << txdev;
+	/*
+	 * The vendor uses MIPI_MODE_BYPASS_W_IPU, not plain bypass: stock's
+	 * live RX0_MODE reads 0x1b (IPU_EN | BYP_TX0_EN) while streaming.
+	 * ponytail: keep it unconditional -- we have no IPU user, and the
+	 * only known-good configuration sets it.
+	 */
+	rx_mode |= RX_MODE_IPU_EN;
+
+	tx_mode = (1 + rxdev) << TX_MODE_BYP_SEL_SHIFT;
+
+	easel_w(easel, EASEL_MIPI_TOP + rx_mode_off[rxdev], rx_mode);
+	easel_w(easel, EASEL_MIPI_TOP + (txdev ? TOP_TX1_MODE : TOP_TX0_MODE),
+		tx_mode);
+
+	/*
+	 * Read back what latched. mnh-mipi.c warns the RX mode register only
+	 * takes while the RX clock is present, and this driver usually runs
+	 * with the sensor off -- these values are the tell (HANDOFF §5.1).
+	 */
+	dev_info(&easel->pdev->dev,
+		 "mux readback: RX%u_MODE 0x%02x (wrote 0x%02x), TX%u_MODE 0x%02x (wrote 0x%02x)\n",
+		 rxdev, easel_r(easel, EASEL_MIPI_TOP + rx_mode_off[rxdev]),
+		 rx_mode, txdev,
+		 easel_r(easel, EASEL_MIPI_TOP +
+			 (txdev ? TOP_TX1_MODE : TOP_TX0_MODE)), tx_mode);
+}
+
+/*
+ * Put one camera link into bypass: sensor -> RXn -> TXn -> SoC CSIPHYn.
+ * @rate is Mbps per lane, i.e. twice the sensor's V4L2 link frequency.
+ */
+int easel_mipi_bypass(struct easel *easel, unsigned int rxdev,
+		      unsigned int txdev, u32 rate)
+{
+	u32 clk;
+	int ret;
+
+	dev_info(&easel->pdev->dev,
+		 "bypass: RX%u -> TX%u at %u Mbps/lane\n", rxdev, txdev, rate);
+
+	/*
+	 * The D-PHY test interface needs its own clock. Measured on taimen:
+	 * SCU CCU_CLK_CTL reads 0x00ff5c63 out of reset -- MIPI_REFCLKEN set,
+	 * **MIPI_TESTCLKEN clear**. With it clear every tx_dphy()/rx_dphy()
+	 * write is silently dropped, including the HS lane-driver enables at
+	 * 0x304..0xB04, so the controller runs its state machine (lanes leave
+	 * stop state, PLL locks) while the pads drive nothing at all. No
+	 * downstream kernel code writes this register -- Easel's boot ROM
+	 * does, and we never boot it (HANDOFF §45).
+	 */
+	clk = easel_r(easel, EASEL_SCU_CCU_CLK_CTL);
+	easel_w(easel, EASEL_SCU_CCU_CLK_CTL,
+		clk | SCU_MIPI_TESTCLKEN | SCU_MIPI_REFCLKEN);
+	dev_info(&easel->pdev->dev,
+		 "SCU CCU_CLK_CTL 0x%08x -> 0x%08x, CSI_CLK_CTRL 0x%08x\n",
+		 clk, easel_r(easel, EASEL_SCU_CCU_CLK_CTL),
+		 easel_r(easel, EASEL_MIPI_TOP + TOP_CSI_CLK_CTRL));
+
+	ret = easel_config_rx(easel, rxdev, rate);
+	if (ret) {
+		dev_err(&easel->pdev->dev, "RX%u config failed: %d\n",
+			rxdev, ret);
+		return ret;
+	}
+
+	ret = easel_config_tx(easel, txdev, rate);
+	if (ret) {
+		dev_err(&easel->pdev->dev, "TX%u config failed: %d\n",
+			txdev, ret);
+		return ret;
+	}
+
+	/*
+	 * vc_en = 0, matching a live stock session (TKMIPI vc_en=0, and the
+	 * working RX0_MODE reads 0x1b with VC_EN clear). We used to enable all
+	 * four virtual channels, a state no working session has ever had.
+	 */
+	easel_config_mux(easel, rxdev, txdev, 0x0);
+
+	/*
+	 * Localize the silence: PHY_RX (0x48) shows clock-lane HS activity,
+	 * PHY_STOPSTATE (0x4c) the lane LP states. With the sensor streaming,
+	 * a live RX shows rxclkactivehs=1; all-idle means the sensor's signal
+	 * never reaches Easel and the TX side is not the problem.
+	 */
+	dev_info(&easel->pdev->dev,
+		 "RX%u: PHY_RX 0x%08x STOPSTATE 0x%08x INT_MAIN 0x%08x, TX%u PHY_STATUS 0x%08x\n",
+		 rxdev, easel_r(easel, easel_rx_base(rxdev) + 0x48),
+		 easel_r(easel, easel_rx_base(rxdev) + 0x4c),
+		 easel_r(easel, easel_rx_base(rxdev) + 0x0c),
+		 txdev, easel_r(easel, easel_tx_base(txdev) + TX_PHY_STATUS));
+
+	dev_info(&easel->pdev->dev, "bypass RX%u->TX%u configured\n",
+		 rxdev, txdev);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(easel_mipi_bypass);
+
+static struct easel *easel_dev;
+
+/*
+ * Cycle the front TX's continuous clock: LP-11 for a few ms, then HS again.
+ * The CSIPHY clock-lane detector may only arm on an LP->HS transition seen
+ * AFTER the CSIPHY is configured; our TX clock has been continuously HS
+ * since module load, so a csiphy configured mid-session never sees one.
+ * Stock never hits this because the HAL brings the TX up 0.1 s before the
+ * CSIPHY, then data follows immediately.
+ */
+void easel_mipi_kick(unsigned int txdev)
+{
+	struct easel *easel = easel_dev;
+	u32 base;
+
+	if (!easel || txdev > 1)
+		return;
+
+	base = easel_tx_base(txdev);
+	easel_rmw(easel, base + TX_LPCLK_CTRL, 0x1, 0);
+	msleep(5);
+	easel_rmw(easel, base + TX_LPCLK_CTRL, 0x1, 0x1);
+	dev_info(&easel->pdev->dev, "TX%u clock lane kicked (LP pulse), PHY_STATUS 0x%08x\n",
+		 txdev, easel_r(easel, base + TX_PHY_STATUS));
+}
+EXPORT_SYMBOL_GPL(easel_mipi_kick);
+
+static int easel_probe(struct pci_dev *pdev, const struct pci_device_id *id)
+{
+	struct easel *easel;
+	u32 ctrl2, off;
+	int i, ret;
+
+	easel = devm_kzalloc(&pdev->dev, sizeof(*easel), GFP_KERNEL);
+	if (!easel)
+		return -ENOMEM;
+
+	easel->pdev = pdev;
+	easel->window = ~0;
+
+	/*
+	 * The PCI core sizes this port's bridge windows to fit Easel but never
+	 * places the endpoint's own BARs -- they stay at address 0 with
+	 * COMMAND=0x0000, so pci_enable_device() fails with "BAR 0 not
+	 * claimed" and any MMIO to them hangs the fabric. Assign them here.
+	 */
+	for (i = 0; i < PCI_STD_NUM_BARS; i++) {
+		struct resource *r = &pdev->resource[i];
+
+		if (!r->flags || r->parent || resource_size(r) == 0)
+			continue;
+		ret = pci_assign_resource(pdev, i);
+		if (ret)
+			dev_warn(&pdev->dev, "BAR %d assign failed: %d\n",
+				 i, ret);
+		else
+			dev_info(&pdev->dev, "BAR %d assigned %pr\n", i, r);
+	}
+
+	ret = pcim_enable_device(pdev);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "cannot enable device\n");
+
+	pci_set_master(pdev);
+
+	ret = pcim_iomap_regions(pdev, BIT(EASEL_BAR_CONFIG), "easel-cfg");
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "cannot map BAR2\n");
+
+	easel->cfg = pcim_iomap_table(pdev)[EASEL_BAR_CONFIG];
+	pci_set_drvdata(pdev, easel);
+	easel_dev = easel;
+
+	dev_info(&pdev->dev, "Easel BAR2 mapped at %pa, len 0x%llx\n",
+		 &pdev->resource[EASEL_BAR_CONFIG].start,
+		 (u64)pci_resource_len(pdev, EASEL_BAR_CONFIG));
+
+	off = easel_set_window(easel, EASEL_PERIPH_BASE, EASEL_MIPI_TOP_BASE);
+	pci_read_config_dword(pdev, IATU_REGION_CTRL_2, &ctrl2);
+	dev_info(&pdev->dev,
+		 "iATU: BAR2 -> 0x%08x (ctrl2 0x%08x), MIPI_TOP at +0x%x\n",
+		 EASEL_PERIPH_BASE, ctrl2, off);
+
+	/*
+	 * ONE MUX reset per probe, before any link config. Downstream never
+	 * resets from the kernel ("Upper layers should issue a MUX reset
+	 * prior to configuring the MUX", mnh-mipi.c:699 -- firmware/HAL did
+	 * it). Doing it per-link reset the already-configured front TX every
+	 * time the rear was configured after it: TX1 PLL read back unlocked
+	 * (PHY_STATUS 0x03) on every bypass=0x3 boot until this moved here.
+	 * MIPI_SW_RST is CSI_CLK_CTRL bit 5.
+	 */
+	if (bypass) {
+		easel_rmw(easel, EASEL_MIPI_TOP + TOP_CSI_CLK_CTRL,
+			  BIT(5), BIT(5));
+		udelay(10);
+		easel_rmw(easel, EASEL_MIPI_TOP + TOP_CSI_CLK_CTRL, BIT(5), 0);
+		udelay(10);
+	}
+
+	if (bypass & 0x1)
+		easel_mipi_bypass(easel, front_rx, front_tx, front_rate);
+	if (bypass & 0x2)
+		easel_mipi_bypass(easel, 0, 0, rear_rate);
+
+	return 0;
+}
+
+static void easel_remove(struct pci_dev *pdev)
+{
+	easel_dev = NULL;
+	pci_clear_master(pdev);
+}
+
+static const struct pci_device_id easel_ids[] = {
+	{ PCI_DEVICE(EASEL_VENDOR_INTEL, EASEL_DEVICE_MNH) },
+	{ }
+};
+MODULE_DEVICE_TABLE(pci, easel_ids);
+
+static struct pci_driver easel_driver = {
+	.name = "easel-mipi",
+	.id_table = easel_ids,
+	.probe = easel_probe,
+	.remove = easel_remove,
+};
+module_pci_driver(easel_driver);
+
+MODULE_DESCRIPTION("Easel (Pixel Visual Core) MIPI bridge");
+MODULE_LICENSE("GPL");
