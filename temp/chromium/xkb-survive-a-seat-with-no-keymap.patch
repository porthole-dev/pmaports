     uint32_t keysym,
     const std::optional<std::vector<std::string_view>>& modifiers) const {
+  // No keymap, no keycodes to map back to. See UpdateModifiers() above.
+  if (!xkb_state_) {
+    return DomCode::NONE;
+  }
