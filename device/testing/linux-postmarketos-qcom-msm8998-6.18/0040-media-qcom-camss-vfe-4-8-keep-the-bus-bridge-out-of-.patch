From 8815e406d063a2ebc8e594f9bbc7e7ce9c5dc25d Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 8 Aug 2026 18:16:48 +0200
Subject: [PATCH 040/115] media: qcom: camss: vfe-4-8: keep the bus bridge out
 of the global reset

This file was derived from the VFE 4.7 one and kept its global reset mask.
The vendor driver picks the mask by hardware version and uses 0x3f7 for
4.8 where 4.7 uses 0x3ff; the single bit of difference is BUS_BDG.

Resetting the AXI bus bridge while its clocks and the VBIF are up brings
it back refusing grants, which leaves the write masters able to latch
their configuration and take pixel data but unable to issue a beat or to
acknowledge a halt - so vfe_gen1_halt() times out as well.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/media/platform/qcom/camss/camss-vfe-4-8.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
index 3c98f686143a..3ed18b6b7744 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
@@ -262,6 +262,14 @@ static inline void vfe_reg_set(struct vfe_device *vfe, u32 reg, u32 set_bits)
 	writel_relaxed(bits | set_bits, vfe->base + reg);
 }
 
+/*
+ * VFE 4.8 does not reset the AXI bus bridge along with the rest of the core:
+ * the vendor driver picks 0x3f7 here where 4.7 uses 0x3ff, the one bit of
+ * difference being BUS_BDG. A bridge reset issued while its clocks and the
+ * VBIF are up comes back refusing grants, so the write masters latch their
+ * configuration and take pixel data but never issue a beat and never
+ * acknowledge a halt.
+ */
 static void vfe_global_reset(struct vfe_device *vfe)
 {
 	u32 reset_bits = VFE_0_GLOBAL_RESET_CMD_IDLE_CGC	|
@@ -270,7 +278,6 @@ static void vfe_global_reset(struct vfe_device *vfe)
 			 VFE_0_GLOBAL_RESET_CMD_BUS_MISR	|
 			 VFE_0_GLOBAL_RESET_CMD_PM		|
 			 VFE_0_GLOBAL_RESET_CMD_REGISTER	|
-			 VFE_0_GLOBAL_RESET_CMD_BUS_BDG		|
 			 VFE_0_GLOBAL_RESET_CMD_BUS		|
 			 VFE_0_GLOBAL_RESET_CMD_CAMIF		|
 			 VFE_0_GLOBAL_RESET_CMD_CORE;
