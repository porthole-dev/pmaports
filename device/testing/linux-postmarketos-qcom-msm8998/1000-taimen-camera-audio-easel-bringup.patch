+static int lg_sw43402_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct lg_sw43402 *ctx = mipi_dsi_get_drvdata(dsi);
+	u8 brightness = backlight_get_brightness(bl);
+	unsigned long saved_flags = dsi->mode_flags;
+	int passes = bl_double ? 2 : 1;
+	ssize_t ret = 0;
+	int i;
+
+	/*
+	 * Reachable with the DDIC asleep: drm_panel_disable() calls
+	 * backlight_disable() before the panel is unprepared, and userspace can
+	 * write the sysfs node whenever it likes.
+	 */
