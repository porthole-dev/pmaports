#!/bin/sh
# Service enablement lives in taimen.preset (systemd) and the -openrc
# subpackage's own post-install (OpenRC) -- see those for
# taimen-modem-bringup, sns-reg, neard and taimen-rescue. Nothing here needs
# a per-unit mechanism, so only the two things that have none are left:

# Phosh session environment (XDG_CURRENT_DESKTOP, GSK_RENDERER,
# G_RESOURCE_OVERLAYS -- see phosh-desktop-env.conf, taimen-gsk.conf and
# taimen-gmobile-overlay.conf for what each is for). Those three ship as
# environment.d drop-ins, which only systemd --user reads. greetd's PAM
# stack (/etc/pam.d/greetd -> base-auth) includes pam_env.so, which reads
# /etc/environment and applies it to every session greetd starts --
# including the initial_session autologin this device actually uses (see
# phosh-desktop-env.conf's header) -- so appending here reaches the same
# session under EITHER init. linux-pam is a hard dependency (see the
# APKBUILD) specifically so /etc/environment already exists by this point.
# Marker-guarded so a pkgrel bump does not duplicate the block.
if ! grep -qF '# taimen-session-env' /etc/environment 2>/dev/null; then
	cat >>/etc/environment <<-'EOF'
	# taimen-session-env
	XDG_CURRENT_DESKTOP=Phosh:GNOME
	GSK_RENDERER=gl
	G_RESOURCE_OVERLAYS=/mobi/phosh/gmobile/devices/display-panels=/usr/share/taimen-gmobile-overlay/display-panels
	EOF
fi

# NOTE: taimen-wifi-country was removed in pkgrel 18. The WiFi regulatory fix is
# now purely the ath.regd_override module param in /usr/lib/modprobe.d -- cfg80211
# adopts the country from the AP beacon country IE on its own.

# Compile /etc/dconf/db/local.d into the binary database dconf actually reads.
# Nothing else does this: dconf ships no apk trigger, so without it the file
# installed above is inert and auto-brightness stays off (see
# taimen-dconf-profile for why a gschema override cannot do this job).
command -v dconf >/dev/null && dconf update

# powerhintd was hand-installed into /usr/local/sbin and /etc/systemd/system
# before it was packaged (pkgrel 39). A unit in /etc SHADOWS the one this
# package ships in /usr/lib, so leaving it there means the upgrade appears to
# install a daemon that never runs -- with `systemctl status` happily reporting
# the old one as active. Remove it, and only it: the guard is that the file
# still points at the hand-installed path, so an admin's own unit is untouched.
for u in /etc/systemd/system/powerhintd.service; do
	if [ -f "$u" ] && grep -q '/usr/local/sbin/powerhintd' "$u"; then
		rm -f "$u"
		rm -rf "$u".d
		rm -f /usr/local/sbin/powerhintd /usr/local/sbin/powerhintd.bak
		echo "removed the hand-installed powerhintd; the packaged one takes over"
	fi
done

exit 0
