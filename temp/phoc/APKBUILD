d30407a94db06aef808d047aa04e13f47aea3b9d84926d3237f4bd870f1140cb2098b1ea5093aba40234aa777270a2f0c5f0e635b16d09fa1f4851dddbd8ea8d  0001-render-don-t-hand-a-NULL-texture-to-the-thumbnail-ren.patch
1b51d5de64e3a64f7c569885d8a6e95ebb59ea5706e934650838a84aa96b24f69f39f97d84edb69907f167177b6ef649e8b727edc38a7b48b9b1f3bd9bde439c  0002-render-repaint-every-output-after-recreating-the-rend.patch
