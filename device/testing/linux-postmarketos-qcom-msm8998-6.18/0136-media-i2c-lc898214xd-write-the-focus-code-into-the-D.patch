From b4ac87044dae7153b423d731729e24fc75aa49b8 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 20 Aug 2026 23:32:40 +0200
Subject: [PATCH] media: i2c: lc898214xd: write the focus code into the DAC
 field

The 0xA0/0xA1 target word is not the DAC code. The code is 12 bits wide
and occupies bits [15:4]; the driver was writing it unshifted, so the
0..4095 range of V4L2_CID_FOCUS_ABSOLUTE only ever commanded 4095 of the
servo's 65535 counts. The lens moved about six percent of its stroke and
the register readback at 0x3C/0x3D dutifully tracked it, which is why a
manual sweep across the whole control range produced an essentially flat
focus metric -- 87, 89, 96, 107 for codes 400, 1600, 2800 and 3800 -- and
why libcamera's contrast AF converged so weakly.

The encoding is explicit in the vendor stack: the actuator's reg_tbl in
libactuator_lc898214xd.so is a single MSM_ACTUATOR_WRITE_DAC entry with
reg_addr 0x00A0 and data_shift 4 over a 12-bit data_size, and
msm_actuator_bivcm_handle_i2c_ops() builds the word as
"next_lens_position << data_shift". The hardware agrees: a code of 3810
(0x0EE2) written straight into 0xA0/0xA1 reads back as 0x0EE0, the low
nibble being no part of the code.

Three smaller corrections come with it, all from the same vendor sources:

  - the standby release is followed by a poll of 0xE0 until it reads 0,
    which is what the vendor's two-entry init table does, instead of a
    blind 5 ms sleep;

  - the "already awake" flag was set once and never cleared, so after the
    image sensor dropped the shared cam0_vaf rail the servo was left
    uninitialised for the rest of the kernel's life. Clear it on subdev
    open and on system resume. The actuator has no supply of its own in
    DT, so those are the only power-cycle proxies available without a DT
    change;

  - the default position becomes the vendor af_tuning initial_code
    0x0EFF, the code the HAL parks the lens at.

The hall reading at 0x3C/0x3D is exposed as a debugfs "position" file.
Register readback of the target proves only that the part accepted the
write; the hall value is what distinguishes a coil that moved from one
that did not, and this driver has now been wrong about exactly that once.
debugfs rather than a control because V4L2 has no standard control for a
measured lens position and a driver-private ID would be new uapi for a
bring-up measurement.

The lc898214xd_fw_setting_kt[]/_largan[] tables in the vendor's
fw_update.c are deliberately not ported. They are not a runtime init
table: they reprogram the module's internal calibration EEPROM through
the part's second i2c address 0xE6, gated on a version check and
bracketed by an unlock and a per-write completion poll, and the
KT-vs-Largan discriminator is read from the LC898123F40 OIS EEPROM on
i2c 0x7C, which mainline does not drive.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/media/i2c/lc898214xd.c | 166 +++++++++++++++++++++++++++------
 1 file changed, 140 insertions(+), 26 deletions(-)

diff --git a/drivers/media/i2c/lc898214xd.c b/drivers/media/i2c/lc898214xd.c
index b39486b68b32..82a8e7b225d6 100644
--- a/drivers/media/i2c/lc898214xd.c
+++ b/drivers/media/i2c/lc898214xd.c
@@ -4,48 +4,102 @@
  *
  * Google Pixel 2 XL (taimen) rear camera AF actuator, addr 0xE4 (8-bit) on
  * CCI master 0. The part self-initialises from its internal EEPROM on
- * standby release (0xE0 = 0x01); the host then only writes 16-bit target
- * positions to 0xA0/0xA1 and the internal servo drives the coil. Register
- * map and gain/range values from the vendor libactuator_lc898214xd.so
- * (slave/init table at .data+0x80) and verified live over CCI i2c:
- * current position reads back from 0x3C/0x3D and tracks the target.
+ * standby release (0xE0 = 0x01); the host then only writes a 16-bit target
+ * to 0xA0/0xA1 and the internal servo drives the coil.
  *
- * ponytail: no runtime PM ties to the camera rails -- the actuator shares
- * the sensor's always-on cam_vio; standby release is idempotent and cheap,
- * so it is re-issued on every first control write after probe.
+ * The target word is not the DAC code: the code is 12 bits wide and sits in
+ * bits [15:4]. The vendor stack encodes this as a MSM_ACTUATOR_WRITE_DAC
+ * entry with data_shift = 4 over a data_size of 12 bits -- see
+ * msm_actuator_bivcm_handle_i2c_ops() in the wahoo kernel
+ * (drivers/media/platform/msm/camera_v2/sensor/actuator/msm_actuator.c),
+ * fed from the reg_tbl in libactuator_lc898214xd.so (.data+0x9c:
+ * reg_write_type = MSM_ACTUATOR_WRITE_DAC, hw_mask = 0, reg_addr = 0x00a0,
+ * hw_shift = 0, data_shift = 4; .data+0x94: data_size = 12).
+ *
+ * Confirmed on the hardware: with a code of 3810 (0x0ee2) written straight
+ * into 0xA0/0xA1, the register reads back 0x0ee0 -- the low nibble is not
+ * part of the code. Writing the code unshifted therefore only ever drove
+ * 4095/65535 of the servo's span, which is why a full sweep of
+ * V4L2_CID_FOCUS_ABSOLUTE moved the lens so little that the focus metric
+ * stayed flat (87/89/96/107 for codes 400/1600/2800/3800).
+ *
+ * NOT ported, deliberately: lc898214xd_fw_setting_{kt,largan}[] from the
+ * vendor's fw_update.c. Those are not a runtime init table -- they are a
+ * one-shot reprogramming of the module's internal EEPROM, issued on the
+ * part's second i2c address 0xE6, gated on a version check
+ * (0x2F == 0x78 && 0x42 == 0x02 && 0x54 == 0x1B && 0x4C == 0x8B/0x8C),
+ * bracketed by an unlock (0x9C = 0xAF, 0x9D = 0x80) and a per-write
+ * completion poll on 0xED. The KT-vs-Largan discriminator is not readable
+ * from this part at all: it comes from the LC898123F40 OIS EEPROM on i2c
+ * 0x7C (RamWrite32A(0xF01B, 0x1A03) then RamRead32A(0xF01B)), which mainline
+ * does not drive. Burning a calibration EEPROM from a mainline driver, with
+ * the module vendor guessed, is not something this driver will do.
+ *
+ * The vendor's actual per-use init table is only two entries -- write
+ * 0xE0 = 0x01, then poll 0xE0 until it reads 0 -- from the init_settings
+ * array in libactuator_lc898214xd.so at .data+0x15c (count 2, followed by
+ * two struct reg_settings_t: {0xE0, BYTE_ADDR, 0x01, BYTE_DATA, MSM_ACT_WRITE,
+ * 10} and {0xE0, BYTE_ADDR, 0x00, BYTE_DATA, MSM_ACT_POLL, 10}).
  */
 
-#include <linux/delay.h>
+#include <linux/debugfs.h>
 #include <linux/i2c.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
+#include <linux/pm.h>
+#include <linux/seq_file.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-subdev.h>
 
 #define LC898214XD_REG_STANDBY		0xe0	/* write 1: release, reads 0 when ready */
-#define LC898214XD_REG_TARGET_MSB	0xa0
-#define LC898214XD_REG_TARGET_LSB	0xa1
+#define LC898214XD_REG_TARGET		0xa0	/* 16-bit, MSB in 0xa0, LSB in 0xa1 */
 #define LC898214XD_REG_POS_MSB		0x3c
 #define LC898214XD_REG_POS_LSB		0x3d
 
-/*
- * Vendor af_tuning region params: infinity 0x144, macro 0xeff. Expose the
- * full span; userspace (libcamera) normalises.
- */
+#define LC898214XD_STANDBY_POLL_US	1000
+#define LC898214XD_STANDBY_TIMEOUT_US	10000
+
+/* The 12-bit code occupies bits [15:4] of the 16-bit target/position word. */
+#define LC898214XD_CODE_SHIFT		4
 #define LC898214XD_POS_MIN		0
 #define LC898214XD_POS_MAX		0x0fff
-#define LC898214XD_POS_DEFAULT		0x0144
+
+/*
+ * Vendor af_tuning initial_code, i.e. where the HAL parks the lens when AF
+ * is initialised (libactuator_lc898214xd.so, .data+0x1808).
+ */
+#define LC898214XD_POS_DEFAULT		0x0eff
 
 struct lc898214xd {
 	struct v4l2_subdev sd;
 	struct v4l2_ctrl_handler ctrls;
 	struct i2c_client *client;
+	struct dentry *debugfs;
 	bool awake;
 };
 
+static struct lc898214xd *to_lc898214xd(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct lc898214xd, sd);
+}
+
+/*
+ * Releasing standby restarts the part's EEPROM-to-RAM load, so it must not be
+ * repeated on every position write. The actuator has no supply of its own in
+ * DT -- its coil rail (cam0_vaf) is switched by the image sensor's power
+ * sequence -- so the driver cannot observe a power cycle directly.
+ *
+ * Bracket it with the events that are observable instead, subdev
+ * open (libcamera opens the lens subdev once per camera session, which is
+ * also when the sensor is powered up) and system resume. If a power cycle
+ * happens inside a session the servo is left uninitialised until the next
+ * open; giving the lens node its own vaf-supply and runtime PM is the real
+ * fix, and needs a DT change.
+ */
 static int lc898214xd_wake(struct lc898214xd *lens)
 {
-	int ret;
+	int val, ret;
 
 	if (lens->awake)
 		return 0;
@@ -54,7 +108,15 @@ static int lc898214xd_wake(struct lc898214xd *lens)
 	if (ret < 0)
 		return ret;
 
-	usleep_range(5000, 6000);
+	ret = read_poll_timeout(i2c_smbus_read_byte_data, val, val <= 0,
+				LC898214XD_STANDBY_POLL_US,
+				LC898214XD_STANDBY_TIMEOUT_US, false,
+				lens->client, LC898214XD_REG_STANDBY);
+	if (ret)
+		return ret;
+	if (val < 0)
+		return val;
+
 	lens->awake = true;
 
 	return 0;
@@ -68,13 +130,8 @@ static int lc898214xd_set_pos(struct lc898214xd *lens, u16 pos)
 	if (ret)
 		return ret;
 
-	ret = i2c_smbus_write_byte_data(lens->client, LC898214XD_REG_TARGET_MSB,
-					pos >> 8);
-	if (ret < 0)
-		return ret;
-
-	return i2c_smbus_write_byte_data(lens->client, LC898214XD_REG_TARGET_LSB,
-					 pos & 0xff);
+	return i2c_smbus_write_word_swapped(lens->client, LC898214XD_REG_TARGET,
+					    pos << LC898214XD_CODE_SHIFT);
 }
 
 static int lc898214xd_s_ctrl(struct v4l2_ctrl *ctrl)
@@ -92,8 +149,47 @@ static const struct v4l2_ctrl_ops lc898214xd_ctrl_ops = {
 	.s_ctrl = lc898214xd_s_ctrl,
 };
 
+static int lc898214xd_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	to_lc898214xd(sd)->awake = false;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops lc898214xd_internal_ops = {
+	.open = lc898214xd_open,
+};
+
 static const struct v4l2_subdev_ops lc898214xd_subdev_ops = { };
 
+/*
+ * The hall sensor's current reading, in the same units as
+ * V4L2_CID_FOCUS_ABSOLUTE. This is the only way to tell "the coil moved"
+ * from "the target register accepted the write", which register readback
+ * alone does not answer. debugfs rather than a control because V4L2 has no
+ * standard control for a measured lens position and a driver-private ID
+ * would be new uapi for what is a bring-up measurement.
+ */
+static int lc898214xd_position_show(struct seq_file *s, void *data)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(s->private);
+	struct lc898214xd *lens = to_lc898214xd(sd);
+	int msb, lsb;
+
+	msb = i2c_smbus_read_byte_data(lens->client, LC898214XD_REG_POS_MSB);
+	if (msb < 0)
+		return msb;
+
+	lsb = i2c_smbus_read_byte_data(lens->client, LC898214XD_REG_POS_LSB);
+	if (lsb < 0)
+		return lsb;
+
+	seq_printf(s, "%u\n",
+		   ((msb << 8) | lsb) >> LC898214XD_CODE_SHIFT);
+
+	return 0;
+}
+
 static int lc898214xd_probe(struct i2c_client *client)
 {
 	struct lc898214xd *lens;
@@ -106,6 +202,7 @@ static int lc898214xd_probe(struct i2c_client *client)
 	lens->client = client;
 
 	v4l2_i2c_subdev_init(&lens->sd, client, &lc898214xd_subdev_ops);
+	lens->sd.internal_ops = &lc898214xd_internal_ops;
 	lens->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
 	lens->sd.entity.function = MEDIA_ENT_F_LENS;
 
@@ -128,6 +225,10 @@ static int lc898214xd_probe(struct i2c_client *client)
 	if (ret < 0)
 		goto err_clean_entity;
 
+	lens->debugfs = debugfs_create_dir(dev_name(&client->dev), NULL);
+	debugfs_create_devm_seqfile(&client->dev, "position", lens->debugfs,
+				    lc898214xd_position_show);
+
 	return 0;
 
 err_clean_entity:
@@ -141,13 +242,25 @@ static int lc898214xd_probe(struct i2c_client *client)
 static void lc898214xd_remove(struct i2c_client *client)
 {
 	struct v4l2_subdev *sd = i2c_get_clientdata(client);
-	struct lc898214xd *lens = container_of(sd, struct lc898214xd, sd);
+	struct lc898214xd *lens = to_lc898214xd(sd);
 
+	debugfs_remove_recursive(lens->debugfs);
 	v4l2_async_unregister_subdev(&lens->sd);
 	media_entity_cleanup(&lens->sd.entity);
 	v4l2_ctrl_handler_free(&lens->ctrls);
 }
 
+static int lc898214xd_resume(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+
+	to_lc898214xd(sd)->awake = false;
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(lc898214xd_pm_ops, NULL, lc898214xd_resume);
+
 static const struct of_device_id lc898214xd_of_table[] = {
 	{ .compatible = "onnn,lc898214xd" },
 	{ /* sentinel */ }
@@ -158,6 +271,7 @@ static struct i2c_driver lc898214xd_i2c_driver = {
 	.driver = {
 		.name = "lc898214xd",
 		.of_match_table = lc898214xd_of_table,
+		.pm = pm_sleep_ptr(&lc898214xd_pm_ops),
 	},
 	.probe = lc898214xd_probe,
 	.remove = lc898214xd_remove,
-- 
2.55.0

