 panels/privacy/nfc/meson.build                |  14 +
 panels/privacy/privacy.gresource.xml          |   1 +
 po/POTFILES.in                                |   1 +
 11 files changed, 701 insertions(+)
 create mode 100644 panels/privacy/icons/scalable/org.gnome.Settings-nfc-access-symbolic.svg
 create mode 100644 panels/privacy/nfc/cc-nfc-page.blp
 create mode 100644 panels/privacy/nfc/cc-nfc-page.c
 create mode 100644 panels/privacy/nfc/cc-nfc-page.h
 create mode 100644 panels/privacy/nfc/meson.build

