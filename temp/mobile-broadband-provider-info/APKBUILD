# TEMPORARY FORK of community/mobile-broadband-provider-info.
#
# Three Italian MCC/MNC pairs are claimed by several providers at once: 222-01
# by TIM, CoopVoce and Tiscali; 222-10 by Vodafone and PosteMobile; 222-99 by 3,
# Fastweb and Bip. The comments already note which are MVNOs, but nothing said
# so where a client could read it, so a client with no SIM data to go on cannot
# prefer the host network. The patch tags them primary="true|false", following
# AOSP's carrier_list.textpb on who owns each code.
#
# Inert on its own -- it needs temp/libnma, which is what teaches libnma to read
# the attribute.
#
# pkgrel is 50 so this build outranks Alpine's 20251101-r1 from any repo, while
# an upstream 20251102 still outranks it by design.
#
# NOT YET SUBMITTED upstream. Drop this fork when the tags land.

maintainer="Giuseppe Maggio <jertlok@proton.me>"
# Contributor: Francesco Colista <fcolista@alpinelinux.org>
pkgname=mobile-broadband-provider-info
pkgver=20251101
pkgrel=50
pkgdesc="Mobile broadband settings for various service providers"
url="https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/"
arch="noarch"
license="CC-PDDC"
makedepends="libxml2-utils libxslt meson"
# not using the CI release process: https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/-/merge_requests/139
source="https://gitlab.gnome.org/GNOME/mobile-broadband-provider-info/-/archive/$pkgver/mobile-broadband-provider-info-$pkgver.tar.gz
	it-primary-provider-per-shared-mcc-mnc.patch
	"
#source="https://download.gnome.org/sources/mobile-broadband-provider-info/$pkgver/mobile-broadband-provider-info-$pkgver.tar.xz"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

