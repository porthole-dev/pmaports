+		return 0;
+
+	if (bl_mode == 3)
+		return 0;
+
+	/*
+	 * mipi_dsi_dcs_write_buffer() derives MIPI_DSI_MSG_USE_LPM from the
+	 * device's mode_flags on every call, so flipping the bit around the
+	 * call is the per-message HS/LP control the API does not otherwise
+	 * expose. update_status() is already serialized by bl->update_lock.
+	 */
+	if (bl_hs)
+		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
