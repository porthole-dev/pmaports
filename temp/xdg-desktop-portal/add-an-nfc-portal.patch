From e652c5a571fad36b8e09605aa0260c628bdeaa2a Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 10 Sep 2026 17:33:36 +0200
Subject: [PATCH 4/9] nfc: OpenNFCRemote hands out a filtered neard connection

A permitted application gets a socket to an xdg-dbus-proxy filtered onto the
system bus, on which it sees org.neard and can start and stop the poll loop,
enumerate tags and read and write records.

It cannot call Properties.Set, so it cannot touch Adapter.Powered. That is
deliberate and load-bearing: the power switch belongs to the user, in Settings,
and it is why this design needs no disable-nfc key.

xdg-dbus-proxy rather than an in-process relay: the filter is the security
claim here, and that is the tool built for it, already trusted by flatpak for
exactly this. Writing a D-Bus message filter inside xdp to save a process would
be new security-critical parsing code.

The proxy listens on a filesystem path rather than accepting a socket, so the
portal gives it a private directory, waits for the byte it writes to its --fd
once it is listening, connects, and unlinks the path so that proxy only ever
has the one client. Closing the other end of that --fd socket pair is what
makes it exit, which happens when the application's bus connection goes away.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 meson.build              |   5 +
 src/nfc.c                | 311 +++++++++++++++++++++++++++++++++++++--
 tests/templates/neard.py |   5 +-
 tests/test_nfc.py        | 133 +++++++++++++++++
 4 files changed, 444 insertions(+), 10 deletions(-)

diff --git a/meson.build b/meson.build
index 9ce49db..015e98b 100644
--- a/meson.build
+++ b/meson.build
@@ -162,6 +162,11 @@ python = pymod.find_installation(
   required: get_option('tests'),
 )
 
+# The NFC portal hands applications a connection to neard that has been
+# filtered by xdg-dbus-proxy, so the proxy is a run-time dependency.
+xdg_dbus_proxy = find_program('xdg-dbus-proxy', required: true)
+config_h.set_quoted('XDG_DBUS_PROXY', xdg_dbus_proxy.full_path())
+
 bwrap = find_program('bwrap', required: get_option('sandboxed-image-validation').allowed() or get_option('sandboxed-sound-validation').allowed())
 
 if not bwrap.found()
diff --git a/src/nfc.c b/src/nfc.c
index 689e76e..c01da3e 100644
--- a/src/nfc.c
+++ b/src/nfc.c
@@ -22,8 +22,13 @@
 
 #include "nfc.h"
 
+#include <errno.h>
 #include <gio/gunixfdlist.h>
 #include <glib/gi18n.h>
+#include <glib/gstdio.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
 
 #include "xdp-context.h"
 #include "xdp-dbus.h"
@@ -50,6 +55,10 @@ struct _Nfc
 
   GCancellable *neard_cancellable;
   GDBusObjectManager *neard_manager;
+
+  /* Set of the NfcProxy handed out by OpenNFCRemote, so that they can be
+   * shut down when the application they were opened for goes away. */
+  GHashTable *proxies;
 };
 
 struct _NfcClass
@@ -214,19 +223,294 @@ handle_access_nfc (XdpDbusNFC            *object,
   return G_DBUS_METHOD_INVOCATION_HANDLED;
 }
 
+/* The filter that makes this portal safe to hand out at all.
+ *
+ * xdg-dbus-proxy applies these to every message the application sends. A rule
+ * names an interface and a member, optionally followed by "@" and an object
+ * path; a path ending in a slash and a star means that subtree. The member is
+ * matched literally unless it is exactly a star, so a rule cannot allow a
+ * prefix of the method names on an interface: each one has to be named.
+ *
+ * What is deliberately absent is org.freedesktop.DBus.Properties.Set. neard's
+ * adapter exposes Powered as a writable property, so a rule that allowed Set
+ * would let any permitted application switch the radio on and off behind the
+ * user's back. Withholding it is what lets this design have no lockdown key:
+ * the power switch stays where the user put it, in Settings.
+ */
+static const char * const nfc_proxy_filter[] = {
+  "--filter",
+
+  /* The application can see org.neard, and nothing else on the system bus. */
+  "--see=org.neard",
+
+  /* Enumerate adapters, tags and records. neard registers its object manager
+   * on the bus root, not under /org/neard, so this rule has to name "/". */
+  "--call=org.neard=org.freedesktop.DBus.ObjectManager.GetManagedObjects@/",
+
+  /* Look for tags, and stop looking. */
+  "--call=org.neard=org.neard.Adapter.StartPollLoop@/org/neard/*",
+  "--call=org.neard=org.neard.Adapter.StopPollLoop@/org/neard/*",
+
+  /* Everything a tag can do, which is Write and Deactivate. Write is here on
+   * purpose: withholding it would make the portal useless for the obvious
+   * write-a-tag application, and the user consented to NFC as a capability,
+   * the way camera permission covers recording and not just preview. */
+  "--call=org.neard=org.neard.Tag.*@/org/neard/*",
+
+  /* Read the properties of adapters, tags and records -- and only read them.
+   * Records carry their whole content as properties, so this is also how an
+   * application reads a tag. */
+  "--call=org.neard=org.freedesktop.DBus.Properties.Get@/org/neard/*",
+  "--call=org.neard=org.freedesktop.DBus.Properties.GetAll@/org/neard/*",
+
+  /* Signals from neard: InterfacesAdded and InterfacesRemoved from the bus
+   * root, which is how a tag arriving is announced, and PropertiesChanged
+   * from the objects themselves. */
+  "--broadcast=org.neard=*",
+};
+
+typedef struct
+{
+  GSubprocess *subprocess;
+  int sync_fd;
+  char *sender;
+} NfcProxy;
+
+static void
+nfc_proxy_free (gpointer data)
+{
+  NfcProxy *proxy = data;
+
+  /* xdg-dbus-proxy holds the other end of this socket pair as its --fd, and
+   * exits when it sees it close. */
+  if (proxy->sync_fd != -1)
+    close (proxy->sync_fd);
+  g_clear_object (&proxy->subprocess);
+  g_free (proxy->sender);
+  g_free (proxy);
+}
+
+static gboolean
+read_ready_byte (int      fd,
+                 GError **error)
+{
+  char byte;
+  ssize_t n;
+
+  do
+    n = read (fd, &byte, 1);
+  while (n == -1 && errno == EINTR);
+
+  if (n == 1)
+    return TRUE;
+
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+               "xdg-dbus-proxy did not start: %s",
+               n == 0 ? "it exited" : g_strerror (errno));
+  return FALSE;
+}
+
+static int
+connect_to (const char  *path,
+            GError     **error)
+{
+  struct sockaddr_un address = { .sun_family = AF_UNIX };
+  int fd;
+
+  if (g_strlcpy (address.sun_path, path, sizeof (address.sun_path)) >=
+      sizeof (address.sun_path))
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FILENAME_TOO_LONG,
+                   "Socket path %s is too long", path);
+      return -1;
+    }
+
+  fd = socket (AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (fd == -1)
+    {
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                   "Failed to create a socket: %s", g_strerror (errno));
+      return -1;
+    }
+
+  if (connect (fd, (struct sockaddr *) &address, sizeof (address)) == -1)
+    {
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                   "Failed to connect to %s: %s", path, g_strerror (errno));
+      close (fd);
+      return -1;
+    }
+
+  return fd;
+}
+
+/* Start a filtered proxy onto the system bus and connect to it, returning the
+ * connected socket in @out_fd for the application to be handed. */
+static NfcProxy *
+nfc_proxy_new (const char  *sender,
+               int         *out_fd,
+               GError     **error)
+{
+  g_autoptr(GSubprocessLauncher) launcher = NULL;
+  g_autoptr(GSubprocess) subprocess = NULL;
+  g_autoptr(GPtrArray) argv = NULL;
+  g_autofree char *directory = NULL;
+  g_autofree char *path = NULL;
+  g_autofree char *address = NULL;
+  g_autofd int sync_fd = -1;
+  NfcProxy *proxy;
+  int sync_fds[2];
+  int fd;
+
+  address = g_dbus_address_get_for_bus_sync (G_BUS_TYPE_SYSTEM, NULL, error);
+  if (address == NULL)
+    return NULL;
+
+  /* The proxy listens on a filesystem path rather than taking a socket, so it
+   * gets a private directory to listen in. The path is unlinked as soon as we
+   * are connected, so this proxy only ever has the one client. */
+  directory = g_dir_make_tmp ("xdg-desktop-portal-nfc-XXXXXX", error);
+  if (directory == NULL)
+    return NULL;
+
+  path = g_build_filename (directory, "bus", NULL);
+
+  if (socketpair (AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sync_fds) == -1)
+    {
+      g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                   "Failed to create a socket pair: %s", g_strerror (errno));
+      g_rmdir (directory);
+      return NULL;
+    }
+  sync_fd = sync_fds[0];
+
+  argv = g_ptr_array_new ();
+  g_ptr_array_add (argv, (char *) XDG_DBUS_PROXY);
+  /* --fd is a general option and has to come before the address; the proxy
+   * writes a byte to it once it is listening, and exits when it closes. */
+  g_ptr_array_add (argv, (char *) "--fd=3");
+  g_ptr_array_add (argv, address);
+  g_ptr_array_add (argv, path);
