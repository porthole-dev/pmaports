+static inline struct imx179 *to_imx179(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx179, sd);
+}
+
+/*
+ * ponytail: bring-up stimulus, delete with the rest of the knobs. Writing N
+ * (0=vio 1=vdig 2=vana) drops that rail for 300 ms while everything else
+ * keeps running. The one electrical event we can command from software that
+ * MUST move the MIPI lane DC levels -- the discriminator for "PHY blind" vs
+ * "sensor silent" (HANDOFF §39): if the PHY latches nothing even across its
+ * transmitter's power dying, its receiver is not alive.
+ */
+static struct imx179 *tk_imx179_instance;
+static int tk_raildrop_set(const char *val, const struct kernel_param *kp)
+{
+	struct imx179 *imx179 = tk_imx179_instance;
+	unsigned int n;
+	int ret;
+
+	if (!imx179)
+		return -ENODEV;
+	ret = kstrtouint(val, 0, &n);
+	if (ret || n >= ARRAY_SIZE(imx179->supplies))
+		return -EINVAL;
+
+	pr_info("imx179: dropping %s for 300 ms\n", imx179->supplies[n].supply);
+	regulator_disable(imx179->supplies[n].consumer);
+	msleep(300);
+	ret = regulator_enable(imx179->supplies[n].consumer);
+	pr_info("imx179: %s restored (%d)\n", imx179->supplies[n].supply, ret);
+
+	return 0;
+}
+module_param_call(tk_raildrop, tk_raildrop_set, NULL, NULL, 0200);
+MODULE_PARM_DESC(tk_raildrop, "bring-up: drop supply N for 300 ms (0=vio 1=vdig 2=vana)");
+
+
+/* 16-bit register address, 8-bit data -- the usual Sony layout. */
+static int imx179_write(struct imx179 *imx179, u16 reg, u8 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx179->sd);
+	u8 buf[3] = { reg >> 8, reg & 0xff, val };
+	int ret;
+
+	ret = i2c_master_send(client, buf, sizeof(buf));
+	if (ret != sizeof(buf)) {
+		dev_err(&client->dev, "write 0x%04x failed: %d\n", reg, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+static int imx179_read(struct imx179 *imx179, u16 reg, u8 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx179->sd);
+	u8 addr[2] = { reg >> 8, reg & 0xff };
+	struct i2c_msg msgs[2] = {
+		{ .addr = client->addr, .flags = 0,
+		  .len = sizeof(addr), .buf = addr },
+		{ .addr = client->addr, .flags = I2C_M_RD,
+		  .len = 1, .buf = val },
+	};
+	int ret;
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return ret < 0 ? ret : -EIO;
+
+	return 0;
+}
+
+static int imx179_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx179 *imx179 = to_imx179(sd);
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx179->supplies),
+				    imx179->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable supplies: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * MCLK1 is a branch inside CAMSS_TOP. clk_branch2_enable() polls the
+	 * branch status and returns -EBUSY if the domain is collapsed, so the
+	 * domain has to be up BEFORE the clock is touched. Attaching the sensor
+	 * to the domain via power-domains is not sufficient on its own here --
+	 * it works at cold boot only because CCI happens to still be active,
+	 * and fails on every later resume or module reload. Hold the CCI device
+	 * (which owns CAMSS_TOP) awake across the sensor's power cycle.
+	 */
+	imx179->cci_dev = client->adapter->dev.parent;
+	if (imx179->cci_dev) {
+		ret = pm_runtime_resume_and_get(imx179->cci_dev);
+		if (ret < 0) {
+			dev_err(dev, "failed to wake CCI: %d\n", ret);
+			regulator_bulk_disable(ARRAY_SIZE(imx179->supplies),
+					       imx179->supplies);
+			return ret;
+		}
+	}
+
+	ret = clk_prepare_enable(imx179->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable xclk: %d\n", ret);
+		if (imx179->cci_dev)
+			pm_runtime_put(imx179->cci_dev);
+		regulator_bulk_disable(ARRAY_SIZE(imx179->supplies),
+				       imx179->supplies);
+		return ret;
+	}
+
+	/*
+	 * Set the rate only once the branch is ENABLED. MCLK1 is an mmcc RCG
+	 * inside the CAMSS domain: with the domain unpowered the regmap write
+	 * goes nowhere, clk_set_rate() still returns 0, and the clock keeps
+	 * running at its 300 MHz power-on default. Setting it here, after the
+	 * branch is on, is what makes it stick -- and the sensor will not
+	 * answer on I2C at all until it does, which presents as "no device at
+	 * this address" rather than as a clock fault.
+	 */
+	ret = clk_set_rate(imx179->xclk, IMX179_XCLK_FREQ);
+	if (ret)
+		dev_warn(dev, "failed to set xclk rate: %d\n", ret);
+
+	if (clk_get_rate(imx179->xclk) != IMX179_XCLK_FREQ)
+		dev_warn(dev, "xclk is %lu Hz, wanted %u -- sensor will not respond\n",
+			 clk_get_rate(imx179->xclk), IMX179_XCLK_FREQ);
+
+	gpiod_set_value_cansleep(imx179->reset_gpio, 0);
+
+	/*
+	 * The vendor waits 9 ms here. Reading the chip ID any earlier gets
+	 * zeroes back, which is indistinguishable from a sensor that is not
+	 * there at all -- so this delay is diagnostic, not just polite.
+	 */
+	usleep_range(9000, 10000);
+
+	return 0;
+}
+
+static int imx179_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx179 *imx179 = to_imx179(sd);
+
+	gpiod_set_value_cansleep(imx179->reset_gpio, 1);
+	clk_disable_unprepare(imx179->xclk);
+	if (imx179->cci_dev)
+		pm_runtime_put(imx179->cci_dev);
+	regulator_bulk_disable(ARRAY_SIZE(imx179->supplies), imx179->supplies);
+
+	return 0;
+}
+
+static int imx179_identify(struct imx179 *imx179)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&imx179->sd);
+	u8 hi, lo;
+	u16 id;
+	int ret;
+
+	ret = imx179_read(imx179, IMX179_REG_CHIP_ID, &hi);
+	if (ret) {
+		dev_err(&client->dev,
+			"no answer at 0x%02x reading chip ID: %d -- rails up but wrong address, or wrong bus\n",
+			client->addr, ret);
+		return ret;
+	}
+
+	ret = imx179_read(imx179, IMX179_REG_CHIP_ID + 1, &lo);
+	if (ret)
+		return ret;
+
+	id = ((hi << 8) | lo) & IMX179_CHIP_ID_MASK;
+	if (id != IMX179_CHIP_ID) {
+		unsigned int reg;
+		u8 v;
+
+		dev_err(&client->dev, "wrong chip ID 0x%04x, expected 0x%04x\n",
+			id, IMX179_CHIP_ID);
+
+		for (reg = 0x0000; reg <= 0x001f; reg += 2) {
+			u8 a, b;
+
+			if (imx179_read(imx179, reg, &a) ||
+			    imx179_read(imx179, reg + 1, &b))
+				continue;
+			dev_dbg(&client->dev, "  0x%04x: %02x %02x\n",
+				 reg, a, b);
+		}
+		(void)v;
+
+		return -ENODEV;
+	}
+
+	dev_dbg(&client->dev, "IMX179 detected (0x%02x%02x masked to 0x%04x)\n",
+		 hi, lo, id);
+
+	return 0;
+}
+
+static void imx179_set_mode_format(struct imx179 *imx179,
+				   const struct imx179_mode *mode)
+{
+	imx179->cur_mode = mode;
+	imx179->fmt.code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	imx179->fmt.width = mode->width;
+	imx179->fmt.height = mode->height;
+	imx179->fmt.field = V4L2_FIELD_NONE;
+	imx179->fmt.colorspace = V4L2_COLORSPACE_RAW;
+}
+
+static void imx179_set_default_format(struct imx179 *imx179)
+{
+	/* Start on the binned mode -- least CSI bandwidth to get right first. */
+	/*
+	 * Default to the FULL mode: stock drives this sensor at 648 Mbps/lane
+	 * (3280x2464), never the binned 340 Mbps mode this used to default to.
+	 * Do not reorder imx179_modes[] -- the LINK_FREQ menu index is computed
+	 * as (mode - &imx179_modes[0]) against imx179_link_freqs[].
+	 */
+	imx179_set_mode_format(imx179, &imx179_modes[2]);
+}
+
+static int imx179_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+
+	return 0;
+}
+
+static int imx179_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	/*
+	 * Only the FULL mode is exposed: Easel's front bypass link is armed
+	 * at 648 Mbps (the FULL-mode rate) once at boot, and a stream at the
+	 * binned/video rates cannot lock the Easel RX -- it also leaves the
+	 * RX wedged for every later session (HANDOFF §5.0). One mode is the
+	 * whole camera until per-stream Easel rate switching exists.
+	 */
+	if (fse->index > 0 || fse->code != MEDIA_BUS_FMT_SRGGB10_1X10)
+		return -EINVAL;
+
+	fse->min_width = imx179_modes[2].width;
+	fse->max_width = imx179_modes[2].width;
+	fse->min_height = imx179_modes[2].height;
+	fse->max_height = imx179_modes[2].height;
+
+	return 0;
+}
+
+static int imx179_get_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct imx179 *imx179 = to_imx179(sd);
+
+	mutex_lock(&imx179->lock);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(state, fmt->pad);
+	else
+		fmt->format = imx179->fmt;
+	mutex_unlock(&imx179->lock);
+
+	return 0;
+}
+
+/* Every request snaps to FULL -- the only Easel-compatible mode (see
+ * imx179_enum_frame_size). */
+static const struct imx179_mode *imx179_find_mode(u32 width, u32 height)
+{
+	return &imx179_modes[2];
+}
+
+static int imx179_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	struct imx179 *imx179 = to_imx179(sd);
+	const struct imx179_mode *mode;
+
+	mutex_lock(&imx179->lock);
+
+	mode = imx179_find_mode(fmt->format.width, fmt->format.height);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		struct v4l2_mbus_framefmt *try_fmt =
+			v4l2_subdev_state_get_format(state, fmt->pad);
+
+		try_fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+		try_fmt->width = mode->width;
+		try_fmt->height = mode->height;
+		try_fmt->field = V4L2_FIELD_NONE;
+		try_fmt->colorspace = V4L2_COLORSPACE_RAW;
+		fmt->format = *try_fmt;
+	} else {
+		imx179_set_mode_format(imx179, mode);
+		fmt->format = imx179->fmt;
+
+		__v4l2_ctrl_s_ctrl_int64(imx179->pixel_rate, mode->pixel_rate);
+		__v4l2_ctrl_s_ctrl(imx179->link_freq,
+				   mode - &imx179_modes[0]);
+		__v4l2_ctrl_modify_range(imx179->hblank,
+					 mode->llp - mode->width,
+					 mode->llp - mode->width, 1,
+					 mode->llp - mode->width);
+		__v4l2_ctrl_modify_range(imx179->vblank,
+					 mode->fll - mode->height,
+					 IMX179_FLL_MAX - mode->height, 1,
+					 mode->fll - mode->height);
+		__v4l2_ctrl_modify_range(imx179->exposure,
+					 IMX179_EXPOSURE_MIN,
+					 mode->fll - IMX179_EXPOSURE_MARGIN, 1,
+					 mode->fll - IMX179_EXPOSURE_MARGIN);
+	}
+
+	mutex_unlock(&imx179->lock);
+
+	return 0;
+}
+
+static int imx179_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct imx179 *imx179 = to_imx179(sd);
+
+	mutex_lock(&imx179->lock);
+	*v4l2_subdev_state_get_format(state, 0) = imx179->fmt;
+	mutex_unlock(&imx179->lock);
+
+	return 0;
+}
+
+static int imx179_write_regs(struct imx179 *imx179,
+			     const struct imx179_reg *regs, u32 num)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < num; i++) {
+		ret = imx179_write(imx179, regs[i].addr, regs[i].val);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int imx179_write16(struct imx179 *imx179, u16 reg, u16 val)
+{
+	int ret;
+
+	ret = imx179_write(imx179, reg, val >> 8);
+	if (ret)
+		return ret;
+	return imx179_write(imx179, reg + 1, val & 0xff);
+}
+
+static int imx179_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx179 *imx179 =
+		container_of(ctrl->handler, struct imx179, ctrls);
+	struct i2c_client *client = v4l2_get_subdevdata(&imx179->sd);
+	int ret = 0;
+
+	/* Keep the exposure ceiling glued to the frame length. */
+	if (ctrl->id == V4L2_CID_VBLANK)
+		__v4l2_ctrl_modify_range(imx179->exposure,
+					 IMX179_EXPOSURE_MIN,
+					 imx179->cur_mode->height + ctrl->val -
+						IMX179_EXPOSURE_MARGIN,
+					 1, imx179->exposure->val);
+
+	/* Only touch the sensor when it is powered. */
+	if (!pm_runtime_get_if_in_use(&client->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = imx179_write16(imx179, IMX179_REG_COARSE_INTEG,
+				     ctrl->val);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = imx179_write16(imx179, IMX179_REG_ANALOG_GAIN, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = imx179_write16(imx179, IMX179_REG_FRM_LENGTH,
+				     imx179->cur_mode->height + ctrl->val);
+		break;
+	default:
+		/* PIXEL_RATE, LINK_FREQ, HBLANK: read-only, nothing to write */
+		break;
+	}
+
+	pm_runtime_put(&client->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx179_ctrl_ops = {
+	.s_ctrl = imx179_set_ctrl,
+};
+
+static int imx179_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx179 *imx179 = to_imx179(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		mutex_lock(&imx179->lock);
+		sel->r = imx179->cur_mode->crop;
+		mutex_unlock(&imx179->lock);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX179_NATIVE_WIDTH;
+		sel->r.height = IMX179_NATIVE_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx179_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx179 *imx179 = to_imx179(sd);
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	const struct imx179_mode *mode;
+	int ret;
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(&client->dev);
+		if (ret < 0)
+			return ret;
+
+		mutex_lock(&imx179->lock);
+		mode = imx179->cur_mode;
+		/*
+		 * The vendor tables carry no global/init block -- they are pure
+		 * per-mode setups -- so nothing has reset the sensor since power
+		 * on. SMIA parts want a software reset before configuration.
+		 *
+		 * Hardware-reset the sensor before every stream.
+		 *
+		 * imx179_probe() takes pm_runtime_get_noresume() and never
+		 * drops it (see the comment there), so imx179_power_off() never
+		 * runs and the sensor is powered exactly once, at probe. The
+		 * consequence is not idle power: it is that only the FIRST
+		 * stream attempt after a boot ever works. After s_stream(0)
+		 * writes MODE_SELECT=0 the sensor is left in a state the mode
+		 * table alone does not restore, and every later attempt is
+		 * silent -- which for a whole session looked like a dead
+		 * CSIPHY.
+		 *
+		 * Toggling XCLR here costs ~10 ms and makes every attempt
+		 * equivalent to the first one after boot. The real fix is to
+		 * drop the probe-time reference once the resume path works.
+		 */
+		gpiod_set_value_cansleep(imx179->reset_gpio, 1);
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(imx179->reset_gpio, 0);
+		usleep_range(9000, 10000);
+
+		ret = imx179_write(imx179, IMX179_REG_SOFTWARE_RST, 0x01);
+		if (!ret)
+			usleep_range(5000, 6000);
+		if (!ret)
+			ret = imx179_write_regs(imx179, mode->regs,
+						mode->num_regs);
+		mutex_unlock(&imx179->lock);
+		/* re-apply user exposure/gain/vblank over the table defaults */
+		if (!ret)
+			ret = v4l2_ctrl_handler_setup(&imx179->ctrls);
+		if (ret) {
+			dev_err(&client->dev, "failed to program mode %ux%u: %d\n",
+				mode->width, mode->height, ret);
+			pm_runtime_put(&client->dev);
+			return ret;
+		}
+
+		ret = imx179_write(imx179, IMX179_REG_MODE_SELECT,
+				   IMX179_MODE_STREAMING);
+		if (ret) {
+			pm_runtime_put(&client->dev);
+			return ret;
+		}
+		/*
+		 * Arm the CSIPHY: front sensor rides Easel TX1. See
+		 * easel_mipi_kick() -- without this pulse the CSIPHY
+		 * never locks and every frame is lost.
+		 */
+		msleep(50);
+		easel_mipi_kick(1);
+	} else {
+		imx179_write(imx179, IMX179_REG_MODE_SELECT,
+			     IMX179_MODE_STANDBY);
+		pm_runtime_put(&client->dev);
+	}
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops imx179_video_ops = {
+	.s_stream = imx179_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx179_pad_ops = {
+	.enum_mbus_code = imx179_enum_mbus_code,
+	.enum_frame_size = imx179_enum_frame_size,
+	.get_fmt = imx179_get_fmt,
+	.set_fmt = imx179_set_fmt,
+	.get_selection = imx179_get_selection,
+};
+
+static const struct v4l2_subdev_ops imx179_subdev_ops = {
+	.video = &imx179_video_ops,
+	.pad = &imx179_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx179_internal_ops = {
+	.init_state = imx179_init_state,
+};
+
+static int imx179_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx179 *imx179;
+	unsigned int i;
+	u32 rate;
+	int ret;
+
+	imx179 = devm_kzalloc(dev, sizeof(*imx179), GFP_KERNEL);
+	if (!imx179)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&imx179->sd, client, &imx179_subdev_ops);
+	imx179->sd.internal_ops = &imx179_internal_ops;
+	mutex_init(&imx179->lock);
+	imx179_set_default_format(imx179);
+
+	imx179->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(imx179->xclk))
+		return dev_err_probe(dev, PTR_ERR(imx179->xclk),
+				     "failed to get xclk\n");
+
+	/*
+	 * Do not trust assigned-clock-rates alone here. MCLK1 is an mmcc RCG
+	 * whose default config is GPLL0_DIV straight through at 300 MHz, and
+	 * the sensor will not answer on I2C at all with a clock that far out of
+	 * spec -- which presents as "no device at this address", not as a clock
+	 * problem. Set it, then check what we actually got.
+	 */
+	ret = clk_set_rate(imx179->xclk, IMX179_XCLK_FREQ);
+	if (ret)
+		dev_warn(dev, "failed to set xclk to %u Hz: %d\n",
+			 IMX179_XCLK_FREQ, ret);
+
+	rate = clk_get_rate(imx179->xclk);
+	if (rate != IMX179_XCLK_FREQ)
+		dev_warn(dev, "xclk is %u Hz, expected %u\n",
+			 rate, IMX179_XCLK_FREQ);
+
+	for (i = 0; i < ARRAY_SIZE(imx179_supply_names); i++)
+		imx179->supplies[i].supply = imx179_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx179->supplies),
+				      imx179->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	/* Held asserted until power_on releases it. */
+	imx179->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx179->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx179->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	tk_imx179_instance = imx179;
+
+	ret = imx179_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = imx179_identify(imx179);
+	if (ret)
+		goto err_power_off;
+
+	/*
+	 * camss and libcamera both need PIXEL_RATE and LINK_FREQ to compute CSI
+	 * timing; a sensor without them is rejected before it ever streams.
+	 * libcamera additionally requires EXPOSURE, ANALOGUE_GAIN, HBLANK and
+	 * VBLANK (camera_sensor_legacy.cpp mandatory list) or it refuses to
+	 * build a pipeline at all.
+	 */
+	ret = v4l2_ctrl_handler_init(&imx179->ctrls, 9);
+	if (ret)
+		goto err_power_off;
+
+	imx179->pixel_rate = v4l2_ctrl_new_std(&imx179->ctrls, NULL,
+					       V4L2_CID_PIXEL_RATE, 1,
+					       INT_MAX, 1,
+					       imx179->cur_mode->pixel_rate);
+
+	imx179->link_freq = v4l2_ctrl_new_int_menu(&imx179->ctrls, NULL,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(imx179_link_freqs) - 1, 0,
+					imx179_link_freqs);
+	if (imx179->link_freq)
+		imx179->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx179->hblank = v4l2_ctrl_new_std(&imx179->ctrls, &imx179_ctrl_ops,
+					   V4L2_CID_HBLANK,
+					   imx179->cur_mode->llp -
+						imx179->cur_mode->width,
+					   imx179->cur_mode->llp -
+						imx179->cur_mode->width,
+					   1,
+					   imx179->cur_mode->llp -
+						imx179->cur_mode->width);
+	if (imx179->hblank)
+		imx179->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx179->vblank = v4l2_ctrl_new_std(&imx179->ctrls, &imx179_ctrl_ops,
+					   V4L2_CID_VBLANK,
+					   imx179->cur_mode->fll -
+						imx179->cur_mode->height,
+					   IMX179_FLL_MAX -
+						imx179->cur_mode->height,
+					   1,
+					   imx179->cur_mode->fll -
+						imx179->cur_mode->height);
+
+	imx179->exposure = v4l2_ctrl_new_std(&imx179->ctrls, &imx179_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX179_EXPOSURE_MIN,
+					     imx179->cur_mode->fll -
+						IMX179_EXPOSURE_MARGIN,
+					     1,
+					     imx179->cur_mode->fll -
+						IMX179_EXPOSURE_MARGIN);
+
+	/*
+	 * Default 4x (256/(256-192)), not 1x. libcamera's simple IPA has no
+	 * sensor helper for this part, so it cannot convert a gain code into
+	 * a real gain and its AE never moves the control -- whatever default
+	 * is set here is what every frame gets. At 1x indoor frames come out
+	 * near-black (reported from the phosh viewfinder, 2026-08-04).
+	 */
+	v4l2_ctrl_new_std(&imx179->ctrls, &imx179_ctrl_ops,
+			  V4L2_CID_ANALOGUE_GAIN, 0, IMX179_ANA_GAIN_MAX,
+			  1, 192);
+
+	/*
+	 * ORIENTATION and SENSOR_ROTATION from the DT node. libcamera reads
+	 * both; without them it logs "Failed to retrieve the camera location"
+	 * and "Rotation control not available" and shows the preview
+	 * unrotated with no front/back distinction.
+	 */
+	{
+		struct v4l2_fwnode_device_properties props;
+
+		ret = v4l2_fwnode_device_parse(dev, &props);
+		if (!ret)
+			ret = v4l2_ctrl_new_fwnode_properties(&imx179->ctrls,
+							      &imx179_ctrl_ops,
+							      &props);
+		if (ret)
+			dev_warn(dev, "no orientation/rotation properties: %d\n",
+				 ret);
+	}
+
+	if (imx179->ctrls.error) {
+		ret = imx179->ctrls.error;
+		dev_err(dev, "failed to add controls: %d\n", ret);
+		goto err_ctrl_free;
+	}
+
+	imx179->sd.ctrl_handler = &imx179->ctrls;
+
+	imx179->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx179->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx179->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx179->sd.entity, 1, &imx179->pad);
+	if (ret)
+		goto err_ctrl_free;
+
+	ret = v4l2_async_register_subdev_sensor(&imx179->sd);
+	if (ret) {
+		dev_err(dev, "failed to register subdev: %d\n", ret);
+		goto err_media_cleanup;
+	}
+
+	/*
+	 * Deliberately NO pm_runtime_idle() here yet: probe already powered the
+	 * sensor up, and letting it idle straight back down exposes a resume
+	 * path that currently fails -- clk_prepare_enable() on MCLK1 returns
+	 * -EBUSY once CAMSS_TOP has collapsed, which puts the device into
+	 * runtime-PM error state and makes every later get return -EBUSY
+	 * ("Resource busy" out of VIDIOC_STREAMON). Holding power from probe
+	 * keeps first light independent of that bug; it costs idle power and
+	 * must not survive past bring-up.
+	 */
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_enable(dev);
+
+	return 0;
+
+err_media_cleanup:
+	media_entity_cleanup(&imx179->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(&imx179->ctrls);
+err_power_off:
+	imx179_power_off(dev);
+	mutex_destroy(&imx179->lock);
+
+	return ret;
+}
+
+static void imx179_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx179 *imx179 = to_imx179(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx179->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx179_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&imx179->lock);
+}
+
+static const struct dev_pm_ops imx179_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx179_power_off, imx179_power_on, NULL)
+};
+
+static const struct of_device_id imx179_of_match[] = {
+	{ .compatible = "sony,imx179" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx179_of_match);
+
+static struct i2c_driver imx179_i2c_driver = {
+	.driver = {
+		.name = "imx179",
+		.of_match_table = imx179_of_match,
+		.pm = &imx179_pm_ops,
+	},
+	.probe = imx179_probe,
+	.remove = imx179_remove,
+};
+module_i2c_driver(imx179_i2c_driver);
+
+MODULE_DESCRIPTION("Sony IMX179 sensor driver");
+MODULE_LICENSE("GPL");
