# 6.18 kernel fork for MSM8998 devices, in parallel with the 6.0 aport
# (linux-postmarketos-qcom-msm8998). See that aport's APKBUILD for why: its
# source branch is 202 commits of bring-up archaeology that doesn't reduce to
# a reviewable patch series. This one tracks the qcom-msm8998-6.18.y branch,
# a 33-commit series rebased on top of it, split one logical change per patch
# (25 -> 33: the MSM8998 CAMSS series landed on taimen-v6.18-wip 2026-08-08).
# Kernel config based on: taimen_defconfig
maintainer="Giuseppe Maggio <jertlok@proton.me>"
_flavor="postmarketos-qcom-msm8998-6.18"
pkgname=linux-$_flavor
pkgver=6.18
pkgrel=3
_commit="4e0c53280d9757b3872d3823b9f94066669aa388"
pkgdesc="6.18 mainline kernel fork for MSM8998 devices"
arch="aarch64"
_carch="arm64"
_config="config-$_flavor.$arch"
url="https://github.com/msm8998-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bison
	clang
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	xz
"

