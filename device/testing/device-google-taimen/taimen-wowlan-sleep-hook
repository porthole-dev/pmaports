#!/bin/sh
# Arm WoWLAN before suspend, so cfg80211 does not tear the WLAN down.
#
# Without a wowlan_config, wiphy_suspend() falls through to
# cfg80211_leave_all() and disconnects every interface; resume then rebuilds
# the stack and re-associates from scratch. Measured on this device,
# interleaved, two rounds each way:
#
#            wiphy_suspend   wiphy_resume   reassociated?
#   off        276 / 273 ms   330 / 303 ms   yes
#   on         115 / 135 ms     8 / 7  ms    no -- stayed associated
#
# ~466 ms per cycle, and the phone keeps its address across suspend.
#
# NetworkManager will not do this for us: `wifi.wake-on-wlan` as a conf.d
# connection default leaves the property at "0x1 (default)" and nothing reaches
# the kernel, verified across a real suspend on NM 1.58.
#
# `magic-packet`, not `magic` -- the short form is a usage error that iw prints
# to stderr while leaving WoWLAN disabled, which silently turns an experiment's
# B arm into a second A arm. It did exactly that here once.
#
# Left armed on resume rather than disabled: it costs nothing while awake, and
# disabling it would reintroduce the disconnect on any suspend that skips this
# hook (rtcwake writes /sys/power/state directly and never runs it).
[ "$1" = pre ] || exit 0
command -v iw >/dev/null 2>&1 || exit 0
for p in /sys/class/ieee80211/*; do
	[ -e "$p" ] || continue
	iw "$(basename "$p")" wowlan enable magic-packet disconnect >/dev/null 2>&1
done
exit 0
