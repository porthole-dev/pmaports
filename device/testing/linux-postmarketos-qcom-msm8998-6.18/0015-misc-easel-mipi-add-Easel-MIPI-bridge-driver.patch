+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Easel (Google Pixel Visual Core / Intel Monette Hill) MIPI bridge.
+ *
+ * On Pixel 2 / 2 XL both camera sensors' CSI lanes terminate on Easel, which
+ * retransmits them to the SoC's CSIPHY0/CSIPHY1 (HANDOFF §41). Until Easel's
+ * MIPI mux is put in bypass, the SoC's CSIPHYs receive nothing at all, which
+ * is exactly what this bring-up measured for three days.
+ *
+ * This driver claims the endpoint so the PCI core assigns its BARs and turns
+ * on memory decoding -- without a driver, COMMAND stays 0x0000, every BAR
+ * reads back 0, and any MMIO access to it is a transaction to nowhere that
+ * hangs the fabric and watchdogs the phone.
+ *
+ * Easel's register space is reached through BAR2, whose inbound window has to
+ * be retargeted first: the window is 8 MB but the peripherals live at
+ * 0x04000000. Downstream does this in mnh_check_iatu_bar2() via PCI *config*
+ * space (the DWC DBI is exposed there), not MMIO -- see mnh-pcie.c:186.
+ *
+ * ponytail: built as a module on purpose during bring-up. A built-in driver
+ * that touches an unresponsive Easel hangs the boot, and three failed boots
+ * drain the A/B retry counter into the bootloader (TODO §3).
+ */
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/limits.h>
+
+#define EASEL_VENDOR_INTEL	0x8086
+#define EASEL_DEVICE_MNH	0x3140
+
+/* Easel address map -- mnh-hwio-bases.h */
+#define EASEL_PERIPH_BASE	0x04000000
+#define EASEL_SCU_BASE		0x04003000
+#define EASEL_SCU_CCU_CLK_CTL	0x04003084
+#define SCU_MIPI_TESTCLKEN	BIT(4)
+#define SCU_MIPI_REFCLKEN	BIT(6)
+#define EASEL_MIPI_TOP_BASE	0x04015000
+
+/* Inbound iATU, in the endpoint's config space -- hw-mnh-regs.h:56-69 */
+#define IATU_VIEWPORT		0x900
+#define IATU_REGION_CTRL_1	0x904
+#define IATU_REGION_CTRL_2	0x908
+#define IATU_LWR_TARGET_ADDR	0x918
+#define IATU_UPPER_TARGET_ADDR	0x91c
+#define IATU_INBOUND		0x80000000
+#define IATU_BAR_MODE		0xc0000000
+
+#define EASEL_BAR_CONFIG	2
+
+/*
+ * Board wiring (factory DTBO + HANDOFF §41): rear imx362 -> RX0 -> TX0 ->
+ * CSIPHY0, front imx179 -> RX1 -> TX1 -> CSIPHY1. Rates are Mbps per lane,
+ * i.e. twice the sensor's V4L2 link frequency: imx179 170 MHz -> 340,
+ * imx362 685 MHz -> 1370.
+ */
+/* Both links by default: front worked 2026-08-04, rear needs RX0->TX0 armed
+ * at probe just the same (a rear test on a bypass=0x1 boot cost an hour). */
+static unsigned int bypass = 0x3;
+module_param(bypass, uint, 0644);
+MODULE_PARM_DESC(bypass, "links to put in MIPI bypass: bit0 front (RX1->TX1), bit1 rear (RX0->TX0)");
+
+/*
+ * 648 Mbps/lane is what the vendor actually drives on the front link --
+ * captured live from a working stock session (TKMIPI rxdev=1 txdev=1
+ * rx_rate=648 tx_rate=648). That is the imx179 FULL mode (3280x2464,
+ * op_pixel_clk 259.2 MHz), not the binned 1640x922/340 Mbps mode this port
+ * used to assume. Stream the front sensor at 3280x2464 to match.
+ */
+static unsigned int front_rate = 648;
+module_param(front_rate, uint, 0644);
+MODULE_PARM_DESC(front_rate, "front link rate, Mbps per lane");
+
+static unsigned int rear_rate = 1368;
+module_param(rear_rate, uint, 0644);
+MODULE_PARM_DESC(rear_rate, "rear link rate, Mbps per lane");
+
+/*
+ * The RX->TX pairing is latched when the TX is configured: re-pointing the
+ * mux afterwards leaves the new transmitter idle (HANDOFF §44a). So the
+ * pairing has to be a parameter, configured from scratch, not a poke.
+ */
+static unsigned int front_rx = 1, front_tx = 1;
+module_param(front_rx, uint, 0644);
+module_param(front_tx, uint, 0644);
+MODULE_PARM_DESC(front_tx, "which Easel TX the front link uses (0 or 1)");
+
+struct easel {
+	struct pci_dev *pdev;
+	void __iomem *cfg;	/* BAR2 window into Easel address space */
+	u32 window;		/* what the window currently targets */
+};
+
+/*
+ * Retarget BAR2 at a 32-bit-aligned region of Easel's address space. Returns
+ * the offset within BAR2 at which @addr can then be reached.
+ */
+static u32 easel_set_window(struct easel *easel, u32 base, u32 addr)
+{
+	struct pci_dev *pdev = easel->pdev;
+
+	if (easel->window != base) {
+		pci_write_config_dword(pdev, IATU_VIEWPORT, IATU_INBOUND | 1);
+		pci_write_config_dword(pdev, IATU_LWR_TARGET_ADDR, base);
+		pci_write_config_dword(pdev, IATU_UPPER_TARGET_ADDR, 0);
+		pci_write_config_dword(pdev, IATU_REGION_CTRL_1, 0);
+		pci_write_config_dword(pdev, IATU_REGION_CTRL_2,
+				       IATU_BAR_MODE |
+				       (EASEL_BAR_CONFIG << 8));
+		udelay(1);
+		easel->window = base;
+	}
+
+	return addr - base;
+}
+
+
+/*
+ * ---------------------------------------------------------------------------
+ * MIPI bypass, ported from downstream mnh-mipi.c
+ *
+ * Bypass = configure the RX host (from the sensor), the TX device (to the
+ * SoC), and the mux that wires one to the other. The IPU is not involved.
+ * ---------------------------------------------------------------------------
+ */
+
+#define EASEL_MIPI_TX0_BASE	0x04010000
+#define EASEL_MIPI_TX1_BASE	0x04011000
+#define EASEL_MIPI_RX0_BASE	0x04012000
+#define EASEL_MIPI_TOP		EASEL_MIPI_TOP_BASE
+#define EASEL_RX_STRIDE		0x1000
+#define EASEL_TX_STRIDE		0x1000
+
+/* MIPI RX (snps mipicsi_host) register offsets */
+#define RX_N_LANES		0x004
+#define RX_CSI2_RESETN		0x008
+#define RX_PHY_SHUTDOWNZ	0x040
+#define RX_DPHY_RSTZ		0x044
+#define RX_PHY_TEST_CTRL0	0x050
+#define RX_PHY_TEST_CTRL1	0x054
+#define RX_INT_MSK_PHY_FATAL	0x0e4
+#define RX_INT_MSK_PKT_FATAL	0x0f4
+#define RX_INT_MSK_FRAME_FATAL	0x104
+#define RX_INT_MSK_PHY		0x114
+#define RX_INT_MSK_PKT		0x124
+#define RX_INT_MSK_LINE		0x134
+#define RX_TESTCLK		BIT(1)
+#define RX_TESTEN		BIT(16)
+
+/* MIPI TX (snps mipicsi_device) register offsets */
+#define TX_CSI2_RESETN		0x004
+#define TX_INT_MASK_N_VPG	0x040
+#define TX_INT_MASK_N_IDI	0x048
+#define TX_PHY_RSTZ		0x0e0
+#define TX_PHY_IF_CFG		0x0e4
+#define TX_LPCLK_CTRL		0x0e8
+#define TX_PHY_STATUS		0x110
+#define TX_PHY0_TST_CTRL0	0x114
+#define TX_PHY0_TST_CTRL1	0x118
+#define TX_PHY_SHUTDOWNZ	BIT(0)
+#define TX_PHY_RSTZ_BIT		BIT(1)
+#define TX_PHY_ENABLECLK	BIT(2)
+#define TX_TESTCLK		BIT(1)
+#define TX_TESTEN		BIT(16)
+
+/* MIPI TOP register offsets */
+#define TOP_TX0_MODE		0x000
+#define TOP_TX0_DPHY_PLL_CNTRL	0x010
+#define TOP_TX0_DPHY_CONFIG	0x018
+#define TOP_TX1_MODE		0x028
+#define TOP_TX1_DPHY_PLL_CNTRL	0x038
+#define TOP_TX1_DPHY_CONFIG	0x040
+#define TOP_RX0_MODE		0x050
+#define TOP_RX0_DPHY_CONFIG	0x064
+#define TOP_RX1_MODE		0x074
+#define TOP_RX1_DPHY_CONFIG	0x078
+#define TOP_RX2_MODE		0x088
+#define TOP_RX2_DPHY_CONFIG	0x08c
+#define TOP_CSI_CLK_CTRL	0x104
+
+/* RXn_MODE / TXn_MODE fields */
+#define RX_MODE_IPU_EN		BIT(0)
+#define RX_MODE_BYP_TX0_EN	BIT(1)
+#define RX_MODE_VC_EN_SHIFT	7
+#define TX_MODE_FUNC		BIT(0)
+#define TX_MODE_BYP_SEL_SHIFT	1
+
+#define REF_FREQ_KHZ		25000
+
+static u32 easel_rx_base(unsigned int dev)
+{
+	return EASEL_MIPI_RX0_BASE + dev * EASEL_RX_STRIDE;
+}
+
+static u32 easel_tx_base(unsigned int dev)
+{
+	return EASEL_MIPI_TX0_BASE + dev * EASEL_TX_STRIDE;
+}
+
+static void easel_w(struct easel *easel, u32 addr, u32 val)
+{
+	u32 off = easel_set_window(easel, EASEL_PERIPH_BASE, addr);
+
+	writel(val, easel->cfg + off);
+}
+
+static u32 easel_r(struct easel *easel, u32 addr)
+{
+	u32 off = easel_set_window(easel, EASEL_PERIPH_BASE, addr);
+
+	return readl(easel->cfg + off);
+}
+
+static void easel_rmw(struct easel *easel, u32 addr, u32 mask, u32 val)
+{
+	easel_w(easel, addr, (easel_r(easel, addr) & ~mask) | (val & mask));
+}
+
+/*
+ * D-PHY test interface: 12-bit test code shifted in 4 bits then 8, then the
+ * data byte -- mnh_sm_mipi_{rx,tx}_dphy_write_gen3().
+ */
+static void easel_dphy_write(struct easel *easel, u32 base, u32 ctrl0,
+			     u32 ctrl1, u32 clk, u32 en, int cmd, int data)
+{
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, 0);
+	easel_rmw(easel, base + ctrl1, en, en);
+	easel_rmw(easel, base + ctrl0, clk, clk);
+	easel_rmw(easel, base + ctrl1, 0xff, 0);
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, 0);
+	easel_rmw(easel, base + ctrl1, 0xff, (cmd & 0xf00) >> 8);
+	easel_rmw(easel, base + ctrl0, clk, clk);
+
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, en);
+	easel_rmw(easel, base + ctrl0, clk, clk);
+	easel_rmw(easel, base + ctrl1, 0xff, cmd & 0xff);
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, 0);
+
+	easel_rmw(easel, base + ctrl1, 0xff, data & 0xff);
+	easel_rmw(easel, base + ctrl0, clk, clk);
+	udelay(1);
+}
+
+#define rx_dphy(e, d, c, v) \
+	easel_dphy_write(e, easel_rx_base(d), RX_PHY_TEST_CTRL0, \
+			 RX_PHY_TEST_CTRL1, RX_TESTCLK, RX_TESTEN, c, v)
+#define tx_dphy(e, d, c, v) \
+	easel_dphy_write(e, easel_tx_base(d), TX_PHY0_TST_CTRL0, \
+			 TX_PHY0_TST_CTRL1, TX_TESTCLK, TX_TESTEN, c, v)
+
+/*
+ * Same address phase as easel_dphy_write, then TESTDOUT (CTRL1[15:8])
+ * instead of a data write. Proves whether test-interface writes actually
+ * land -- with SCU MIPI_TESTCLKEN off they are silently dropped (§45), and
+ * the HS lane-driver enables at 0x304..0xB04 go through this interface.
+ */
+static u8 easel_dphy_read(struct easel *easel, u32 base, u32 ctrl0,
+			  u32 ctrl1, u32 clk, u32 en, int cmd)
+{
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, 0);
+	easel_rmw(easel, base + ctrl1, en, en);
+	easel_rmw(easel, base + ctrl0, clk, clk);
+	easel_rmw(easel, base + ctrl1, 0xff, 0);
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, 0);
+	easel_rmw(easel, base + ctrl1, 0xff, (cmd & 0xf00) >> 8);
+	easel_rmw(easel, base + ctrl0, clk, clk);
+
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, en);
+	easel_rmw(easel, base + ctrl0, clk, clk);
+	easel_rmw(easel, base + ctrl1, 0xff, cmd & 0xff);
+	easel_rmw(easel, base + ctrl0, clk, 0);
+	easel_rmw(easel, base + ctrl1, en, 0);
+	udelay(1);
+
+	return (easel_r(easel, base + ctrl1) >> 8) & 0xff;
+}
+
+#define tx_dphy_rd(e, d, c) \
+	easel_dphy_read(e, easel_tx_base(d), TX_PHY0_TST_CTRL0, \
+			TX_PHY0_TST_CTRL1, TX_TESTCLK, TX_TESTEN, c)
+
+/* freq_range_code per Mbps/lane -- mipi_rate_configs[], osc code is 0x1b6. */
+static const struct { u16 rate; u8 code; u16 osc; } easel_rates[] = {
+	{   80, 0x00, 0x1b6 }, {   90, 0x10, 0x1b6 }, {  100, 0x20, 0x1b6 }, {  110, 0x30, 0x1b6 },
+	{  120, 0x01, 0x1b6 }, {  130, 0x11, 0x1b6 }, {  140, 0x21, 0x1b6 }, {  150, 0x31, 0x1b6 },
+	{  160, 0x02, 0x1b6 }, {  170, 0x12, 0x1b6 }, {  180, 0x22, 0x1b6 }, {  190, 0x32, 0x1b6 },
+	{  205, 0x03, 0x1b6 }, {  220, 0x13, 0x1b6 }, {  235, 0x23, 0x1b6 }, {  250, 0x33, 0x1b6 },
+	{  275, 0x04, 0x1b6 }, {  300, 0x14, 0x1b6 }, {  325, 0x25, 0x1b6 }, {  350, 0x35, 0x1b6 },
+	{  400, 0x05, 0x1b6 }, {  450, 0x16, 0x1b6 }, {  500, 0x26, 0x1b6 }, {  550, 0x37, 0x1b6 },
+	{  600, 0x07, 0x1b6 }, {  650, 0x18, 0x1b6 }, {  700, 0x28, 0x1b6 }, {  750, 0x39, 0x1b6 },
+	{  800, 0x09, 0x1b6 }, {  850, 0x19, 0x1b6 }, {  900, 0x29, 0x1b6 }, {  950, 0x3a, 0x1b6 },
+	{ 1000, 0x0a, 0x1b6 }, { 1050, 0x1a, 0x1b6 }, { 1100, 0x2a, 0x1b6 }, { 1150, 0x3b, 0x1b6 },
+	{ 1200, 0x0b, 0x1b6 }, { 1250, 0x1b, 0x1b6 }, { 1300, 0x2b, 0x1b6 }, { 1350, 0x3c, 0x1b6 },
+	{ 1400, 0x0c, 0x1b6 }, { 1450, 0x1c, 0x1b6 }, { 1500, 0x2c, 0x1b6 }, { 1550, 0x3d, 0x10f },
+	{ 1600, 0x0d, 0x118 }, { 1650, 0x1d, 0x121 }, { 1700, 0x2e, 0x12a }, { 1750, 0x3e, 0x132 },
+	{ 1800, 0x0e, 0x13b }, { 1850, 0x1e, 0x144 }, { 1900, 0x2f, 0x14d }, { 1950, 0x3f, 0x155 },
+	{ 2000, 0x0f, 0x15e }, { 2050, 0x40, 0x167 }, { 2100, 0x41, 0x170 }, { 2150, 0x42, 0x178 },
+	{ 2200, 0x43, 0x181 }, { 2250, 0x44, 0x18a }, { 2300, 0x45, 0x193 }, { 2350, 0x46, 0x19b },
+	{ 2400, 0x47, 0x1a4 }, { 2450, 0x48, 0x1ad }, { 2500, 0x49, 0x1b6 },
+};
+#define EASEL_OSC_FREQ_CODE	0x1b6
+
+
+/*
+ * Vendor mipi_dev_ovr_cfgs[] (mnh-mipi.c:197). Per-rate D-PHY timing
+ * overrides plus PHY_STOP_WAIT_TIME. 0x5E and 0x64 are deliberately NOT
+ * written -- the vendor comments them out.
+ */
+struct easel_ovr {
+	u16 rate;
+	u8 r5a, r5b, r5c, r5d, r5f, r61, r62, r63, r65;
+	u8 wait_time;
+	bool use_ovrd;
+};
+
