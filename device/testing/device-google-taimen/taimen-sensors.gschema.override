# Auto-brightness. taimen has a real ambient light sensor -- the ALS half of
# qcom-smgr-prox-light -- and iio-sensor-proxy exposes it as
# HasAmbientLight=true with sane lux values.
#
# Both phosh (00_mobi.Phosh.gschema.override) and postmarketOS
# (00_postmarketos-base-ui-gnome.gschema.override) force ambient-enabled=false,
# because most mobile devices have no working ALS. That single key is what
# hides "Automatic Brightness" in Settings and stops gsd-power ever claiming
# the sensor. The upstream schema default is true.
#
# Overrides are applied in lexical filename order, so this must sort after the
# 00_ files. glib's apk trigger recompiles the schema cache on install.
[org.gnome.settings-daemon.plugins.power]
ambient-enabled=true
