+/*
+ * The AK8789 hall switch: a boolean, 0 clear and the sensor range when a
+ * magnet is close, the same shape as proximity. It reports on subscribe, so a
+ * raw read answers immediately.
+ *
+ * Not IIO_PROXIMITY, deliberately. iio-sensor-proxy publishes the first
+ * proximity device it finds, and this one has no PROXIMITY_NEAR_LEVEL, so
+ * offering it as one risks it shadowing the real prox/ALS part and taking
+ * call blanking with it.
+ */
+static const struct iio_chan_spec qcom_smgr_hall_iio_channels[] = {
+	QCOM_SMGR_INDEX_CHANNEL(0),
+	QCOM_SMGR_TIMESTAMP_CHANNEL(3)
+};
