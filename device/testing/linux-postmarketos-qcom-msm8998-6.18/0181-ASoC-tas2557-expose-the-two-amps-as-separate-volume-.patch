From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Wed, 26 Aug 2026 22:58:24 +0200
Subject: [PATCH] ASoC: tas2557: expose the two amps as separate volume
 controls

The board's two amps are not a stereo pair. One is the earpiece and one is
the loudspeaker, selected by which firmware configuration is loaded, and
only ever one of them is in use. The driver offered a single stereo control
covering both, and a UCM device can name a control but not a channel of
one, so both playback devices pointed at the same thing: changing the
loudspeaker volume changed the earpiece with it, and the slider a user was
moving was never the output they were listening to.

Add a per-amp control alongside the stereo one, which stays for a device
that really does drive both. Downstream reaches the same conclusion and
exposes exactly two, "Stereo LDAC Playback Volume" and "Stereo RDAC
Playback Volume".

Numbered rather than named, because which amp is the earpiece is a board
fact and belongs in the board's UCM, as the comment on the configuration
enum already says.

No TLV: this field's dB-per-step is not in the vendor driver either, and a
made-up scale is worse than none. It stays a raw 0-15 until someone has the
datasheet -- which also leaves the sound server rounding a 16-step control
onto a percentage slider, so a volume-down can reach zero and a small
volume-up rounds back to it.

Verified on the device: Speaker1=3 and Speaker2=12 set independently, with
the stereo control reading back 3,12.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 sound/soc/codecs/tas2557.c | 78 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 78 insertions(+)

diff --git a/sound/soc/codecs/tas2557.c b/sound/soc/codecs/tas2557.c
index 14d4e1d8790f..f11085ce6724 100644
--- a/sound/soc/codecs/tas2557.c
+++ b/sound/soc/codecs/tas2557.c
@@ -1116,6 +1116,77 @@ static int tas2557_gain_put(struct snd_kcontrol *kcontrol,
 	return changed;
 }
 
+/*
+ * The same gain, one amp at a time.
+ *
+ * The stereo control above moves both amps together, which is what a stereo
+ * speaker pair wants. This board is not that: the two amps are separate
+ * outputs -- one earpiece, one loudspeaker -- chosen by which firmware
+ * configuration is loaded, and only ever one of them is in use. A UCM device
+ * can name a control but not a channel of one, so with only the stereo
+ * control both of this board's playback devices point at the same thing, and
+ * changing the loudspeaker volume moves the earpiece with it.
+ *
+ * Downstream reaches the same conclusion and exposes exactly two, "Stereo
+ * LDAC Playback Volume" and "Stereo RDAC Playback Volume". Neither driver has
+ * dB-per-step for this field, so neither carries a TLV: the scale stays a raw
+ * 0-15 until someone has the datasheet.
+ */
+static int tas2557_amp_gain_get(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct tas2557 *tas = snd_soc_component_get_drvdata(c);
+	int idx = kcontrol->private_value;
+	int ret;
+	u8 v;
+
+	ret = tas2557_read(tas, idx, TAS2557_SPK_CTRL_REG, &v);
+	if (ret < 0)
+		return ret;
+
+	ucontrol->value.integer.value[0] = FIELD_GET(TAS2557_DAC_GAIN_MASK, v);
+
+	return 0;
+}
+
+static int tas2557_amp_gain_put(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct tas2557 *tas = snd_soc_component_get_drvdata(c);
+	int idx = kcontrol->private_value;
+	long want = ucontrol->value.integer.value[0];
+
+	if (want < 0 || want > TAS2557_DAC_GAIN_MAX)
+		return -EINVAL;
+
+	return tas2557_update_bits(tas, BIT(idx), TAS2557_SPK_CTRL_REG,
+				   TAS2557_DAC_GAIN_MASK,
+				   FIELD_PREP(TAS2557_DAC_GAIN_MASK, want));
+}
+
+static int tas2557_amp_gain_info(struct snd_kcontrol *kcontrol,
+				 struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = TAS2557_DAC_GAIN_MAX;
+
+	return 0;
+}
+
+#define TAS2557_AMP_GAIN(xname, xidx)					\
+	{								\
+		.iface		= SNDRV_CTL_ELEM_IFACE_MIXER,		\
+		.name		= xname,				\
+		.info		= tas2557_amp_gain_info,		\
+		.get		= tas2557_amp_gain_get,			\
+		.put		= tas2557_amp_gain_put,			\
+		.private_value	= (xidx),				\
+	}
+
 static const struct snd_kcontrol_new tas2557_controls[] = {
 	{
 		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
@@ -1127,6 +1198,13 @@ static const struct snd_kcontrol_new tas2557_controls[] = {
 	SOC_DOUBLE_EXT("Speaker Playback Volume", SND_SOC_NOPM, 0, 1,
 		       TAS2557_DAC_GAIN_MAX, 0,
 		       tas2557_gain_get, tas2557_gain_put),
+	/*
+	 * Numbered, not named: which amp is the earpiece and which the
+	 * loudspeaker is a board fact, and the board says so in its UCM. The
+	 * stereo control above stays for a device that really does drive both.
+	 */
+	TAS2557_AMP_GAIN("Speaker1 Playback Volume", 0),
+	TAS2557_AMP_GAIN("Speaker2 Playback Volume", 1),
 };
 
 /*
