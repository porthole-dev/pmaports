+/*
+ * milestone-2 TODO: 6.18's msm8998.dtsi carries no apc_cprh/cpufreq_hw
+ * nodes at all (no CPR calibration, no cpufreq-hw block) -- that whole
+ * subsystem was never ported here, unlike our 6.0 base. Re-add once
+ * apc_cprh/cpufreq_hw land in msm8998.dtsi upstream or get hand-ported.
+ *
+ * &apc_cprh {
+ *	status = "okay";
+ * };
+ *
+ * &cpufreq_hw {
+ *	status = "okay";
+ * };
+ */
+
+&pm8005_lsid1 {
+	pm8005-regulators {
+		compatible = "qcom,pm8005-regulators";
+
+		vdd_s1-supply = <&vph_pwr>;
+
+		pm8005_s1: s1 {
+			regulator-name = "vdd_gfx";
+			regulator-min-microvolt = <524000>;
+			regulator-max-microvolt = <1100000>;
+			regulator-enable-ramp-delay = <500>;
+
+			/*
+			 * The GPU node consumes this as vdd-supply (via the
+			 * OPP table) now. Kept always-on regardless: the GPU
+			 * enable path only regulator_enable()s it, and losing
+			 * the rail across a runtime suspend while debugging
+			 * GPU issues is a variable nobody needs.
+			 */
+			regulator-always-on;
+		};
+	};
+};
+
+&qusb2phy {
+	status = "okay";
+
+	vdda-pll-supply = <&vreg_l12a_1p8>;
+	vdda-phy-dpdm-supply = <&vreg_l24a_3p075>;
+};
+
+&remoteproc_adsp {
+	status = "okay";
+
+	firmware-name = "qcom/msm8998/wahoo/adsp.mbn";
+};
+
+&remoteproc_mss {
+	/*
+	 * Re-enabled on top of the MPSS metadata carveout fix. Before that, this
+	 * bootlooped the phone: the reset left nothing in pstore even though
+	 * ramoops works here, i.e. it came from below the kernel, which is what
+	 * an XPU violation looks like - and handing the Q6 dynamically allocated
+	 * metadata is exactly the documented way to cause one.
+	 *
+	 * If it bootloops again, this node is the first thing to drop, and the
+	 * carveout backport is then disproven rather than merely unhelpful.
+	 */
+	status = "okay";
+
+	firmware-name = "qcom/msm8998/wahoo/mba.mbn",
+			"qcom/msm8998/wahoo/modem.mbn";
+};
+
+&remoteproc_slpi {
+	status = "okay";
+
+	firmware-name = "qcom/msm8998/wahoo/slpi_v2.mbn";
+};
