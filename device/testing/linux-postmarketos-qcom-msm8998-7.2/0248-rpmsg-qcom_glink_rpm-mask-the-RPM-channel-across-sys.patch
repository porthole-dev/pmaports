From 1ffa2d5234391c999bfd16cd48e96cf2e4779e43 Mon Sep 17 00:00:00 2001
From: jert <joseph96tb@gmail.com>
Date: Sat, 19 Sep 2026 23:39:31 +0200
Subject: [PATCH] rpmsg: qcom_glink_rpm: mask the RPM channel across system
 suspend

The interrupt is requested IRQF_NO_SUSPEND because RPM traffic has to keep
working through the noirq phases: the regulators, clocks, power domains and
interconnect providers all sit under rpm_requests, a child of this node, and
vote from their own noirq callbacks.

Once they are done, nothing on the application processor has anything left to
say to the RPM, and a channel left unmasked is only a wakeup source. Measured
on msm8998, glink-rpm fires about 237 times across a 31 s s2idle, each one
pulling a CPU back out of idle for a reply nobody is waiting for.

Downstream masks it for exactly this reason: msm_rpm_enter_sleep() calls
glink_rpm_mask_rx_interrupt() before a cluster enters a level marked
qcom,notify-rpm.

noirq rather than syscore, for two reasons. syscore_suspend() is never reached
for suspend-to-idle at all -- kernel/power/suspend.c goes from s2idle_loop()
straight to Platform_wake. And because this node is the parent of rpm_requests,
the noirq phases order it correctly for free: children suspend before their
parent and resume after it, so the mask lands once every RPM consumer has
finished and lifts before any of them runs again.

Assisted-by: Claude
---
 drivers/rpmsg/qcom_glink_rpm.c | 49 ++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/drivers/rpmsg/qcom_glink_rpm.c b/drivers/rpmsg/qcom_glink_rpm.c
index e3ba2c63a5fc..796aa7b9a8c8 100644
--- a/drivers/rpmsg/qcom_glink_rpm.c
+++ b/drivers/rpmsg/qcom_glink_rpm.c
@@ -13,6 +13,7 @@
 #include <linux/of_address.h>
 #include <linux/of_irq.h>
 #include <linux/platform_device.h>
+#include <linux/pm.h>
 #include <linux/regmap.h>
 #include <linux/rpmsg.h>
 #include <linux/slab.h>
@@ -373,6 +374,53 @@ static void glink_rpm_remove(struct platform_device *pdev)
 	mbox_free_channel(rpm->mbox_chan);
 }
 
+/*
+ * Mask the RPM channel across system suspend.
+ *
+ * The interrupt is requested IRQF_NO_SUSPEND because RPM traffic has to keep
+ * working through the noirq phases: the regulators, clocks, power domains and
+ * interconnect providers all sit under rpm_requests, a child of this node, and
+ * vote from their own noirq callbacks.  Once they are done, nothing on the
+ * application processor has anything left to say to the RPM, and a channel
+ * left unmasked is only a wakeup source.  Measured on msm8998, glink-rpm fires
+ * about 237 times across a 31 s s2idle, each one pulling a CPU back out of
+ * idle for a reply nobody is waiting for.
+ *
+ * Downstream masks it for exactly this reason: msm_rpm_enter_sleep() calls
+ * glink_rpm_mask_rx_interrupt() before a cluster enters a level marked
+ * qcom,notify-rpm.
+ *
+ * noirq rather than syscore, for two reasons.  syscore_suspend() is never
+ * reached for suspend-to-idle at all -- kernel/power/suspend.c goes from
+ * s2idle_loop() straight to Platform_wake.  And because this node is the
+ * parent of rpm_requests, the noirq phases order it correctly for free:
+ * children suspend before their parent and resume after it, so the mask lands
+ * once every RPM consumer has finished and lifts before any of them runs
+ * again.
+ */
+static int qcom_glink_rpm_suspend_noirq(struct device *dev)
+{
+	struct glink_rpm *rpm = dev_get_drvdata(dev);
+
+	disable_irq(rpm->irq);
+
+	return 0;
+}
+
+static int qcom_glink_rpm_resume_noirq(struct device *dev)
+{
+	struct glink_rpm *rpm = dev_get_drvdata(dev);
+
+	enable_irq(rpm->irq);
+
+	return 0;
+}
+
+static const struct dev_pm_ops qcom_glink_rpm_pm_ops = {
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(qcom_glink_rpm_suspend_noirq,
+				  qcom_glink_rpm_resume_noirq)
+};
+
 static const struct of_device_id glink_rpm_of_match[] = {
 	{ .compatible = "qcom,glink-rpm" },
 	{}
@@ -385,6 +433,7 @@ static struct platform_driver glink_rpm_driver = {
 	.driver = {
 		.name = "qcom_glink_rpm",
 		.of_match_table = glink_rpm_of_match,
+		.pm = pm_sleep_ptr(&qcom_glink_rpm_pm_ops),
 	},
 };
 
