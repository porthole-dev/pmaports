+/*
+ * Board wiring (factory DTBO + HANDOFF §41): rear imx362 -> RX0 -> TX0 ->
+ * CSIPHY0, front imx179 -> RX1 -> TX1 -> CSIPHY1. Rates are Mbps per lane,
+ * i.e. twice the sensor's V4L2 link frequency: imx179 170 MHz -> 340,
+ * imx362 685 MHz -> 1370.
+ */
+/* Both links by default: front worked 2026-08-04, rear needs RX0->TX0 armed
+ * at probe just the same (a rear test on a bypass=0x1 boot cost an hour). */
+static unsigned int bypass = 0x3;
+module_param(bypass, uint, 0644);
+MODULE_PARM_DESC(bypass, "links to put in MIPI bypass: bit0 front (RX1->TX1), bit1 rear (RX0->TX0)");
+
+/*
+ * 648 Mbps/lane is what the vendor actually drives on the front link --
+ * captured live from a working stock session (TKMIPI rxdev=1 txdev=1
+ * rx_rate=648 tx_rate=648). That is the imx179 FULL mode (3280x2464,
+ * op_pixel_clk 259.2 MHz), not the binned 1640x922/340 Mbps mode this port
+ * used to assume. Stream the front sensor at 3280x2464 to match.
+ */
+static unsigned int front_rate = 648;
+module_param(front_rate, uint, 0644);
+MODULE_PARM_DESC(front_rate, "front link rate, Mbps per lane");
+
+static unsigned int rear_rate = 1368;
+module_param(rear_rate, uint, 0644);
+MODULE_PARM_DESC(rear_rate, "rear link rate, Mbps per lane");
+
+/*
+ * The RX->TX pairing is latched when the TX is configured: re-pointing the
+ * mux afterwards leaves the new transmitter idle (HANDOFF §44a). So the
+ * pairing has to be a parameter, configured from scratch, not a poke.
+ */
+static unsigned int front_rx = 1, front_tx = 1;
+module_param(front_rx, uint, 0644);
+module_param(front_tx, uint, 0644);
+MODULE_PARM_DESC(front_tx, "which Easel TX the front link uses (0 or 1)");
+
+struct easel {
+	struct pci_dev *pdev;
+	void __iomem *cfg;	/* BAR2 window into Easel address space */
+	u32 window;		/* what the window currently targets */
+};
+
+/*
+ * Retarget BAR2 at a 32-bit-aligned region of Easel's address space. Returns
+ * the offset within BAR2 at which @addr can then be reached.
+ */
+static u32 easel_set_window(struct easel *easel, u32 base, u32 addr)
+{
+	struct pci_dev *pdev = easel->pdev;
+
+	if (easel->window != base) {
+		pci_write_config_dword(pdev, IATU_VIEWPORT, IATU_INBOUND | 1);
+		pci_write_config_dword(pdev, IATU_LWR_TARGET_ADDR, base);
+		pci_write_config_dword(pdev, IATU_UPPER_TARGET_ADDR, 0);
+		pci_write_config_dword(pdev, IATU_REGION_CTRL_1, 0);
+		pci_write_config_dword(pdev, IATU_REGION_CTRL_2,
+				       IATU_BAR_MODE |
+				       (EASEL_BAR_CONFIG << 8));
+		udelay(1);
+		easel->window = base;
+	}
+
+	return addr - base;
+}
