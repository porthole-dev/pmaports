# Reference: <https://postmarketos.org/devicepkg>
maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=device-google-taimen
pkgdesc="Google Pixel 2 XL"
pkgver=1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# soc-qcom-qbootctl marks each boot successful in the Android A/B interface.
# Without it the bootloader decrements the slot's retry counter every boot
# and eventually refuses the slot, even though pmOS booted fine. Its -openrc
# subpackage comes in on its own via install_if, exactly as rmtfs's does, and
# runs `rc-update add qbootctl default`; on systemd the unit is already
# unconditionally enabled by postmarketos-base-systemd's 90-base.preset
# ("enable qbootctl.service"). So do NOT hand-symlink either init here or in
# the post-install, and do NOT list the -openrc subpackage here.
depends="
	alsa-ucm-conf
	linux-pam
	mkbootimg
	neard
	postmarketos-base
	sns-reg
	soc-qcom-msm8998
	soc-qcom-qbootctl
"
# post-upgrade is a symlink to post-install (the pmaports idiom, cf.
# postmarketos-base-ui-cage). apk runs post-INSTALL only on a fresh install and
# post-UPGRADE on an upgrade, so with post-install alone the /etc/environment
# append and dconf update below would be silently skipped on every pkgrel
# bump -- apk still exits 0. Both are idempotent (marker-guarded / dconf
# update itself is a no-op when nothing changed), so re-running on every
# upgrade is harmless and is what actually keeps them applied when this
# package or its dconf db drop-ins change.
#
# Service enablement is NOT done here any more (P1-12): taimen.preset covers
# systemd for taimen-modem-bringup, sns-reg, taimen-rescue and neard, and the
# openrc() subpackage below (install_if-gated, same shape as qbootctl's)
# covers OpenRC for all four -- see that subpackage's own post-install.
# Neither post-install symlinks anything any more.
install="$pkgname.post-install $pkgname.post-upgrade"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.mainline.conf
	modules-initfs.mainline
	taimen-modem-bringup
	taimen-modem-bringup.initd
	taimen-modem-bringup.service
	ath-regd-override.conf
	taimen.preset
	swclock-wait-for-rtc.conf
	groups.conf
	sns-reg-registry.conf
	taimen-dconf-profile
	taimen-dconf-sensors
	taimen-dconf-greeter
	taimen-proximity.rules
	taimen-accel-matrix.rules
	phosh-desktop-env.conf
	taimen-suspend-guard.conf
	ucm/HiFi.conf
	ucm/taimen.conf
	iio-sensor-proxy-wait-for-ssc.conf
	neard-install.conf
	taimen-nfc-toggle
	taimen-nfc-toggle.desktop
	taimen-sns-reg-prepare
	taimen-sensors-modules.conf
	taimen-crash-reboot.conf
	taimen-rescue.py
	taimen-rescue.service
	taimen-powerkey.conf
	taimen-watchdog.conf
	taimen-ambient-nudge
	taimen-ambient-nudge.service
	taimen-perf.rules
	taimen-perf.conf
	taimen-gsk.conf
	taimen-display-panel.json
	taimen-gmobile-overlay.conf
	taimen-uclamp-session
	taimen-uclamp-session.service
	sns-reg.confd
	iio-sensor-proxy.confd
	taimen-rescue.initd
	taimen-ambient-nudge.desktop
	taimen-uclamp-session.desktop
	taimen-suspend-guard-elogind.conf
"
subpackages="
	$pkgname-kernel-mainline:kernel_mainline
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-openrc:openrc
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# WLAN/modem bring-up ordering. This used to live in /etc/local.d on the
	# device only, which meant every clean install silently came up with no
	# working modem. Ship it, and ship both init wrappers: the .service is
	# always in the main package (inert on OpenRC), and the initd is amoved
	# into the openrc() subpackage below so it only lands on OpenRC systems
	# in the first place, rather than shipping inert on systemd.
	install -Dm755 "$srcdir"/taimen-modem-bringup \
		"$pkgdir"/usr/bin/taimen-modem-bringup
	install -Dm755 "$srcdir"/taimen-modem-bringup.initd \
		"$pkgdir"/etc/init.d/taimen-modem-bringup
	install -Dm644 "$srcdir"/taimen-modem-bringup.service \
		"$pkgdir"/usr/lib/systemd/system/taimen-modem-bringup.service

	# WiFi regulatory. The board data pins this device to the US, which disables
	# 2.4 ch 12-13 and the whole ETSI 5 GHz midband; see the conf file's header.
	# This module param is ALL that is needed: it opens the permissive world SKU
	# channel superset, and cfg80211 then adopts the actual country from the AP
	# beacon country IE by itself -- verified in dmesg:
	#   ath: regdomain 0x817c dynamically updated by country element
	#   ath: Country alpha2 being used: IT
	# taimen-wifi-country (the SIM-MCC helper) was deleted in pkgrel 18: it had
	# never run at all (it exits early without `iw`, which was never a dependency),
	# and once `iw` was installed it did nothing except burn ~11 s of boot waiting
	# for a modem operator id that a PIN-locked SIM never provides.
	install -Dm644 "$srcdir"/ath-regd-override.conf \
		"$pkgdir"/etc/modprobe.d/ath-regd-override.conf

	# systemd preset policy -- see the file's header. Without this,
	# `systemctl preset-all` obeys pmOS's 99-default.preset "disable *" and
	# the modem/sns-reg/rescue/neard units never get their .wants symlink
	# created in the first place, so the device boots with no modem. Must
	# sort before 99-default.preset.
	install -Dm644 "$srcdir"/taimen.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/91-taimen.preset

	# swclock-offset-boot loses a probe race with rtc-pm8xxx, so the software
	# clock is never restored and the machine boots days behind; NTP then steps
	# the clock and takes NetworkManager's DHCP lease (and DNS) down with it.
	# See the drop-in's header.
	install -Dm644 "$srcdir"/swclock-wait-for-rtc.conf \
		"$pkgdir"/usr/lib/systemd/system/swclock-offset-boot.service.d/10-wait-for-rtc.conf

	# Sensors. Every sensor sits behind the SLPI island and is reachable only
	# through the SSC Sensor Manager, which will not publish its QMI service
	# until the AP answers its registry reads -- see the prepare script's
	# header. groups.conf maps each registry group to a byte range of
	# /persist/sensors/sns.reg and was extracted from the stock
	# /vendor/bin/sensors.qcom by tools/tk-sns-groups.py.
	install -Dm644 "$srcdir"/groups.conf "$pkgdir"/etc/sns-reg.d/groups.conf
	install -Dm755 "$srcdir"/taimen-sns-reg-prepare \
		"$pkgdir"/usr/bin/taimen-sns-reg-prepare
	install -Dm644 "$srcdir"/sns-reg-registry.conf \
		"$pkgdir"/usr/lib/systemd/system/sns-reg.service.d/10-registry.conf
	install -Dm644 "$srcdir"/taimen-sensors-modules.conf \
		"$pkgdir"/usr/lib/modules-load.d/taimen-sensors.conf

	# OpenRC counterpart of the ExecStartPre drop-in above: sns-reg (main/sns-reg)
	# now ships an /etc/init.d/sns-reg, and this conf.d start_pre() hook makes
	# it call the same prepare script -- see the file's header for how the
	# hook mechanism works.
	install -Dm644 "$srcdir"/sns-reg.confd "$pkgdir"/etc/conf.d/sns-reg

	# Making the sensors reachable from the SHELL, which is a separate problem
	# from making them work. Each file's header says what is broken without it;
	# in short: gsd-power never claims the ALS unless ambient-enabled is true
	# and neither phosh nor postmarketOS will let a gschema override make it
	# true, proximity is refused without a udev property, and iio-sensor-proxy
	# races the SSC sensors at boot. dconf update runs from the post-install.
	install -Dm644 "$srcdir"/taimen-dconf-profile "$pkgdir"/etc/dconf/profile/user
	install -Dm644 "$srcdir"/taimen-dconf-sensors \
		"$pkgdir"/etc/dconf/db/local.d/01-taimen-sensors

	# Land the greeter on phosh instead of the unstartable gnome session --
	# see taimen-dconf-greeter for what that costs when it is not set.
	install -Dm644 "$srcdir"/taimen-dconf-greeter \
		"$pkgdir"/etc/dconf/db/local.d/02-taimen-greeter
	install -Dm644 "$srcdir"/taimen-proximity.rules \
		"$pkgdir"/usr/lib/udev/rules.d/99-taimen-proximity.rules
	install -Dm644 "$srcdir"/taimen-accel-matrix.rules \
		"$pkgdir"/usr/lib/udev/rules.d/99-taimen-accel-matrix.rules

	# XDG_CURRENT_DESKTOP -- see the file's header. Without it there is no
	# Settings app on the device at all.
	install -Dm644 "$srcdir"/phosh-desktop-env.conf \
		"$pkgdir"/usr/lib/environment.d/60-phosh-desktop.conf

	# Suspend hangs the SoC via ipa -- see the file's header. It goes on
	# systemd-suspend.service and NOT on suspend.target: the stock target is
	# ordered After= the service, so the service suspends the machine before
	# the target's assertions are ever evaluated. On suspend.target this file
	# was decorative from 2026-07-31 to 2026-08-02 (PLAN-daily-driver-v2.md
	# 6.5a). suspend-then-hibernate reaches the same suspend path so it gets
	# the same guard; plain hibernate cannot work here (no swap-to-disk).
	install -Dm644 "$srcdir"/taimen-suspend-guard.conf \
		"$pkgdir"/usr/lib/systemd/system/systemd-suspend.service.d/10-taimen-broken.conf
	install -Dm644 "$srcdir"/taimen-suspend-guard.conf \
		"$pkgdir"/usr/lib/systemd/system/systemd-suspend-then-hibernate.service.d/10-taimen-broken.conf
	# elogind counterpart -- see the file's own header for why this is a
	# static AllowSuspend=no rather than the same arm/disarm gate.
	install -Dm644 "$srcdir"/taimen-suspend-guard-elogind.conf \
		"$pkgdir"/etc/elogind/sleep.conf.d/10-taimen-broken.conf

	# PID 1 seatbelt + the PAM-free way back in when PID 1 freezes. Both files'
	# headers explain the failure they exist for. The rescue channel binds the
	# USB-gadget address ONLY -- it is an unauthenticated root shell and must
	# never be reachable over WiFi or the modem.
	install -Dm644 "$srcdir"/taimen-crash-reboot.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/10-taimen-crash.conf
	install -Dm755 "$srcdir"/taimen-rescue.py \
		"$pkgdir"/usr/bin/taimen-rescue.py
	install -Dm644 "$srcdir"/taimen-rescue.service \
		"$pkgdir"/usr/lib/systemd/system/taimen-rescue.service
	install -Dm755 "$srcdir"/taimen-rescue.initd \
		"$pkgdir"/etc/init.d/taimen-rescue

	# Long power-press -> poweroff when the shell is dead. See the file's header,
	# including what it does NOT save you from.
	install -Dm644 "$srcdir"/taimen-powerkey.conf \
		"$pkgdir"/usr/lib/systemd/logind.conf.d/10-taimen-powerkey.conf
	# elogind (the OpenRC-path logind) uses the exact same [Login] directive
	# and drop-in convention, just under its own /etc/elogind/ tree -- see
	# the elogind package's own shipped logind.conf.d/10-elogind.conf for
	# confirmation. Same file, second destination.
	install -Dm644 "$srcdir"/taimen-powerkey.conf \
		"$pkgdir"/etc/elogind/logind.conf.d/10-taimen-powerkey.conf
	install -Dm644 "$srcdir"/taimen-watchdog.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/10-taimen-watchdog.conf
	install -Dm755 "$srcdir"/taimen-ambient-nudge \
		"$pkgdir"/usr/libexec/taimen-ambient-nudge
	install -Dm644 "$srcdir"/taimen-perf.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-taimen-perf.rules
	install -Dm644 "$srcdir"/taimen-perf.conf \
		"$pkgdir"/usr/lib/tmpfiles.d/taimen-perf.conf
	install -Dm644 "$srcdir"/taimen-gsk.conf \
		"$pkgdir"/usr/lib/environment.d/60-taimen-gsk.conf

	# Rounded display corners. gmobile (linked into phoc/phosh) ships no
	# panel data for "google,taimen" -- see taimen-gmobile-overlay.conf's
	# header for how that was confirmed and why an environment.d
	# G_RESOURCE_OVERLAYS is the only override point that exists. The JSON
	# goes under the overlay's real directory, mirroring gmobile's resource
	# path minus the prefix consumed by the overlay.
	install -Dm644 "$srcdir"/taimen-display-panel.json \
		"$pkgdir"/usr/share/taimen-gmobile-overlay/display-panels/google,taimen.json
	install -Dm644 "$srcdir"/taimen-gmobile-overlay.conf \
		"$pkgdir"/usr/lib/environment.d/60-taimen-gmobile-overlay.conf

	install -Dm644 "$srcdir"/taimen-ambient-nudge.service \
		"$pkgdir"/usr/lib/systemd/user/taimen-ambient-nudge.service

	# Userspace half of the UI-stutter fix (kernel half: CONFIG_UCLAMP_TASK{,_GROUP}
	# in linux-postmarketos-qcom-msm8998). This is the SECOND mechanism: the
	# first (cgroup v2 cpu.uclamp.min on user-<uid>.slice, plus a
	# user@.service.d Delegate=cpu drop-in) shipped in r38 and was confirmed
	# broken on hardware -- this device's systemd 261.2 has cpu-controller
	# support compiled out entirely (`strings /usr/lib/systemd/systemd` has
	# zero occurrences of CPUAccounting/CPUWeight/cpu.weight/cpu.uclamp), so
	# PID 1 can never push "cpu" into cgroup.subtree_control no matter what
	# Delegate= says, and cpu.uclamp.min never exists. The drop-in
	# (taimen-user-cpu-delegate.conf) is deleted, not kept: dead config that
	# implies a working feature is worse than none.
	#
	# This script now calls sched_setattr(2) directly (per-task uclamp,
	# CONFIG_UCLAMP_TASK -- needs neither systemd nor the cgroup cpu
	# controller) against every thread of phoc and phosh by process name.
	# See the script's own header for the full mechanism, the arm64 syscall
	# number, the permission-check trace through this kernel's
	# kernel/sched/core.c, why every thread (not just the main one) is set,
	# why 25% was chosen, and why it fails loudly (journaled, unit left
	# FAILED) instead of silently no-op'ing.
	install -Dm755 "$srcdir"/taimen-uclamp-session \
		"$pkgdir"/usr/libexec/taimen-uclamp-session
	install -Dm644 "$srcdir"/taimen-uclamp-session.service \
		"$pkgdir"/usr/lib/systemd/user/taimen-uclamp-session.service

	# A system preset cannot enable a USER unit, and post-install only makes
	# system symlinks -- so this shipped symlink IS the enablement. Packaged
	# files survive `systemctl preset-all`; generated ones do not.
	install -dm755 "$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants
	ln -sf ../taimen-ambient-nudge.service \
		"$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants/taimen-ambient-nudge.service
	ln -sf ../taimen-uclamp-session.service \
		"$pkgdir"/usr/lib/systemd/user/graphical-session.target.wants/taimen-uclamp-session.service

	# OpenRC counterparts -- see each .desktop file's header for why XDG
	# autostart is the right mechanism here (no systemd --user to hang a
	# graphical-session.target unit off of) and why they are shipped
	# unconditionally with an /run/systemd/system guard in their Exec=.
	install -Dm644 "$srcdir"/taimen-ambient-nudge.desktop \
		"$pkgdir"/etc/xdg/autostart/taimen-ambient-nudge.desktop
	install -Dm644 "$srcdir"/taimen-uclamp-session.desktop \
		"$pkgdir"/etc/xdg/autostart/taimen-uclamp-session.desktop

	install -Dm644 "$srcdir"/iio-sensor-proxy-wait-for-ssc.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-wait-for-ssc.conf

	# OpenRC counterpart of the ExecStartPre drop-in above -- see the file's
	# header for the same mechanism used for sns-reg.confd. Enablement is not
	# this package's job: postmarketos-base-ui-gnome's openrc post-install
	# already does `rc-update add iio-sensor-proxy default`.
	install -Dm644 "$srcdir"/iio-sensor-proxy.confd \
		"$pkgdir"/etc/conf.d/iio-sensor-proxy

	# ALSA use case manager. Without this the card has 1243 raw mixer
	# controls and nothing can tell which one is "volume", so the shell shows
	# a dummy output and routing has to be applied by hand with amixer and
	# does not survive a reboot. With it, PulseAudio publishes
	# HiFi__Speaker__sink and HiFi__Mic__source and the volume controls work.
	#
	# alsa-lib looks this up as ucm2/conf.d/$CardDriver/$CardLongName.conf --
	# msm8998 and Google-Pixel-2-XL respectively, both of which come from the
	# card and neither of which is the card *id* (GooglePixel2XL).
	install -Dm644 -t "$pkgdir"/usr/share/alsa/ucm2/Google/taimen \
		"$srcdir"/HiFi.conf \
		"$srcdir"/taimen.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/msm8998
	ln -s /usr/share/alsa/ucm2/Google/taimen/taimen.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/msm8998/Google-Pixel-2-XL.conf

	# NFC. The PN553 works and neard drives it, but the Alpine package cannot
	# start itself -- see the drop-in's header.
	install -Dm644 "$srcdir"/neard-install.conf \
		"$pkgdir"/usr/lib/systemd/system/neard.service.d/10-install.conf

	# There is no NFC control anywhere in phosh or GNOME Settings -- no
	# panel, no quick setting -- and phosh's quick settings are not
	# user-extensible without writing a plugin, so the hardware was only
	# reachable from a terminal. This is a launcher, which is the one
	# extension point that does exist. No polkit rule is needed: neard's
	# D-Bus policy already lets a session user set Powered.
	install -Dm755 "$srcdir"/taimen-nfc-toggle \
		"$pkgdir"/usr/bin/taimen-nfc-toggle
	install -Dm644 "$srcdir"/taimen-nfc-toggle.desktop \
		"$pkgdir"/usr/share/applications/taimen-nfc-toggle.desktop
}

openrc() {
	pkgdesc="OpenRC service enablement (taimen-modem-bringup, sns-reg, taimen-rescue, neard)"
	# Pulled in only on an OpenRC system, exactly like soc-qcom's
	# qbootctl_openrc()/modem_openrc(). The systemd side of the same units
	# is taimen.preset, not a subpackage -- presets need no install_if gate
	# because `systemctl preset` is a harmless no-op when systemd is not
	# the running init.
	#
	# neard: main/neard-openrc (0.20-r0, origin "neard") exists and ships
	# an OpenRC init script -- confirmed against the APKINDEX itself, not
	# against a downloaded apk cache, which is what led an earlier pass to
	# wrongly conclude no such subpackage exists. Its own install_if
	# ("openrc neard=0.20-r0") pulls it in automatically once neard,
	# already a top-level depends= above, is present, so this subpackage
	# only needs to `rc-update add` it below.
	#
	# sns-reg's own /etc/init.d/sns-reg comes from the sns-reg aport, not
	# from this package, so it cannot be amoved in -- it is guaranteed to
	# exist by the hard `sns-reg` depends= below instead.
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	# install_if is not a dependency edge, so without an explicit depends=
	# apk can run this post-install before sns-reg's init script exists and
	# `rc-update add sns-reg default` fails (the script has no `set -e`, so
	# it would keep going and apk would just warn on exit). Declaring our
	# own depends= here drops abuild's automatic "$pkgname=$pkgver-r$pkgrel"
	# dependency on the parent, so that has to be listed explicitly too.
	# taimen-modem-bringup and taimen-rescue need no such guarantee any
	# more: amove below moves their init scripts into this subpackage, so
	# they exist by construction before this post-install can run.
	depends="$pkgname=$pkgver-r$pkgrel openrc sns-reg"
	amove etc/init.d/taimen-modem-bringup etc/init.d/taimen-rescue
}

kernel_mainline() {
	pkgdesc="Close to mainline kernel"
	# The -6.18 aport, not the 6.0 one. Both exist in pmaports and both build
	# from this project's tree, so naming the 6.0 package here installed it
	# into the rootfs, gave it ownership of /boot/vmlinuz, and left every
	# 6.18 package build unable to place its kernel -- the device booted
	# whatever the 6.0-named package last contained.
	#
	# soc-qcom-msm8998 moved to the top-level depends= (it is a device
	# runtime dependency, not a kernel-specific one) -- see that depends=
	# block's comment.
	depends="linux-postmarketos-qcom-msm8998-6.18"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

nonfree_firmware() {
	pkgdesc="Firmware for modem, GPU zap shader, WiFi, Bluetooth, ADSP and SLPI"
	# pd-mapper and tqftpserv used to be listed here explicitly. Both are now
	# transitively pulled in through the top-level soc-qcom-msm8998 depend:
	# soc-qcom-msm8998 -> soc-qcom-pd-mapper -> pd-mapper, and
	# soc-qcom-msm8998 -> soc-qcom -> tqftpserv. Listing them again here
	# would be redundant, so they were dropped.
	#
	# qcom-diag is NOT covered by that chain -- soc-qcom-msm8998 only pulls
	# qcom-diag in through its own nonfree_firmware subpackage, which nothing
	# here depends on -- so it stays explicit, and so does rmtfs, which isn't
	# reachable from soc-qcom or soc-qcom-msm8998 at all. Both are required
	# before the modem will stay up.
	#
	# Do NOT ship units for these here. rmtfs-systemd and qcom-diag-systemd
	# already own /usr/lib/systemd/system/{rmtfs,diag-router}.service and are
	# pulled in automatically by install_if="systemd <pkg>", so adding our own
	# copies just makes apk fail with "trying to overwrite ... owned by".
	# Upstream's rmtfs.service already runs exactly "rmtfs -r -P -s".
	depends="
		firmware-google-taimen
		qcom-diag
		rmtfs
	"
	mkdir "$subpkgdir"
}

