From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Tue, 25 Aug 2026 20:58:08 +0200
Subject: [PATCH] irqchip/qcom-mpm: hand vMPM to RPM from system suspend on
 PC-mode firmware

The only path that notifies RPM to latch vMPM into the hardware MPM is
mpm_pd_power_off(), reachable exclusively as a genpd parent of the CPU
cluster domains -- i.e. only when the PSCI firmware supports OSI mode.
On SoCs whose firmware implements Platform Coordinated mode only (the
msm8998 TZ rejects SET_SUSPEND_MODE with -3 in both directions), no CPU
PM domain topology can exist, the genpd is never powered off, and there
is no way to arm the wakeup pins for a system-level power collapse.

Add a suspend-based mode, selected by omitting "#power-domain-cells"
from the MPM node (the property is already optional in the binding):

 - the genpd provider is not registered;
 - the noirq suspend phase performs the power_off sequence instead:
   write an infinite (~0ULL) deadline into the vMPM timer words, clear
   STATUS, ring the RPM doorbell.  This runs after suspend_device_irqs()
   has masked every non-wake interrupt (IRQCHIP_MASK_ON_SUSPEND), so
   the vMPM ENABLE words at that point contain exactly the wake set --
   the same trim the downstream driver performs by writing its
   dedicated wake_irq array on suspend entry;
 - nothing runs on resume: RPM restores APSS context and replays the
   pending pin through the summary interrupt, exactly as in genpd mode;
 - the summary interrupt handler re-arms vMPM while a suspend is in
   flight, so an intermediate s2idle wake that goes back to sleep does
   not collapse with a returned, un-armed vMPM.

The vMPM timer words were previously never written at all (the probe
zeroes only ENABLE..STATUS, which start at word 2), leaving whatever
the SRAM held as the wakeup deadline.  ~0ULL is the explicit "no timer
wake" value the downstream suspend path uses; hardware wake events
(PMIC RTC alarm and power key via the SPMI summary pin) do not need it.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/irqchip/irq-qcom-mpm.c | 140 ++++++++++++++++++++++++++++-----
 1 file changed, 122 insertions(+), 18 deletions(-)

diff --git a/drivers/irqchip/irq-qcom-mpm.c b/drivers/irqchip/irq-qcom-mpm.c
index 181320528a47..091ef2770d0c 100644
--- a/drivers/irqchip/irq-qcom-mpm.c
+++ b/drivers/irqchip/irq-qcom-mpm.c
@@ -85,6 +85,8 @@ struct qcom_mpm_priv {
 	unsigned int reg_stride;
 	struct irq_domain *domain;
 	struct generic_pm_domain genpd;
+	bool no_genpd;
+	bool sleeping;
 };
 
 static u32 qcom_mpm_read(struct qcom_mpm_priv *priv, unsigned int reg,
@@ -261,6 +263,84 @@ static const struct irq_domain_ops qcom_mpm_ops = {
 	.translate	= irq_domain_translate_twocell,
 };
 
+/* vMPM words 0/1: the 64-bit wakeup deadline, in QTIMER (19.2 MHz) ticks */
+static void qcom_mpm_timer_write(struct qcom_mpm_priv *priv, u64 deadline)
+{
+	writel_relaxed(lower_32_bits(deadline), priv->base);
+	writel_relaxed(upper_32_bits(deadline), priv->base + 4);
+
+	/* Ensure the write is completed */
+	wmb();
+}
+
+/*
+ * Hand vMPM over to RPM: on the next APSS power collapse RPM copies it
+ * into the hardware MPM, which then monitors the enabled pins while the
+ * SoC sleeps.  Wake pins are already latched in the ENABLE words -- the
+ * irqchip writes them at unmask time and IRQCHIP_MASK_ON_SUSPEND has
+ * masked everything that is not a wake source -- so only the deadline,
+ * the STATUS clear and the doorbell are per-sleep work.
+ */
+static int qcom_mpm_enter_sleep(struct qcom_mpm_priv *priv)
+{
+	unsigned long flags;
+	int i, ret;
+
+	raw_spin_lock_irqsave(&priv->lock, flags);
+
+	/*
+	 * No vMPM deadline: system suspend wakes on hardware events only.
+	 * The PMIC RTC alarm and the power key both arrive through the
+	 * SPMI summary pin, so timer wake does not need the vMPM timer.
+	 * This matches the downstream suspend path, which writes ~0ULL
+	 * whenever no override is set (msm_mpm_enter_sleep(0, ...)).
+	 */
+	qcom_mpm_timer_write(priv, ~0ULL);
+
+	for (i = 0; i < priv->reg_stride; i++)
+		qcom_mpm_write(priv, MPM_REG_STATUS, i, 0);
+
+	raw_spin_unlock_irqrestore(&priv->lock, flags);
+
+	ret = mbox_send_message(priv->mbox_chan, NULL);
+	if (ret < 0)
+		return ret;
+
+	mbox_client_txdone(priv->mbox_chan, 0);
+
+	return 0;
+}
+
+static int qcom_mpm_suspend_noirq(struct device *dev)
+{
+	struct qcom_mpm_priv *priv = dev_get_drvdata(dev);
+	int ret;
+
+	if (!priv->no_genpd)
+		return 0;
+
+	ret = qcom_mpm_enter_sleep(priv);
+	if (ret)
+		return ret;
+
+	WRITE_ONCE(priv->sleeping, true);
+
+	return 0;
+}
+
+static int qcom_mpm_resume_noirq(struct device *dev)
+{
+	struct qcom_mpm_priv *priv = dev_get_drvdata(dev);
+
+	WRITE_ONCE(priv->sleeping, false);
+
+	return 0;
+}
+
+static const struct dev_pm_ops qcom_mpm_pm_ops = {
+	NOIRQ_SYSTEM_SLEEP_PM_OPS(qcom_mpm_suspend_noirq, qcom_mpm_resume_noirq)
+};
+
 /* Triggered by RPM when system resumes from deep sleep */
 static irqreturn_t qcom_mpm_handler(int irq, void *dev_id)
 {
@@ -289,6 +369,16 @@ static irqreturn_t qcom_mpm_handler(int irq, void *dev_id)
 		}
 	}
 
+	/*
+	 * Still inside system suspend: RPM handed vMPM back on this wake.
+	 * Re-arm it so that, if the s2idle loop goes back to sleep, the
+	 * next last-man collapse still has live wake pins.  If this wake
+	 * ends the suspend instead, the extra doorbell is harmless -- RPM
+	 * only applies vMPM on an APSS collapse.
+	 */
+	if (READ_ONCE(priv->sleeping))
+		qcom_mpm_enter_sleep(priv);
+
 	return ret;
 }
 
@@ -415,24 +505,35 @@ static int qcom_mpm_probe(struct platform_device *pdev, struct device_node *pare
 	if (irq < 0)
 		return irq;
 
-	genpd = &priv->genpd;
-	genpd->flags = GENPD_FLAG_IRQ_SAFE;
-	genpd->power_off = mpm_pd_power_off;
-
-	genpd->name = devm_kasprintf(dev, GFP_KERNEL, "%s", dev_name(dev));
-	if (!genpd->name)
-		return -ENOMEM;
+	/*
+	 * Without a "#power-domain-cells" property the node is not a genpd
+	 * provider: the vMPM handover then runs from the system-suspend
+	 * noirq phase instead of a domain power_off hook.  This is the
+	 * shape for firmware that only implements PSCI Platform
+	 * Coordinated mode, where no CPU PM domain topology exists to
+	 * parent on the MPM.
+	 */
+	priv->no_genpd = !of_property_present(np, "#power-domain-cells");
+	if (!priv->no_genpd) {
+		genpd = &priv->genpd;
+		genpd->flags = GENPD_FLAG_IRQ_SAFE;
+		genpd->power_off = mpm_pd_power_off;
+
+		genpd->name = devm_kasprintf(dev, GFP_KERNEL, "%s", dev_name(dev));
+		if (!genpd->name)
+			return -ENOMEM;
 
-	ret = pm_genpd_init(genpd, NULL, false);
-	if (ret) {
-		dev_err(dev, "failed to init genpd: %d\n", ret);
-		return ret;
-	}
+		ret = pm_genpd_init(genpd, NULL, false);
+		if (ret) {
+			dev_err(dev, "failed to init genpd: %d\n", ret);
+			return ret;
+		}
 
-	ret = of_genpd_add_provider_simple(np, genpd);
-	if (ret) {
-		dev_err(dev, "failed to add genpd provider: %d\n", ret);
-		goto remove_genpd;
+		ret = of_genpd_add_provider_simple(np, genpd);
+		if (ret) {
+			dev_err(dev, "failed to add genpd provider: %d\n", ret);
+			goto remove_genpd;
+		}
 	}
 
 	priv->mbox_client.dev = dev;
@@ -469,6 +570,8 @@ static int qcom_mpm_probe(struct platform_device *pdev, struct device_node *pare
 		goto remove_domain;
 	}
 
+	platform_set_drvdata(pdev, priv);
+
 	return 0;
 
 remove_domain:
@@ -476,12 +579,13 @@ static int qcom_mpm_probe(struct platform_device *pdev, struct device_node *pare
 free_mbox:
 	mbox_free_channel(priv->mbox_chan);
 remove_genpd:
-	pm_genpd_remove(genpd);
+	if (!priv->no_genpd)
+		pm_genpd_remove(&priv->genpd);
 	return ret;
 }
 
 IRQCHIP_PLATFORM_DRIVER_BEGIN(qcom_mpm)
 IRQCHIP_MATCH("qcom,mpm", qcom_mpm_probe)
-IRQCHIP_PLATFORM_DRIVER_END(qcom_mpm)
+IRQCHIP_PLATFORM_DRIVER_END(qcom_mpm, .pm = &qcom_mpm_pm_ops)
 MODULE_DESCRIPTION("Qualcomm Technologies, Inc. MSM Power Manager");
 MODULE_LICENSE("GPL v2");
