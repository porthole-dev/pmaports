 .../platform/qcom/camss/camss-csid-4-7.c      | 31 ++++++++++++++++---
 .../media/platform/qcom/camss/camss-csid.c    | 30 ++++++++++++++++++
 .../media/platform/qcom/camss/camss-ispif.c   | 14 +++++++--
 drivers/media/platform/qcom/camss/camss-vfe.c |  6 ++++
 4 files changed, 75 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csid-4-7.c b/drivers/media/platform/qcom/camss/camss-csid-4-7.c
index 66054d4872e6..d0a7da402393 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-4-7.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-4-7.c
@@ -43,6 +43,32 @@
 #define CAMSS_CSID_TG_DT_n_CGG_1(n)	(0x0b8 + 0xc * (n))
 #define CAMSS_CSID_TG_DT_n_CGG_2(n)	(0x0bc + 0xc * (n))
 
+/*
+ * csid_is_plain16 - is this sink/src pair asking for unpacked 16-bit output
+ * @sink_code: media bus format code on the sink pad
+ * @src_code: media bus format code on the source pad
+ *
+ * The padded source code is how userspace asks the CSID to unpack MIPI
+ * samples into one 16-bit word each, rather than dumping them packed.
+ */
+static bool csid_is_plain16(u32 sink_code, u32 src_code)
+{
+	switch (sink_code) {
+	case MEDIA_BUS_FMT_SBGGR10_1X10:
+		return src_code == MEDIA_BUS_FMT_SBGGR10_2X8_PADHI_LE;
+	case MEDIA_BUS_FMT_SGBRG10_1X10:
+		return src_code == MEDIA_BUS_FMT_SGBRG10_2X8_PADHI_LE;
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+		return src_code == MEDIA_BUS_FMT_SGRBG10_2X8_PADHI_LE;
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+		return src_code == MEDIA_BUS_FMT_SRGGB10_2X8_PADHI_LE;
+	case MEDIA_BUS_FMT_Y10_1X10:
+		return src_code == MEDIA_BUS_FMT_Y10_2X8_PADHI_LE;
+	default:
+		return false;
+	}
+}
+
 static void csid_configure_stream(struct csid_device *csid, u8 enable)
 {
 	struct csid_testgen_config *tg = &csid->testgen;
@@ -119,10 +145,7 @@ static void csid_configure_stream(struct csid_device *csid, u8 enable)
 		val |= format->decode_format << CAMSS_CSID_CID_n_CFG_DECODE_FORMAT_SHIFT;
 		val |= CAMSS_CSID_CID_n_CFG_RDI_MODE_RAW_DUMP;
 
-		if ((sink_code == MEDIA_BUS_FMT_SBGGR10_1X10 &&
-		     src_code == MEDIA_BUS_FMT_SBGGR10_2X8_PADHI_LE) ||
-		    (sink_code == MEDIA_BUS_FMT_Y10_1X10 &&
-		     src_code == MEDIA_BUS_FMT_Y10_2X8_PADHI_LE)) {
+		if (csid_is_plain16(sink_code, src_code)) {
 			val |= CAMSS_CSID_CID_n_CFG_RDI_MODE_PLAIN_PACKING;
 			val |= CAMSS_CSID_CID_n_CFG_PLAIN_FORMAT_16;
 			val |= CAMSS_CSID_CID_n_CFG_PLAIN_ALIGNMENT_LSB;
