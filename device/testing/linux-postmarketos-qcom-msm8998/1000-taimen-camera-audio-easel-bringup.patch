+static u32 easel_rx_base(unsigned int dev)
+{
+	return EASEL_MIPI_RX0_BASE + dev * EASEL_RX_STRIDE;
+}
+
+static u32 easel_tx_base(unsigned int dev)
+{
+	return EASEL_MIPI_TX0_BASE + dev * EASEL_TX_STRIDE;
+}
+
+static void easel_w(struct easel *easel, u32 addr, u32 val)
+{
+	u32 off = easel_set_window(easel, EASEL_PERIPH_BASE, addr);
+
+	writel(val, easel->cfg + off);
+}
+
+static u32 easel_r(struct easel *easel, u32 addr)
+{
+	u32 off = easel_set_window(easel, EASEL_PERIPH_BASE, addr);
+
+	return readl(easel->cfg + off);
+}
+
+static void easel_rmw(struct easel *easel, u32 addr, u32 mask, u32 val)
+{
+	easel_w(easel, addr, (easel_r(easel, addr) & ~mask) | (val & mask));
+}
