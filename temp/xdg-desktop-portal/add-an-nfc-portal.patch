+++ b/tests/test_nfc.py
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# This file is formatted with Python Black
+
+import tests.xdp_utils as xdp
+
+import pytest
+
+
+@pytest.fixture
+def required_templates():
+    return {
+        "access": {},
+    }
+
+
+class TestNfc:
+    def set_permissions(self, dbus_con, appid, permissions):
+        perm_store_intf = xdp.get_permission_store_iface(dbus_con)
+        perm_store_intf.SetPermission(
+            "devices",
+            True,
+            "nfc",
+            appid,
+            permissions,
+        )
+
+    def test_version(self, portals, dbus_con):
+        xdp.check_version(dbus_con, "NFC", 1)
+
+    def test_access(self, portals, dbus_con, xdp_app_info):
+        app_id = xdp_app_info.app_id
+        nfc_intf = xdp.get_portal_iface(dbus_con, "NFC")
+        mock_intf = xdp.get_mock_iface(dbus_con)
+
+        request = xdp.Request(dbus_con, nfc_intf)
+        response = request.call("AccessNFC", options={})
+
+        assert response
+        assert response.response == 0
+
+        method_calls = mock_intf.GetMethodCalls("AccessDialog")
+        assert len(method_calls) == 1
+        _, args = method_calls[-1]
+        assert args[1] == app_id
+
+    @pytest.mark.parametrize("template_params", ({"access": {"response": 1}},))
+    def test_access_cancel(self, portals, dbus_con, xdp_app_info):
+        nfc_intf = xdp.get_portal_iface(dbus_con, "NFC")
+
+        request = xdp.Request(dbus_con, nfc_intf)
+        response = request.call("AccessNFC", options={})
+
+        assert response
+        assert response.response == 1
+
+    def test_access_denied(self, portals, dbus_con, xdp_app_info):
+        app_id = xdp_app_info.app_id
+        nfc_intf = xdp.get_portal_iface(dbus_con, "NFC")
+        mock_intf = xdp.get_mock_iface(dbus_con)
+
+        self.set_permissions(dbus_con, app_id, ["no"])
+
+        request = xdp.Request(dbus_con, nfc_intf)
+        response = request.call("AccessNFC", options={})
+
+        assert response
+        assert response.response == 1
+
+        # A stored "no" must be honoured without asking the user again.
+        method_calls = mock_intf.GetMethodCalls("AccessDialog")
+        assert len(method_calls) == 0
+
+    def test_access_remembered(self, portals, dbus_con, xdp_app_info):
+        """A granted permission is stored, so the second call does not prompt."""
+        nfc_intf = xdp.get_portal_iface(dbus_con, "NFC")
+        mock_intf = xdp.get_mock_iface(dbus_con)
+
+        first = xdp.Request(dbus_con, nfc_intf).call("AccessNFC", options={})
+        assert first.response == 0
+
+        second = xdp.Request(dbus_con, nfc_intf).call("AccessNFC", options={})
+        assert second.response == 0
+
+        method_calls = mock_intf.GetMethodCalls("AccessDialog")
+        assert len(method_calls) == 1

From 3cd8bb619e1a2b35b4466f671a7a530831e67a12 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 10 Sep 2026 16:40:03 +0200
Subject: [PATCH 2/9] nfc: fix translation extraction, orphan docs, and doc
 comment form

Review of the previous commit found three registration/shape problems:

- src/nfc.c's six translatable strings were never reachable by xgettext
  because the file was missing from po/POTFILES.in. Camera's _() strings are
  extracted from src/camera.c, listed there; NFC's were not, so the Access
  dialog would have been permanently untranslatable.

- Adding org.freedesktop.portal.NFC.xml to portal_sources makes
  doc/meson.build auto-generate doc-org.freedesktop.portal.NFC.rst, but
  nothing referenced it from the toctree in doc/api-reference.rst, so sphinx
  would see it as an orphan document -- an error under -Dwerror=true, which
  upstream CI uses.

- The interface XML documented itself with a <doc:doc> block, which
  gdbus-codegen's --generate-rst does not read. Every other portal in this
  tree, including Camera, documents its members with gdbus-codegen's own
  <!-- Member: @arg: ... --> comment form; rewritten to match, so the
  published page actually has content for AccessNFC, OpenNFCRemote,
  IsNFCPresent and the interface description.

Also: ported test_access_close from test_camera.py. It is the only test
that exercises xdp_request_set_impl_request and the request->exported close
path, which nfc.c copies from camera.c verbatim, and the NFC test file
hadn't had a counterpart for it. And: src/nfc.c and src/nfc.h now carry the
same LGPL boilerplate paragraph every other src/*.c/*.h in this tree carries
alongside its SPDX tag, not SPDX alone.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 data/org.freedesktop.portal.NFC.xml | 53 ++++++++++++++++++++++++-----
 doc/api-reference.rst               |  1 +
 po/POTFILES.in                      |  1 +
 src/nfc.c                           | 14 ++++++++
 src/nfc.h                           | 14 ++++++++
 tests/test_nfc.py                   | 20 +++++++++++
 6 files changed, 95 insertions(+), 8 deletions(-)

diff --git a/data/org.freedesktop.portal.NFC.xml b/data/org.freedesktop.portal.NFC.xml
index f48fa1e..50b6d80 100644
--- a/data/org.freedesktop.portal.NFC.xml
+++ b/data/org.freedesktop.portal.NFC.xml
@@ -4,28 +4,65 @@
 
  SPDX-License-Identifier: LGPL-2.1-or-later
 -->
+
 <node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
+  <!--
+      org.freedesktop.portal.NFC:
+      @short_description: NFC portal
+
+      The NFC portal lets applications use the Near Field Communication
+      reader, through the neard API on a filtered connection.
+  -->
   <interface name="org.freedesktop.portal.NFC">
-    <doc:doc>
-      <doc:description>
-        <doc:para>
-          The NFC portal lets applications use the Near Field Communication
-          reader, through the neard API on a filtered connection.
-        </doc:para>
-      </doc:description>
-    </doc:doc>
+    <!--
+        AccessNFC:
+        @options: Vardict with optional further information
+        @handle: Object path for the :ref:`org.freedesktop.portal.Request` object representing this call
+
+        Request to gain access to NFC.
+
+        Supported keys in the @options vardict include:
 
+        * ``handle_token`` (``s``)
+          A string that will be used as the last element of the @handle. Must be a valid
+          object path element. See the :ref:`org.freedesktop.portal.Request` documentation for
+          more information about the @handle.
+
+        Following the :ref:`org.freedesktop.portal.Request::Response` signal, if
+        granted, org.freedesktop.portal.NFC.OpenNFCRemote() can be used to
+        open a connection to the NFC adapter.
+    -->
     <method name="AccessNFC">
       <arg type="a{sv}" name="options" direction="in"/>
       <arg type="o" name="handle" direction="out"/>
     </method>
+    <!--
+        OpenNFCRemote:
+        @options: Vardict with optional further information
+        @fd: File descriptor of an open D-Bus connection.
+
+        Open a file descriptor for a D-Bus connection on which the neard API
+        is available. The connection permits polling for and enumerating NFC
+        tags, and reading and writing their records. It does not permit
+        changing the adapter's power state, which belongs to the user.
+
+        This method will only succeed if the application already has
+        permission to use NFC, granted through
+        org.freedesktop.portal.NFC.AccessNFC().
 
+        There are currently no supported keys in the @options vardict.
+    -->
     <method name="OpenNFCRemote">
       <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
       <arg type="a{sv}" name="options" direction="in"/>
       <arg type="h" name="fd" direction="out"/>
     </method>
+    <!--
+        IsNFCPresent:
 
+        A boolean stating whether there is any NFC adapter available, so an
+        application can hide its NFC UI rather than fail.
