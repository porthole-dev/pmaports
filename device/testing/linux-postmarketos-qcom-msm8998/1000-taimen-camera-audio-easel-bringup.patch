+static int lg_panel_enable(struct drm_panel *panel)
+{
+	struct lg_sw43402 *ctx = to_lg_sw43402(panel);
+	struct drm_dsc_picture_parameter_set pps;
+	int ret;
+
+	if (ctx->enabled)
+		return 0;
+
+	if (panel->dsc) {
+		/*
+		 * drm_dsc_pps_payload_pack() takes bits_per_pixel in 1/16ths
+		 * ("bits_per_pixel << 4", see struct drm_dsc_config), but the
+		 * msm code around it uses a plain integer: dsi_populate_dsc_params()
+		 * computes slice_chunk_size = slice_width * bits_per_pixel / 8
+		 * = 720, and dpu_hw_dsc_config() converts 8 into the 6.4-format
+		 * 128 the DSC_ENC register wants. This tree predates the
+		 * conversion upstream did, so only the PPS needs fixing up --
+		 * doing it here rather than changing the value everyone else
+		 * reads.
+		 *
+		 * Without this the panel is told to decode 0.5 bpp while the
+		 * DPU compresses at 8, and the screen is full-frame noise.
+		 */
+		struct drm_dsc_config pps_cfg = *panel->dsc;
+
+		pps_cfg.bits_per_pixel <<= 4;
+		drm_dsc_pps_payload_pack(&pps, &pps_cfg);
+
+		ret = mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
+		if (ret < 0) {
+			DRM_DEV_ERROR(panel->dev,
+				      "failed to set pps: %d\n", ret);
+			return ret;
+		}
+	}
+
+	/*
+	 * Display-on (0x29) is required -- without it the panel never starts
+	 * scanning (no TE, "frame done timeout") -- but it is DEFERRED so the
+	 * first frames overwrite the GRAM garbage before emission starts.
+	 * See display_on_delay_ms. The vsync source here is the WD timer, not
+	 * panel TE, so frames flow even while the display is still off.
+	 */
+	if (display_on_delay_ms) {
+		schedule_delayed_work(&ctx->display_on_work,
+				      msecs_to_jiffies(display_on_delay_ms));
+	} else {
+		ret = mipi_dsi_dcs_set_display_on(ctx->dsi);
+		if (ret < 0) {
+			DRM_DEV_ERROR(panel->dev,
+				      "failed to set display on: %d\n", ret);
+			return ret;
+		}
+	}
+
+	/*
+	 * 0x53 (write control display) deliberately stays at the init
+	 * sequence's 0x00. On this DDIC a bare 0x51 applies directly ONLY
+	 * while 0x53 == 0x00 -- setting BCTRL (0x24, as this driver briefly
+	 * did) makes every subsequent 0x51 latch (0x52 reads it back) without
+	 * ever changing emission, which presented as a completely broken
+	 * backlight. Stock (mdss_dsi_panel_bklt_dcs) never writes 0x53 either.
+	 * The panel comes up dark simply because the brightness register is 0
+	 * until drm_panel_enable() calls backlight_enable() right after this
+	 * function, which sends 0x51 with the stored level.
+	 */
+	ctx->enabled = true;
+
+	return 0;
+}
+
+static void lg_sw43402_display_on_work(struct work_struct *work)
+{
+	struct lg_sw43402 *ctx = container_of(work, struct lg_sw43402,
+					      display_on_work.work);
+	int ret;
+
+	/* The panel may have been disabled again before the delay expired. */
+	if (!ctx->enabled)
+		return;
+
+	ret = mipi_dsi_dcs_set_display_on(ctx->dsi);
+	if (ret < 0)
+		dev_err(&ctx->dsi->dev, "deferred display on failed: %d\n",
+			ret);
+}
+
+static int lg_panel_disable(struct drm_panel *panel)
+{
+	struct lg_sw43402 *ctx = to_lg_sw43402(panel);
+
+	/*
+	 * enable() early-returns on this flag, so it has to be cleared or the
+	 * panel never gets its PPS and display-on again after a blank and comes
+	 * back permanently dark. Nothing cleared it before, because there was no
+	 * disable() at all -- which is the likeliest reason unprepare() was
+	 * compiled out rather than debugged.
+	 */
+	ctx->enabled = false;
+	cancel_delayed_work_sync(&ctx->display_on_work);
+
+	return 0;
+}
+
+static int lg_sw43402_on(struct lg_sw43402 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
+	int ret;
+
+	dsi_dcs_write_seq(dsi, 0xb0, 0x20, 0x43);
+	/*
+	 * Vendor on-command parity, gated for A/B testing (init_df=1
+	 * init_no_e7=1 == the vendor's exact sequence): it sends df 0a 70
+	 * between the two b0 writes, and contains no 0xe7 writes at all --
+	 * the two 18-byte 0xe7s below are not in the factory dtbo's
+	 * on-command. Takes effect on the next re-init (power-button
+	 * blank/unblank cycle), no reboot needed.
+	 */
+	if (init_df)
+		dsi_dcs_write_seq(dsi, 0xdf, 0x0a, 0x70);
+	dsi_dcs_write_seq(dsi, 0xb0, 0xa5, 0x00);
+	dsi_dcs_write_seq(dsi, 0xb2,
+			  0x5d, 0x01, 0x02, 0x80, 0x00, 0xff, 0xff, 0x15, 0x00,
+			  0x00, 0x00, 0x00);
+	dsi_dcs_write_seq(dsi, 0x35);
+
+	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to exit sleep mode: %d\n", ret);
+		return ret;
+	}
+	msleep(60);
+
+	if (!init_no_e7)
+		dsi_dcs_write_seq(dsi, 0xe7,
+				  0x00, 0x0d, 0x76, 0x23, 0x00, 0x00, 0x5d, 0x44,
+				  0x0d, 0x76, 0x0d, 0x0d, 0x00, 0x0d, 0x0d, 0x0d,
+				  0x4a, 0x00);
+	dsi_dcs_write_seq(dsi, 0x53, 0x00);
+	dsi_dcs_write_seq(dsi, 0x55, 0x0c);
+	dsi_dcs_write_seq(dsi, 0xfb, 0x03, 0x77);
+	dsi_dcs_write_seq(dsi, 0xed, 0x13, 0x00, 0x06, 0x00, 0x00);
+	dsi_dcs_write_seq(dsi, 0xe2,
+			  0x20, 0x0d, 0x08, 0xa8, 0x0a, 0xaa, 0x04, 0x44, 0x80,
+			  0x80, 0x80, 0x5c, 0x5c, 0x5c);
+	if (!init_no_e7) {
+		msleep(90);
+		dsi_dcs_write_seq(dsi, 0xe7,
+				  0x00, 0x0d, 0x76, 0x23, 0x00, 0x00, 0x0d, 0x44,
+				  0x0d, 0x76, 0x0d, 0x0d, 0x00, 0x0d, 0x0d, 0x0d,
+				  0x4a, 0x00);
+	}
+	msleep(20);
+
+	pr_info("sw43402-init: df=%d no_e7=%d\n", init_df, init_no_e7);
+
+	return 0;
+}
+
+static int lg_sw43402_off(struct lg_sw43402 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
+	int ret;
+
+	dsi_dcs_write_seq(dsi, 0xe8, 0x08, 0x90, 0x18, 0x05);
+
+	ret = mipi_dsi_dcs_set_display_off(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to set display off: %d\n", ret);
+		return ret;
+	}
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enter sleep mode: %d\n", ret);
+		return ret;
+	}
+	msleep(100);
+
+	return 0;
+}
+
+static int lg_sw43402_prepare(struct drm_panel *panel)
+{
+	struct lg_sw43402 *ctx = to_lg_sw43402(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	lg_sw43402_reset(ctx);
+
+	ret = lg_sw43402_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return ret;
+	}
+
+	ctx->prepared = true;
+	return 0;
+}
+
+static int lg_sw43402_unprepare(struct drm_panel *panel)
+{
+	struct lg_sw43402 *ctx = to_lg_sw43402(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (!ctx->prepared)
+		return 0;
+
+	ret = lg_sw43402_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	/*
+	 * The rails deliberately stay up. lg_sw43402_off() puts the DDIC in
+	 * sleep mode, which is enough to blank it, and leaving vddio/vpnl and
+	 * the OLED lab/ibb rails alone keeps the unblank cheap -- prepare()
+	 * re-runs reset and the full init sequence from there.
+	 */
+	ctx->prepared = false;
+	return 0;
+}
+
+static const struct drm_display_mode lg_sw43402_mode = {
+	.clock = (1440 + 20 + 32 + 20) * (2880 + 20 + 4 + 20) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 20,
+	.hsync_end = 1440 + 20 + 32,
+	.htotal = 1440 + 20 + 32 + 20,
+	.vdisplay = 2880,
+	.vsync_start = 2880 + 20,
+	.vsync_end = 2880 + 20 + 4,
+	.vtotal = 2880 + 20 + 4 + 20,
+	.width_mm = 68,
+	.height_mm = 136,
+};
+
+static int lg_sw43402_get_modes(struct drm_panel *panel,
+				 struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &lg_sw43402_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs lg_sw43402_panel_funcs = {
+	.prepare = lg_sw43402_prepare,
+	.enable = lg_panel_enable,
+	.disable = lg_panel_disable,
+	.unprepare = lg_sw43402_unprepare,
+	.get_modes = lg_sw43402_get_modes,
+};
+
+static int lg_sw43402_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct lg_sw43402 *ctx;
+	struct drm_dsc_config *dsc;
+	int i, ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	dsc = devm_kzalloc(&dsi->dev, sizeof(*dsc), GFP_KERNEL);
+	if (!dsc)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++)
+		ctx->supplies[i].supply = lg_sw43402_supplies[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	INIT_DELAYED_WORK(&ctx->display_on_work, lg_sw43402_display_on_work);
+	WRITE_ONCE(lg_sw43402_probe_ctx, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * Keep MIPI_DSI_CLOCK_NON_CONTINUOUS. Dropping it to match
+	 * panel-lg-sw43408 was tried on 2026-07-27 and REGRESSED: DCS reads
+	 * became reliable (0x54 stopped failing on alternate attempts), but a
+	 * plain runtime brightness write then corrupted the panel into full RGB
+	 * noise, with zero DSI errors reported and no frames in flight. Do not
+	 * re-walk this without a different reason.
+	 *
+	 * MIPI_DSI_MODE_VIDEO_BURST is inert here -- msm only ever tests
+	 * MIPI_DSI_MODE_VIDEO, and this panel is qcom,mdss-dsi-panel-type =
+	 * "dsi_cmd_mode" -- but it mirrors the vendor's
+	 * qcom,mdss-dsi-traffic-mode = "burst_mode", so it is left alone rather
+	 * than changed as a side effect of something else.
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM;
+
+	drm_panel_init(&ctx->panel, dev, &lg_sw43402_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	ret = lg_sw43402_backlight_init(ctx);
+	if (ret < 0)
+		return ret;
+
+	dsc->dsc_version_major = 0x1;
+	dsc->dsc_version_minor = 0x1;
+
+	dsc->slice_height = 16;
+	dsc->slice_width = 720;
+	dsc->slice_count = 1;
+	dsc->bits_per_component = 8;
+	dsc->bits_per_pixel = 8;
+	dsc->block_pred_enable = true;
+
+	/*
+	 * Must be set before drm_panel_add(): that publishes the panel, and
+	 * msm_dsi_host_modeset_init() then samples panel->dsc via
+	 * of_drm_find_panel() to decide whether to run the link compressed.
+	 * Assigning it afterwards leaves the host with dsc == NULL.
+	 */
+	ctx->panel.dsc = dsc;
+
+	drm_panel_add(&ctx->panel);
+
+	return mipi_dsi_attach(dsi);
+}
+
+static int lg_sw43402_remove(struct mipi_dsi_device *dsi)
+{
+	struct lg_sw43402 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	WRITE_ONCE(lg_sw43402_probe_ctx, NULL);
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+
+	return 0;
+}
+
+static const struct of_device_id lg_sw43402_of_match[] = {
+	{ .compatible = "lg,sw43402" }, // FIXME
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lg_sw43402_of_match);
+
+static struct mipi_dsi_driver lg_sw43402_driver = {
+	.probe = lg_sw43402_probe,
+	.remove = lg_sw43402_remove,
+	.driver = {
+		.name = "panel-sw43402",
+		.of_match_table = lg_sw43402_of_match,
+	},
+};
+module_mipi_dsi_driver(lg_sw43402_driver);
+
+MODULE_AUTHOR("Caleb Connolly <caleb@connolly.tech>"); // FIXME
+MODULE_DESCRIPTION("DRM driver for SW43402 cmd mode dsc dsi panel");
+MODULE_LICENSE("GPL v2");
