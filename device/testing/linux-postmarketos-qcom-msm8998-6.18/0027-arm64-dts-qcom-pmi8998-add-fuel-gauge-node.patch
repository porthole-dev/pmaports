From 93eae9c2facf4963990bffede1fd98eec3e50492 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 8 Aug 2026 15:40:31 +0200
Subject: [PATCH 027/113] arm64: dts: qcom: pmi8998: add fuel gauge node

Adds the pmi8998_fg fuel-gauge node consumed by the qcom_fg driver,
needed on the Google Pixel 2 XL (taimen) to report battery state of
charge. Two reg entries are mandatory: qcom_fg.c reads index 0 as the
SOC base and index 1 as the CHG base, and aborts probe if the second
is missing.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 arch/arm64/boot/dts/qcom/pmi8998.dtsi | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/pmi8998.dtsi b/arch/arm64/boot/dts/qcom/pmi8998.dtsi
index cd3f0790fd42..b5989bf79a10 100644
--- a/arch/arm64/boot/dts/qcom/pmi8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/pmi8998.dtsi
@@ -29,6 +29,23 @@ pmi8998_charger: charger@1000 {
 			status = "disabled";
 		};
 
+		pmi8998_fg: fuel-gauge@4000 {
+			compatible = "qcom,pmi8998-fg";
+			/*
+			 * Two entries are mandatory: qcom_fg.c reads index 0 as
+			 * the SOC base and index 1 as the CHG base, and aborts
+			 * probe with "Couldn't read CHG base address from dt" if
+			 * the second is missing. 0x4100 is the BATT peripheral
+			 * (downstream calls it qcom,fg-batt-info@4100).
+			 */
+			reg = <0x4000>, <0x4100>;
+
+			interrupts = <0x2 0x40 0x3 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "soc-delta";
+
+			status = "disabled";
+		};
+
 		pmi8998_gpios: gpio@c000 {
 			compatible = "qcom,pmi8998-gpio", "qcom,spmi-gpio";
 			reg = <0xc000>;
