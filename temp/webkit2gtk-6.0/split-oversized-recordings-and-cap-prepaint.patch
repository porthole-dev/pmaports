+#if USE(SKIA)
+// record() walks the render tree clipped to the rect it is handed, on the MAIN
+// thread, so its cost tracks that rect's AREA -- and the rect it is handed is a
+// BOUNDING BOX over every dirty tile. Two dirty tiles at opposite ends of a
+// 5438px layer make that box the whole layer, so repainting two tiles records
+// the entire page. Measured on taimen 2026-09-05: Page::updateRendering() took
+// 1205 ms on the first interaction with such a page, 601 ms of it in style and
+// 476 ms in layout, all of it main-thread.
+//
+// When most of the bounding box is not actually dirty, record each tile on its
+// own instead: N small tree walks whose total area is the area really being
+// repainted, rather than one walk over mostly-clean space. Adjacent tiles keep
+// the single recording, where the box is tight and one walk is cheaper.
+//
+// Ratio of bounding-box area to dirty area above which to split. 0 disables,
+// which is the default so this lands as a no-op and can be A/B'd at runtime.
+static bool shouldRecordPerTile(const WebCore::IntRect& boundingBox, uint64_t dirtyArea)
+{
+    static double splitRatio = [] {
+        const char* env = getenv("WEBKIT_SKIA_RECORD_SPLIT_RATIO");
+        return env && *env ? std::max(0.0, atof(env)) : 0.0;
+    }();
+    if (splitRatio <= 0 || !dirtyArea)
+        return false;
+    auto boxArea = static_cast<uint64_t>(boundingBox.width()) * boundingBox.height();
+    return static_cast<double>(boxArea) > dirtyArea * splitRatio;
+}
+#endif
