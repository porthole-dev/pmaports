+	if (!ctx || !ctx->enabled)
+		return -ENODEV;
+
+	ret = mipi_dsi_dcs_read(ctx->dsi, reg, &data, 1);
+	pr_info("sw43402-probe: reg=0x%02x val=0x%02x ret=%d\n",
+		reg, data, ret);
+
+	return 0;
+}
