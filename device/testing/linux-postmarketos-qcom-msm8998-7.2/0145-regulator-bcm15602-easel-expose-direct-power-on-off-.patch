From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 22 Aug 2026 19:12:01 +0200
Subject: [PATCH] regulator: bcm15602-easel: expose direct power on/off for the
 sleep-lifecycle owner

Easel loses power across s2idle no matter what the AP does, and the
vendor's mnh-sm never keeps it up across AP sleep either -- it is fully
powered down (rails off) before Android suspends and re-powered on
demand.  easel-mipi is about to do the same from a PM notifier, and
needs the two halves of the power cycle separately: off BEFORE the
sleep, on AFTER it.

The regulator API cannot express either half: the PCIe RC pins
easel_vddpe enabled for probe-ordering reasons, so a consumer
enable/disable never reaches the hardware.  Split the regulator ops
from the hardware sequencing and export the pair for the one consumer
that owns Easel's system-sleep lifecycle.

The power-off helper doubles as the revival-failure fallback: a fully
powered-off Easel behind an asserted PERST# is a stable link-down
state, where a powered-but-unlinked one wedges the next suspend
(measured 2026-08-20, cycle 2 of the lifecycle-v1 experiment).  That
fallback runs after a FAILED power-on too, so balance the clock
handling both ways: power-on now unwinds the reference clocks when the
soc_pwr_good write fails, and power-off only disables clocks a
successful power-on left enabled.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/regulator/bcm15602-easel.c       | 75 +++++++++++++++++++++---
 include/linux/regulator/bcm15602-easel.h | 13 ++++
 2 files changed, 80 insertions(+), 8 deletions(-)
 create mode 100644 include/linux/regulator/bcm15602-easel.h

diff --git a/drivers/regulator/bcm15602-easel.c b/drivers/regulator/bcm15602-easel.c
index 7de8190dc1bf..1a47c5b4e779 100644
--- a/drivers/regulator/bcm15602-easel.c
+++ b/drivers/regulator/bcm15602-easel.c
@@ -30,6 +30,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
+#include <linux/regulator/bcm15602-easel.h>
 #include <linux/regulator/driver.h>
 #include <linux/regulator/machine.h>
 
@@ -111,9 +112,8 @@ static int bcm15602_wake(struct bcm15602 *bcm)
 	return 0;
 }
 
-static int bcm15602_enable(struct regulator_dev *rdev)
+static int bcm15602_power_on(struct bcm15602 *bcm)
 {
-	struct bcm15602 *bcm = rdev_get_drvdata(rdev);
 	int i, ret;
 
 	if (!bcm->on) {
@@ -157,8 +157,11 @@ static int bcm15602_enable(struct regulator_dev *rdev)
 	ret = i2c_smbus_write_byte_data(bcm->client, BCM15602_REG_GPIO_OUT_CTRL,
 					BCM15602_GPIO_BASE |
 					BCM15602_GPIO_SOC_PWR_GOOD);
-	if (ret)
+	if (ret) {
+		clk_disable_unprepare(bcm->sleep_clk);
+		clk_disable_unprepare(bcm->ref_clk);
 		return ret;
+	}
 
 	/* mnh_pwr_up() gives the PLLs 60 us before touching the PCIe link. */
 	usleep_range(100, 200);
@@ -169,20 +172,74 @@ static int bcm15602_enable(struct regulator_dev *rdev)
 	return 0;
 }
 
-static int bcm15602_disable(struct regulator_dev *rdev)
+static int bcm15602_power_off(struct bcm15602 *bcm)
 {
-	struct bcm15602 *bcm = rdev_get_drvdata(rdev);
-
 	i2c_smbus_write_byte_data(bcm->client, BCM15602_REG_GPIO_OUT_CTRL,
 				  BCM15602_GPIO_BASE);
-	clk_disable_unprepare(bcm->sleep_clk);
-	clk_disable_unprepare(bcm->ref_clk);
+	/*
+	 * Only a successful power-on leaves the clocks enabled; the
+	 * lifecycle's failure fallback calls this after a failed one, too.
+	 */
+	if (bcm->on) {
+		clk_disable_unprepare(bcm->sleep_clk);
+		clk_disable_unprepare(bcm->ref_clk);
+	}
 	gpiod_set_value_cansleep(bcm->pon, 0);
 	bcm->on = false;
 
 	return 0;
 }
 
+static int bcm15602_enable(struct regulator_dev *rdev)
+{
+	return bcm15602_power_on(rdev_get_drvdata(rdev));
+}
+
+static int bcm15602_disable(struct regulator_dev *rdev)
+{
+	return bcm15602_power_off(rdev_get_drvdata(rdev));
+}
+
+static struct bcm15602 *bcm15602_dev;
+
+/*
+ * Direct power control for the one consumer that owns Easel's system-sleep
+ * lifecycle (easel-mipi): Easel loses power across s2idle no matter what,
+ * so its driver powers it off deliberately before the sleep and back on
+ * after.  The regulator API cannot express this -- the PCIe RC holds
+ * easel_vddpe enabled for probe-ordering reasons, so a second consumer's
+ * disable can never reach the hardware.
+ *
+ * While Easel is off the regulator core still believes easel_vddpe is
+ * enabled; nothing else consumes it and the pair is always restored before
+ * userspace thaws, so the framework never observes the mismatch (bcm->on
+ * keeps is_enabled() honest for anything that does look).
+ */
+int bcm15602_easel_power_on_ext(void)
+{
+	struct bcm15602 *bcm = READ_ONCE(bcm15602_dev);
+
+	if (!bcm)
+		return -ENODEV;
+
+	return bcm15602_power_on(bcm);
+}
+EXPORT_SYMBOL_GPL(bcm15602_easel_power_on_ext);
+
+/*
+ * Also the revival-failure fallback: a fully powered-off Easel behind an
+ * asserted PERST# is a stable link-down state; a powered-but-unlinked one
+ * is what wedges the NEXT suspend (measured 2026-08-20, cycle 2).
+ */
+void bcm15602_easel_power_off_ext(void)
+{
+	struct bcm15602 *bcm = READ_ONCE(bcm15602_dev);
+
+	if (bcm)
+		bcm15602_power_off(bcm);
+}
+EXPORT_SYMBOL_GPL(bcm15602_easel_power_off_ext);
+
 static int bcm15602_is_enabled(struct regulator_dev *rdev)
 {
 	struct bcm15602 *bcm = rdev_get_drvdata(rdev);
@@ -252,6 +309,8 @@ static int bcm15602_probe(struct i2c_client *client)
 		return dev_err_probe(dev, PTR_ERR(rdev),
 				     "failed to register regulator\n");
 
+	WRITE_ONCE(bcm15602_dev, bcm);
+
 	return 0;
 }
 
diff --git a/include/linux/regulator/bcm15602-easel.h b/include/linux/regulator/bcm15602-easel.h
new file mode 100644
index 000000000000..b09b570026f6
--- /dev/null
+++ b/include/linux/regulator/bcm15602-easel.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __LINUX_REGULATOR_BCM15602_EASEL_H
+#define __LINUX_REGULATOR_BCM15602_EASEL_H
+
+#if IS_ENABLED(CONFIG_REGULATOR_BCM15602_EASEL)
+int bcm15602_easel_power_on_ext(void);
+void bcm15602_easel_power_off_ext(void);
+#else
+static inline int bcm15602_easel_power_on_ext(void) { return -ENODEV; }
+static inline void bcm15602_easel_power_off_ext(void) { }
+#endif
+
+#endif
