+    def test_open_remote_reclaims_a_slot_when_a_proxy_dies(
+        self, portals, dbus_con, xdp_app_info, xdg_desktop_portal
+    ):
+        """A proxy that exits on its own must not hold its slot forever.
+
+        Nothing the application does can free that slot: closing the fd it was
+        handed does not make xdg-dbus-proxy exit. So a proxy that crashes would
+        otherwise cost a permitted app one of its connections for the life of
+        its bus connection, with no cause it could see and no way to recover.
+        Killing a proxy stands in for it crashing.
+        """
+        self.set_permissions(dbus_con, xdp_app_info.app_id, ["yes"])
+        nfc_intf = xdp.get_portal_iface(dbus_con, "NFC")
+
+        def proxy_pids():
+            return xdg_dbus_proxy_pids(xdg_desktop_portal.pid)
+
+        opened = []
+        for _ in range(4):
+            fd = nfc_intf.OpenNFCRemote({}, dbus_interface="org.freedesktop.portal.NFC")
+            opened.append(fd.take())
+
+        # The quota is spent.
+        with pytest.raises(dbus.exceptions.DBusException) as excinfo:
+            nfc_intf.OpenNFCRemote({}, dbus_interface="org.freedesktop.portal.NFC")
+        assert excinfo.value.get_dbus_name() == "org.freedesktop.portal.Error.Failed"
+
+        pids = proxy_pids()
+        assert len(pids) == 4
+        os.kill(pids[0], signal.SIGKILL)
