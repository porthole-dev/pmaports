From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Tue, 25 Aug 2026 20:58:07 +0200
Subject: [PATCH] dt-bindings: interconnect: qcom: Add MSM8998 NoC bindings

Add bindings for the Network-on-Chip interconnect providers found on
MSM8998: A1NOC, A2NOC, BIMC, CNOC, GNOC (virtual, carries the CPU
master node), MNOC and SNOC.  The topology and node IDs are taken from
the downstream msm8998-bus.dtsi.

The RPM-owned bus clocks (bimc, snoc, cnoc, aggre1/aggre2 NoC and the
MMSS NoC AXI clock) are voted for over SMD by the driver; the fabrics
themselves only need their register base.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../bindings/interconnect/qcom,msm8998.yaml   |  46 +++++++
 .../dt-bindings/interconnect/qcom,msm8998.h   | 130 ++++++++++++++++++
 2 files changed, 176 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/interconnect/qcom,msm8998.yaml
 create mode 100644 include/dt-bindings/interconnect/qcom,msm8998.h

diff --git a/Documentation/devicetree/bindings/interconnect/qcom,msm8998.yaml b/Documentation/devicetree/bindings/interconnect/qcom,msm8998.yaml
new file mode 100644
index 000000000000..550234e0700c
--- /dev/null
+++ b/Documentation/devicetree/bindings/interconnect/qcom,msm8998.yaml
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interconnect/qcom,msm8998.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8998 Network-On-Chip interconnect
+
+maintainers:
+  - Bjorn Andersson <andersson@kernel.org>
+
+description: |
+  The Qualcomm MSM8998 interconnect providers support adjusting the
+  bandwidth requirements between the various NoC fabrics.  The bus
+  clocks of the RPM-owned fabrics are voted for over SMD.
+
+properties:
+  compatible:
+    enum:
+      - qcom,msm8998-a1noc
+      - qcom,msm8998-a2noc
+      - qcom,msm8998-bimc
+      - qcom,msm8998-cnoc
+      - qcom,msm8998-gnoc
+      - qcom,msm8998-mnoc
+      - qcom,msm8998-snoc
+
+  reg:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+
+allOf:
+  - $ref: qcom,rpm-common.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    interconnect@1660000 {
+        compatible = "qcom,msm8998-a1noc";
+        reg = <0x01660000 0x60000>;
+        #interconnect-cells = <2>;
+    };
diff --git a/include/dt-bindings/interconnect/qcom,msm8998.h b/include/dt-bindings/interconnect/qcom,msm8998.h
new file mode 100644
index 000000000000..1804976549a6
--- /dev/null
+++ b/include/dt-bindings/interconnect/qcom,msm8998.h
@@ -0,0 +1,130 @@
