# Reference: <https://postmarketos.org/devicepkg>
maintainer="Giuseppe Maggio <jertlok@proton.me>"
#
# Proprietary firmware for the Google Pixel 2 XL (taimen). Bulk of it comes
# from TheMuppets' LineageOS vendor mirror, pinned by commit -- same source
# pmOS already uses for firmware-google-sargo and firmware-google-manta (the
# other Pixel devices). taimen reached end-of-life on the Android 11 build
# this port was verified against, so there have been no further OTAs to drift
# the vendor blobs: every file below was hashed byte-identical against this
# project's own first-party extraction from the Android 11 factory image
# (taimen-rp1a.201005.004.a1-factory-2f5c4987, docs/BLOBS.md) before the
# switch. Full comparison and evidence log: docs/campaign/ws-07-vendor-blobs.md.
#
# mba.mbn / modem.mbn (remoteproc_mss) do NOT come from TheMuppets: its
# lineage-22.2 tree carries no modem firmware for taimen at all -- no mba.mbn
# and no radio/ image, only mcfg_sw carrier configs (checked 2026-08-19 over
# the full 1135-entry file list of the pinned commit). They come instead from
# Google's own factory image, which ships the modem partition verbatim as
# radio-taimen-$_baseband.img: an 8-byte "BOOTLDR!" container whose first
# member is the FAT16 filesystem of the modem_a partition, holding
# image/mba.mbn and image/modem.mdt + modem.b00..b27.
#
# That is a first-party, permanently-hosted, checksummed URL -- the cleanest
# licence story available for this blob -- and its bytes are proven identical
# to what the device actually boots: all 28 modem files hash-match the live
# read-only pull off this phone's own modem_a partition (docs/BLOBS.md), and
# pil-squashing them reproduces the previously shipped modem.mbn byte for
# byte (sha256 748b8704...48c61be, 56070368 B, 26/29 segments).
#
# The cost is the download: Google publishes only the whole 1.8 GB factory
# zip, of which one 59 MB member is used. unpack() below streams just that
# member out with `unzip -p` instead of extracting the archive, so the build
# never writes the other 1.7 GB, but abuild still has to fetch it once into
# the distfiles cache. If that is unacceptable to a builder, the fallback is
# the firmware-google-sargo pattern -- a small maintainer-hosted repo holding
# only radio-taimen-$_baseband.img, pinned by commit.
#
# ath10k board-2.bin / firmware-5.bin are GENERATED at build time from
# TheMuppets' bdwlan.bin + bdwlan.b09 with qca-swiss-army-knife (board-2.json
# in this dir carries the board-id mapping: qmi-board-id=ff for bdwlan.bin,
# =9 for bdwlan.b09). linux-firmware-ath10k ships generic WCN3990
# board-2.bin.zst/firmware-5.bin.zst in the same directory; no name conflict,
# and ours win because the firmware loader tries the uncompressed name across
# every search path before any .zst (drivers/base/firmware_loader/main.c).
#
# fpctzappfingerprint.mdt/.bNN (the FPC fingerprint sensor's TrustZone
# trustlet) is not in TheMuppets' tree either, and unlike mba.mbn/modem.mbn
# it isn't on the modem partition -- it lives at /firmware/ inside
# vendor.img, which is an Android-sparse ext4 nested two zips deep in the
# same factory zip already fetched for the radio image. unpack() streams
# both zip layers, unsparses with simg2img, and reads the nine files out
# with debugfs -- no mount, no root required. It ships as the
# firmware-google-taimen-fingerprint subpackage, split .mdt + .bNN and
# unsquashed (see that subpackage's function for why), and nothing depends
# on it: see the WARNING below about what installing anything in this
# APKBUILD does, which applies equally to the subpackage.
#
# adsp.mbn / slpi_v2.mbn / ipa_fws.mbn: TheMuppets ships these PIL-split as
# foo.mdt + foo.b00..bNN; pil-squasher welds them back into the single .mbn
# our DT asks for. a540_zap.elf and wlanmdsp.mbn ship already combined --
# installed verbatim, just renamed to match the DT's firmware-name.
#
# Not included, deliberately:
#   a530_* GPU firmware comes from firmware-qcom-adreno-a530.
#
# WARNING -- INSTALLING THIS PACKAGE FLASHES boot_b.
#
# Files under /lib/firmware fire mkinitfs's apk trigger, mkinitfs calls
# boot-deploy, and boot-deploy on this device ends with `dd` of a freshly
# built boot.img onto the boot_b partition. So a routine `apk add
# firmware-google-taimen`, and equally a routine `apk fix`, is a FLASH -- in
# the middle of whatever else is running. It is not a slot switch and it does
# not change which kernel is installed, but an interrupted write does leave
# an unbootable slot.
#
# To land the files without any of that:
#
#     apk add --no-scripts firmware-google-taimen
#
# Nothing this package ships is read from the initramfs -- the modem, ath10k
# and the GPU all load after switch-root -- so skipping the trigger costs
# nothing. Drop --no-scripts only when you actually want a new boot.img.

pkgname=firmware-google-taimen
pkgver=20250505
pkgrel=8
pkgdesc="Firmware for Google Pixel 2 XL (adsp, slpi, wlan, bluetooth, gpu zap, modem)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !archcheck !strip !tracedeps !spdx pmb:cross-native"
makedepends="qca-swiss-army-knife pil-squasher"
depends="
	firmware-qcom-adreno-a530
	linux-firmware-ath10k
	linux-firmware-qca
"
subpackages="$pkgname-fingerprint:_fingerprint"
_commit="d1a4f0d0ea34157875751c812c9887550e216c5a"
_repo="TheMuppets/proprietary_vendor_google_taimen"
_firmware_commit="d7bdad8e5599eefbafb6fa454f0967b01af8f76f"
source="
	$pkgname-$_commit.tar.gz::https://github.com/$_repo/archive/$_commit.tar.gz
	fpctzappfingerprint.b00::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b00
	fpctzappfingerprint.b01::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b01
	fpctzappfingerprint.b02::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b02
	fpctzappfingerprint.b03::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b03
	fpctzappfingerprint.b04::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b04
	fpctzappfingerprint.b05::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b05
	fpctzappfingerprint.b06::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b06
	fpctzappfingerprint.b07::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.b07
	fpctzappfingerprint.mdt::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/fingerprint/fpctzappfingerprint.mdt
	mba.mbn::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/modem/mba.mbn
	modem.mbn::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/modem/modem.mbn
	modemr.jsn::https://raw.githubusercontent.com/porthole-dev/firmware-google-taimen/$_firmware_commit/google-factory/modem/modemr.jsn
	board-2.json
	"
builddir="$srcdir/proprietary_vendor_google_taimen-$_commit/proprietary/vendor/firmware"

build() {
	pil-squasher adsp.mbn adsp.mdt
	pil-squasher slpi_v2.mbn slpi_v2.mdt
	pil-squasher ipa_fws.mbn ipa_fws.mdt

	# venus, the video accelerator. The vendor tree ships a pre-made
	# venus.mbn alongside the .mdt/.bNN set, but squash our own from the
	# .mdt like every other blob here: that is exactly the layout
	# qcom_mdt_load() expects, and it does not depend on how whoever
	# assembled the vendor tree produced theirs.
	pil-squasher venus-fw.mbn venus.mdt

	cp "$srcdir"/board-2.json .
	ath10k-bdencoder -c board-2.json -o board-2.bin
	ath10k-fwencoder --create \
		--features=wowlan,mgmt-tx-by-ref,non-bmi,single-chan-info-per-channel \
		--set-wmi-op-version=tlv --set-htt-op-version=tlv --set-fw-api=5
}

package() {
	local _fw="$pkgdir"/lib/firmware
	install -d "$_fw"/qcom/msm8998/wahoo "$_fw"/qca "$_fw"/ath10k/WCN3990/hw1.0

	install -Dm644 adsp.mbn slpi_v2.mbn ipa_fws.mbn wlanmdsp.mbn modemuw.jsn \
		-t "$_fw"/qcom/msm8998/wahoo/
	install -Dm644 a540_zap.elf "$_fw"/qcom/msm8998/wahoo/a540_zap.mbn

	# The Adreno 540 GPMU firmware. firmware-qcom-adreno-a530 ships the a530
	# parts and a530v3_gpmu.fw2, but nothing upstream carries a540_gpmu.fw2,
	# and msm asks for it by that exact name. Without it adreno_request_fw()
	# fails with -ENOENT, the GPU never initialises, wlroots cannot create a
	# renderer, phoc exits, and greetd gives up -- i.e. no display at all,
	# with nothing in the log that mentions the GPU unless you go looking.
	install -Dm644 a540_gpmu.fw2 -t "$_fw"/qcom/

	# The venus decoder firmware. The driver asks for this exact path --
	# core.c msm8998_res.fwname = "qcom/venus-4.4/venus.mbn" -- and without
	# it the node probes and then fails to boot the core, so every video
	# frame falls back to the CPU.
	install -Dm644 venus-fw.mbn "$_fw"/qcom/venus-4.4/venus.mbn

	# mba.mbn / modem.mbn: from Google's factory image -- see header.
	# modemr.jsn comes from there too: it is the modem ROOT protection-domain
	# map, and pd-mapper needs it alongside modemuw.jsn (the modem USER pd,
	# which carries the wlan/fw service ath10k_snoc blocks on). With only one
	# of the two, pd-mapper exits "no pd maps available" and WiFi never comes
	# up. It lives on the modem partition, not in vendor.img, so it was lost
	# when the rest of this package moved to TheMuppets in pkgrel 1.
	install -Dm644 "$srcdir"/mba.mbn \
		"$srcdir"/modem.mbn \
		"$srcdir"/modemr.jsn \
		-t "$_fw"/qcom/msm8998/wahoo/

	install -Dm644 crbtfw21.tlv crnv21.bin -t "$_fw"/qca/
	# TAS2557 speaker amp uCDSP firmware -- without it the codec probe fails
	# and the whole sound card defers forever (silent phone).
	install -Dm644 tas2557s_PG21_uCDSP.bin tas2557s_uCDSP.bin -t "$_fw"/

	install -Dm644 board-2.bin firmware-5.bin -t "$_fw"/ath10k/WCN3990/hw1.0/

	find "$pkgdir"/lib/firmware -type f -exec chmod 644 {} +
}

_fingerprint() {
	pkgdesc="FPC fingerprint trustlet for the Pixel 2 XL (opt-in)"
	# Deliberately NOT a dependency of the device package. This is a
	# proprietary TrustZone application; nothing on a default install
	# should pull it in. It is useful only with the qseecom-ta transport.
	depends=""
	# Unlike adsp/slpi/ipa_fws/venus above, this .mdt + .bNN set is
	# installed as-is, NOT pil-squasher'd into one .mbn. The loader for
	# this blob (Task 5 in the fingerprint-trustlet-transport campaign)
	# uses qcom_mdt_load(), which opens the .mdt and then requests each
	# .bNN segment itself by name -- that split *is* the layout it wants,
	# so squashing them here would only have to be undone there.
	install -Dm644 "$srcdir"/fpctzappfingerprint.mdt \
		"$subpkgdir"/lib/firmware/qcom/msm8998/taimen/fpctzappfingerprint.mdt
	local _s
	for _s in b00 b01 b02 b03 b04 b05 b06 b07; do
		install -Dm644 "$srcdir"/fpctzappfingerprint.$_s \
			"$subpkgdir"/lib/firmware/qcom/msm8998/taimen/fpctzappfingerprint.$_s
	done
}

