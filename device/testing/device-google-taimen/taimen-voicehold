#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Hold the voice front-end's uplink running for as long as a call is up.

A call carries no samples across the application processor: the modem exchanges
speech with the ADSP and the ADSP drives the codec. But in this stack only a
PCM powers an AFE port, and q6voice starts the session once both directions
have prepared -- so something has to open the front-end and keep it up. Android's
audio HAL is what does that there, and it starts the stream too.

STARTING it is not optional, which cost a day to establish: the codec only puts
the microphone on the SLIMbus from wcd934x_trigger(), so a stream that is merely
open and prepared powers the entire DAPM path, configures the AFE port, creates
the vocproc -- and moves no data at all. See hold().

The DOWNLINK is not this script's job: 52-taimen-voice.conf makes the sound
server hold that one open with node.always-process, which is the mechanism for
a device node nothing is linked to. Taking it here instead would work right up
until the sound server probed the profile, found the PCM busy and dropped the
profile entirely. The uplink has no such owner -- the verb declares no capture
device, deliberately -- so it falls to this.

WHY THIS WAITS FOR THE MODEM, rather than opening when the verb is enabled:
q6voice creates the session as soon as both directions have prepared, and a
CREATE_PASSIVE issued when the modem has no session of its own does not join
one -- it allocates a fresh session, answers status 0 to every command that
follows, and carries no call audio at all. The sound server enables this verb
once at startup merely to probe the profile, so opening on the verb alone
guarantees exactly that useless session. The modem reporting an ACTIVE call is
the signal that there is something to join.

Started from the Voice Call verb's EnableSequence and stopped from HiFi's --
NOT from Voice Call's DisableSequence. ACP models each UCM device as its own
card profile, so pressing the loudspeaker button cycles the whole verb
(measured: VERB-DISABLE, VERB-ENABLE, DEV-SPEAKER), and releasing there would
tear the route down under a live session.

Usage: taimen-voicehold watch|stop|selftest
"""
import ctypes
import os
import re
import signal
import subprocess
import sys
import time

PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/run",
                       "taimen-voicehold.pid")

SND_PCM_STREAM_CAPTURE = 1
SND_PCM_FORMAT_S16_LE = 2
SND_PCM_ACCESS_RW_INTERLEAVED = 3

CALL_PATH = re.compile(r"/org/freedesktop/ModemManager1/Call/\d+")
POLL_SECONDS = 1


def voice_pcm(lines):
    """hw:<card>,<device> of the VoiceMMode1 front-end, or None."""
    for line in lines:
        if "VoiceMMode1" in line:
            card, device = line.split(":", 1)[0].split("-")
            return "hw:%d,%d" % (int(card), int(device))

    return None


def _mmcli(*args):
    try:
        return subprocess.run(("mmcli",) + args, capture_output=True,
                              text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def call_active(states):
    """True if any of these mmcli call-state readings says active."""
    return any(state == "active" for state in states)


def call_states():
    """The state of every call the modem currently has."""
    states = []
    for path in CALL_PATH.findall(_mmcli("-m", "any", "--voice-list-calls")):
        out = _mmcli("-m", "any", "--call", path.rsplit("/", 1)[1],
                     "--output-keyvalue")
        for line in out.splitlines():
            key, _, value = line.partition(":")
            if key.strip() == "call.properties.state":
                states.append(value.strip())

    return states


def hold(asound, device):
    """Open, prepare and START the uplink. The start is what carries the call.

    slim_stream_prepare() and slim_stream_enable() are called from
    wcd934x_trigger() and from nowhere else in the tree, so the codec puts the
    microphone on the SLIMbus only once the stream is STARTED. Everything else
    a call needs is already in place before that: DAPM has powered SLIM TX7,
    the AFE port is up, and the vocproc is created with tx=0x4001. None of it
    moves a sample.

    Nothing has to be READ, which is what made this look like an ADM problem
    for a day. Measured on this front-end with a kprobe on slim_stream_enable:
    open+set_params+prepare fires nothing; adding snd_pcm_start() and never
    reading a frame fires it. That -- not an ASM session, not an ADM copp --
    is all the throwaway `arecord` on MultiMedia2 ever contributed: it started
    the same SLIMBUS_0_TX back-end. It is deleted.

    It is also why the downlink never needed scaffolding: the sound server does
    not merely open the sink, it streams to it.
    """
    handle = ctypes.c_void_p()

    if asound.snd_pcm_open(ctypes.byref(handle), device.encode(),
                           SND_PCM_STREAM_CAPTURE, 0) < 0:
        return None

    if asound.snd_pcm_set_params(handle, SND_PCM_FORMAT_S16_LE,
                                 SND_PCM_ACCESS_RW_INTERLEAVED,
                                 1, 48000, 1, 500000) < 0 or \
       asound.snd_pcm_prepare(handle) < 0 or \
       asound.snd_pcm_start(handle) < 0:
        asound.snd_pcm_close(handle)
        return None

    return handle


def running():
    try:
        with open(PIDFILE) as f:
            os.kill(int(f.read()), 0)
    except (OSError, ValueError):
        return False

    return True


def watch():
    # ponytail: check-then-fork, not a lock. The verb enables once per profile
    # change, so the window is theoretical; take a lock if that ever changes.
    if running():
        return 0

    device = voice_pcm(open("/proc/asound/pcm"))
    if not device:
        print("no VoiceMMode1 front-end on this card", file=sys.stderr)
        return 1

    # UCM runs this from inside the sound server's sequence and waits for it,
    # so the watcher cannot be this process.
    if os.fork():
        return 0
    os.setsid()

    with open(PIDFILE, "w") as f:
        f.write("%d\n" % os.getpid())
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))

    asound = ctypes.CDLL("libasound.so.2")
    handle = None
    while True:
        if call_active(call_states()):
            if handle is None:
                handle = hold(asound, device)
                if handle is None:
                    print("%s capture would not start -- is the verb routed?"
                          % device, file=sys.stderr)
        elif handle is not None:
            asound.snd_pcm_close(handle)
            handle = None
        time.sleep(POLL_SECONDS)


def stop():
    try:
        with open(PIDFILE) as f:
            os.kill(int(f.read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass

    try:
        os.unlink(PIDFILE)
    except OSError:
        pass

    return 0


def selftest():
    assert voice_pcm(["00-00: MultiMedia1 (*) :  : playback 1 : capture 1",
                      "00-02: VoiceMMode1 (*) :  : playback 1 : capture 1"]) \
        == "hw:0,2"
    assert voice_pcm(["01-13: VoiceMMode1 (*) :  : playback 1"]) == "hw:1,13"
    assert voice_pcm(["00-00: MultiMedia1 (*) :  : playback 1"]) is None
    assert call_active(["active"])
    assert call_active(["ringing-in", "active"])
    assert not call_active(["dialing"])
    assert not call_active([])
    print("ok")

    return 0


if __name__ == "__main__":
    verbs = {"watch": watch, "stop": stop, "selftest": selftest}
    verb = verbs.get(sys.argv[1] if len(sys.argv) > 1 else "")
    if not verb:
        sys.exit(__doc__.strip().splitlines()[-1])
    sys.exit(verb())
