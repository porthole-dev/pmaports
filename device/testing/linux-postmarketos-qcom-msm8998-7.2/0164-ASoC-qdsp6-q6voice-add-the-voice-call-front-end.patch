From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Wed, 26 Aug 2026 02:00:01 +0200
Subject: [PATCH] ASoC: qdsp6: q6voice: add the voice call front-end

A voice call carries no samples across the application processor, so this
front-end carries none either. It exists so that opening it powers the
AFE ports the ADSP renders the call into.

That indirection is the whole point. q6afe_port_start() is called from
q6afe_dai_prepare(), a DAI operation, and every qdsp6 DAPM widget is
SND_SOC_NOPM -- so in this stack a mixer control can route a path but
only a PCM can power one. Without a front-end the ports are never
started, the session still reports success at every step, and the call is
silent; the ports had to be held open with unrelated streams to get audio
at all, and ASoC then powered the backend down mid-call when pmdown_time
expired.

The ports are read back from the DPCM back-ends rather than hardcoded, so
a board describes its own wiring. Both directions must be up before the
session is created and each substream only knows its own back-ends, so
the call starts once playback and capture have both prepared and ends
when both are gone.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 sound/soc/qcom/Kconfig             |   4 +
 sound/soc/qcom/qdsp6/Makefile      |   1 +
 sound/soc/qcom/qdsp6/q6voice-dai.c | 270 +++++++++++++++++++++++++++++
 3 files changed, 275 insertions(+)
 create mode 100644 sound/soc/qcom/qdsp6/q6voice-dai.c

diff --git a/sound/soc/qcom/Kconfig b/sound/soc/qcom/Kconfig
index 24d49940c749..677fa6b02d97 100644
--- a/sound/soc/qcom/Kconfig
+++ b/sound/soc/qcom/Kconfig
@@ -143,6 +143,9 @@ config SND_SOC_QDSP6_USB
 config SND_SOC_QDSP6_VOICE
 	tristate
 
+config SND_SOC_QDSP6_VOICE_DAI
+	tristate
+
 config SND_SOC_QDSP6_VOICE_DBG
 	tristate "Raw APR access to the QDSP6 voice services (bring-up)"
 	depends on QCOM_APR
@@ -167,6 +170,7 @@ config SND_SOC_QDSP6
 	select SND_SOC_QDSP6_ASM
 	select SND_SOC_QDSP6_ASM_DAI
 	select SND_SOC_QDSP6_VOICE
+	select SND_SOC_QDSP6_VOICE_DAI
 	select SND_SOC_TOPOLOGY
 	select SND_SOC_QDSP6_APM
 	select SND_SOC_QDSP6_PRM
diff --git a/sound/soc/qcom/qdsp6/Makefile b/sound/soc/qcom/qdsp6/Makefile
index 343729c7ee32..1ac8dee5078b 100644
--- a/sound/soc/qcom/qdsp6/Makefile
+++ b/sound/soc/qcom/qdsp6/Makefile
@@ -19,4 +19,5 @@ obj-$(CONFIG_SND_SOC_QDSP6_PRM) += q6prm.o
 obj-$(CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS) += q6prm-clocks.o
 obj-$(CONFIG_SND_SOC_QDSP6_USB) += q6usb.o
 obj-$(CONFIG_SND_SOC_QDSP6_VOICE) += q6voice.o
+obj-$(CONFIG_SND_SOC_QDSP6_VOICE_DAI) += q6voice-dai.o
 obj-$(CONFIG_SND_SOC_QDSP6_VOICE_DBG) += q6voice-dbg.o
diff --git a/sound/soc/qcom/qdsp6/q6voice-dai.c b/sound/soc/qcom/qdsp6/q6voice-dai.c
new file mode 100644
index 000000000000..4883b57af2ab
--- /dev/null
+++ b/sound/soc/qcom/qdsp6/q6voice-dai.c
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Voice call front-end for the QDSP6 ADSP.
+ *
+ * A voice call carries no samples across the application processor, so this
+ * front-end carries none either: it exists so that opening it powers the AFE
+ * ports the ADSP renders the call into.
+ *
+ * That indirection is not decoration. q6afe_port_start() is called from
+ * q6afe_dai_prepare(), a DAI operation, and every qdsp6 DAPM widget is
+ * SND_SOC_NOPM -- so in this stack a mixer control can route a path but only a
+ * PCM can power one. Without a front-end the ports are never started, the
+ * session comes up reporting success at every step, and the call is silent.
+ *
+ * Both directions have to be up before the session is created, and each
+ * substream only knows about its own back-ends, so the call starts once
+ * playback and capture have both prepared and ends when both are gone.
+ *
+ * Copyright (c) 2026 Giuseppe Maggio
+ */
+
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm.h>
+#include <sound/soc.h>
+#include <sound/soc-dpcm.h>
+
+#include "q6afe.h"
+#include "q6voice.h"
+
+#define DRV_NAME "q6voice-dai"
+
+struct q6voice_dai {
+	struct mutex lock;	/* pairs the two directions */
+	u16 rx_port;
+	u16 tx_port;
+	bool started;
+	u64 started_ns[2];		/* per direction, for the position */
+};
+
+/*
+ * The ports are whatever the card routed this front-end to, so read them back
+ * from the DPCM back-ends rather than hardcoding a board's wiring.
+ */
+static int q6voice_dai_find_port(struct snd_pcm_substream *substream, u16 *port)
+{
+	struct snd_soc_pcm_runtime *fe = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dpcm *dpcm;
+	int id;
+
+	for_each_dpcm_be(fe, substream->stream, dpcm) {
+		struct snd_soc_pcm_runtime *be = dpcm->be;
+
+		id = q6afe_get_port_id(snd_soc_rtd_to_cpu(be, 0)->id);
+		if (id < 0)
+			continue;
+
+		*port = id;
+
+		return 0;
+	}
+
+	return -ENODEV;
+}
+
+static int q6voice_dai_prepare(struct snd_soc_component *component,
+			       struct snd_pcm_substream *substream)
+{
+	struct q6voice_dai *v = snd_soc_component_get_drvdata(component);
+	u16 port;
+	int ret;
+
+	ret = q6voice_dai_find_port(substream, &port);
+	if (ret) {
+		dev_err(component->dev, "voice %s is not routed to a port\n",
+			substream->stream == SNDRV_PCM_STREAM_PLAYBACK ?
+			"playback" : "capture");
+		return ret;
+	}
+
+	guard(mutex)(&v->lock);
+
+	v->started_ns[substream->stream] = ktime_get_ns();
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		v->rx_port = port;
+	else
+		v->tx_port = port;
+
+	if (v->started || !v->rx_port || !v->tx_port)
+		return 0;
+
+	ret = q6voice_start(v->rx_port, v->tx_port);
+	if (ret)
+		return ret;
+
+	v->started = true;
+
+	return 0;
+}
+
+static int q6voice_dai_close(struct snd_soc_component *component,
+			     struct snd_pcm_substream *substream)
+{
+	struct q6voice_dai *v = snd_soc_component_get_drvdata(component);
+
+	guard(mutex)(&v->lock);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		v->rx_port = 0;
+	else
+		v->tx_port = 0;
+
+	if (v->started && !v->rx_port && !v->tx_port) {
+		q6voice_stop();
+		v->started = false;
+	}
+
+	return 0;
+}
+
+/*
+ * Nothing ever reads or writes the buffer -- userspace holds the stream open
+ * for the duration of the call and that is all. It exists because a DPCM
+ * front-end must present a PCM.
+ */
+/*
+ * Downstream's voice PCM has no .pointer and no .copy at all: its HAL opens
+ * the stream and never transfers through it, so the question never arises. A
+ * sound server does transfer, though -- selecting the voice profile gives it a
+ * sink and it writes silence into it -- so this one has to tolerate a reader
+ * and a writer even though the samples go nowhere.
+ *
+ * The buffer is deliberately large. With a position derived from the wall
+ * clock, a small buffer wraps faster than a client polls -- 2048 frames at
+ * 48 kHz is 43 ms -- and capture reads that as an underrun and fails with
+ * -EIO. 64 KiB is ~0.68 s at the same rate, which no longer races the reader.
+ */
+static const struct snd_pcm_hardware q6voice_dai_hardware = {
+	.info			= SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER |
+				  SNDRV_PCM_INFO_PAUSE |
+				  SNDRV_PCM_INFO_RESUME,
+	.formats		= SNDRV_PCM_FMTBIT_S16_LE,
+	.rates			= SNDRV_PCM_RATE_8000_48000,
+	.rate_min		= 8000,
+	.rate_max		= 48000,
+	.channels_min		= 1,
+	.channels_max		= 1,
+	.buffer_bytes_max	= 64 * 1024,
+	.period_bytes_min	= 4096,
+	.period_bytes_max	= 16 * 1024,
+	.periods_min		= 2,
+	.periods_max		= 16,
+};
+
+static int q6voice_dai_open(struct snd_soc_component *component,
+			    struct snd_pcm_substream *substream)
+{
+	snd_soc_set_runtime_hwparams(substream, &q6voice_dai_hardware);
+
+	return 0;
+}
+
+/*
+ * No samples cross the application processor, so there is no DMA position to
+ * report -- but a PCM that never advances looks stalled and a transfer fails
+ * with -EIO. Report the wall clock instead, which is what this stream really
+ * does: it occupies the route for as long as the call lasts.
+ *
+ * Deliberately NOT a timer calling snd_pcm_period_elapsed(). That was tried:
+ * from the timer callback it runs with preemption disabled, and the result was
+ * "BUG: scheduling while atomic: swapper/7/0" followed by a hard lockup and a
+ * watchdog reset -- on a device carrying a live call. A position that a reader
+ * may find stale is a far better failure than one that resets the SoC.
+ */
+static snd_pcm_uframes_t
+q6voice_dai_pointer(struct snd_soc_component *component,
+		    struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct q6voice_dai *v = snd_soc_component_get_drvdata(component);
+	u64 elapsed, started = v->started_ns[substream->stream];
+
+	if (!started || !runtime->buffer_size)
+		return 0;
+
+	elapsed = div_u64((ktime_get_ns() - started) * runtime->rate,
+			  NSEC_PER_SEC);
+
+	return do_div(elapsed, runtime->buffer_size);
+}
+
+static int q6voice_dai_pcm_new(struct snd_soc_component *component,
+			       struct snd_soc_pcm_runtime *rtd)
+{
+	snd_pcm_set_managed_buffer_all(rtd->pcm, SNDRV_DMA_TYPE_CONTINUOUS,
+				       component->dev, 64 * 1024, 64 * 1024);
+
+	return 0;
+}
+
+static const struct snd_soc_component_driver q6voice_fe_component = {
+	.name			= DRV_NAME,
+	.open			= q6voice_dai_open,
+	.close			= q6voice_dai_close,
+	.prepare		= q6voice_dai_prepare,
+	.pointer		= q6voice_dai_pointer,
+	.pcm_new			= q6voice_dai_pcm_new,
+	.legacy_dai_naming	= 1,
+};
+
+static struct snd_soc_dai_driver q6voice_fe_dai = {
+	.playback = {
+		.stream_name = "VoiceMMode1 Playback",
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+		.channels_min = 1,
+		.channels_max = 1,
+		.rate_min = 8000,
+		.rate_max = 48000,
+	},
+	.capture = {
+		.stream_name = "VoiceMMode1 Capture",
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+		.channels_min = 1,
+		.channels_max = 1,
+		.rate_min = 8000,
+		.rate_max = 48000,
+	},
+	.name = "VoiceMMode1",
+	.id = 0,
+};
+
+static int q6voice_dai_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct q6voice_dai *v;
+
+	v = devm_kzalloc(dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return -ENOMEM;
+
+	mutex_init(&v->lock);
+	dev_set_drvdata(dev, v);
+
+	return devm_snd_soc_register_component(dev, &q6voice_fe_component,
+					       &q6voice_fe_dai, 1);
+}
+
+static const struct of_device_id q6voice_dai_device_id[] = {
+	{ .compatible = "qcom,q6voice-dais" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, q6voice_dai_device_id);
+
+static struct platform_driver q6voice_dai_platform_driver = {
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = of_match_ptr(q6voice_dai_device_id),
+	},
+	.probe = q6voice_dai_probe,
+};
+module_platform_driver(q6voice_dai_platform_driver);
+
+MODULE_DESCRIPTION("Q6 Voice call front-end");
+MODULE_LICENSE("GPL");
