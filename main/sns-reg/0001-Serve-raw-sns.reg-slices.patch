--- a/main.c
+++ b/main.c
@@ -24,6 +24,82 @@
 #define LINE_SIZE	0x100
 #define BUFFER_LEN	0x1000
 
+#define REG_BIN		"/etc/sns-reg.d/sns.reg"
+#define REG_MAP		"/etc/sns-reg.d/groups.conf"
+#define SLOT_MAX	256
+
+/*
+ * ponytail: serve raw slices of the stock sns.reg instead of reassembling
+ * groups from per-key values. The (group, offset, size) table below is the
+ * one sensors.qcom itself uses, so every group SSC asks for is covered --
+ * the hand-derived key map in map.c is missing 15 of the 53 groups taimen's
+ * SMGR reads, and a short/failed answer makes it assert in sns_smgr_reg.c.
+ */
+struct slot {
+	unsigned short id;
+	unsigned short addr;
+	unsigned short size;
+};
+
+static struct slot slots[SLOT_MAX];
+static int slot_count;
+static unsigned char *reg_blob;
+static size_t reg_blob_len;
+
+static const struct slot *slot_by_id(unsigned short id)
+{
+	int i;
+
+	for (i = 0; i < slot_count; i++)
+		if (slots[i].id == id)
+			return &slots[i];
+
+	return NULL;
+}
+
+static int load_registry(void)
+{
+	char line[LINE_SIZE];
+	struct stat st;
+	FILE *file;
+	int fd;
+
+	fd = open(REG_BIN, O_RDONLY);
+	if (fd < 0 || fstat(fd, &st) < 0) {
+		fprintf(stderr, "Failed to open " REG_BIN ": %s\n", strerror(errno));
+		return -1;
+	}
+	reg_blob_len = st.st_size;
+	reg_blob = mmap(NULL, reg_blob_len, PROT_READ, MAP_PRIVATE, fd, 0);
+	close(fd);
+	if (reg_blob == MAP_FAILED) {
+		fprintf(stderr, "Failed to map " REG_BIN ": %s\n", strerror(errno));
+		return -1;
+	}
+
+	file = fopen(REG_MAP, "r");
+	if (!file) {
+		fprintf(stderr, "Failed to open " REG_MAP ": %s\n", strerror(errno));
+		return -1;
+	}
+	while (fgets(line, LINE_SIZE, file) && slot_count < SLOT_MAX) {
+		struct slot *s = &slots[slot_count];
+
+		if (sscanf(line, "%hu %hu %hu", &s->id, &s->addr, &s->size) != 3)
+			continue;
+		if ((size_t)s->addr + s->size > reg_blob_len) {
+			fprintf(stderr, "Group %u overruns the registry, dropped\n", s->id);
+			continue;
+		}
+		slot_count++;
+	}
+	fclose(file);
+
+	printf("Loaded %zu byte registry, %d groups\n", reg_blob_len, slot_count);
+
+	return slot_count ? 0 : -1;
+}
+
