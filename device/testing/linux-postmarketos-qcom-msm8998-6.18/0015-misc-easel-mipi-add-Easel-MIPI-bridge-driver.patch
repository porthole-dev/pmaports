+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_EASEL_MIPI_H
+#define _LINUX_EASEL_MIPI_H
+
+/*
+ * Pulse Easel TX @txdev's continuous clock lane through LP-11 for ~5 ms.
+ *
+ * The msm8998 CSIPHY arms its clock-lane detector only on an LP->HS
+ * transition seen AFTER the CSIPHY is configured; Easel's continuous clock
+ * runs from easel-mipi probe, so without this pulse no capture session can
+ * ever lock (first frames 2026-08-04 were unlocked by exactly this).
+ * Sensors call it right after starting their MIPI output, which the media
+ * pipeline guarantees is after CSIPHY config. No-op if easel-mipi is not
+ * bound. Sleeps; process context only.
+ */
+void easel_mipi_kick(unsigned int txdev);
+
+#endif
