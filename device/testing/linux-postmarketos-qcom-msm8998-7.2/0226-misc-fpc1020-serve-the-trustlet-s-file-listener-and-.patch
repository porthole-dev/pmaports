+	wait_queue_head_t listener_rsp_wq;
 };
-#define FPC1020_TEE_IOC_XFER _IOWR('F', 0x01, struct fpc1020_tee_xfer)
 
 static irqreturn_t fpc1020_irq_handler(int irq, void *data)
 {
 	struct fpc1020 *fpc1020 = data;
 
-	atomic_set(&fpc1020->latched, 1);
-	sysfs_notify(&fpc1020->dev->kobj, NULL, "irq");
+	pm_wakeup_event(fpc1020->dev, 1000);
 	wake_up_interruptible(&fpc1020->irq_wq);
+	sysfs_notify(&fpc1020->dev->kobj, NULL, "irq");
 
 	return IRQ_HANDLED;
 }
@@ -248,22 +179,10 @@ static ssize_t irq_show(struct device *dev, struct device_attribute *attr,
 {
 	struct fpc1020 *fpc1020 = dev_get_drvdata(dev);
 
-	return sysfs_emit(buf, "%d\n", atomic_read(&fpc1020->latched));
+	return sysfs_emit(buf, "%d\n",
+			  gpiod_get_value_cansleep(fpc1020->irq_gpio));
 }
-
-/* Any write clears/re-arms the latch. The value written is not
- * inspected -- only the act of writing matters, matching what the
- * sensor's own HAL protocol does after every wakeup. */
-static ssize_t irq_store(struct device *dev, struct device_attribute *attr,
-			 const char *buf, size_t count)
-{
-	struct fpc1020 *fpc1020 = dev_get_drvdata(dev);
-
