5f36703cc81e28446646c05f7045e3ec9839ab9bac90f7ac9580e7086cf2d718513a9e25226098095eb0ede75c780f6dcd105ab474b94e1b417bc7604560a5b7  config-postmarketos-qcom-msm8998.aarch64
1a34a905f5668d4d2fbc4a623f1cda9f37037e090839b27f7ce5bcdb883658e072726cf462cb6e427f8d43e5131031130631c60c00a016e3b1ca2818722d5aea  1000-taimen-camera-audio-easel-bringup.patch
