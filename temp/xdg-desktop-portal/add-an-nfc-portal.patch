From e328a1516df5f68e898db6bb300a7e0ffe39a25b Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 10 Sep 2026 18:18:48 +0200
Subject: [PATCH 6/9] nfc: free a proxy's slot when the proxy itself dies

The per-sender cap was a lifetime quota rather than a concurrency one. The
only thing that freed a slot was the application leaving the bus: closing
the file descriptor it was handed does not make xdg-dbus-proxy exit, and it
cannot take another client, because the socket it listened on is unlinked.
So a proxy that crashed cost a permitted application one of its connections
for the rest of its bus connection, with no cause it could see and nothing
it could do about it.

Watch each child and drop its entry when it exits. The entry is found by its
GSubprocess rather than by the NfcProxy pointer, because
g_subprocess_wait_async keeps the subprocess alive until the callback runs
whereas the NfcProxy may already have been freed by on_peer_disconnect; when
it has, the lookup finds nothing and does nothing. That is what makes the
two reclaim paths safe to race, and there is now a test that races them.

Say plainly in the comment what is still not reclaimed -- an application
that opens a connection and abandons it while staying on the bus -- rather
than describing that as a supported pattern. Raising the cap would only
delay it; there is no fix short of a change to xdg-dbus-proxy.

Also rename the test override to XDP_DBUS_PROXY: XDG_ is the freedesktop
base-directory namespace, and every other override in this daemon is XDP_.

Report hitting the cap as Failed rather than NotAllowed. NotAllowed is this
portal's answer to "you do not have permission", and the one sensible thing
an application can do with it is ask the user for permission -- which it
already holds, so the dialog could not fix what it appeared to be about. The
message names the limit, since a developer reading a journal has no other
way to see the cause.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 src/nfc.c         |  86 +++++++++++++++++++++++++++-----
 tests/test_nfc.py | 124 ++++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 194 insertions(+), 16 deletions(-)

diff --git a/src/nfc.c b/src/nfc.c
index 2862ecc..a3d63e1 100644
--- a/src/nfc.c
+++ b/src/nfc.c
@@ -271,11 +271,28 @@ static const char * const nfc_proxy_filter[] = {
   "--broadcast=org.neard=*@/org/neard/*",
 };
 
-/* One connection is what an application needs; a couple more leaves room for
- * one that opens a second before dropping the first. The cap exists because
- * every live proxy costs the *portal* a file descriptor and a process, so an
- * application looping on OpenNFCRemote would exhaust xdg-desktop-portal rather
- * than itself, and take every other portal in the session down with it. */
+/* The cap exists because every live proxy costs the *portal* a file descriptor
+ * and a process, so an application looping on OpenNFCRemote would exhaust
+ * xdg-desktop-portal rather than itself, and take every other portal in the
+ * session down with it.
+ *
+ * One connection is all an application needs: a D-Bus connection multiplexes,
+ * so nothing pushes it to open one per tag or per thread. The headroom is for
+ * a proxy that died and was retried -- and it has to be real headroom, because
+ * the reclaim is asynchronous: the application learns its proxy is gone from
+ * its own socket reaching EOF at the same moment we learn from SIGCHLD, so a
+ * prompt retry can arrive before the child watch has dispatched.
+ *
+ * Be clear about what a slot is, though: it is freed when the application
+ * leaves the bus, or when its proxy exits. It is *not* freed when the
+ * application closes the file descriptor it was handed. xdg-dbus-proxy has no
+ * way to tell us its client went away -- it does not exit when a client
+ * disconnects, and it cannot take another one, because the socket it was
+ * listening on has been unlinked. So an application that repeatedly opens a
+ * connection and abandons it will run out for the life of its bus connection.
+ * Raising this number would only delay that; there is no fix short of a
+ * change to xdg-dbus-proxy. Opening once, which is the working pattern, is
+ * unaffected. */
 #define NFC_MAX_PROXIES_PER_SENDER 4
 
 typedef struct
@@ -353,14 +370,15 @@ connect_to (const char  *path,
   return fd;
 }
 
-/* Mirrors flatpak_get_bwrap() in validate-icon.c: the build-time path, with an
- * environment override so the tests can substitute a program that fails. It
- * grants nothing -- anyone who can set this already controls the portal's own
- * process. */
+/* The build-time path, with an environment override so the tests can
+ * substitute a program that fails. The same shape as XDP_VALIDATE_ICON in
+ * xdp-utils.c, and it grants nothing: anyone who can set this already controls
+ * the portal's own process, and with it unrestricted access to the system bus
+ * the proxy exists to filter. */
 static const char *
 nfc_get_dbus_proxy (void)
 {
-  const char *e = g_getenv ("XDG_DBUS_PROXY");
+  const char *e = g_getenv ("XDP_DBUS_PROXY");
 
   if (e != NULL)
     return e;
@@ -481,6 +499,41 @@ count_proxies_for_sender (Nfc        *nfc,
   return n;
 }
 
+static gboolean
+proxy_has_subprocess (gpointer key,
+                      gpointer value,
+                      gpointer user_data)
+{
+  NfcProxy *proxy = key;
+
+  return proxy->subprocess == user_data;
+}
+
+/* A proxy that exits on its own -- it crashed, or something killed it -- must
+ * not hold its slot for the rest of the application's bus connection, because
+ * nothing the application does can free it.
+ *
+ * The proxy is found by its GSubprocess rather than by the NfcProxy pointer:
+ * g_subprocess_wait_async holds a reference to the subprocess until this runs,
+ * so it is always safe to compare, whereas the NfcProxy may already have been
+ * freed by on_peer_disconnect. If it has, g_hash_table_foreach_remove only
+ * visits entries that are still in the table, so this never even sees the
+ * freed NfcProxy -- which is what makes the two paths safe to race.
+ *
+ * The Nfc is kept alive across the wait by the reference taken where it is
+ * armed, so nfc->proxies below is always a live table. */
+static void
+on_proxy_exited (GObject      *source,
+                 GAsyncResult *result,
+                 gpointer      user_data)
+{
+  g_autoptr(Nfc) nfc = user_data;
+
+  g_subprocess_wait_finish (G_SUBPROCESS (source), result, NULL);
+
+  g_hash_table_foreach_remove (nfc->proxies, proxy_has_subprocess, source);
+}
+
 static gboolean
 proxy_is_for_sender (gpointer key,
                      gpointer value,
@@ -537,10 +590,17 @@ handle_open_nfc_remote (XdpDbusNFC            *object,
 
   if (count_proxies_for_sender (nfc, sender) >= NFC_MAX_PROXIES_PER_SENDER)
     {
+      /* Not NOT_ALLOWED: the application holds the permission, so the one
+       * sensible response to being told it does not would be to ask the user
+       * for it again -- a dialog that cannot fix what it appears to be about.
+       * Name the limit in the message, since a developer reading a journal
+       * has no other way to see the cause. */
       g_dbus_method_invocation_return_error (invocation,
                                              XDG_DESKTOP_PORTAL_ERROR,
-                                             XDG_DESKTOP_PORTAL_ERROR_NOT_ALLOWED,
-                                             "Too many NFC connections open");
+                                             XDG_DESKTOP_PORTAL_ERROR_FAILED,
+                                             "Too many NFC connections open "
+                                             "at once (the limit is %d)",
+                                             NFC_MAX_PROXIES_PER_SENDER);
       return G_DBUS_METHOD_INVOCATION_HANDLED;
     }
 
@@ -556,6 +616,8 @@ handle_open_nfc_remote (XdpDbusNFC            *object,
     }
 
   g_hash_table_add (nfc->proxies, proxy);
+  g_subprocess_wait_async (proxy->subprocess, NULL,
+                           on_proxy_exited, g_object_ref (nfc));
 
   out_fd_list = g_unix_fd_list_new ();
   fd_id = g_unix_fd_list_append (out_fd_list, fd, &error);
