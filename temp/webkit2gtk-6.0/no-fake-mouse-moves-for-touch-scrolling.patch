+// Touch drags scroll the page by synthesizing wheel events, and every scroll makes WebCore schedule
+// a fake mouse move to refresh :hover under the pointer. While the page is being driven by touch
+// there is no pointer to refresh hover for, and each fake move costs a hit test plus the layout that
+// hit test forces, so suppress them until a real pointer is seen again. Only ever set from the
+// touch-only gestures, and cleared by any real pointer motion or scroll, so a device with both a
+// touchscreen and a mouse keeps working: the wrong answer in the permissive direction merely
+// restores the default behaviour.
+static void webkitWebViewBaseSetLastInputWasTouch(WebKitWebViewBase* webViewBase, bool lastInputWasTouch)
+{
+    WebKitWebViewBasePrivate* priv = webViewBase->priv;
+    if (priv->lastInputWasTouch == lastInputWasTouch)
+        return;
+
+    priv->lastInputWasTouch = lastInputWasTouch;
+    if (priv->pageProxy)
+        priv->pageProxy->setShouldDispatchFakeMouseMoveEvents(!lastInputWasTouch);
+}
+
