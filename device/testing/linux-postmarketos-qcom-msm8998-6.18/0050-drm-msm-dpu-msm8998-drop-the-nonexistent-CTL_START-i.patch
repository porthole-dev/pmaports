From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sun, 9 Aug 2026 13:02:28 +0200
Subject: [PATCH] drm/msm/dpu: msm8998: drop the nonexistent CTL_START
 interrupts

MSM8998 has no CTL_START interrupt: downstream (mdss_mdp_hwio.h) defines
only the two PP CWB overflow bits in INTR2 -- the CTL start bits at 9..13
exist from SDM845 on. Measured on a Pixel 2 XL: frames complete
(PP_LINE_COUNT reaches vdisplay, the DSI raises CMD_MDP_DONE) while INTR2
bits 9..13 never assert, so every cmd-mode commit spent its whole timeout
in the ctl-start wait and the display never recovered from the first
frame. Drop the bogus indices so the cmd encoder uses the pp-done path.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../gpu/drm/msm/disp/dpu1/catalog/dpu_3_0_msm8998.h  | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_3_0_msm8998.h b/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_3_0_msm8998.h
index f91220496082..b52e3528717a 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_3_0_msm8998.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_3_0_msm8998.h
@@ -37,29 +37,31 @@ static const struct dpu_mdp_cfg msm8998_mdp = {
 	},
 };
 
+/*
+ * No .intr_start: MSM8998 has no CTL_START interrupt. Downstream
+ * (mdss_mdp_hwio.h) defines only the two PP CWB overflow bits in INTR2;
+ * the 9..13 CTL start bits exist from SDM845 on. Measured on a Pixel 2 XL:
+ * frames complete (PP_LINE_COUNT reaches vdisplay, DSI raises CMD_MDP_DONE)
+ * while INTR2 bits 9..13 never assert, so every ctl-start wait times out.
+ */
 static const struct dpu_ctl_cfg msm8998_ctl[] = {
 	{
 		.name = "ctl_0", .id = CTL_0,
 		.base = 0x1000, .len = 0x94,
 		.features = BIT(DPU_CTL_SPLIT_DISPLAY),
-		.intr_start = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR2, 9),
 	}, {
 		.name = "ctl_1", .id = CTL_1,
 		.base = 0x1200, .len = 0x94,
-		.intr_start = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR2, 10),
 	}, {
 		.name = "ctl_2", .id = CTL_2,
 		.base = 0x1400, .len = 0x94,
 		.features = BIT(DPU_CTL_SPLIT_DISPLAY),
-		.intr_start = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR2, 11),
 	}, {
 		.name = "ctl_3", .id = CTL_3,
 		.base = 0x1600, .len = 0x94,
-		.intr_start = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR2, 12),
 	}, {
 		.name = "ctl_4", .id = CTL_4,
 		.base = 0x1800, .len = 0x94,
-		.intr_start = DPU_IRQ_IDX(MDP_SSPP_TOP0_INTR2, 13),
 	},
 };
 
