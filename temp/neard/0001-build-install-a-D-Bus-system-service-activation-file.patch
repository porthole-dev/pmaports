From 6fce23b3fe7ca87e2ccfcacf56b7516288da80a3 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 10 Sep 2026 14:07:36 +0200
Subject: [PATCH] build: install a D-Bus system-service activation file

neard ships no /usr/share/dbus-1/system-services/org.neard.service, so the
message bus has no way to start it on demand -- even though the unit is
already Type=dbus with BusName=org.neard, which only works if something else
gets the daemon running first. Without the activation file, a client that
calls any org.neard method before the systemd unit happens to be up gets
"The name org.neard was not provided by any .service files" instead of an
answer, and nothing recovers that for it.

Add src/org.neard.service.in next to the existing org.neard.conf policy
file, generated the same way neard.service.in already is, and wire it into
Makefile.am to match: dbusservicedir under datadir, dbusservice_DATA to
install the generated file, and the usual EXTRA_DIST/CLEANFILES pair for the
.in source and its generated output.

Assisted-by: Claude
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 Makefile.am              | 7 +++++++
 src/org.neard.service.in | 5 +++++
 2 files changed, 12 insertions(+)
 create mode 100644 src/org.neard.service.in

diff --git a/Makefile.am b/Makefile.am
index 592fb7c..bc2619a 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -111,6 +111,10 @@ dbusdir = ${sysconfdir}/dbus-1/system.d/
 
 dist_dbus_DATA = src/org.neard.conf
 
+dbusservicedir = ${datadir}/dbus-1/system-services
+
+dbusservice_DATA = src/org.neard.service
+
 if SE
 dist_dbus_DATA += se/org.neard.se.conf
 endif
@@ -153,6 +157,9 @@ endif
 EXTRA_DIST += src/neard.service.in
 CLEANFILES += src/neard.service
 
+EXTRA_DIST += src/org.neard.service.in
+CLEANFILES += src/org.neard.service
+
 if TEST
 testdir = $(pkglibdir)/test
 test_SCRIPTS = $(test_scripts)
diff --git a/src/org.neard.service.in b/src/org.neard.service.in
new file mode 100644
index 0000000..f7df805
--- /dev/null
+++ b/src/org.neard.service.in
@@ -0,0 +1,5 @@
+[D-BUS Service]
+Name=org.neard
+Exec=@pkglibexecdir@/neard -n
+User=root
+SystemdService=neard.service
-- 
