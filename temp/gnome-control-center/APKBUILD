# TEMPORARY FORK of community/gnome-control-center.
#
# Adds Privacy > NFC: a page whose switch is org.neard.Adapter Powered, and
# which hides itself where neard reports no adapter. GNOME has no NFC control
# of any kind -- gnome-control-center#2233 was opened and closed the same day
# in 2022 with no discussion, and phosh has never had an issue about it -- so
# the radio on this phone was reachable only from a terminal, or from the
# taimen-nfc-toggle launcher this replaces.
#
# It also carries the Permitted Apps list, reading the same freedesktop
# permission store (table "devices", id "nfc") that org.freedesktop.portal.NFC
# writes -- see temp/xdg-desktop-portal, and
# docs/superpowers/specs/2026-09-10-nfc-toggle-and-portal-design.md.
#
# pkgrel is 50+ so this build outranks Alpine's 50.4-r0 from any repo, while an
# upstream 50.5 still outranks it by design. Bump it whenever the patch changes:
# the patch is not part of pkgver, so apk cannot otherwise tell two builds of
# 50.4 apart.
#
# Also carries users-offer-fingerprint-login-without-gdm.patch: the Users page
# only shows Fingerprint Login when GDM's org.gnome.login-screen schema exists,
# and a Phosh image has no GDM, so a working reader could never be enrolled
# from Settings. The patch treats a missing schema as no policy against it.
#
# NOT YET SUBMITTED upstream: no gnome-control-center MR covers this yet. Drop
# this fork when one lands.

maintainer="Giuseppe Maggio <jertlok@proton.me>"
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Contributor: Pablo Correa Gomez <pabloyoyoista@postmarketos.org>
# Contributor: team/gnome <achill@achill.org>
pkgname=gnome-control-center
pkgver=51.0
pkgrel=54
pkgdesc="GNOME control center"
url="https://gitlab.gnome.org/GNOME/gnome-control-center"
arch="all"
license="GPL-2.0-or-later"
depends="
	accountsservice
	colord
	cups-pk-helper
	dbus:org.freedesktop.Secrets
	malcontent
	openrc-settingsd
	setxkbmap
	"
makedepends="
	accountsservice-dev
	blueprint-compiler
	cairo-dev
	colord-dev
	colord-gtk-dev
	cups-dev
	docbook-xml
	docbook-xsl
	gcr4-dev
	glib-dev
	gmobile-dev
	gnome-bluetooth-dev
	gnome-desktop-dev
	gnome-online-accounts-dev
	gnome-settings-daemon-dev
	gsettings-desktop-schemas-dev
	gsound-dev
	ibus-dev
	itstool
	krb5-dev
	libadwaita-dev
	libgtop-dev
	libgudev-dev
	libnma-dev
	libpwquality-dev
	libsecret-dev
	libwacom-dev
	libxml2-utils
	libxslt
	malcontent-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-dev
	pulseaudio-dev
	samba-dev
	tecla-dev
	udisks2-dev
	upower-dev
	"
options="!check" # needs unpackaged py-dbusmock
install="$pkgname.pre-install $pkgname.pre-upgrade"
subpackages="$pkgname-dbg $pkgname-dev $pkgname-lang $pkgname-doc $pkgname-bash-completion"
source="https://download.gnome.org/sources/gnome-control-center/${pkgver%%.*}/gnome-control-center-$pkgver.tar.xz
	README.alpine
	privacy-add-an-nfc-page.patch
	users-offer-fingerprint-login-without-gdm.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dibus=true \
		-Dlocation-services=enabled \
		-Dmalcontent=true \
		. output

	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	mkdir -p "$pkgdir"/usr/lib/pkgconfig
	mv "$pkgdir"/usr/share/pkgconfig/* "$pkgdir"/usr/lib/pkgconfig
	rmdir "$pkgdir"/usr/share/pkgconfig

	install -Dm0644 "$srcdir"/README.alpine -t "$pkgdir"/usr/share/doc/"$pkgname"
}

