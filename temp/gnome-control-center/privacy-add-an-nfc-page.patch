--- /dev/null
+++ b/panels/privacy/nfc/cc-nfc-page.blp
@@ -0,0 +1,22 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $CcNfcPage: Adw.NavigationPage {
+  title: _("NFC");
+  tag: "nfc";
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {}
+
+    content: Adw.PreferencesPage {
+      Adw.PreferencesGroup {
+        Adw.SwitchRow nfc_row {
+          title: _("_NFC");
+          subtitle: _("Allow permitted apps to use NFC");
+          use-underline: true;
+        }
+      }
+    };
+  };
+}
diff --git a/panels/privacy/nfc/cc-nfc-page.c b/panels/privacy/nfc/cc-nfc-page.c
new file mode 100644
index 0000000..f26f5d6
--- /dev/null
+++ b/panels/privacy/nfc/cc-nfc-page.c
@@ -0,0 +1,285 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
+ * Copyright (C) 2026 Giuseppe Maggio
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "cc-nfc-page.h"
+
+#include <gio/gio.h>
+
+#define NEARD_BUS_NAME      "org.neard"
+#define NEARD_ADAPTER_IFACE "org.neard.Adapter"
+
+/* Unlike the camera page, this switch is not backed by a GSetting. A camera
+ * cannot be powered off, so org.gnome.desktop.privacy disable-camera stands in
+ * for a switch the hardware does not have; an NFC adapter has a real one, and
+ * making it the single source of truth is what keeps the switch honest when
+ * something else changes the radio.
+ */
+struct _CcNfcPage
+{
+  AdwNavigationPage parent_instance;
+
+  AdwSwitchRow *nfc_row;
+
+  GDBusObjectManager *manager;
+  GDBusProxy         *adapter;
+  GCancellable       *cancellable;
+  gboolean            syncing;
+};
+
+G_DEFINE_TYPE (CcNfcPage, cc_nfc_page, ADW_TYPE_NAVIGATION_PAGE)
+
+static void
+sync_switch (CcNfcPage *self)
+{
+  g_autoptr(GVariant) powered = NULL;
+  gboolean active = FALSE;
+
+  if (self->adapter != NULL)
+    powered = g_dbus_proxy_get_cached_property (self->adapter, "Powered");
+
+  if (powered != NULL)
+    active = g_variant_get_boolean (powered);
+
+  /* Moving the switch ourselves must not be mistaken for the user moving it. */
+  self->syncing = TRUE;
+  adw_switch_row_set_active (self->nfc_row, active);
+  self->syncing = FALSE;
+}
+
+static void
+on_powered_set (GObject      *source_object,
+                GAsyncResult *res,
+                gpointer      user_data)
+{
+  g_autoptr(GVariant) reply = NULL;
+  g_autoptr(GError) error = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source_object),
+                                         res,
+                                         &error);
+  if (reply != NULL)
+    return;
+
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  g_warning ("Failed to change the NFC adapter power state: %s", error->message);
+
+  /* The radio did not move, so the switch must not claim it did. */
+  sync_switch (CC_NFC_PAGE (user_data));
+}
+
+static void
+on_switch_active (GObject    *object,
+                  GParamSpec *pspec,
+                  gpointer    user_data)
+{
+  CcNfcPage *self = user_data;
+  gboolean active;
+
+  if (self->syncing || self->adapter == NULL)
+    return;
+
+  active = adw_switch_row_get_active (self->nfc_row);
+
+  g_dbus_connection_call (g_dbus_proxy_get_connection (self->adapter),
+                          NEARD_BUS_NAME,
+                          g_dbus_proxy_get_object_path (self->adapter),
+                          "org.freedesktop.DBus.Properties",
+                          "Set",
+                          g_variant_new ("(ssv)",
+                                         NEARD_ADAPTER_IFACE,
+                                         "Powered",
+                                         g_variant_new_boolean (active)),
+                          NULL,
+                          G_DBUS_CALL_FLAGS_NONE,
+                          -1,
+                          self->cancellable,
+                          on_powered_set,
+                          self);
+}
+
+static void
+set_adapter (CcNfcPage  *self,
+             GDBusProxy *adapter)
+{
+  g_set_object (&self->adapter, adapter);
+
+  /* Nearly no machine has an NFC adapter. The row in the panel follows this
+     through a property binding, so a desktop never sees a dead entry. */
+  gtk_widget_set_visible (GTK_WIDGET (self), adapter != NULL);
+
+  sync_switch (self);
+}
+
+/* (transfer full) (nullable): the first adapter neard is publishing. */
+static GDBusProxy *
+find_adapter (GDBusObjectManager *manager)
+{
+  GList *objects = g_dbus_object_manager_get_objects (manager);
+  GDBusProxy *found = NULL;
+
+  for (GList *l = objects; l != NULL && found == NULL; l = l->next)
+    {
+      GDBusInterface *iface = g_dbus_object_get_interface (G_DBUS_OBJECT (l->data),
+                                                           NEARD_ADAPTER_IFACE);
+
+      if (iface != NULL)
+        found = G_DBUS_PROXY (iface);
+    }
+
+  g_list_free_full (objects, g_object_unref);
+
+  return found;
+}
+
+static void
+on_object_added (GDBusObjectManager *manager,
+                 GDBusObject        *object,
+                 gpointer            user_data)
+{
+  CcNfcPage *self = user_data;
+  g_autoptr(GDBusInterface) iface = NULL;
+
+  if (self->adapter != NULL)
+    return;
+
+  iface = g_dbus_object_get_interface (object, NEARD_ADAPTER_IFACE);
+  if (iface != NULL)
+    set_adapter (self, G_DBUS_PROXY (iface));
+}
+
+static void
+on_object_removed (GDBusObjectManager *manager,
+                   GDBusObject        *object,
+                   gpointer            user_data)
+{
+  CcNfcPage *self = user_data;
+  g_autoptr(GDBusProxy) next = NULL;
+
+  if (self->adapter == NULL)
+    return;
+
+  if (g_strcmp0 (g_dbus_object_get_object_path (object),
+                 g_dbus_proxy_get_object_path (self->adapter)) != 0)
+    return;
+
+  next = find_adapter (manager);
+  set_adapter (self, next);
+}
+
+static void
+on_properties_changed (GDBusObjectManagerClient *manager,
+                       GDBusObjectProxy         *object_proxy,
+                       GDBusProxy               *interface_proxy,
+                       GVariant                 *changed_properties,
+                       const gchar * const      *invalidated_properties,
+                       gpointer                  user_data)
+{
+  CcNfcPage *self = user_data;
+
+  if (interface_proxy != self->adapter)
+    return;
+
+  /* The client has already updated the proxy's cached properties. */
+  sync_switch (self);
+}
+
+static void
+on_manager_ready (GObject      *source_object,
+                  GAsyncResult *res,
+                  gpointer      user_data)
+{
+  CcNfcPage *self;
+  GDBusObjectManager *manager;
+  g_autoptr(GDBusProxy) adapter = NULL;
+  g_autoptr(GError) error = NULL;
+
+  manager = g_dbus_object_manager_client_new_for_bus_finish (res, &error);
+  if (manager == NULL)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Failed to connect to neard: %s", error->message);
+      return;
+    }
+
+  self = user_data;
+  self->manager = manager;
+
+  g_signal_connect_object (manager, "object-added",
+                           G_CALLBACK (on_object_added), self, 0);
+  g_signal_connect_object (manager, "object-removed",
+                           G_CALLBACK (on_object_removed), self, 0);
+  g_signal_connect_object (manager, "interface-proxy-properties-changed",
+                           G_CALLBACK (on_properties_changed), self, 0);
+
+  adapter = find_adapter (manager);
+  set_adapter (self, adapter);
+}
+
+static void
+cc_nfc_page_finalize (GObject *object)
+{
+  CcNfcPage *self = CC_NFC_PAGE (object);
+
+  g_cancellable_cancel (self->cancellable);
+  g_clear_object (&self->cancellable);
+
+  g_clear_object (&self->adapter);
+  g_clear_object (&self->manager);
+
+  G_OBJECT_CLASS (cc_nfc_page_parent_class)->finalize (object);
+}
+
+static void
+cc_nfc_page_class_init (CcNfcPageClass *klass)
+{
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = cc_nfc_page_finalize;
+
+  gtk_widget_class_set_template_from_resource (widget_class, "/org/gnome/control-center/privacy/nfc/cc-nfc-page.ui");
+
+  gtk_widget_class_bind_template_child (widget_class, CcNfcPage, nfc_row);
+}
+
+static void
+cc_nfc_page_init (CcNfcPage *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  /* Hidden until neard says there is an adapter. */
+  gtk_widget_set_visible (GTK_WIDGET (self), FALSE);
+
+  self->cancellable = g_cancellable_new ();
+
+  g_signal_connect (self->nfc_row, "notify::active",
+                    G_CALLBACK (on_switch_active), self);
+
+  g_dbus_object_manager_client_new_for_bus (G_BUS_TYPE_SYSTEM,
+                                            G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_NONE,
+                                            NEARD_BUS_NAME,
+                                            "/",
+                                            NULL, NULL, NULL,
+                                            self->cancellable,
+                                            on_manager_ready,
+                                            self);
+}
