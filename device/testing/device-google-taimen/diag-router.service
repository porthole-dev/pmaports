[Unit]
Description=Qualcomm DIAG router
Documentation=https://github.com/linux-msm/diag
# msm8998 firmware is documented to misbehave without a diag client attached
# (same on OnePlus 5), so keep one running for the modem's whole lifetime.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/bin/diag-router
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
