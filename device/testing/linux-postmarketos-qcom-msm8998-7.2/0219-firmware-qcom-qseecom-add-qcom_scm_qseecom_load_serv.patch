From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Fri, 11 Sep 2026 18:30:42 +0200
Subject: [PATCH] firmware: qcom: qseecom: add
 qcom_scm_qseecom_load_services_image()

qcom_scm_qseecom_app_load() cannot start a 32-bit (ELFCLASS32) QSEE
app until the 32-bit common library ("cmnlib") is resident: the vendor
driver loads it on the first such app_load()
(qseecom_load_commonlib_image(), qseecom.c:4139-4147), rather than
assuming a bootloader or firmware stage already has, and the trustlet
this is being tested against is ELFCLASS32.

Add qcom_scm_qseecom_load_services_image(), issuing
QSEOS_LOAD_SERV_IMAGE_COMMAND (TZ_OS_LOAD_SERVICES_IMAGE_ID =
TZ_SYSCALL_CREATE_SMC_ID(TZ_OWNER_QSEE_OS, TZ_SVC_APP_MGR, 0x07)). Like
qcom_scm_qseecom_app_region_notify(), and unlike
qcom_scm_qseecom_app_load(), the vendor's own dispatch for this command
(qseecom.c, the QSEOS_LOAD_SERV_IMAGE_COMMAND case) passes the image's
address and both lengths as plain scalar SMC arguments, not through a
request buffer -- its "ireq" structs exist only to carry those values
through one C switch statement and are never copied into TZ-visible
memory. Confirmed by reading the vendor dispatch directly rather than
assumed from a neighbouring command's shape, after
qcom_scm_qseecom_app_region_notify() got exactly that assumption wrong
the first time.

The image itself is expected in the same mdt+bNN concatenated layout
qcom_scm_qseecom_app_load() already assembles; the caller assembles it
the same way.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/firmware/qcom/qcom_scm.c       | 66 ++++++++++++++++++++++++++
 include/linux/firmware/qcom/qcom_scm.h |  9 ++++
 2 files changed, 75 insertions(+)

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 85cc2926786a..3b3772f6db39 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -115,6 +115,7 @@ enum qcom_scm_qseecom_tz_cmd_app {
 	QSEECOM_TZ_CMD_APP_SEND			= 1,
 	QSEECOM_TZ_CMD_APP_LOOKUP		= 3,
 	QSEECOM_TZ_CMD_APP_REGION_NOTIFICATION	= 5,
+	QSEECOM_TZ_CMD_LOAD_SERV_IMAGE		= 7,
 	/*
 	 * The command space is per (owner, svc): APP_SEND is
 	 * (TZ_APPS, APP_ID_PLACEHOLDER) and APP_START is (QSEE_OS, APP_MGR),
@@ -2493,6 +2494,71 @@ int qcom_scm_qseecom_app_load(const char *app_name, phys_addr_t img_phys,
 }
 EXPORT_SYMBOL_GPL(qcom_scm_qseecom_app_load);
 
+/**
+ * qcom_scm_qseecom_load_services_image() - Load the QSEE common library.
+ * @img_phys: The image, already laid out in TZ memory the same way
+ *	      qcom_scm_qseecom_app_load() expects (its own .mdt member
+ *	      followed by every .bNN member, in order).
+ * @mdt_len:  Length of the .mdt member.
+ * @img_len:  Combined length of .mdt and every .bNN member.
+ *
+ * QSEE hosts a 32-bit ("cmnlib") and/or 64-bit ("cmnlib64") common library
+ * that ELFCLASS32/ELFCLASS64 apps respectively depend on -- the vendor
+ * driver loads the matching one on the first app_load() of that class
+ * (qseecom.c:4139-4147, qseecom_load_commonlib_image()) unless the platform
+ * has already latched it as loaded some other way. Without it QSEOS_APP_START
+ * for an app of that class can fail outright: TrustZone has nowhere to
+ * resolve the library calls the app was linked against.
+ *
+ * Unlike qcom_scm_qseecom_app_load(), the image address and both lengths are
+ * passed to TrustZone as plain scalar arguments, not through a request
+ * buffer -- the vendor driver's own dispatch for this command (qseecom.c,
+ * the QSEOS_LOAD_SERV_IMAGE_COMMAND case) sets desc.args[0..2] directly from
+ * the values it was given. Its "ireq" structs exist only to carry those
+ * values through that one C switch statement, the same pattern already found
+ * to hold for qcom_scm_qseecom_app_region_notify().
+ *
+ * Return: Zero on success, nonzero on failure.
+ */
+int qcom_scm_qseecom_load_services_image(phys_addr_t img_phys,
+					 size_t mdt_len, size_t img_len)
+{
+	struct qcom_scm_desc desc = {};
+	struct qcom_scm_qseecom_resp res = {};
+	int status;
+
+	status = qcom_scm_qseecom_check_dma32(img_phys, img_len);
+	if (status)
+		return status;
+
+	desc.owner = QSEECOM_TZ_OWNER_QSEE_OS;
+	desc.svc = QSEECOM_TZ_SVC_APP_MGR;
+	desc.cmd = QSEECOM_TZ_CMD_LOAD_SERV_IMAGE;
+	desc.arginfo = QCOM_SCM_ARGS(3, QCOM_SCM_VAL, QCOM_SCM_VAL, QCOM_SCM_VAL);
+	desc.args[0] = mdt_len;
+	desc.args[1] = img_len;
+	desc.args[2] = img_phys;
+
+	status = qcom_scm_qseecom_call(&desc, &res);
+	if (status)
+		return status;
+
+	/* Same INCOMPLETE/BLOCKED_ON_LISTENER split as qcom_scm_qseecom_app_load(). */
+	if (res.result == QSEECOM_RESULT_INCOMPLETE ||
+	    res.result == QSEECOM_RESULT_BLOCKED_ON_LISTENER) {
+		dev_err(__scm->dev,
+			"qseecom: services image load did not complete (result=%llu); likely needs a listener callback this driver does not implement\n",
+			res.result);
+		return -EOPNOTSUPP;
+	}
+
+	if (res.result != QSEECOM_RESULT_SUCCESS)
+		return -EIO;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_qseecom_load_services_image);
+
 /**
  * qcom_scm_qseecom_app_send() - Send to and receive data from a given QSEE app.
  * @app_id:   The ID of the target app.
diff --git a/include/linux/firmware/qcom/qcom_scm.h b/include/linux/firmware/qcom/qcom_scm.h
index da3099bcbee6..fc31d032d512 100644
--- a/include/linux/firmware/qcom/qcom_scm.h
+++ b/include/linux/firmware/qcom/qcom_scm.h
@@ -177,6 +177,8 @@ int qcom_scm_qseecom_app_get_id(const char *app_name, u32 *app_id);
 int qcom_scm_qseecom_app_region_notify(phys_addr_t addr, size_t size);
 int qcom_scm_qseecom_app_load(const char *app_name, phys_addr_t img_phys,
 			      size_t mdt_len, size_t img_len, u32 *app_id);
+int qcom_scm_qseecom_load_services_image(phys_addr_t img_phys,
+					 size_t mdt_len, size_t img_len);
 int qcom_scm_qseecom_app_send(u32 app_id, void *req, size_t req_size,
 			      void *rsp, size_t rsp_size);
 
@@ -200,6 +202,13 @@ static inline int qcom_scm_qseecom_app_load(const char *app_name,
 	return -EINVAL;
 }
 
+static inline int qcom_scm_qseecom_load_services_image(phys_addr_t img_phys,
+							size_t mdt_len,
+							size_t img_len)
+{
+	return -EINVAL;
+}
+
 static inline int qcom_scm_qseecom_app_send(u32 app_id,
 					    void *req, size_t req_size,
 					    void *rsp, size_t rsp_size)
