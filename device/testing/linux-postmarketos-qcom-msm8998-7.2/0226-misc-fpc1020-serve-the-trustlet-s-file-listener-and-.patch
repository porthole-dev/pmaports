-static DEVICE_ATTR_RW(irq);
+static DEVICE_ATTR_RO(irq);
 
 static struct attribute *fpc1020_attrs[] = {
 	&dev_attr_irq.attr,
@@ -288,37 +207,139 @@ static void fpc1020_disable_regulator(void *data)
 	regulator_disable(data);
 }
 
-/* ------------------------------------------------------------------
- * TrustZone transport: envelope/cmdbuf construction and the one-time
- * load+INIT bring-up. Everything here runs with fpc1020->lock held.
+/* ------------------------------------------------------------------ *
+ * Listener rendezvous
  * ------------------------------------------------------------------ */
 
-static void fpc1020_put32(void *buf, unsigned int word, u32 val)
+/*
+ * Called by qcom_scm_qseecom_app_send_listener() with the QSEECOM call lock
+ * and fpc1020->lock held, when the trustlet asks for listener @listener_id.
+ * The request is already in fpc1020->sb; hand it to userspace and wait for
+ * the answer to be written back into the same buffer. For 0x7000 the layout
+ * is qseecomd's GP file service (libdrmfs.so, gpdispatch()): u32 command
+ * (0 read, 1 write, 2 remove, 3 rename), then a 256-byte path, offset,
+ * count, backup flag and data, answered in place.
+ */
+static int fpc1020_listener_handle(void *priv, u32 listener_id)
 {
-	u8 *b = buf;
+	struct fpc1020 *fpc1020 = priv;
+	unsigned long flags;
+	long left;
+	int ret;
+
+	if (listener_id != FPC1020_GPFS_LISTENER_ID) {
+		dev_warn_ratelimited(fpc1020->dev,
+				     "trustlet asked for unknown listener 0x%x\n",
+				     listener_id);
+		return -ENOENT;
+	}
+
+	spin_lock_irqsave(&fpc1020->listener_lock, flags);
+	fpc1020->listener_state = FPC1020_LISTENER_PENDING;
+	spin_unlock_irqrestore(&fpc1020->listener_lock, flags);
+	wake_up_interruptible(&fpc1020->listener_req_wq);
+
+	left = wait_event_killable_timeout(fpc1020->listener_rsp_wq,
+			fpc1020->listener_state == FPC1020_LISTENER_DONE,
+			msecs_to_jiffies(FPC1020_LISTENER_TIMEOUT_MS));
 
-	b[word * 4 + 0] = (u8)(val >> 0);
-	b[word * 4 + 1] = (u8)(val >> 8);
-	b[word * 4 + 2] = (u8)(val >> 16);
-	b[word * 4 + 3] = (u8)(val >> 24);
+	spin_lock_irqsave(&fpc1020->listener_lock, flags);
+	if (fpc1020->listener_state == FPC1020_LISTENER_DONE)
+		ret = fpc1020->listener_status;
+	else
+		ret = left < 0 ? left : -ETIMEDOUT;
+	fpc1020->listener_state = FPC1020_LISTENER_IDLE;
+	spin_unlock_irqrestore(&fpc1020->listener_lock, flags);
+
+	if (ret)
+		dev_warn_ratelimited(fpc1020->dev,
+				     "listener 0x%x request not served: %d\n",
+				     listener_id, ret);
+	return ret;
+}
+
+static int fpc1020_listener_recv(struct fpc1020 *fpc1020, unsigned long arg)
+{
+	struct fpc1020_tee_listener l;
+	unsigned long flags;
+	size_t len;
