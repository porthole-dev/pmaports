# Reference: <https://postmarketos.org/devicepkg>
maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=device-google-taimen
pkgdesc="Google Pixel 2 XL"
pkgver=0.1
pkgrel=15
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# qbootctl marks each boot successful in the Android A/B interface. Without it
# the bootloader decrements the slot's retry counter every boot and eventually
# refuses the slot, even though pmOS booted fine -- see the post-install. The
# -openrc/-systemd subpackages come in on their own via install_if, exactly as
# rmtfs's do, so do NOT list them here.
depends="
	mkbootimg
	postmarketos-base
	qbootctl
"
install="$pkgname.post-install"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.mainline.conf
	modules-initfs.mainline
	sudoers-nopasswd
	taimen-modem-bringup
	taimen-modem-bringup.initd
	taimen-modem-bringup.service
	taimen-wifi-country
	taimen-wifi-country.initd
	taimen-wifi-country.service
	ath-regd-override.conf
"
subpackages="
	$pkgname-kernel-mainline:kernel_mainline
	$pkgname-nonfree-firmware:nonfree_firmware
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# See the file's header: local bring-up convenience, not for upstream.
	install -Dm440 "$srcdir"/sudoers-nopasswd \
		"$pkgdir"/etc/sudoers.d/50-pmos-dev-nopasswd

	# WLAN/modem bring-up ordering. This used to live in /etc/local.d on the
	# device only, which meant every clean install silently came up with no
	# working modem. Ship it, and ship both init wrappers: the matching one is
	# enabled by the post-install, the other is an inert file.
	install -Dm755 "$srcdir"/taimen-modem-bringup \
		"$pkgdir"/usr/bin/taimen-modem-bringup
	install -Dm755 "$srcdir"/taimen-modem-bringup.initd \
		"$pkgdir"/etc/init.d/taimen-modem-bringup
	install -Dm644 "$srcdir"/taimen-modem-bringup.service \
		"$pkgdir"/usr/lib/systemd/system/taimen-modem-bringup.service

	# WiFi regulatory. The board data pins this device to the US, which
	# disables 2.4 ch 12-13 and the whole ETSI 5 GHz midband; see the conf
	# file's header. regd_override only opens the channel superset -- the
	# country itself is applied at runtime from the SIM MCC (or the country
	# IE in beacons), never hardcoded.
	install -Dm644 "$srcdir"/ath-regd-override.conf \
		"$pkgdir"/etc/modprobe.d/ath-regd-override.conf
	install -Dm755 "$srcdir"/taimen-wifi-country \
		"$pkgdir"/usr/bin/taimen-wifi-country
	install -Dm755 "$srcdir"/taimen-wifi-country.initd \
		"$pkgdir"/etc/init.d/taimen-wifi-country
	install -Dm644 "$srcdir"/taimen-wifi-country.service \
		"$pkgdir"/usr/lib/systemd/system/taimen-wifi-country.service
}

kernel_mainline() {
	pkgdesc="Close to mainline kernel"
	depends="linux-postmarketos-qcom-msm8998 soc-qcom-msm8998"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

nonfree_firmware() {
	pkgdesc="Firmware for modem, GPU zap shader, WiFi, Bluetooth, ADSP and SLPI"
	# rmtfs and qcom-diag are named explicitly rather than relying on
	# soc-qcom-msm8998-nonfree-firmware to pull them in; both are required
	# before the modem will stay up.
	#
	# Do NOT ship units for these here. rmtfs-systemd and qcom-diag-systemd
	# already own /usr/lib/systemd/system/{rmtfs,diag-router}.service and are
	# pulled in automatically by install_if="systemd <pkg>", so adding our own
	# copies just makes apk fail with "trying to overwrite ... owned by".
	# Upstream's rmtfs.service already runs exactly "rmtfs -r -P -s".
	depends="
		firmware-google-taimen
		pd-mapper
		qcom-diag
		rmtfs
		tqftpserv
	"
	mkdir "$subpkgdir"
}

