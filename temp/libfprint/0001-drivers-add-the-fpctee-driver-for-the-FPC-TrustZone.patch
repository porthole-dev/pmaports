diff --git a/libfprint/drivers/fpctee/fpc-tz.c b/libfprint/drivers/fpctee/fpc-tz.c
new file mode 100644
index 0000000..c6b1571
--- /dev/null
+++ b/libfprint/drivers/fpctee/fpc-tz.c
@@ -0,0 +1,572 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/*
+ * FPC TrustZone application protocol — transport-independent core.
+ *
+ * Derived from https://github.com/sonyxperiadev/vendor-sony-oss-fingerprint
+ * Copyright (C) 2016 Shane Francis / Jens Andersen, Apache-2.0.
+ * Copyright (C) 2026 Giuseppe Maggio <jertlok@proton.me>
+ *
+ * See fpc-tz.h for the licence notice and what was changed.
+ */
+
+#include "fpc-tz.h"
+
+#include <string.h>
+
+/*
+ * Sony, tz_api_yoshino.h.  This is the generation taimen is expected to be
+ * on: FPC1270 + FPC2050 is contemporaneous with yoshino (msm8998, 2017).
+ * Expected, not confirmed — that is what fpc_tz_probe() is for.
+ */
+const fpc_tz_table fpc_tz_table_yoshino = {
+  .name             = "yoshino",
+
+  .grp_normal       = FPC_TZ_ABSENT,
+  .grp_db           = 0x02,
+  .grp_fpcdata      = 0x03,
+  .grp_qc           = 0x07,
+  .grp_info         = 0x09,
+  .grp_sensor       = 0x0a,
+  .grp_template     = 0x0b,
+
+  .load_db          = 0x0b,
+  .store_db         = 0x0c,
+
+  .get_fpc_info     = 0x02,
+
+  .wait_finger_lost = 0x00,
+  .wait_finger_down = 0x02,
+  .capture_image    = 0x03,
+  .deep_sleep       = 0x04,
+  .get_otp_info     = 0x06,
+
+  .begin_enrol      = 0x00,
+  .enrol_step       = 0x01,
+  .end_enrol        = 0x02,
+  .identify         = 0x03,
+  .update_template  = 0x04,
+  .load_empty_db    = 0x06,
+  .get_fingerprints = 0x07,
+  .delete_fingerprint = 0x08,
+  .set_gid          = 0x09,
+  .get_template_id  = 0x0a,
+};
+
+/*
+ * Sony, tz_api_loire_tone.h.  One flat FPC_GROUP_NORMAL = 0x1, no INFO group
+ * at all.  Present so that "the numbering is not yoshino" has somewhere to
+ * land — it is never selected automatically.
+ */
+const fpc_tz_table fpc_tz_table_loire = {
+  .name             = "loire",
+
+  .grp_normal       = 0x01,
+  .grp_db           = 0x02,
+  .grp_fpcdata      = 0x03,
+  .grp_qc           = 0x07,
+  .grp_info         = FPC_TZ_ABSENT,
+  .grp_sensor       = 0x01,
+  .grp_template     = 0x01,
+
+  .load_db          = 0x0b,
+  .store_db         = 0x0c,
+
+  .get_fpc_info     = FPC_TZ_ABSENT,
+
+  .wait_finger_lost = 0x05,
+  .wait_finger_down = 0x07,
+  .capture_image    = 0x0f,
+  .deep_sleep       = FPC_TZ_ABSENT,
+  .get_otp_info     = FPC_TZ_ABSENT,
+
+  .begin_enrol      = 0x00,
+  .enrol_step       = 0x01,
+  .end_enrol        = 0x02,
+  .identify         = 0x03,
+  .update_template  = 0x04,
+  .load_empty_db    = 0x0a,
+  .get_fingerprints = 0x0d,
+  .delete_fingerprint = 0x0e,
+  .set_gid          = 0x10,
+  .get_template_id  = 0x11,
+};
+
+const fpc_tz_table *
+fpc_tz_table_by_name (const char *name)
+{
+  if (name == NULL)
+    return NULL;
+  if (strcmp (name, fpc_tz_table_yoshino.name) == 0)
+    return &fpc_tz_table_yoshino;
+  if (strcmp (name, fpc_tz_table_loire.name) == 0)
+    return &fpc_tz_table_loire;
+  return NULL;
+}
+
+/*
+ * Wire helpers.  Every field on this protocol is a 32-bit little-endian word;
+ * spelling that out keeps the encoding checkable from the self-check instead
+ * of depending on struct layout.
+ */
+#define FPC_TZ_BUF_WORDS 16     /* BUFFER_SIZE 64 */
+#define FPC_TZ_HDR_WORDS 4      /* group, cmd, status, length */
+
+static void
+put32 (uint8_t *buf, unsigned word, uint32_t val)
+{
+  buf[word * 4 + 0] = (uint8_t) (val >> 0);
+  buf[word * 4 + 1] = (uint8_t) (val >> 8);
+  buf[word * 4 + 2] = (uint8_t) (val >> 16);
+  buf[word * 4 + 3] = (uint8_t) (val >> 24);
+}
+
+static uint32_t
+get32 (const uint8_t *buf, unsigned word)
+{
+  return (uint32_t) buf[word * 4 + 0] |
+         ((uint32_t) buf[word * 4 + 1] << 8) |
+         ((uint32_t) buf[word * 4 + 2] << 16) |
+         ((uint32_t) buf[word * 4 + 3] << 24);
+}
+
+static int32_t
+get_status (const uint8_t *buf, unsigned word)
+{
+  return (int32_t) get32 (buf, word);
+}
+
+static int
+xfer (fpc_tz *s, void *buf, size_t len)
+{
+  if (s == NULL || s->ops == NULL || s->ops->xfer == NULL)
+    return FPC_TZ_EINVAL;
+  if (s->ops->xfer (s->ctx, buf, len) < 0)
+    return FPC_TZ_ETRANSPORT;
+  return FPC_TZ_OK;
+}
+
+/*
+ * send_normal_command(): group/cmd/ret_val in 64 bytes, result read back out
+ * of ret_val.  Returns FPC_TZ_OK, FPC_TZ_ETRANSPORT, or FPC_TZ_ESTATUS with
+ * the TA's own code in *ret when ret is non-NULL.
+ */
+static int
+std_cmd (fpc_tz *s, uint32_t group, uint32_t cmd, int32_t *ret)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+  int rc;
+
+  if (group == FPC_TZ_ABSENT || cmd == FPC_TZ_ABSENT)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, group);
+  put32 (buf, 1, cmd);
+  put32 (buf, 2, 0);
+
+  rc = xfer (s, buf, sizeof (buf));
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  if (ret != NULL)
+    *ret = get_status (buf, 2);
+
+  return get_status (buf, 2) == 0 ? FPC_TZ_OK : FPC_TZ_ESTATUS;
+}
+
+/*
+ * send_custom_cmd(): the request struct is longer than the three-word header
+ * and the TA answers in place.  words[] is the whole command, word 2 is the
+ * status on the way back.
+ */
+static int
+custom_cmd (fpc_tz *s, uint8_t *buf, size_t len)
+{
+  int rc = xfer (s, buf, len);
+
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  return get_status (buf, 2) == 0 ? FPC_TZ_OK : FPC_TZ_ESTATUS;
+}
+
+/*
+ * send_buffer_command(): header then payload at offset 16.  Used for the
+ * template database, whose payload is a *path* — see fpc_tz_load_db().
+ */
+static int
+buffer_cmd (fpc_tz *s, uint32_t group, uint32_t cmd,
+            const void *data, uint32_t len,
+            uint8_t *buf, size_t bufsz)
+{
+  if (group == FPC_TZ_ABSENT || cmd == FPC_TZ_ABSENT)
+    return FPC_TZ_EINVAL;
+  if (bufsz < (size_t) FPC_TZ_HDR_WORDS * 4 + len)
+    return FPC_TZ_EINVAL;
+
+  memset (buf, 0, bufsz);
+  put32 (buf, 0, group);
+  put32 (buf, 1, cmd);
+  put32 (buf, 2, 0);
+  put32 (buf, 3, len);
+  if (len != 0)
+    memcpy (buf + FPC_TZ_HDR_WORDS * 4, data, len);
+
+  return custom_cmd (s, buf, bufsz);
+}
+
+void
+fpc_tz_init (fpc_tz *s, const fpc_tz_ops *ops, void *ctx)
+{
+  memset (s, 0, sizeof (*s));
+  s->ops = ops;
+  s->ctx = ctx;
+}
+
+int
+fpc_tz_select_table (fpc_tz *s, const char *name)
+{
+  const fpc_tz_table *tab = fpc_tz_table_by_name (name);
+
+  if (tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  s->tab = tab;
+  return FPC_TZ_OK;
+}
+
+int
+fpc_tz_probe (fpc_tz *s, const char *db_path, int *transport_ok)
+{
+  const fpc_tz_table *y = &fpc_tz_table_yoshino;
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+  int rc;
+
+  if (transport_ok != NULL)
+    *transport_ok = 0;
+
+  s->tab = NULL;
+
+  /* INFO 0x09 / GET_FPC_INFO 0x02 — absent from the loire table entirely. */
+  put32 (buf, 0, y->grp_info);
+  put32 (buf, 1, y->get_fpc_info);
+  put32 (buf, 2, 0);
+
+  rc = xfer (s, buf, sizeof (buf));
+  if (rc != FPC_TZ_OK)
+    return FPC_TZ_ETRANSPORT;
+
+  if (transport_ok != NULL)
+    *transport_ok = 1;
+
+  if (get_status (buf, 2) == 0)
+    {
+      s->info = get32 (buf, 3);
+      s->tab = y;
+      return FPC_TZ_OK;
+    }
+
+  /*
+   * The TA answered, but not to group 0x09.  Prove the transport with
+   * DB 0x2 / LOAD_DB 0x0B, which is stable across both Sony tables, before
+   * anyone blames the numbering.  Deliberately do NOT fall back to the loire
+   * table: recovering taimen's numbering is disassembly work, not a guess.
+   */
+  if (db_path != NULL)
+    {
+      uint8_t dbbuf[FPC_TZ_BUF_WORDS * 4 + 256];
+      uint32_t len = (uint32_t) strlen (db_path) + 1;
+
+      if (len <= sizeof (dbbuf) - FPC_TZ_HDR_WORDS * 4)
+        {
+          int drc = buffer_cmd (s, fpc_tz_table_loire.grp_db,
+                                fpc_tz_table_loire.load_db,
+                                db_path, len, dbbuf, sizeof (dbbuf));
+
+          if (transport_ok != NULL)
+            *transport_ok = (drc != FPC_TZ_ETRANSPORT);
+        }
+    }
+
+  return FPC_TZ_EGENERATION;
+}
+
+/*
+ * ponytail: LOAD_DB/STORE_DB take a *path*, not a blob — that is how Sony's
+ * HAL uses them, and it means the TA does its own file I/O over a QSEECom
+ * listener.  Mainline has no listener support at all, so this pair is the
+ * most likely thing to fail first on this port.  If it does, the fix is to
+ * add the listener (or a blob-carrying variant if the TA has one), not to
+ * change this encoding.
+ */
+int
+fpc_tz_load_db (fpc_tz *s, const char *path)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4 + 256];
+
+  if (s->tab == NULL || path == NULL)
+    return FPC_TZ_EINVAL;
+
+  return buffer_cmd (s, s->tab->grp_db, s->tab->load_db,
+                     path, (uint32_t) strlen (path) + 1, buf, sizeof (buf));
+}
+
+int
+fpc_tz_store_db (fpc_tz *s, const char *path)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4 + 256];
+
+  if (s->tab == NULL || path == NULL)
+    return FPC_TZ_EINVAL;
+
+  return buffer_cmd (s, s->tab->grp_db, s->tab->store_db,
+                     path, (uint32_t) strlen (path) + 1, buf, sizeof (buf));
+}
+
+int
+fpc_tz_load_empty_db (fpc_tz *s)
+{
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  return std_cmd (s, s->tab->grp_template, s->tab->load_empty_db, NULL);
+}
+
+int
+fpc_tz_set_gid (fpc_tz *s, uint32_t gid)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, s->tab->grp_template);
+  put32 (buf, 1, s->tab->set_gid);
+
+  /* The two generations disagree about field order here, not just numbering:
+   * yoshino is {group, cmd, status, gid}, loire is {group, cmd, gid, status}. */
+  if (s->tab == &fpc_tz_table_loire)
+    {
+      put32 (buf, 2, gid);
+      put32 (buf, 3, 0);
+      if (xfer (s, buf, sizeof (buf)) != FPC_TZ_OK)
+        return FPC_TZ_ETRANSPORT;
+      return get_status (buf, 3) == 0 ? FPC_TZ_OK : FPC_TZ_ESTATUS;
+    }
+
+  put32 (buf, 2, 0);
+  put32 (buf, 3, gid);
+  return custom_cmd (s, buf, sizeof (buf));
+}
+
+int
+fpc_tz_wait_finger_down (fpc_tz *s, int timeout_ms)
+{
+  int rc;
+
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  rc = std_cmd (s, s->tab->grp_sensor, s->tab->wait_finger_down, NULL);
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  /* The TA only arms the sensor; the finger event arrives as an IRQ. */
+  if (s->ops->wait_event == NULL)
+    return FPC_TZ_EINVAL;
+
+  return s->ops->wait_event (s->ctx, timeout_ms);
+}
+
+int
+fpc_tz_wait_finger_lost (fpc_tz *s, int timeout_ms)
+{
+  int rc;
+
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  rc = std_cmd (s, s->tab->grp_sensor, s->tab->wait_finger_lost, NULL);
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  if (s->ops->wait_event == NULL)
+    return FPC_TZ_EINVAL;
+
+  return s->ops->wait_event (s->ctx, timeout_ms);
+}
+
+/*
+ * Returns the TA's own acquisition code in *ret (0 = good image, 3 = keep
+ * collecting, others map to retry conditions).  No pixels ever reach us: the
+ * image stays inside the TA and feeds its matcher.
+ */
+int
+fpc_tz_capture_image (fpc_tz *s)
+{
+  int32_t ret = 0;
+  int rc;
+
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  rc = std_cmd (s, s->tab->grp_sensor, s->tab->capture_image, &ret);
+  if (rc == FPC_TZ_ETRANSPORT)
+    return rc;
+
+  return (int) ret;
+}
+
+int
+fpc_tz_deep_sleep (fpc_tz *s)
+{
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+  if (s->tab->deep_sleep == FPC_TZ_ABSENT)
+    return FPC_TZ_OK;           /* loire has no such command; nothing to do */
+
+  return std_cmd (s, s->tab->grp_sensor, s->tab->deep_sleep, NULL);
+}
+
+void
+fpc_tz_cancel (fpc_tz *s)
+{
+  if (s->ops != NULL && s->ops->cancel != NULL)
+    s->ops->cancel (s->ctx);
+}
+
+int
+fpc_tz_begin_enrol (fpc_tz *s)
+{
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  return std_cmd (s, s->tab->grp_template, s->tab->begin_enrol, NULL);
+}
+
+int
+fpc_tz_enrol_step (fpc_tz *s, uint32_t *remaining_touches)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+  int rc;
+
+  if (s->tab == NULL || remaining_touches == NULL)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, s->tab->grp_template);
+  put32 (buf, 1, s->tab->enrol_step);
+
+  rc = custom_cmd (s, buf, sizeof (buf));
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  /* nr_enroll_stages comes from here, not from a constant. */
+  *remaining_touches = get32 (buf, 3);
+  return FPC_TZ_OK;
+}
+
+int
+fpc_tz_end_enrol (fpc_tz *s, uint32_t *print_id)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+  int rc;
+
+  if (s->tab == NULL || print_id == NULL)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, s->tab->grp_template);
+  put32 (buf, 1, s->tab->end_enrol);
+
+  rc = custom_cmd (s, buf, sizeof (buf));
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  *print_id = get32 (buf, 3);
+  return FPC_TZ_OK;
+}
+
+int
+fpc_tz_identify (fpc_tz *s, uint32_t *print_id)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+  int rc;
+
+  if (s->tab == NULL || print_id == NULL)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, s->tab->grp_template);
+  put32 (buf, 1, s->tab->identify);
+
+  rc = custom_cmd (s, buf, sizeof (buf));
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  /* Match on chip: an id, or 0 for no match.  Never an image. */
+  *print_id = get32 (buf, 3);
+  return FPC_TZ_OK;
+}
+
+int
+fpc_tz_update_template (fpc_tz *s, int *changed)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+  int rc;
+
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, s->tab->grp_template);
+  put32 (buf, 1, s->tab->update_template);
+
+  rc = custom_cmd (s, buf, sizeof (buf));
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  if (changed != NULL)
+    *changed = (int) get32 (buf, 3);
+
+  return FPC_TZ_OK;
+}
+
+int
+fpc_tz_get_fingerprints (fpc_tz *s, uint32_t *ids, uint32_t *count)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+  uint32_t n;
+  int rc;
+
+  if (s->tab == NULL || ids == NULL || count == NULL)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, s->tab->grp_template);
+  put32 (buf, 1, s->tab->get_fingerprints);
+  put32 (buf, 3, FPC_TZ_MAX_PRINTS);
+
+  rc = custom_cmd (s, buf, sizeof (buf));
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  n = get32 (buf, 3);
+  if (n > FPC_TZ_MAX_PRINTS)
+    return FPC_TZ_ESTATUS;
+
+  for (uint32_t i = 0; i < n; i++)
+    ids[i] = get32 (buf, 4 + i);
+
+  *count = n;
+  return FPC_TZ_OK;
+}
+
+int
+fpc_tz_delete_fingerprint (fpc_tz *s, uint32_t id)
+{
+  uint8_t buf[FPC_TZ_BUF_WORDS * 4] = { 0 };
+
+  if (s->tab == NULL)
+    return FPC_TZ_EINVAL;
+
+  put32 (buf, 0, s->tab->grp_template);
+  put32 (buf, 1, s->tab->delete_fingerprint);
+  put32 (buf, 3, id);
+
+  return custom_cmd (s, buf, sizeof (buf));
+}
