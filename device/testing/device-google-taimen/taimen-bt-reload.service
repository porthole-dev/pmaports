[Unit]
Description=Re-probe hci_uart when the BT controller never reaches mgmt (workaround)
# bluetoothd must be up so it adopts the controller as soon as the re-probe
# emits Index Added.
Wants=bluetooth.service
After=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/taimen-bt-reload
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
