# Reference: <https://postmarketos.org/devicepkg>
maintainer="Giuseppe Maggio <jertlok@proton.me>"
#
# Proprietary firmware for the Google Pixel 2 XL (taimen), lifted out of the
# factory image. The tarball is NOT in git -- it is Google/Qualcomm's to
# redistribute, not ours -- so regenerate it before building on a fresh checkout:
#
#   1. Fetch taimen-rp1a.201005.004.a1-factory-2f5c4987.zip from
#      https://developers.google.com/android/images  (Android 11, the last taimen build)
#   2. taimen/docs/BLOBS.md documents the extraction; in short:
#        unzip -p <factory>.zip '*/image-*.zip' > image.zip
#        unzip -p image.zip vendor.img > vendor.sparse
#        python3 taimen/blobs/unsparse.py vendor.sparse vendor.raw
#        debugfs -R "ls -l /firmware" vendor.raw        # to browse
#   3. Vendor ships the PIL images SPLIT as foo.mdt + foo.b00..bNN, while our DT
#      asks for a single foo.mbn. Weld them with taimen/tools/pil-squash.py.
#      Where vendor already ships a combined image (a540_zap.elf, wlanmdsp.mbn)
#      prefer that verbatim over a reconstruction.
#
#   4. mba.mbn and modem.{mdt,bNN} are NOT in vendor.img -- they live on the
#      modem_a/b partition, which is readable straight off a booted device once
#      UFS works (no TWRP needed):
#        mount -o ro /dev/disk/by-partlabel/modem_a /mnt/modem   # files in image/
#      Back up modemst1/2, fsg and fsc before anything ever writes there.
#   5. The two PD maps pd-mapper needs are in DIFFERENT places:
#        modemr.jsn   modem partition image/   -- modem ROOT pd
#        modemuw.jsn  vendor.img /firmware     -- modem USER pd (subdomain
#                     wlan_pd), which advertises provider=wlan service=fw. This
#                     is the service ath10k_snoc blocks on, so WiFi needs it.
#      pd-mapper looks for *.jsn NEXT TO the firmware named in
#      /sys/class/remoteproc/*/firmware, honouring firmware_class.path -- not in
#      /lib/firmware root.
#   6. ath10k board-2.bin / firmware-5.bin are GENERATED from vendor's
#      bdwlan.bin + bdwlan.b09 with qca-swiss-army-knife:
#        ath10k-bdencoder -c board-2.json -o board-2.bin
#          # names: bus=snoc,qmi-board-id=ff for bdwlan.bin, =9 for bdwlan.b09
#        ath10k-fwencoder -c --timestamp=0 --set-fw-api=5 \
#          --features=wowlan,mgmt-tx-by-ref,non-bmi,single-chan-info-per-channel \
#          --set-wmi-op-version=tlv --set-htt-op-version=tlv -o firmware-5.bin
#      linux-firmware-ath10k ships generic WCN3990 board-2.bin.zst/firmware-5.bin.zst
#      in the same directory. There is no file conflict (different names) and ours
#      win: the firmware loader tries the uncompressed name across every search
#      path before it tries any .zst (drivers/base/firmware_loader/main.c).
#
# Not included, deliberately:
#   a530_* GPU firmware comes from firmware-qcom-adreno-a530.
pkgname=firmware-google-taimen
pkgver=20201005
pkgrel=2
pkgdesc="Firmware for Google Pixel 2 XL (modem, adsp, slpi, wlan, bluetooth, gpu zap)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !archcheck !strip !tracedeps !spdx"
depends="
	firmware-qcom-adreno-a530
	linux-firmware-ath10k
	linux-firmware-qca
"
source="$pkgname-$pkgver.tar.gz
	tas2557s_PG21_uCDSP.bin
	tas2557s_uCDSP.bin
	"

package() {
	install -d "$pkgdir"/lib/firmware
	cp -a "$srcdir"/qcom "$srcdir"/qca "$srcdir"/ath10k "$pkgdir"/lib/firmware/
	# TAS2557 speaker amp uCDSP firmware -- without it the codec probe fails
	# and the whole sound card defers forever (silent phone).
	install -Dm644 "$srcdir"/tas2557s_PG21_uCDSP.bin "$srcdir"/tas2557s_uCDSP.bin \
		-t "$pkgdir"/lib/firmware/
	find "$pkgdir"/lib/firmware -type f -exec chmod 644 {} +
}

sha512sums="
