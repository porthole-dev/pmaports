+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Sony IMX179 CMOS image sensor driver
+ *
+ * Written for the Google Pixel 2 XL (taimen) front camera, where the sensor
+ * sits on CCI master 1 behind CSIPHY1/CSID1. Streams RAW10 at up to
+ * 3280x2464 through the Easel MIPI bridge (see easel-mipi.c) to CSIPHY1.
+ *
+ * The power sequence is load-bearing and comes from the vendor devicetree, not
+ * from guesswork: rails (VIO, then DVDD, then AVDD), then MCLK at 24 MHz, then
+ * release reset, then wait ~9 ms before the first I2C transaction. Reading the
+ * chip ID earlier returns zeroes, which looks exactly like a dead sensor.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#include <linux/easel-mipi.h>
+
+/*
+ * The vendor's power_setting_array (0x7d0 in libmmcamera_imx179.so, 16-byte
+ * records of {seq_type, seq_val, config_val, delay}) decodes to:
+ *
+ *   GPIO RESET -> low        assert reset
+ *   GPIO VANA  -> high       AVDD  (note: AVDD before DVDD)
+ *   GPIO VDIG  -> high       DVDD
+ *   VREG  1    -> on         VIO
+ *   GPIO RESET -> high       release reset
+ *   CLK   0    -> 24000000   MCLK LAST, after reset is already released
+ *
+ * This driver does the opposite on the last point: MCLK first, then release
+ * reset -- which is the more conventional order and is why it was written that
+ * way.
+ */
+
+#define IMX179_REG_MODE_SELECT		0x0100
+#define IMX179_REG_SOFTWARE_RST		0x0103
+#define IMX179_MODE_STANDBY		0x00
+#define IMX179_MODE_STREAMING		0x01
+
+/*
+ * SMIA CSI_LANE_MODE lives at 0x0114 on most Sony parts and is absent from all
+ * three vendor mode tables, which makes it an obvious suspect for "the sensor
+ * only drives one lane". It is not: on this part 0x0114 reads 0x00 and stays
+ * 0x00 after writing 0x03, while 0x030d in the same sequence reads back its
+ * programmed 0x55. The register is not implemented here and the lane count is
+ * not software-selectable. Do not re-run this experiment.
+ */
+
+/*
+ * Model ID register, taken from the vendor's own sensor library
+ * (vendor/lib/libmmcamera_imx179.so), which carries the downstream
+ * msm_camera_sensor_slave_info struct verbatim:
+ *
+ *   slave_addr        0x20 (8-bit) -> 0x10 7-bit
+ *   i2c_freq_mode     1    (fast mode, 400 kHz)
+ *   addr_type         2    (16-bit register addresses)
+ *   sensor_id_reg_addr 0x0002
+ *   sensor_id          0x0179
+ *   sensor_id_mask     0x0fff
+ *
+ * The mask is the part worth knowing: this sensor answers 0x8179 at 0x0002,
+ * with the top nibble a revision field. Comparing the raw word against 0x0179
+ * therefore fails on a perfectly good sensor -- and 0x0000 and 0x0016, the
+ * usual Sony model-ID locations, read 0x1176 and 0x0a00 here, which look
+ * convincingly like "some other part" if you stop there.
+ */
+#define IMX179_REG_CHIP_ID		0x0002
+#define IMX179_CHIP_ID			0x0179
+#define IMX179_CHIP_ID_MASK		0x0fff
+
+#define IMX179_XCLK_FREQ		24000000
+
+/* Native full resolution; the default mode the sensor powers up in. */
+#define IMX179_NATIVE_WIDTH		3280U
+#define IMX179_NATIVE_HEIGHT		2464U
+
+/*
+ * Standard SMIA/Sony exposure+timing registers, same layout as the mode
+ * tables below use. libcamera refuses any sensor that does not expose
+ * EXPOSURE / ANALOGUE_GAIN / HBLANK / VBLANK, so these are load-bearing for
+ * the GNOME camera path even before image quality matters.
+ */
+#define IMX179_REG_FRM_LENGTH		0x0340	/* u16, lines */
+#define IMX179_REG_COARSE_INTEG		0x0202	/* u16, lines */
+#define IMX179_REG_ANALOG_GAIN		0x0204	/* u16, G = 256/(256-code) */
+#define IMX179_FLL_MAX			0xffff
+#define IMX179_EXPOSURE_MARGIN		4	/* coarse_max = FLL - 4 */
+#define IMX179_EXPOSURE_MIN		1
+/* ponytail: 224 = 8x, the vendor tuning ceiling; datasheet may allow more */
+#define IMX179_ANA_GAIN_MAX		224
+
+/*
+ * Mode register tables, extracted byte-for-byte from the vendor sensor library
+ * (vendor/lib/libmmcamera_imx179.so). Downstream stores them as
+ * struct msm_camera_i2c_reg_array { u16 reg; u16 val; u32 delay; }, so they are
+ * literal 8-byte records in .data and can be read out rather than guessed --
+ * see docs/CAMERA-M2-PREP.md. The three tables correspond exactly to the three
+ * tuning libraries shipped alongside them (res0_snapshot, res1_video_30,
+ * res2_video_qtr).
+ *
+ * These are complete per-mode setups, not deltas on a common init block: each
+ * starts by parking the sensor (0x0100 = 0) and includes the PLL, the crop and
+ * output window, and the analogue tuning in the 0x3xxx range. So there is no
+ * separate init table to apply first, and streaming is just the table followed
+ * by 0x0100 = 1.
+ */
+struct imx179_reg {
+	u16 addr;
+	u8 val;
+};
