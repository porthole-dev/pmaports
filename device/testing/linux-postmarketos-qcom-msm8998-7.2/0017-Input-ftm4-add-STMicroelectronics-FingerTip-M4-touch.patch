From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 8 Aug 2026 15:33:31 +0200
Subject: [PATCH] Input: ftm4 - add STMicroelectronics FingerTip M4 touchscreen
 driver

Adds a driver for the STMicroelectronics FingerTip M4 (FTM4) I2C
multi-touch controller, found on the Google Pixel 2 XL (taimen). It
is a relative of the FingerTip S described by st,stmfts.txt, but the
two protocols are not interchangeable.

Includes the st,ftm4 devicetree binding.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../bindings/input/touchscreen/st,ftm4.yaml   |  88 ++
 drivers/input/touchscreen/Kconfig             |  13 +
 drivers/input/touchscreen/Makefile            |   1 +
 drivers/input/touchscreen/ftm4.c              | 815 ++++++++++++++++++
 4 files changed, 917 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/st,ftm4.yaml
 create mode 100644 drivers/input/touchscreen/ftm4.c

diff --git a/Documentation/devicetree/bindings/input/touchscreen/st,ftm4.yaml b/Documentation/devicetree/bindings/input/touchscreen/st,ftm4.yaml
new file mode 100644
index 000000000000..6d8f55759aec
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/st,ftm4.yaml
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/st,ftm4.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STMicroelectronics FingerTip M4 touchscreen controller
+
+maintainers:
+  - Giuseppe Maggio <jertlok@proton.me>
+
+description:
+  The FingerTip M4 (FTM4) is an I2C multi-touch controller reporting up to ten
+  contacts. It is a relative of the FingerTip S described by st,stmfts.txt, but
+  the two are not interchangeable.
+
+allOf:
+  - $ref: touchscreen.yaml#
+
+properties:
+  compatible:
+    const: st,ftm4
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  vdd-supply:
+    description: Digital supply regulator (DVDD)
+
+  avdd-supply:
+    description: Analog supply regulator (AVDD)
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      Reset line of the controller. The pin usually has no bias configured, so
+      it must be driven for as long as the controller is in use.
+
+  st,i2c-switch-gpios:
+    maxItems: 1
+    description:
+      Some designs place the controller on an I2C bus shared with a second
+      master, with an external mux selecting which one drives it. When present,
+      this GPIO is asserted while the SoC needs the bus and deasserted once the
+      controller is powered down. The line is typically low when the SoC owns
+      the bus, i.e. GPIO_ACTIVE_LOW.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - vdd-supply
+  - avdd-supply
+  - reset-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@49 {
+            compatible = "st,ftm4";
+            reg = <0x49>;
+
+            interrupt-parent = <&tlmm>;
+            interrupts = <125 IRQ_TYPE_LEVEL_LOW>;
+
+            vdd-supply = <&vreg_l6a_1p8>;
+            avdd-supply = <&vreg_l28_3p0>;
+
+            reset-gpios = <&tlmm 89 GPIO_ACTIVE_LOW>;
+            st,i2c-switch-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
+
+            touchscreen-size-x = <1440>;
+            touchscreen-size-y = <2880>;
+        };
+    };
+
+...
