maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=soc-qcom-msm8998
pkgdesc="Common package for Qualcomm MSM8998 devices"
pkgver=1
pkgrel=6
url="https://postmarketos.org"
license="BSD-3-Clause"
arch="aarch64"
options="!check !archcheck !tracedeps"
# qcom-diag and soc-qcom-modem used to live in a nonfree_firmware
# subpackage; pmaports policy since the 2024 default-nonfree-firmware
# change is that nonfree firmware belongs in the package's own depends=,
# not a separate subpackage (see docs/packaging/firmware-packages.md).
depends="
	qcom-diag
	soc-qcom
	soc-qcom-modem
	soc-qcom-pd-mapper
"
source="iwd-main.conf"
subpackages="
	$pkgname-openrc:openrc
	"

package() {
	mkdir -p "$pkgdir"
	install -D -m644 "$srcdir"/iwd-main.conf \
		"$pkgdir"/etc/iwd/main.conf
}

openrc() {
	pkgdesc="OpenRC service enablement for soc-qcom-msm8998"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="qcom-diag-openrc openrc"

	mkdir "$subpkgdir"
}

sha512sums="
2e3e2be6947e1fb0335ca53ef1f1929b614e3192385f3a42ddb895729793ce185e8c8ad0f16f851ee025c751045cfaf02712b42e89818e37eae532fb59613375  iwd-main.conf
"
