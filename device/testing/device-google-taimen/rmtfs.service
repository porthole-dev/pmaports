[Unit]
Description=Qualcomm Remote Filesystem Service
Documentation=https://github.com/linux-msm/rmtfs
# The modem reads and writes its NV/EFS through this. If it is not up before
# the modem boots, the modem takes a fatal error a short while later.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
# -r: use the /dev/qcom_rmtfs_mem* carveout   -P: back storage with the
# by-partlabel partitions (modemst1/modemst2/fsg/fsc)   -s: sync after writes
ExecStart=/usr/bin/rmtfs -r -P -s
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
