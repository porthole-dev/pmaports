+// A canvas that draws nothing and remembers whether it was asked to. Played back with the
+// recording's bounding-box hierarchy and a clip, it is only handed the operations whose bounds
+// touch the clip, and the abort callback stops the playback at the first one.
+class DrawProbeCanvas final : public SkNoDrawCanvas, public SkPicture::AbortCallback {
+public:
+    explicit DrawProbeCanvas(const SkIRect& bounds)
+        : SkNoDrawCanvas(bounds)
+    {
+    }
+
+    bool drewSomething() const { return m_drewSomething; }
+
+private:
+    bool abort() final { return m_drewSomething; }
+    void onDrawPaint(const SkPaint&) final { m_drewSomething = true; }
+    void onDrawBehind(const SkPaint&) final { m_drewSomething = true; }
+    void onDrawPoints(PointMode, size_t, const SkPoint[], const SkPaint&) final { m_drewSomething = true; }
+    void onDrawRect(const SkRect&, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawRegion(const SkRegion&, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawOval(const SkRect&, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawArc(const SkRect&, SkScalar, SkScalar, bool, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawRRect(const SkRRect&, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawDRRect(const SkRRect&, const SkRRect&, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawPath(const SkPath&, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawImage2(const SkImage*, SkScalar, SkScalar, const SkSamplingOptions&, const SkPaint*) final { m_drewSomething = true; }
+    void onDrawImageRect2(const SkImage*, const SkRect&, const SkRect&, const SkSamplingOptions&, const SkPaint*, SrcRectConstraint) final { m_drewSomething = true; }
+    void onDrawImageLattice2(const SkImage*, const Lattice&, const SkRect&, SkFilterMode, const SkPaint*) final { m_drewSomething = true; }
+    void onDrawAtlas2(const SkImage*, const SkRSXform[], const SkRect[], const SkColor[], int, SkBlendMode, const SkSamplingOptions&, const SkRect*, const SkPaint*) final { m_drewSomething = true; }
+    void onDrawVerticesObject(const SkVertices*, SkBlendMode, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawPatch(const SkPoint[12], const SkColor[4], const SkPoint[4], SkBlendMode, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawShadowRec(const SkPath&, const SkDrawShadowRec&) final { m_drewSomething = true; }
+    void onDrawTextBlob(const SkTextBlob*, SkScalar, SkScalar, const SkPaint&) final { m_drewSomething = true; }
+    void onDrawDrawable(SkDrawable*, const SkMatrix*) final { m_drewSomething = true; }
+    void onDrawPicture(const SkPicture*, const SkMatrix*, const SkPaint*) final { m_drewSomething = true; }
+    void onDrawEdgeAAQuad(const SkRect&, const SkPoint[4], QuadAAFlags, const SkColor4f&, SkBlendMode) final { m_drewSomething = true; }
+    void onDrawEdgeAAImageSet2(const ImageSetEntry[], int, const SkPoint[], const SkMatrix[], const SkSamplingOptions&, const SkPaint*, SrcRectConstraint) final { m_drewSomething = true; }
+
+    bool m_drewSomething { false };
+};
+
+} // namespace
+
+bool SkiaPaintingEngine::recordingPaintsInRect(const SkiaRecordingResult& recording, const IntRect& rect)
+{
+    DrawProbeCanvas probe(SkIRect::MakeWH(rect.width(), rect.height()));
+    probe.translate(recording.recordRect().x() - rect.x(), recording.recordRect().y() - rect.y());
+    recording.picture()->playback(&probe, &probe);
+    return probe.drewSomething();
+}
