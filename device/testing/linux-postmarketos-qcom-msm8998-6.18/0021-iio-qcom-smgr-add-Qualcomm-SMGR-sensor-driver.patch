--- /dev/null
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -0,0 +1,1706 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm Sensor Manager driver
+ *
+ * Copyright (c) 2021-2025, Yassine Oudjana <y.oudjana@protonmail.com>
+ */
+
+#include <linux/iio/buffer.h>
+#include <linux/iio/common/qcom_smgr.h>
+#include <linux/iio/events.h>
+#include <linux/iio/iio.h>
+#include <linux/iio/kfifo_buf.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/remoteproc/qcom_rproc.h>
+#include <linux/soc/qcom/qmi.h>
+#include <linux/soc/qcom/qrtr.h>
+#include <linux/types.h>
+#include <net/sock.h>
+
+#include "qmi/qmi_sns_smgr.h"
+
+MODULE_IMPORT_NS("QRTR");
+
+#define SMGR_TICKS_PER_SECOND		32768
+#define SMGR_REPORT_RATE_HZ		(SMGR_TICKS_PER_SECOND * 2)
+#define SMGR_VALUE_DECIMAL_OFFSET	16
+
+/*
+ * Several parts are ONE sensor id with TWO data types: the prox/ALS part
+ * carries the ambient light as its SECONDARY, and the IMU and barometer carry
+ * their die thermometers there. Reports are dispatched by report id, so the
+ * second subscription needs an id of its own. Sensor ids are all below 0x80
+ * here except the Google 0xf0-0xf9 block, which has no secondary, so setting
+ * bit 7 cannot collide.
+ */
+#define SMGR_SECONDARY_REPORT_ID(id)	((id) | 0x80)
+
+/* scan index of the magnetometer's synthesised heading channel */
+#define QCOM_SMGR_MAG_SCAN_ROT		3
+
+static int qcom_smgr_request_all_sensor_info(struct qcom_smgr *smgr,
+					     struct qcom_smgr_sensor **sensors)
+{
+	struct sns_smgr_all_sensor_info_resp resp = {};
+	struct qmi_txn txn;
+	u8 i;
+	int ret;
+
+	dev_dbg(smgr->dev, "Getting available sensors\n");
+
+	ret = qmi_txn_init(&smgr->sns_smgr_hdl, &txn,
+			   sns_smgr_all_sensor_info_resp_ei, &resp);
+	if (ret < 0) {
+		dev_err(smgr->dev, "Failed to initialize QMI TXN: %d\n", ret);
+		return ret;
+	}
+
+	ret = qmi_send_request(&smgr->sns_smgr_hdl, &smgr->sns_smgr_info, &txn,
+			       SNS_SMGR_ALL_SENSOR_INFO_MSG_ID,
+			       SNS_SMGR_ALL_SENSOR_INFO_REQ_MAX_LEN, NULL,
+			       NULL);
+	if (ret) {
+		dev_err(smgr->dev,
+			"Failed to send available sensors request: %d\n", ret);
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+
+	ret = qmi_txn_wait(&txn, 5 * HZ);
+	if (ret < 0)
+		return ret;
+
+	/* Check the response */
+	if (resp.result) {
+		dev_err(smgr->dev, "Available sensors request failed: 0x%x\n",
+			resp.result);
+		return -EREMOTEIO;
+	}
+
+	*sensors = devm_kzalloc(smgr->dev,
+				sizeof(struct qcom_smgr_sensor) * resp.item_len,
+				GFP_KERNEL);
+
+	for (i = 0; i < resp.item_len; ++i) {
+		(*sensors)[i].id = resp.items[i].id;
+		(*sensors)[i].type =
+			sns_smgr_sensor_type_from_str(resp.items[i].type);
+
+		/*
+		 * Worth keeping: this is how it was established that the SLPI
+		 * offers no fused orientation over SMGR, only raw sensors --
+		 * which is why the compass is synthesised below.
+		 */
+		dev_dbg(smgr->dev, "sensor id=0x%02x type='%s' mapped=%d\n",
+			 resp.items[i].id, resp.items[i].type,
+			 (*sensors)[i].type);
+
+		mutex_init(&(*sensors)[i].lock);
+		init_completion(&(*sensors)[i].report);
+	}
+
+	return resp.item_len;
+}
+
+static int qcom_smgr_request_single_sensor_info(struct qcom_smgr *smgr,
+						struct qcom_smgr_sensor *sensor)
+{
+	struct sns_smgr_single_sensor_info_req req = {
+		.sensor_id = sensor->id,
+	};
+	struct sns_smgr_single_sensor_info_resp resp = {};
+	struct qmi_txn txn;
+	u8 i;
+	int ret;
+
+	dev_vdbg(smgr->dev, "Getting single sensor info for ID 0x%02x\n",
+		 sensor->id);
+
+	ret = qmi_txn_init(&smgr->sns_smgr_hdl, &txn,
+			   sns_smgr_single_sensor_info_resp_ei, &resp);
+	if (ret < 0) {
+		dev_err(smgr->dev, "Failed to initialize QMI transaction: %d\n",
+			ret);
+		return ret;
+	}
+
+	ret = qmi_send_request(&smgr->sns_smgr_hdl, &smgr->sns_smgr_info, &txn,
+			       SNS_SMGR_SINGLE_SENSOR_INFO_MSG_ID,
+			       SNS_SMGR_SINGLE_SENSOR_INFO_REQ_MAX_LEN,
+			       sns_smgr_single_sensor_info_req_ei, &req);
+	if (ret < 0) {
+		dev_err(smgr->dev, "Failed to send sensor data request: %d\n",
+			ret);
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+
+	ret = qmi_txn_wait(&txn, 5 * HZ);
+	if (ret < 0)
+		return ret;
+
+	/* Check the response */
+	if (resp.result) {
+		dev_err(smgr->dev, "Single sensor info request failed: 0x%x\n",
+			resp.result);
+		return -EREMOTEIO;
+	}
+
+	sensor->data_type_count = resp.data_type_len;
+	sensor->data_types =
+		devm_kzalloc(smgr->dev,
+			     sizeof(struct qcom_smgr_data_type_item) *
+				     sensor->data_type_count,
+			     GFP_KERNEL);
+	if (!sensor->data_types)
+		return -ENOMEM;
+
+	for (i = 0; i < sensor->data_type_count; ++i) {
+		sensor->data_types[i].name = devm_kstrdup_const(
+			smgr->dev, resp.data_types[i].name, GFP_KERNEL);
+		sensor->data_types[i].vendor = devm_kstrdup_const(
+			smgr->dev, resp.data_types[i].vendor, GFP_KERNEL);
+
+		sensor->data_types[i].range = resp.data_types[i].range;
+
+		sensor->data_types[i].native_sample_rate_count =
+			resp.native_sample_rates[i].rate_count;
+		if (sensor->data_types[i].native_sample_rate_count) {
+			sensor->data_types[i]
+				.native_sample_rates = devm_kmemdup(
+				smgr->dev, resp.native_sample_rates[i].rates,
+				array_size(sensor->data_types[i]
+						   .native_sample_rate_count,
+					   sizeof(u16)),
+				GFP_KERNEL);
+			if (!sensor->data_types[i].native_sample_rates)
+				return -ENOMEM;
+		}
+
+		sensor->data_types[i].max_sample_rate =
+			resp.data_types[i].max_sample_rate_hz;
+	}
+
+	return 0;
+}
+
+/*
+ * Where a sensor's SECONDARY data type lands in its scan, or -1 if it has none
+ * worth exposing. A secondary report carries a single value, and it has to be
+ * merged into the scan position its channel spec declares rather than the
+ * position it arrives in.
+ */
+static int qcom_smgr_secondary_scan_index(enum qcom_smgr_sensor_type type)
+{
+	switch (type) {
+	case SNS_SMGR_SENSOR_TYPE_PROX_LIGHT:	/* ambient light */
+	case SNS_SMGR_SENSOR_TYPE_PRESSURE:	/* BMP280 die temperature */
+		return 1;
+	/*
+	 * Not the LSM6DSM thermometer, even though SMGR advertises it as data
+	 * type 1 on both the accelerometer and the gyroscope: subscribing to it
+	 * is rejected with result 0x501, while the BMP280's temperature on the
+	 * same code path is accepted. The vendor's own sensor list does not
+	 * expose it either. Advertising a channel that can never report is
+	 * worse than not having one.
+	 */
+	default:
+		return -1;
+	}
+}
+
+static int qcom_smgr_request_buffering_item(struct qcom_smgr *smgr,
+					   struct qcom_smgr_sensor *sensor,
+					   u8 data_type, u8 report_id,
+					   bool enable)
+{
+	struct sns_smgr_buffering_req req = {
+		.report_id = report_id,
+		.notify_suspend_valid = false
+	};
+	struct sns_smgr_buffering_resp resp = {};
+	struct qmi_txn txn;
+	u16 sample_rate = 0;
+	int ret;
+
+	if (enable) {
+		req.action = SNS_SMGR_BUFFERING_ACTION_ADD;
+
+		/*
+		 * Report rate and sample rate can be configured separately.
+		 * The former is the rate at which buffering report indications
+		 * are sent, while the latter is the actual sample rate of the
+		 * sensor. If report rate is set lower than sample rate,
+		 * multiple samples can be bundled and sent in one report.
+		 * A report cannot have 0 samples, therefore report rate cannot
+		 * be higher than sample rate.
+		 *
+		 * Fow now we default to the maximum sample rate and set the
+		 * report rate such that every report contains only 1 sample.
+		 * This gives us the lowest latency.
+		 */
+		if (sensor->data_types[data_type].native_sample_rates)
+			sample_rate = sensor->data_types[data_type].native_sample_rates
+					[sensor->data_types[data_type]
+						 .native_sample_rate_count - 1];
+
+		/*
+		 * SMGR may support a lower maximum sample rate than natively
+		 * supported by the sensor.
+		 */
+		if (sample_rate == 0 ||
+		    sample_rate > sensor->data_types[data_type].max_sample_rate)
+			sample_rate = sensor->data_types[data_type].max_sample_rate;
+
+		req.report_rate = sample_rate * SMGR_REPORT_RATE_HZ;
+
+		req.item_len = 1;
+		req.items[0].sensor_id = sensor->id;
+		req.items[0].data_type = data_type;
+
+		req.items[0].sampling_rate = sample_rate;
+
+		/*
+		 * Unknown fields set to values frequently seen in dumps and
+		 * known to be working (although many different random values
+		 * appear to not cause any trouble).
+		 */
+		req.items[0].val1 = 3;
+		req.items[0].val2 = 1;
+
+	} else
+		req.action = SNS_SMGR_BUFFERING_ACTION_DELETE;
+
+	ret = qmi_txn_init(&smgr->sns_smgr_hdl, &txn,
+			   sns_smgr_buffering_resp_ei, &resp);
+	if (ret < 0) {
+		dev_err(smgr->dev, "Failed to initialize QMI TXN: %d\n", ret);
+		return ret;
+	}
+
+	ret = qmi_send_request(&smgr->sns_smgr_hdl, &smgr->sns_smgr_info, &txn,
+			       SNS_SMGR_BUFFERING_MSG_ID,
+			       SNS_SMGR_BUFFERING_REQ_MAX_LEN,
+			       sns_smgr_buffering_req_ei, &req);
+	if (ret < 0) {
+		dev_err(smgr->dev, "Failed to send buffering request: %d\n",
+			ret);
+		qmi_txn_cancel(&txn);
+		return ret;
+	}
+
+	ret = qmi_txn_wait(&txn, 5 * HZ);
+	if (ret < 0)
+		return ret;
+
+	/* Check the response */
+	if (resp.result) {
+		dev_err(smgr->dev, "Buffering request failed: 0x%x\n",
+			resp.result);
+		return -EREMOTEIO;
+	}
+
+	/* Keep track of requested sample rate */
+	sensor->data_types[data_type].cur_sample_rate = sample_rate;
+
+	return 0;
+}
+
+/*
+ * A sensor id can carry a second data type, and it is not decoration. The AMS
+ * TMx490x reports 'TMx490x PROX' and 'TMx490x ALS'; the LSM6DSM and the BMP280
+ * report their die thermometers the same way. Subscribing to PRIMARY alone was
+ * why illuminance had to be scraped out of the PROX report's second value, and
+ * that value tracks the proximity IR emitter: covering the sensor drove it
+ * from ~124 to ~41088, so covering the phone made the screen BRIGHTER. The ALS
+ * data type behaves properly -- 9 lux uncovered, 0 when covered.
+ *
+ * SMGR will not take both data types as two items of ONE request: it acks the
+ * request and then stops reporting that sensor entirely. Two separate
+ * requests, each with its own report id, work.
+ */
+static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
+				       struct qcom_smgr_sensor *sensor,
+				       bool enable)
+{
+	int ret;
+
+	ret = qcom_smgr_request_buffering_item(smgr, sensor,
+					       SNS_SMGR_DATA_TYPE_PRIMARY,
+					       sensor->id, enable);
+	if (ret)
+		return ret;
+
+	if (qcom_smgr_secondary_scan_index(sensor->type) < 0 ||
+	    sensor->data_type_count <= SNS_SMGR_DATA_TYPE_SECONDARY)
+		return 0;
+
+	/*
+	 * Deliberately not fatal. SMGR advertises data types it will then
+	 * refuse to buffer -- the LSM6DSM thermometer is rejected with 0x501 --
+	 * and returning that error here took the whole sensor down with it,
+	 * because the caller unwinds and the accelerometer ends up with no
+	 * subscription at all. The secondary is always the lesser channel, so
+	 * lose it and keep the sensor.
+	 */
+	ret = qcom_smgr_request_buffering_item(smgr, sensor,
+					       SNS_SMGR_DATA_TYPE_SECONDARY,
+					       SMGR_SECONDARY_REPORT_ID(sensor->id),
+					       enable);
+	if (ret)
+		dev_warn_ratelimited(smgr->dev,
+				     "sensor 0x%02x: no secondary data type: %d\n",
+				     sensor->id, ret);
+
+	return 0;
+}
+
+
+/* ---------------------------------------------------------------- compass */
+
+/*
+ * A heading has to be synthesised here because nothing else can.
+ *
+ * The SLPI advertises only raw sensors over SMGR -- ACCEL, GYRO, MAG,
+ * PRESSURE, PROX_LIGHT, HALL_EFFECT and a handful of gesture/step ones. The
+ * fused orientation the vendor uses lives in SAM, a different QMI service this
+ * driver does not speak. And iio-sensor-proxy, which is what every desktop
+ * compass consumer talks to, only recognises a compass from a device that
+ * exposes in_rot_from_north_magnetic_tilt_comp -- it has no path that fuses a
+ * raw magnetometer with an accelerometer itself.
+ *
+ * So the choice is between doing it here and having no compass at all. This is
+ * in-kernel sensor fusion, which upstream IIO would rightly object to; it is
+ * here because on this SoC there is no other place to put it.
+ *
+ * All arithmetic is Q16 fixed point, matching the sample format. No sin/cos is
+ * needed: projecting out the vertical component and taking one atan2 does the
+ * tilt compensation with dot and cross products alone.
+ */
+
+#define SMGR_Q16	(1 << SMGR_VALUE_DECIMAL_OFFSET)
+#define SMGR_DEG(x)	((s32)((x) * SMGR_Q16))
+
+/* atan(2^-i) in Q16 degrees */
+static const s32 qcom_smgr_cordic_atan[] = {
+	2949120, 1740993, 919938, 466945, 234378, 117308, 58666, 29335,
+	14667, 7334, 3667, 1834, 917, 458, 229, 115,
+};
+
+/*
+ * CORDIC in vectoring mode: rotate (x, y) onto the +x axis and accumulate the
+ * angle. Returns Q16 degrees in [0, 360). x and y may be any consistent unit --
+ * only their ratio matters, so the CORDIC gain is irrelevant.
+ */
+static s32 qcom_smgr_atan2(s64 y, s64 x)
+{
+	s64 xn, yn;
+	s32 z = 0;
+	int i;
+
+	if (!x && !y)
+		return 0;
+
+	/* CORDIC only converges for x > 0; fold the other half plane in. */
+	if (x < 0) {
+		x = -x;
+		y = -y;
+		z = SMGR_DEG(180);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(qcom_smgr_cordic_atan); i++) {
+		if (y > 0) {
+			xn = x + (y >> i);
+			yn = y - (x >> i);
+			z += qcom_smgr_cordic_atan[i];
+		} else {
+			xn = x - (y >> i);
+			yn = y + (x >> i);
+			z -= qcom_smgr_cordic_atan[i];
+		}
+		x = xn;
+		y = yn;
+	}
+
+	/* Fold into [0, 360) */
+	while (z < 0)
+		z += SMGR_DEG(360);
+	while (z >= SMGR_DEG(360))
+		z -= SMGR_DEG(360);
+
+	return z;
+}
+
+/*
+ * qcom_smgr_iio_mount_matrix is what consumers apply to reach the IIO device
+ * frame. The heading is computed here rather than by a consumer, so it has to
+ * be applied here too -- and it has to be the SAME matrix, or the compass and
+ * the screen rotation disagree about which way the phone is pointing.
+ *
+ * SMGR reports (top, right, into-the-screen), so this is the x/y swap and the
+ * z inversion of that matrix, spelled out. Both frames are right-handed and
+ * this is a proper rotation, which the cross product below depends on.
+ */
+static void qcom_smgr_to_iio_frame(const s32 *in, s32 *out)
+{
+	out[0] = in[1];
+	out[1] = in[0];
+	out[2] = -in[2];
+}
+
+/*
+ * Tilt-compensated magnetic heading of the device's +Y axis (the top of the
+ * screen), Q16 degrees clockwise from magnetic north.
+ *
+ * up  = normalised accelerometer vector; at rest it points away from the earth
+ * Nh  = m - up (m . up)   -- the horizontal component of the field, i.e. north
+ * E   = Nh x up           -- east, and |E| == |Nh| because up is a unit vector
+ *                            and perpendicular to Nh, so no normalisation is
+ *                            needed before the atan2
+ * The device's +Y axis dotted with each of those is simply their y component.
+ */
+static s32 qcom_smgr_heading(const s32 *accel_smgr, const s32 *mag_smgr)
+{
+	s32 a[3], m[3], up[3], nh[3];
+	s64 norm, dot, ey;
+	int i;
+
+	qcom_smgr_to_iio_frame(accel_smgr, a);
+	qcom_smgr_to_iio_frame(mag_smgr, m);
+
+	norm = (s64)a[0] * a[0] + (s64)a[1] * a[1] + (s64)a[2] * a[2];
+	norm = int_sqrt64(norm);
+	if (!norm)
+		return 0;
+
+	for (i = 0; i < 3; i++)
+		up[i] = div64_s64((s64)a[i] * SMGR_Q16, norm);
+
+	dot = ((s64)m[0] * up[0] + (s64)m[1] * up[1] + (s64)m[2] * up[2])
+		>> SMGR_VALUE_DECIMAL_OFFSET;
+
+	for (i = 0; i < 3; i++)
+		nh[i] = m[i] - (s32)((dot * up[i]) >> SMGR_VALUE_DECIMAL_OFFSET);
+
+	/* E = Nh x up; only the y component is needed */
+	ey = ((s64)nh[2] * up[0] - (s64)nh[0] * up[2])
+		>> SMGR_VALUE_DECIMAL_OFFSET;
+
+	return qcom_smgr_atan2(ey, nh[1]);
+}
+
+static struct qcom_smgr_sensor *qcom_smgr_find(struct qcom_smgr *smgr,
+					       enum qcom_smgr_sensor_type type)
+{
+	u8 i;
+
+	for (i = 0; i < smgr->sensor_count; i++)
+		if (smgr->sensors[i].type == type)
+			return &smgr->sensors[i];
+
+	return NULL;
+}
+
+/*
+ * Two things ask the SLPI to stream a sensor now: the sensor's own IIO buffer,
+ * and the magnetometer's compass channel, which needs the accelerometer for
+ * tilt. Refcount it, or whichever one stops last silently kills the other.
+ * Callers hold sensor->lock.
+ */
+static int qcom_smgr_buffering_get(struct qcom_smgr *smgr,
+				   struct qcom_smgr_sensor *sensor)
+{
+	int ret;
+
+	if (sensor->buffering_refs++)
+		return 0;
+
+	ret = qcom_smgr_request_buffering(smgr, sensor, true);
+	if (ret)
+		sensor->buffering_refs--;
+
+	return ret;
+}
+
+static void qcom_smgr_buffering_put(struct qcom_smgr *smgr,
+				    struct qcom_smgr_sensor *sensor)
+{
+	if (WARN_ON(!sensor->buffering_refs))
+		return;
+
+	if (--sensor->buffering_refs)
+		return;
+
+	qcom_smgr_request_buffering(smgr, sensor, false);
+	sensor->have_report = false;
+}
+
+static void qcom_smgr_buffering_report_handler(struct qmi_handle *hdl,
+					       struct sockaddr_qrtr *sq,
+					       struct qmi_txn *txn,
+					       const void *data)
+{
+	struct qcom_smgr *smgr =
+		container_of(hdl, struct qcom_smgr, sns_smgr_hdl);
+	const struct sns_smgr_buffering_report_ind *ind = data;
+	struct qcom_smgr_sensor *sensor;
+	struct qcom_smgr_iio_data iio_data = {};
+	bool is_secondary = false;
+	int sec, temp;
+	u8 i, j;
+
+	for (i = 0; i < smgr->sensor_count; ++i) {
+		sensor = &smgr->sensors[i];
+
+		/* Find sensor matching report */
+		if (sensor->id == ind->report_id)
+			break;
+
+		/*
+		 * ...or its second subscription, which carries its own report
+		 * id and a single value: the ambient light, or a die
+		 * temperature.
+		 */
+		if (qcom_smgr_secondary_scan_index(sensor->type) >= 0 &&
+		    SMGR_SECONDARY_REPORT_ID(sensor->id) == ind->report_id) {
+			is_secondary = true;
+			break;
+		}
+	}
+
+	if (i == smgr->sensor_count) {
+		dev_warn_ratelimited(smgr->dev,
+			"Received buffering report with unknown ID: %02x",
+			ind->report_id);
+		return;
+	}
+
+	/*
+	 * Construct data to be passed to IIO. Since we are matching report rate
+	 * with sample rate, we only get a single sample in every report.
+	 */
+	for (j = 0; j < ARRAY_SIZE(ind->samples[0].values); ++j)
+		iio_data.values[j] = ind->samples[0].values[j];
+
+	/*
+	 * SMGR reports sensor data in 32-bit fixed-point values, with 16 bits
+	 * holding the integer part and the other 16 bits holding the numerator
+	 * of a fraction with the denominator 2**16.
+	 */
+
+	/*
+	 * Hard-iron correction. taimen's own magnets bias the field by roughly
+	 * three times its magnitude, so without this the heading is meaningless
+	 * -- see tools/tk-compass-cal.py.
+	 */
+	if (sensor->type == SNS_SMGR_SENSOR_TYPE_MAG) {
+		s32 mag[3];
+		struct qcom_smgr_sensor *accel;
+
+		for (j = 0; j < 3; j++) {
+			mag[j] = (s32)le32_to_cpu(iio_data.values[j]) -
+				 sensor->calibbias[j];
+			iio_data.values[j] = cpu_to_le32(mag[j]);
+		}
+
+		accel = qcom_smgr_find(smgr, SNS_SMGR_SENSOR_TYPE_ACCEL);
+		if (accel && accel->have_report)
+			iio_data.values[3] = cpu_to_le32(
+				qcom_smgr_heading((s32 *)accel->last_values,
+						  mag));
+	}
+
+	/*
+	 * Proximity is a boolean (0 or 1, still in the fixed-point format)
+	 * meaning "something is within range". Scale it by the sensor range so
+	 * there is something to threshold against, and keep the ABI's
+	 * polarity: in_proximity_raw is defined so that higher means closer,
+	 * and iio-sensor-proxy reports "near" at or above
+	 * PROXIMITY_NEAR_LEVEL. Emitting a distance instead is not merely
+	 * wrong but unusable -- no threshold reads "far" while uncovered.
+	 */
+	if (sensor->type == SNS_SMGR_SENSOR_TYPE_PROX_LIGHT && !is_secondary) {
+		temp = le32_to_cpu(iio_data.values[0]);
+		temp >>= SMGR_VALUE_DECIMAL_OFFSET;
+		temp &= 1;
+		temp *= sensor->data_types[0].range;
+		iio_data.values[0] = cpu_to_le32(temp);
+	}
+
+	/*
+	 * The hall switch is the same fixed-point boolean, but nothing
+	 * thresholds it the way iio-sensor-proxy thresholds proximity, so
+	 * report a plain 0 or 1 rather than the Q16.16 1.0 that reads as
+	 * 65536. Measured: 65536 with a magnet at the phone's bottom-left
+	 * corner, 0 everywhere else.
+	 */
+	if (sensor->type == SNS_SMGR_SENSOR_TYPE_HALL_EFFECT) {
+		temp = le32_to_cpu(iio_data.values[0]);
+		temp >>= SMGR_VALUE_DECIMAL_OFFSET;
+		iio_data.values[0] = cpu_to_le32(temp & 1);
+	}
+
+	/*
+	 * Two data types means two subscriptions and two reports, and each
+	 * carries only its own values. Merge them through last_values, or
+	 * whichever report arrived last would blank the other's channels and a
+	 * consumer polling one would read a stale zero in the other.
+	 *
+	 * A secondary report carries its single value in values[0]; it belongs
+	 * at the scan index its channel spec declares.
+	 */
+	/*
+	 * An event-only sensor produces a report exactly when its event fires,
+	 * so the report IS the event. It has no scan and nothing to buffer.
+	 */
+	if (sensor->iio_dev->channels[0].scan_index < 0) {
+		const struct iio_chan_spec *chan = &sensor->iio_dev->channels[0];
+		u64 code, now;
+
+		if (chan->modified)
+			code = IIO_MOD_EVENT_CODE(chan->type, chan->channel,
+						  chan->channel2,
+						  IIO_EV_TYPE_CHANGE,
+						  IIO_EV_DIR_NONE);
+		else
+			code = IIO_UNMOD_EVENT_CODE(chan->type, chan->channel,
+						    IIO_EV_TYPE_CHANGE,
+						    IIO_EV_DIR_NONE);
+
+		now = iio_get_time_ns(sensor->iio_dev);
+
+		/*
+		 * Coalesce. SMGR does not send one report per detection: a
+		 * single step produces a burst of around 25 reports inside 3
+		 * ms, bursts arriving roughly 800 ms apart, and every report
+		 * carries the same v0=1 with samples_len=1 -- so there is no
+		 * edge or count in the payload to tell them apart. Measured:
+		 * 270 events for 25 steps.
+		 *
+		 * ponytail: 100 ms window, which no human gait can beat, so
+		 * one burst becomes one event. It is a floor on the duplicates
+		 * rather than a fix for them -- the burst cadence is not
+		 * understood, and 11 bursts for 25 steps means bursts are not
+		 * steps either. Treat in_steps_input on qcom-smgr-step-count
+		 * as the accurate source; this event says "moving", not "one
+		 * step". The real fix is in the subscription's report rate,
+		 * which is set for continuous sensors.
+		 */
+		if (sensor->last_event_ns &&
+		    now - sensor->last_event_ns < 100 * NSEC_PER_MSEC) {
+			sensor->have_report = true;
+			complete(&sensor->report);
+			return;
+		}
+		sensor->last_event_ns = now;
+
+		iio_push_event(sensor->iio_dev, code, now);
+
+		sensor->have_report = true;
+		complete(&sensor->report);
+		return;
+	}
+
+	sec = qcom_smgr_secondary_scan_index(sensor->type);
+	if (sec >= 0) {
+		u32 merged[ARRAY_SIZE(iio_data.values)];
+
+		memcpy(merged, sensor->last_values, sizeof(merged));
+
+		if (is_secondary) {
+			merged[sec] = le32_to_cpu(iio_data.values[0]);
+		} else {
+			for (j = 0; j < ARRAY_SIZE(merged); j++)
+				if (j != sec)
+					merged[j] =
+					    le32_to_cpu(iio_data.values[j]);
+		}
+
+		for (j = 0; j < ARRAY_SIZE(merged); j++)
+			iio_data.values[j] = cpu_to_le32(merged[j]);
+	}
+
+	/*
+	 * Not iio_push_to_buffers(): the struct is laid out for a 3-axis
+	 * sensor, but pressure and prox/light have fewer channels and so a
+	 * shorter scan, which puts their timestamp somewhere else entirely.
+	 * The _with_timestamp() helper places it per the device's own scan.
+	 */
+	memcpy(sensor->last_values, iio_data.values,
+	       sizeof(sensor->last_values));
+	sensor->have_report = true;
+	complete(&sensor->report);
+
+	iio_push_to_buffers_with_timestamp(sensor->iio_dev, &iio_data,
+					   iio_get_time_ns(sensor->iio_dev));
+}
+
+static const struct qmi_msg_handler qcom_smgr_msg_handlers[] = {
+	{
+		.type = QMI_INDICATION,
+		.msg_id = SNS_SMGR_BUFFERING_REPORT_MSG_ID,
+		.ei = sns_smgr_buffering_report_ind_ei,
+		.decoded_size = sizeof(struct sns_smgr_buffering_report_ind),
+		.fn = qcom_smgr_buffering_report_handler,
+	},
+	{ }
+};
