From 0f9d064d27c08cd3f4cac9bfa69861e524c11149 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 20 Aug 2026 19:53:30 +0200
Subject: [PATCH] media: qcom: camss: csiphy: keep the computed settle count,
 add a sweep knob

An earlier version of this patch forced the vendor settle counts on msm8998
(14 above 500 MHz, 21 below), on the theory that the computed 11/12 sampled the
data lane too early and caused the stray wrong-coloured pixels seen in the
image.

Tested on hardware: it made the artefacts visibly WORSE. Back at the computed
11 the frame shows 1-2 stray pixels; at the vendor 14 there were many more. A
settle count can be wrong in both directions -- too long overshoots into the
payload -- and the values stock programs evidently do not transfer to this
link rate and lane configuration.

So keep the computed value as the default and keep only the module parameter,
which is what made the test possible without a rebuild. The remaining 1-2 stray
pixels are unexplained; settle_override is the tool for whoever chases them.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../qcom/camss/camss-csiphy-3ph-1-0.c         | 27 ++++++++-----------
 1 file changed, 11 insertions(+), 16 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
index c77eb6669904..08a5cd129ffd 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -832,8 +832,15 @@ static irqreturn_t csiphy_isr(int irq, void *dev)
 }
 
 /*
- * Sweep the settle count without a rebuild. 0 keeps the per-SoC default. This
- * is how the msm8998 vendor values below were pinned down against stock.
+ * Sweep the settle count without a rebuild; 0 keeps the computed value.
+ *
+ * Worth having because the computed value is not obviously right and the only
+ * way to judge it is to look at the image. Measured on msm8998 2026-08-20: the
+ * computed 11 (685 MHz rear link, 200 MHz settle timer) leaves 1-2 stray
+ * wrong-coloured pixels per frame, and forcing the vendor's 14 -- the value
+ * stock Android programs -- made it visibly WORSE, not better. So the vendor
+ * numbers do not transfer to this configuration and the computed value stays
+ * the default.
  */
 static unsigned int settle_override;
 module_param(settle_override, uint, 0644);
@@ -984,23 +991,11 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 	u8 val;
 	int i;
 
-	if (settle_override) {
+	if (settle_override)
 		settle_cnt = settle_override;
-	} else if (csiphy->camss->res->version == CAMSS_8998) {
-		/*
-		 * csiphy_settle_cnt_calc() collapses T_HS_SETTLE to its
-		 * T_HS_PREPARE_max bound and, with this PHY's 200 MHz settle
-		 * timer, lands on 11 for the 685 MHz rear link and 12 for the
-		 * 324 MHz front one. The vendor programs 14 and 21, captured
-		 * live from stock. Sampling that early costs occasional bit
-		 * errors on the data lane, which show up as stray wrong-coloured
-		 * pixels scattered through the frame.
-		 */
-		settle_cnt = link_freq > 500000000 ? 14 : 21;
-	} else {
+	else
 		settle_cnt = csiphy_settle_cnt_calc(link_freq,
 						    csiphy->timer_clk_rate);
-	}
 
 	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
 	for (i = 0; i < c->num_data; i++)
-- 
2.55.0

