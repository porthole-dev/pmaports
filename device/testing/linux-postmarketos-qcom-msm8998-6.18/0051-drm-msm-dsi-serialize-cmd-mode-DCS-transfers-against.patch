From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sun, 9 Aug 2026 13:12:30 +0200
Subject: [PATCH] drm/msm/dsi: serialize cmd-mode DCS transfers against DPU
 frame kickoff

A DCS command sent while the DPU is composing corrupts this DSC panel:
the stream desynchronises into full-screen noise banded at slice
boundaries, and a bad HS misframe can make the DDIC execute a phantom
command (measured: NORON dropped, screen dark) -- only a full panel
re-init recovers. This is mainline's long-standing "TODO: make sure
dsi_cmd_mdp is idle" biting for real.

Two approaches were measured insufficient before this one:

 - One-way waiting. Polling DSI_STATUS0 for CMD_MODE_MDP_BUSY|DMA_BUSY
   does engage (entry=05, 5-15 ms waits per write during a drag) and
   writes fired at status==0 still corrupted: nothing stops the DPU
   kicking off the next frame between the poll passing and the DMA
   leaving the wire.

 - Downstream's cmd-burst bit. Stock (msm-4.4 wahoo) sets 0x1b8[16]
   (mdss_dsi_set_burst_mode) and then skips its mdp_busy wait for
   burst-mode panels entirely. Setting the same bit here did not make
   unserialized writes safe and changed the failure shape; mainline's
   cmd-mode MDP stream programming evidently differs from downstream in
   ways this tree does not replicate. Kept available for experiments as
   msm.cmd_burst (default off).

The working fix is strict two-way mutual exclusion, the semantics
downstream implements with mdp_busy for non-burst panels:

 - dpu_encoder_kickoff() calls msm_dsi_cmd_kickoff_begin() before
   triggering CTL_START (which happens under enc_spinlock, hence the
   hook sits before it, in sleepable context). It takes the host's
   cmd_mutex -- blocking while any DCS transfer, including a multi-DMA
   read, is on the wire -- and marks a frame pending.

 - dsi_host_transfer() waits under cmd_mutex for the pending frame's
   CMD_MDP_DONE irq (newly handled in dsi_host_irq) before touching the
   wire, so commands only ever go out in a true inter-frame gap.

Verified on taimen (sw43402): brightness slider drags that corrupted
the panel within a second now run indefinitely clean, with the DCS
writes interleaving frames at ~30/s. Runtime switch:
msm.cmd_frame_serialize (default on).

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c |  11 ++
 drivers/gpu/drm/msm/dsi/dsi_host.c          | 208 ++++++++++++++++++++
 drivers/gpu/drm/msm/msm_drv.h               |   4 +
 3 files changed, 223 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 258edaa18fc0..2f81b63f77ff 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -2156,6 +2156,17 @@ void dpu_encoder_kickoff(struct drm_encoder *drm_enc)
 
 	trace_dpu_enc_kickoff(DRMID(drm_enc));
 
+	/*
+	 * Strict DCS/frame interleaving for cmd-mode DSI (see
+	 * msm_dsi_cmd_kickoff_begin()): blocks while a DCS transfer is on the
+	 * wire, and marks a frame pending so the next transfer waits for this
+	 * frame's CMD_MDP_DONE. Must stay ahead of _dpu_encoder_kickoff_phys(),
+	 * which triggers CTL_START under enc_spinlock (atomic). No-op unless
+	 * the dsi host has cmd_frame_serialize set.
+	 */
+	if (dpu_enc->disp_info.intf_type == DRM_MODE_ENCODER_DSI)
+		msm_dsi_cmd_kickoff_begin();
+
 	/* All phys encs are ready to go, trigger the kickoff */
 	_dpu_encoder_kickoff_phys(dpu_enc);
 
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index e0de545d4077..068f2b69e10b 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -8,6 +8,7 @@
 #include <linux/dma-mapping.h>
 #include <linux/err.h>
 #include <linux/interrupt.h>
+#include <linux/iopoll.h>
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
@@ -99,6 +100,20 @@ static int dsi_get_version(const void __iomem *base, u32 *major, u32 *minor)
 		DSI_CLK_CTRL_BYTECLK_ON | DSI_CLK_CTRL_ESCCLK_ON | \
 		DSI_CLK_CTRL_FORCE_ON_DYN_AHBM_HCLK)
 
+/*
+ * A/B switches for the cmd-mode DCS-vs-frame corruption investigation
+ * (2026-07-27, sw43402). cmd_burst mirrors what stock actually ships
+ * (hardware interleaving, no software wait); cmd_frame_serialize is the
+ * downstream non-burst fallback semantics (strict frame/command
+ * interleaving via cmd_mutex + CMD_MDP_DONE). cmd_burst applies at the
+ * next panel power-on (power-button cycle); cmd_frame_serialize applies
+ * immediately.
+ */
+static bool cmd_burst;
+module_param(cmd_burst, bool, 0644);
+static bool cmd_frame_serialize = true;
+module_param(cmd_frame_serialize, bool, 0644);
+
 struct msm_dsi_host {
 	struct mipi_dsi_host base;
 
@@ -146,6 +161,23 @@ struct msm_dsi_host {
 	struct mutex cmd_mutex;
 	spinlock_t intr_lock; /* Protect interrupt ctrl register */
 
+	/*
+	 * Command-mode frame/DCS interleaving. frame_pending is set by the DPU
+	 * (msm_dsi_cmd_kickoff_begin(), under cmd_mutex) before it writes
+	 * CTL_START, and cleared by the CMD_MDP_DONE interrupt when the frame
+	 * has fully left the controller. dsi_host_transfer() waits on it before
+	 * touching the wire, so a DCS packet can only go out in a true
+	 * inter-frame gap -- and because the DPU takes cmd_mutex to set it, a
+	 * new frame can never be kicked off while a transfer is in flight.
+	 * This is the interlock downstream implements with mdp_busy in
+	 * mdss_dsi_cmdlist_commit(); the one-way STATUS0 poll alone was
+	 * measured insufficient (writes placed at STATUS0==0 still corrupted
+	 * the panel, dsi-mdpwait 2026-07-27).
+	 */
+	wait_queue_head_t frame_wait;
+	bool frame_pending;
+	u32 mdp_done_cnt;
+
 	u32 err_work_state;
 	struct work_struct err_work;
 	struct workqueue_struct *workqueue;
@@ -1086,6 +1118,31 @@ static void dsi_timing_setup(struct msm_dsi_host *msm_host, bool is_bonded_dsi)
 		dsi_write(msm_host, REG_DSI_CMD_MDP_STREAM0_TOTAL,
 			DSI_CMD_MDP_STREAM0_TOTAL_H_TOTAL(hdisplay) |
 			DSI_CMD_MDP_STREAM0_TOTAL_V_TOTAL(mode->vdisplay));
+
+		/*
+		 * Command-mode burst. Downstream (mdss_dsi_set_burst_mode(),
+		 * msm-4.4 android-msm-wahoo-4.4-android10) sets 0x1b8 bit 16
+		 * for every DSI >= HW rev 1.03 whenever the panel declares
+		 * qcom,mdss-dsi-traffic-mode = "burst_mode" -- and with it set,
+		 * mdss_dsi_cmdlist_commit() sends non-MDP DCS commands (the
+		 * brightness path included) WITHOUT waiting for mdp_busy.
+		 * Stock therefore relies on this hardware feature, not on
+		 * software serialization, to interleave a command DMA with an
+		 * ongoing frame safely.
+		 *
+		 * Raw offset because this tree's dsi.xml.h predates the bit:
+		 * it labels 0x1b8 CMD_MODE_MDP_STREAM2_CTRL, while the actual
+		 * QC driver for this silicon read-modify-writes bit 16 of
+		 * 0x1b8 as the burst enable.
+		 */
+		if (cmd_burst) {
+			u32 data = dsi_read(msm_host, 0x1b8);
+
+			data |= BIT(16);
+			dsi_write(msm_host, 0x1b8, data);
+			pr_info("dsi: cmd-mode burst enabled (0x1b8=%08x)\n",
+				data);
+		}
 	}
 }
 
@@ -1119,6 +1176,14 @@ static void dsi_sw_reset(struct msm_dsi_host *msm_host)
 	}
 }
 
+/*
+ * The command-mode host the DPU must interleave frames against. Single
+ * pointer rather than per-encoder plumbing: this fork drives exactly one
+ * cmd-mode DSI panel, and the DPU-side hook (msm_dsi_cmd_kickoff_begin())
+ * simply no-ops while it is NULL.
+ */
+static struct msm_dsi_host *cmd_sync_host;
+
 static void dsi_op_mode_config(struct msm_dsi_host *msm_host,
 					bool video_mode, bool enable)
 {
@@ -1131,12 +1196,23 @@ static void dsi_op_mode_config(struct msm_dsi_host *msm_host,
 				DSI_CTRL_CMD_MODE_EN);
 		dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_CMD_MDP_DONE |
 					DSI_IRQ_MASK_VIDEO_DONE, 0);
+		if (cmd_sync_host == msm_host)
+			WRITE_ONCE(cmd_sync_host, NULL);
+		/*
+		 * A CMD_MDP_DONE that raced the disable would leave
+		 * frame_pending stuck and cost every init command a full
+		 * timeout on the next enable.
+		 */
+		WRITE_ONCE(msm_host->frame_pending, false);
+		wake_up(&msm_host->frame_wait);
 	} else {
 		if (video_mode) {
 			dsi_ctrl |= DSI_CTRL_VID_MODE_EN;
 		} else {		/* command mode */
 			dsi_ctrl |= DSI_CTRL_CMD_MODE_EN;
 			dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_CMD_MDP_DONE, 1);
+			WRITE_ONCE(msm_host->frame_pending, false);
+			WRITE_ONCE(cmd_sync_host, msm_host);
 		}
 		dsi_ctrl |= DSI_CTRL_ENABLE;
 	}
@@ -1144,6 +1220,28 @@ static void dsi_op_mode_config(struct msm_dsi_host *msm_host,
 	dsi_write(msm_host, REG_DSI_CTRL, dsi_ctrl);
 }
 
+/*
+ * Called by dpu_encoder_kickoff() before it triggers CTL_START for a
+ * cmd-mode DSI encoder. Taking cmd_mutex blocks until any in-flight DCS
+ * transfer (including a multi-DMA read) has fully finished, so a frame can
+ * never start on top of one; setting frame_pending then holds the next DCS
+ * transfer off until this frame's CMD_MDP_DONE.
+ *
+ * Process context only -- dpu_encoder_kickoff() runs in the commit worker,
+ * before enc_spinlock is taken.
+ */
+void msm_dsi_cmd_kickoff_begin(void)
+{
+	struct msm_dsi_host *msm_host = READ_ONCE(cmd_sync_host);
+
+	if (!msm_host || !cmd_frame_serialize)
+		return;
+
+	mutex_lock(&msm_host->cmd_mutex);
+	WRITE_ONCE(msm_host->frame_pending, true);
+	mutex_unlock(&msm_host->cmd_mutex);
+}
+
 static void dsi_set_tx_power_mode(int mode, struct msm_dsi_host *msm_host)
 {
 	u32 data;
@@ -1200,6 +1298,59 @@ static void dsi_wait4video_eng_busy(struct msm_dsi_host *msm_host)
 	}
 }
 
+/*
+ * The command-mode counterpart of dsi_wait4video_eng_busy().
+ *
+ * In command mode the display driver pushes frames through the same command
+ * engine this DMA is about to use, as DCS long writes, and nothing otherwise
+ * stops the two overlapping. Downstream does the wait explicitly:
+ * mdss_dsi_cmdlist_commit() calls mdss_dsi_cmd_mdp_busy() under "make sure
+ * dsi_cmd_mdp is idle" for DSI_CMD_MODE, and dsi_host.c has carried a TODO to
+ * do the same ever since.
+ *
+ * Without it, a DCS command issued while frames are in flight lands inside a
+ * compressed payload. On a DSC panel that does not merely glitch the image, it
+ * desynchronises the decoder: the screen fills with noise banded at slice
+ * boundaries and only a full panel re-init clears it.
+ *
+ * Note on measuring this: sampling DSI_STATUS0 while the screen is STATIC is
+ * meaningless. A command-mode panel sends no frames when nothing changes, so
+ * the busy bits read 0 and this looks like a no-op. It has to be sampled with
+ * something actually composing -- an earlier round concluded the bit "never
+ * sets" purely because every sample was taken on an idle screen.
+ */
+static void dsi_wait4cmd_mdp_idle(struct msm_dsi_host *msm_host)
+{
+	u32 entry, status;
+	ktime_t t0;
+	s64 waited;
+	int ret;
+
+	if (msm_host->mode_flags & MIPI_DSI_MODE_VIDEO)
+		return;
+
+	if (!msm_host->power_on || !msm_host->enabled)
+		return;
+
+	entry = dsi_read(msm_host, REG_DSI_STATUS0);
+	t0 = ktime_get();
+
+	ret = readl_poll_timeout(msm_host->ctrl_base + REG_DSI_STATUS0, status,
+				 !(status & (DSI_STATUS0_CMD_MODE_MDP_BUSY |
+					     DSI_STATUS0_CMD_MODE_DMA_BUSY)),
+				 10, 50000);
+
+	waited = ktime_us_delta(ktime_get(), t0);
+
+	/*
+	 * Only log when the wait actually did something, so this says whether
+	 * the interlock is real rather than drowning in idle-path noise.
+	 */
+	if (ret || waited > 50)
+		pr_debug("dsi-mdpwait: entry=%08x exit=%08x waited=%lldus ret=%d\n",
+			 entry, status, waited, ret);
+}
+
 int dsi_tx_buf_alloc_6g(struct msm_dsi_host *msm_host, int size)
 {
 	struct drm_device *dev = msm_host->dev;
@@ -1416,13 +1567,29 @@ static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len)
 	reinit_completion(&msm_host->dma_comp);
 
 	dsi_wait4video_eng_busy(msm_host);
+	dsi_wait4cmd_mdp_idle(msm_host);
 
 	triggered = msm_dsi_manager_cmd_xfer_trigger(
 						msm_host->id, dma_base, len);
 	if (triggered) {
+		ktime_t t0 = ktime_get();
+		s64 dma_us;
+
 		ret = wait_for_completion_timeout(&msm_host->dma_comp,
 					msecs_to_jiffies(200));
 		DBG("ret=%d", ret);
+
+		/*
+		 * A short LP write completes in well under a millisecond.
+		 * Longer means the controller held the DMA off -- i.e. the
+		 * hardware deferred it around an in-flight frame, which is
+		 * the behavior burst mode (0x1b8[16]) is supposed to make
+		 * safe. Worth knowing either way.
+		 */
+		dma_us = ktime_us_delta(ktime_get(), t0);
+		if (dma_us > 2000)
+			pr_debug("dsi-dmaslow: cmd DMA took %lldus\n", dma_us);
+
 		if (ret == 0)
 			ret = -ETIMEDOUT;
 		else
@@ -1431,6 +1598,24 @@ static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len)
 		ret = len;
 	}
 
+	/*
+	 * TOCTOU detector for dsi_wait4cmd_mdp_idle(): that wait releases at
+	 * frame-done, but nothing stops the DPU kicking off the NEXT frame
+	 * while this DMA is still on the wire. A frame transfer lasts
+	 * milliseconds and this DMA microseconds, so if one started during the
+	 * DMA, MDP_BUSY is still set right here. Correlate these lines with
+	 * the corruption events: if corruption happens on drags where this
+	 * never fired, the collision theory is dead and the write itself is
+	 * the trigger.
+	 */
+	if (!(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO)) {
+		u32 status = dsi_read(msm_host, REG_DSI_STATUS0);
+
+		if (status & DSI_STATUS0_CMD_MODE_MDP_BUSY)
+			pr_warn("dsi-collide: frame started during cmd DMA, status=%08x ret=%d\n",
+				status, ret);
+	}
+
 	return ret;
 }
 
@@ -1667,6 +1852,12 @@ static irqreturn_t dsi_host_irq(int irq, void *ptr)
 	if (isr & DSI_IRQ_CMD_DMA_DONE)
 		complete(&msm_host->dma_comp);
 
+	if (isr & DSI_IRQ_CMD_MDP_DONE) {
+		msm_host->mdp_done_cnt++;
+		WRITE_ONCE(msm_host->frame_pending, false);
+		wake_up(&msm_host->frame_wait);
+	}
+
 	return IRQ_HANDLED;
 }
 
@@ -1717,6 +1908,22 @@ static ssize_t dsi_host_transfer(struct mipi_dsi_host *host,
 		return -EINVAL;
 
 	mutex_lock(&msm_host->cmd_mutex);
+
+	/*
+	 * Strict interleaving (downstream's non-burst semantics): hold this
+	 * transfer until the frame the DPU has kicked off is fully out of the
+	 * controller (CMD_MDP_DONE). The reverse direction is covered by
+	 * msm_dsi_cmd_kickoff_begin() taking cmd_mutex, which we now hold.
+	 */
+	if (cmd_frame_serialize && READ_ONCE(cmd_sync_host) == msm_host) {
+		long rc = wait_event_timeout(msm_host->frame_wait,
+					!READ_ONCE(msm_host->frame_pending),
+					msecs_to_jiffies(100));
+		if (!rc)
+			pr_warn("dsi-framewait: frame_pending stuck (mdp_done irqs=%u)\n",
+				msm_host->mdp_done_cnt);
+	}
+
 	ret = msm_dsi_manager_cmd_xfer(msm_host->id, msg);
 	mutex_unlock(&msm_host->cmd_mutex);
 
@@ -2018,6 +2225,7 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 	mutex_init(&msm_host->dev_mutex);
 	mutex_init(&msm_host->cmd_mutex);
 	spin_lock_init(&msm_host->intr_lock);
+	init_waitqueue_head(&msm_host->frame_wait);
 
 	/* setup workqueue */
 	msm_host->workqueue = alloc_ordered_workqueue("dsi_drm_work", 0);
diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
index 6d847d593f1a..4a7c2305bea5 100644
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -306,6 +306,7 @@ bool msm_dsi_is_master_dsi(struct msm_dsi *msm_dsi);
 bool msm_dsi_wide_bus_enabled(struct msm_dsi *msm_dsi);
 struct drm_dsc_config *msm_dsi_get_dsc_config(struct msm_dsi *msm_dsi);
 const char *msm_dsi_get_te_source(struct msm_dsi *msm_dsi);
+void msm_dsi_cmd_kickoff_begin(void);
 #else
 static inline void __init msm_dsi_register(void)
 {
@@ -348,6 +349,9 @@ static inline const char *msm_dsi_get_te_source(struct msm_dsi *msm_dsi)
 {
 	return NULL;
 }
+static inline void msm_dsi_cmd_kickoff_begin(void)
+{
+}
 #endif
 
 struct msm_dp;
