+/*
+ * IIO_INDEX for the sensors IIO has no type for. It carries no unit claim,
+ * which is the point: a hall switch is not a proximity sensor and a strain
+ * gauge is not a pressure, and typing them as either would have consumers --
+ * iio-sensor-proxy above all -- pick them up as something they are not.
+ */
+#define QCOM_SMGR_INDEX_CHANNEL(idx)					\
+	{								\
+		.type = IIO_INDEX,					\
+		.indexed = 1,						\
+		.channel = (idx),					\
+		.scan_index = (idx),					\
+		.scan_type = {						\
+			.sign = 'u',					\
+			.realbits = 32,					\
+			.storagebits = 32,				\
+			.endianness = IIO_LE,				\
+		},							\
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW)		\
+	}
+
+#define QCOM_SMGR_TIMESTAMP_CHANNEL(idx)				\
+	{								\
+		.type = IIO_TIMESTAMP,					\
+		.channel = -1,						\
+		.scan_index = (idx),					\
+		.scan_type = {						\
+			.sign = 's',					\
+			.realbits = 64,					\
+			.storagebits = 64,				\
+			.endianness = IIO_LE,				\
+		},							\
+	}
