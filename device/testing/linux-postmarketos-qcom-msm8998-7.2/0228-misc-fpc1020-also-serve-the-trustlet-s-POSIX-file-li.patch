From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sun, 13 Sep 2026 21:55:21 +0200
Subject: [PATCH] misc: fpc1020: also serve the trustlet's POSIX file listener

The trustlet sizes its template database before loading it with
open/lseek(SEEK_END)/close, and those are cmnlib's POSIX-style file API,
which reaches the normal world through QSEE's file-service listener, 0xa
-- not the GP file service (0x7000) the database is then read and
written through. With only 0x7000 registered, QSEE refused cmnlib's
request itself, open() failed inside the trustlet, and LOAD_DB answered
-1 without ever asking for a read.

Register 0xa as well, with the 0x5000 shared buffer qseecomd's
libdrmfs.so gives it, and route requests for either listener through the
same RECV/SEND rendezvous; RECV now reports which listener the request is
for. Verified on taimen with both served from userspace: STORE_DB writes
through 0x7000, LOAD_DB opens, seeks and closes through 0xa and reads
through 0x7000, and the database id reads back unchanged.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/misc/fpc1020.c | 137 +++++++++++++++++++++++++++--------------
 1 file changed, 92 insertions(+), 45 deletions(-)

diff --git a/drivers/misc/fpc1020.c b/drivers/misc/fpc1020.c
index f7412dc54d00..808cffbd86ea 100644
--- a/drivers/misc/fpc1020.c
+++ b/drivers/misc/fpc1020.c
@@ -22,8 +22,10 @@
  *    wait for the level, command, wait again. An edge latch does not fit it --
  *    the commands themselves pulse the line.
  *  - The trustlet keeps its template database in the normal world's
- *    filesystem through QSEE's GP file-service listener (id 0x7000): a
- *    database command is answered by QSEE with a request in the listener's
+ *    filesystem, through two QSEE listener services: the GP file service
+ *    (0x7000) it reads and writes the database with, and the POSIX-style
+ *    file service (0xa) cmnlib's open/lseek/close use to size it first. A
+ *    database command is answered by QSEE with a request in a listener's
  *    shared buffer, which must be served before the command can finish.
  *    Filesystem policy belongs in userspace, so the request is handed to
  *    whoever waits in FPC1020_TEE_IOC_LISTENER_RECV and the answer taken back
@@ -87,9 +89,21 @@
 #define FPC1020_TZ_REGION_ADDR		0x86600000UL
 #define FPC1020_TZ_REGION_SIZE		0x2200000UL
 
-/* QSEE's GP file service, and the shared buffer size qseecomd gives it. */
-#define FPC1020_GPFS_LISTENER_ID	0x7000
-#define FPC1020_GPFS_SB_SIZE		0x7e000
+/*
+ * The listener services the trustlet uses, with the shared buffer sizes
+ * qseecomd's libdrmfs.so registers them with (fs_start(), gpfs_start()).
+ */
+struct fpc1020_listener_desc {
+	u32 id;
+	size_t sb_size;
+};
+
+static const struct fpc1020_listener_desc fpc1020_listeners[] = {
+	{ .id = 0x000a, .sb_size = 0x5000 },	/* file service */
+	{ .id = 0x7000, .sb_size = 0x7e000 },	/* GP file service */
+};
+
+#define FPC1020_NUM_LISTENERS		ARRAY_SIZE(fpc1020_listeners)
 
 /* How long a blocked trustlet call waits for userspace to serve its file. */
 #define FPC1020_LISTENER_TIMEOUT_MS	30000
@@ -152,12 +166,15 @@ struct fpc1020 {
 	bool ready;
 	u32 app_id;
 
-	void *sb;
-	dma_addr_t sb_phys;
-	bool listener_registered;
+	struct {
+		void *sb;
+		dma_addr_t sb_phys;
+		bool registered;
+	} listener[FPC1020_NUM_LISTENERS];
 
 	spinlock_t listener_lock;
 	enum fpc1020_listener_state listener_state;
+	unsigned int listener_index;	/* of the request in flight */
 	int listener_status;
 	wait_queue_head_t listener_req_wq;
 	wait_queue_head_t listener_rsp_wq;
@@ -211,23 +228,37 @@ static void fpc1020_disable_regulator(void *data)
  * Listener rendezvous
  * ------------------------------------------------------------------ */
 
+static int fpc1020_listener_index(struct fpc1020 *fpc1020, u32 listener_id)
+{
+	unsigned int i;
+
+	for (i = 0; i < FPC1020_NUM_LISTENERS; i++)
+		if (fpc1020_listeners[i].id == listener_id &&
+		    fpc1020->listener[i].registered)
+			return i;
+
+	return -ENOENT;
+}
+
 /*
  * Called by qcom_scm_qseecom_app_send_listener() with the QSEECOM call lock
  * and fpc1020->lock held, when the trustlet asks for listener @listener_id.
- * The request is already in fpc1020->sb; hand it to userspace and wait for
- * the answer to be written back into the same buffer. For 0x7000 the layout
- * is qseecomd's GP file service (libdrmfs.so, gpdispatch()): u32 command
- * (0 read, 1 write, 2 remove, 3 rename), then a 256-byte path, offset,
- * count, backup flag and data, answered in place.
+ * The request is already in that listener's shared buffer; hand it to
+ * userspace and wait for the answer to be written back into the same buffer.
+ * The layouts are qseecomd's (libdrmfs.so): for 0xa, dispatch() -- u32
+ * command 0x201.. and POSIX-shaped arguments; for 0x7000, gpdispatch() --
+ * u32 command (0 read, 1 write, 2 remove, 3 rename), a 256-byte path,
+ * offset, count, backup flag and data.
  */
 static int fpc1020_listener_handle(void *priv, u32 listener_id)
 {
 	struct fpc1020 *fpc1020 = priv;
 	unsigned long flags;
 	long left;
-	int ret;
+	int index, ret;
 
-	if (listener_id != FPC1020_GPFS_LISTENER_ID) {
+	index = fpc1020_listener_index(fpc1020, listener_id);
+	if (index < 0) {
 		dev_warn_ratelimited(fpc1020->dev,
 				     "trustlet asked for unknown listener 0x%x\n",
 				     listener_id);
@@ -235,6 +266,7 @@ static int fpc1020_listener_handle(void *priv, u32 listener_id)
 	}
 
 	spin_lock_irqsave(&fpc1020->listener_lock, flags);
+	fpc1020->listener_index = index;
 	fpc1020->listener_state = FPC1020_LISTENER_PENDING;
 	spin_unlock_irqrestore(&fpc1020->listener_lock, flags);
 	wake_up_interruptible(&fpc1020->listener_req_wq);
@@ -262,13 +294,12 @@ static int fpc1020_listener_recv(struct fpc1020 *fpc1020, unsigned long arg)
 {
 	struct fpc1020_tee_listener l;
 	unsigned long flags;
+	unsigned int index;
 	size_t len;
 	long left;
 
 	if (copy_from_user(&l, (void __user *)arg, sizeof(l)))
 		return -EFAULT;
-	if (!fpc1020->listener_registered)
-		return -ENODEV;
 
 	left = wait_event_interruptible_timeout(fpc1020->listener_req_wq,
 			fpc1020->listener_state == FPC1020_LISTENER_PENDING,
@@ -284,12 +315,14 @@ static int fpc1020_listener_recv(struct fpc1020 *fpc1020, unsigned long arg)
 		return -EAGAIN;
 	}
 	fpc1020->listener_state = FPC1020_LISTENER_SERVING;
+	index = fpc1020->listener_index;
 	spin_unlock_irqrestore(&fpc1020->listener_lock, flags);
 
-	len = min_t(size_t, l.len, FPC1020_GPFS_SB_SIZE);
-	l.id = FPC1020_GPFS_LISTENER_ID;
+	len = min_t(size_t, l.len, fpc1020_listeners[index].sb_size);
+	l.id = fpc1020_listeners[index].id;
 	l.len = len;
-	if (copy_to_user((void __user *)(uintptr_t)l.buf, fpc1020->sb, len) ||
+	if (copy_to_user((void __user *)(uintptr_t)l.buf,
+			 fpc1020->listener[index].sb, len) ||
 	    copy_to_user((void __user *)arg, &l, sizeof(l))) {
 		spin_lock_irqsave(&fpc1020->listener_lock, flags);
 		fpc1020->listener_status = -EFAULT;
@@ -306,23 +339,26 @@ static int fpc1020_listener_send(struct fpc1020 *fpc1020, unsigned long arg)
 {
 	struct fpc1020_tee_listener l;
 	unsigned long flags;
+	unsigned int index;
 	int status;
 
 	if (copy_from_user(&l, (void __user *)arg, sizeof(l)))
 		return -EFAULT;
-	if (l.id != FPC1020_GPFS_LISTENER_ID || l.len > FPC1020_GPFS_SB_SIZE)
-		return -EINVAL;
 
 	spin_lock_irqsave(&fpc1020->listener_lock, flags);
-	if (fpc1020->listener_state != FPC1020_LISTENER_SERVING) {
+	index = fpc1020->listener_index;
+	if (fpc1020->listener_state != FPC1020_LISTENER_SERVING ||
+	    l.id != fpc1020_listeners[index].id ||
+	    l.len > fpc1020_listeners[index].sb_size) {
 		spin_unlock_irqrestore(&fpc1020->listener_lock, flags);
 		return -EINVAL;
 	}
 	spin_unlock_irqrestore(&fpc1020->listener_lock, flags);
 
-	/* Only the servicer writes sb while SERVING. */
+	/* Only the servicer writes the buffer while SERVING. */
 	status = l.status ? -EIO : 0;
-	if (copy_from_user(fpc1020->sb, (void __user *)(uintptr_t)l.buf, l.len))
+	if (copy_from_user(fpc1020->listener[index].sb,
+			   (void __user *)(uintptr_t)l.buf, l.len))
 		status = -EFAULT;
 
 	spin_lock_irqsave(&fpc1020->listener_lock, flags);
@@ -365,8 +401,7 @@ static int fpc1020_tz_xfer_locked(struct fpc1020 *fpc1020, void *cmdbuf,
 	ret = qcom_scm_qseecom_app_send_listener(fpc1020->app_id,
 						 env, FPC1020_TZ_ENV_SIZE,
 						 env, FPC1020_TZ_ENV_SIZE,
-						 fpc1020->listener_registered ?
-						 fpc1020_listener_handle : NULL,
+						 fpc1020_listener_handle,
 						 fpc1020);
 
 	qcom_tzmem_free(env);
@@ -503,6 +538,7 @@ static int fpc1020_load_trustlet_locked(struct fpc1020 *fpc1020)
 
 static int fpc1020_bring_up_locked(struct fpc1020 *fpc1020)
 {
+	unsigned int i;
 	int ret;
 
 	lockdep_assert_held(&fpc1020->lock);
@@ -513,17 +549,19 @@ static int fpc1020_bring_up_locked(struct fpc1020 *fpc1020)
 
 	/*
 	 * A failed registration is not fatal: every command except the
-	 * template database ones works without it, and those fail cleanly.
+	 * template database ones works without them, and those fail cleanly.
 	 */
-	ret = qcom_scm_qseecom_listener_register(FPC1020_GPFS_LISTENER_ID,
-						 fpc1020->sb_phys,
-						 FPC1020_GPFS_SB_SIZE);
-	if (ret)
-		dev_err(fpc1020->dev,
-			"GP file listener registration failed: %d -- template storage will not work\n",
-			ret);
-	else
-		fpc1020->listener_registered = true;
+	for (i = 0; i < FPC1020_NUM_LISTENERS; i++) {
+		ret = qcom_scm_qseecom_listener_register(fpc1020_listeners[i].id,
+							 fpc1020->listener[i].sb_phys,
+							 fpc1020_listeners[i].sb_size);
+		if (ret)
+			dev_err(fpc1020->dev,
+				"listener 0x%x registration failed: %d -- template storage will not work\n",
+				fpc1020_listeners[i].id, ret);
+		else
+			fpc1020->listener[i].registered = true;
+	}
 
 	fpc1020->ready = true;
 	return 0;
@@ -643,6 +681,7 @@ static int fpc1020_probe(struct platform_device *pdev)
 		.policy = QCOM_TZMEM_POLICY_STATIC,
 	};
 	struct fpc1020 *fpc1020;
+	unsigned int i;
 	int ret;
 
 	fpc1020 = devm_kzalloc(dev, sizeof(*fpc1020), GFP_KERNEL);
@@ -704,10 +743,14 @@ static int fpc1020_probe(struct platform_device *pdev)
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to set DMA mask\n");
 
-	fpc1020->sb = dmam_alloc_coherent(dev, FPC1020_GPFS_SB_SIZE,
-					  &fpc1020->sb_phys, GFP_KERNEL);
-	if (!fpc1020->sb)
-		return -ENOMEM;
+	for (i = 0; i < FPC1020_NUM_LISTENERS; i++) {
+		fpc1020->listener[i].sb =
+			dmam_alloc_coherent(dev, fpc1020_listeners[i].sb_size,
+					    &fpc1020->listener[i].sb_phys,
+					    GFP_KERNEL);
+		if (!fpc1020->listener[i].sb)
+			return -ENOMEM;
+	}
 
 	/* One command buffer and one envelope at a time, each page-aligned. */
 	fpc1020->tzpool = devm_qcom_tzmem_pool_new(dev, &pool_cfg);
@@ -729,13 +772,17 @@ static int fpc1020_probe(struct platform_device *pdev)
 static void fpc1020_remove(struct platform_device *pdev)
 {
 	struct fpc1020 *fpc1020 = platform_get_drvdata(pdev);
+	unsigned int i;
 
 	misc_deregister(&fpc1020->miscdev);
 
-	/* QSEE would otherwise keep writing into a buffer devres frees. */
-	if (fpc1020->listener_registered &&
-	    qcom_scm_qseecom_listener_unregister(FPC1020_GPFS_LISTENER_ID))
-		dev_err(&pdev->dev, "GP file listener unregistration failed\n");
+	/* QSEE would otherwise keep writing into buffers devres frees. */
+	for (i = 0; i < FPC1020_NUM_LISTENERS; i++)
+		if (fpc1020->listener[i].registered &&
+		    qcom_scm_qseecom_listener_unregister(fpc1020_listeners[i].id))
+			dev_err(&pdev->dev,
+				"listener 0x%x unregistration failed\n",
+				fpc1020_listeners[i].id);
 
 	disable_irq_wake(fpc1020->irq);
 	device_init_wakeup(&pdev->dev, false);
