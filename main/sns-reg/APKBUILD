aab37e6a488782e965f47c6d4d7eae46942364ef3aaa5f571c3e742a89a5c06440aa0b0f925a8c7ef77237ff0b84bada0fb60425de167660665e21fd031a15ca  0001-Serve-raw-sns.reg-slices.patch
