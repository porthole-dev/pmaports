+/*
+ * Overlay planes
+ *
+ * A client that offloads content to a subsurface stacked BELOW its toplevel --
+ * GTK4 does this for a WebKit web view, GStreamer's waylandsink for video --
+ * has punched a transparent hole in the parent and handed us an opaque dmabuf
+ * that covers most of the screen. It then repaints that dmabuf on every vsync.
+ *
+ * Texturing it through the GPU every frame is what pins a mobile GPU at its
+ * top frequency. Measured on a Pixel 2 XL (msm8998, Adreno 540): a *paused*
+ * video in Epiphany held the GPU at 710 MHz and the die at 77 C with both
+ * browser processes at 0 % of a core, purely because the web view re-attached
+ * a 1440x2481 buffer 57 times a second and the compositor re-composited the
+ * screen for each one. The DPU on that chip has eight planes and phoc used
+ * one.
+ *
+ * So hand the largest such surface to a hardware plane and let the GPU stop
+ * seeing it. The promotion rule is deliberately strict, because getting it
+ * wrong means painting over the shell:
+ *
+ *   - the surface must be stacked below its view's toplevel, which is the
+ *     client's own statement that it punched a hole for it;
+ *   - it must be fully opaque and backed by a dmabuf, so the plane can
+ *     replace rather than blend;
+ *   - no *other* surface on the output may have an opaque region overlapping
+ *     its box, in either direction -- then the stacking order cannot matter,
+ *     which is what lets this be decided without replicating the render walk;
+ *   - and the backend has the last word, via wlr_output_test_state().
+ *
+ * Anything that does not qualify is composited exactly as before.
+ *
+ * ponytail: one plane, the largest candidate. The DPU has seven spare and a
+ * second video window would want a second; add more layers when something
+ * measurably needs them.
+ */
+
+/*
+ * PHOC_DEBUG_PLANES=1 says, once a second, what the plane decision did. The
+ * decision runs every frame and every one of its failure modes looks exactly
+ * like silence, which is not a thing to debug by rebuilding.
+ */
+static void
+plane_debug (const char *fmt, ...)
+{
+  static gint64 last_us = 0;
+  static int enabled = -1;
+  g_autofree char *msg = NULL;
+  va_list args;
+  gint64 now;
+
+  if (G_LIKELY (enabled == 0))
+    return;
+  if (enabled < 0)
+    enabled = g_getenv ("PHOC_DEBUG_PLANES") ? 1 : 0;
+  if (!enabled)
+    return;
+
+  now = g_get_monotonic_time ();
+  if (now - last_us < G_USEC_PER_SEC)
+    return;
+  last_us = now;
+
+  va_start (args, fmt);
+  msg = g_strdup_vprintf (fmt, args);
+  va_end (args);
+  g_message ("plane: %s", msg);
+}
+
+
+typedef struct {
+  PhocView           *view;         /* the view being walked */
+  struct wlr_surface *root;         /* its toplevel surface */
+  gboolean            past_root;
+
+  PhocView           *best_view;    /* the view that owns the winner */
+  struct wlr_surface *surface;      /* best candidate so far */
+  struct wlr_box      box;          /* in output-buffer coordinates */
+  struct wlr_fbox     src;
+  int                 area;
+} PhocPlaneScan;
+
+
+typedef struct {
+  struct wlr_surface *candidate;
+  gboolean            after;        /* has the walk passed the candidate? */
+  struct wlr_box      box;          /* the candidate, output-buffer coords */
+  gboolean            blocked;
+  const char         *phase;        /* which walk found it, for PHOC_DEBUG_PLANES */
+  const char         *blocker;      /* and what it was */
+  const char         *namespace;    /* layer-shell namespace, when that is what it is */
+  struct wlr_box      blocker_box;
+  int                 blocker_w, blocker_h;
+} PhocPlaneBlockScan;
+
+
+static gboolean
+surface_is_fully_opaque (struct wlr_surface *surface)
+{
+  pixman_region32_t clear;
+  gboolean opaque;
+
+  pixman_region32_init_rect (&clear, 0, 0,
+                             surface->current.width, surface->current.height);
+  pixman_region32_subtract (&clear, &clear, &surface->opaque_region);
+  opaque = !pixman_region32_not_empty (&clear);
+  pixman_region32_fini (&clear);
+
+  return opaque;
+}
+
+/*
+ * The two scans below and phoc_renderer's walk must agree on where a surface
+ * lands, so they scale a box the same way. Keep in step with
+ * render_surface_iterator().
+ */
+static void
+plane_box_to_output (PhocOutput *output, struct wlr_box *box, float scale)
+{
+  phoc_utils_scale_box (box, scale);
+  phoc_utils_scale_box (box, output->wlr_output->scale);
+  phoc_output_transform_box (output, box);
+}
+
+
+static void
+plane_candidate_iterator (PhocOutput         *output,
+                          struct wlr_surface *surface,
+                          struct wlr_box     *box,
+                          float               scale,
+                          void               *data)
+{
+  PhocPlaneScan *scan = data;
+  const struct wlr_alpha_modifier_surface_v1_state *alpha_state;
+  struct wlr_dmabuf_attributes attribs;
+  struct wlr_box dst;
+  int area;
+
+  if (surface == scan->root) {
+    scan->past_root = TRUE;
+    return;
+  }
+
+  /* Only surfaces stacked below the toplevel: the hole-punch contract. */
+  if (scan->past_root)
+    return;
+
+  if (surface->buffer == NULL)
+    return;
+
+  if (!wlr_buffer_get_dmabuf (&surface->buffer->base, &attribs)) {
+    plane_debug ("below-toplevel surface %dx%d is not a dmabuf",
+                 surface->current.width, surface->current.height);
+    return;
+  }
+
+  if (!surface_is_fully_opaque (surface)) {
+    plane_debug ("below-toplevel surface %dx%d is not fully opaque",
+                 surface->current.width, surface->current.height);
+    return;
+  }
+
+  if (surface->current.transform != output->wlr_output->transform) {
+    plane_debug ("below-toplevel surface transform %d != output %d",
+                 surface->current.transform, output->wlr_output->transform);
+    return;
+  }
+
+  /* A plane scans out its buffer as-is; there is nowhere to apply a fade. */
+  alpha_state = wlr_alpha_modifier_v1_get_surface_state (surface);
+  if (alpha_state && alpha_state->multiplier < 1.0)
+    return;
+
+  dst = *box;
+  plane_box_to_output (output, &dst, scale);
+
+  area = dst.width * dst.height;
+  if (area <= scan->area)
+    return;
+
+  scan->surface = surface;
+  scan->best_view = scan->view;
+  scan->box = dst;
+  scan->area = area;
+  wlr_surface_get_buffer_source_box (surface, &scan->src);
+}
+
+
+/*
+ * Only what is painted AFTER the candidate can block it. Getting this wrong in
+ * the safe-looking direction -- treating any opaque overlap as a blocker,
+ * whichever side it is on -- refuses every candidate there will ever be, since
+ * the wallpaper is an opaque full-screen layer surface underneath everything.
+ */
+static void
+plane_blocker_iterator (PhocOutput         *output,
+                        struct wlr_surface *surface,
+                        struct wlr_box     *box,
+                        float               scale,
+                        void               *data)
+{
+  PhocPlaneBlockScan *scan = data;
+  const struct wlr_alpha_modifier_surface_v1_state *alpha_state;
+  pixman_box32_t *rects;
+  struct wlr_box dummy;
+  int n_rects;
+
+  if (surface == scan->candidate) {
+    scan->after = TRUE;
+    return;
+  }
+
+  if (scan->blocked || !scan->after || surface->buffer == NULL)
+    return;
+
+  /* A buffer the compositor is fading to nothing draws nothing, however opaque
+   * the client honestly declared it. Anything between 0 and 1 does blend
+   * something over the candidate, so it still blocks -- the test is exactly
+   * render_texture()'s own. */
+  alpha_state = wlr_alpha_modifier_v1_get_surface_state (surface);
+  if (alpha_state && alpha_state->multiplier == 0.0)
+    return;
+
+  /* Only opaque pixels can hide a plane, and every rectangle of the region has
+   * to be tested rather than its bounding box: a shell surface that spans the
+   * screen to hold a fold-out drawer, and a window with a top and a bottom bar,
+   * both declare a couple of thin bands whose EXTENTS cover everything. Taking
+   * the extents there looks like the safe direction and is simply wrong -- it
+   * refuses every candidate. A surface with an empty opaque region, which is
+   * what the hole-punched parent is over the hole, has no rectangles at all. */
+  rects = pixman_region32_rectangles (&surface->opaque_region, &n_rects);
+  for (int i = 0; i < n_rects; i++) {
+    struct wlr_box opaque = {
+      .x      = box->x + rects[i].x1,
+      .y      = box->y + rects[i].y1,
+      .width  = rects[i].x2 - rects[i].x1,
+      .height = rects[i].y2 - rects[i].y1,
+    };
+
+    if (wlr_box_empty (&opaque))
+      continue;
+
+    plane_box_to_output (output, &opaque, scale);
+
+    if (wlr_box_intersection (&dummy, &opaque, &scan->box)) {
+      scan->blocked = TRUE;
+      scan->blocker = surface->role ? surface->role->name : "(no role)";
+      scan->blocker_box = opaque;
+      scan->blocker_w = surface->current.width;
+      scan->blocker_h = surface->current.height;
+      return;
+    }
+  }
+}
+
+/**
+ * phoc_output_pick_plane_surface:
+ * @self: the output
+ *
+ * Find the surface worth handing to a hardware plane this frame, if any.
+ * Fills the output's `planed_box` and @src on success.
+ *
+ * Returns: (nullable) (transfer none): the surface, or %NULL
+ */
+static struct wlr_surface *
+phoc_output_pick_plane_surface (PhocOutput *self, struct wlr_fbox *src)
+{
+  PhocOutputPrivate *priv = phoc_output_get_instance_private (self);
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+  PhocWorkspace *workspace = phoc_desktop_get_active_workspace (desktop);
+  PhocInput *input = phoc_server_get_input (phoc_server_get_default ());
+  PhocPlaneScan scan = { 0 };
+  PhocPlaneBlockScan block;
+
+  /* A drag icon follows the pointer over anything; the scanout path refuses
+   * one too, for the same reason. */
+  for (GSList *elem = phoc_input_get_seats (input); elem; elem = elem->next) {
+    if (phoc_drag_icon_is_mapped (PHOC_SEAT (elem->data)->drag_icon))
+      return NULL;
+  }
+
+  if (self->fullscreen_view) {
+    /* Match the renderer, which draws only this view. */
+    scan.view = self->fullscreen_view;
+    scan.root = self->fullscreen_view->wlr_surface;
+    phoc_output_view_for_each_surface (self, self->fullscreen_view,
+                                       plane_candidate_iterator, &scan);
+  } else {
+    for (GList *l = phoc_workspace_get_views (workspace)->tail; l; l = l->prev) {
+      PhocView *view = PHOC_VIEW (l->data);
+
+      if (!phoc_desktop_view_check_visibility (desktop, view) ||
+          phoc_view_get_alpha (view) != 1.0)
+        continue;
+
+      scan.view = view;
+      scan.root = view->wlr_surface;
+      scan.past_root = FALSE;
+      phoc_output_view_for_each_surface (self, view, plane_candidate_iterator, &scan);
+    }
+  }
+
+  if (scan.surface == NULL) {
+    plane_debug ("no candidate: nothing offloaded below a toplevel");
+    return NULL;
+  }
+
+  /* Everything painted after the candidate, in three parts, because that is
+   * how the renderer draws it: the rest of its own view, then any other view,
+   * then the shell's top and overlay layers. Background and bottom layers sit
+   * under every view and cannot block. Another view counts as a blocker
+   * whichever side of this one it is on -- two visible app windows barely
+   * happen on a phone shell, and being wrong there costs only the plane. */
+  block = (PhocPlaneBlockScan) { .candidate = scan.surface, .box = scan.box,
+                                 .phase = "own view" };
+  phoc_output_view_for_each_surface (self, scan.best_view, plane_blocker_iterator, &block);
+
+  block.after = TRUE;
+  block.phase = "another view";
+  for (GList *l = phoc_workspace_get_views (workspace)->tail; l && !block.blocked; l = l->prev) {
+    PhocView *view = PHOC_VIEW (l->data);
+
+    if (view == scan.best_view || !phoc_desktop_view_check_visibility (desktop, view) ||
+        phoc_view_get_alpha (view) == 0.0)
+      continue;
+
+    phoc_output_view_for_each_surface (self, view, plane_blocker_iterator, &block);
+  }
+
+  for (enum zwlr_layer_shell_v1_layer layer = ZWLR_LAYER_SHELL_V1_LAYER_TOP;
+       layer <= ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY && !block.blocked; layer++) {
+    GQueue *layer_surfaces = phoc_output_get_layer_surfaces_for_layer (self, layer);
+
+    block.phase = layer == ZWLR_LAYER_SHELL_V1_LAYER_TOP ? "layer top" : "layer overlay";
+    for (GList *l = layer_surfaces->tail; l && !block.blocked; l = l->prev) {
+      PhocLayerSurface *ls = PHOC_LAYER_SURFACE (l->data);
+
+      /* phoc fades a shell surface with an alpha of its own, not the client's:
+       * phosh's 'top-panel background' is a full-screen, honestly opaque
+       * surface held at 0 until the drawer is pulled down, and render_layer()
+       * draws nothing whatsoever for it. Reading only the client's alpha
+       * modifier here left that surface vetoing every plane on the phone. */
+      if (phoc_layer_surface_get_alpha (ls) == 0.0)
+        continue;
+
+      block.namespace = phoc_layer_surface_get_namespace (ls);
+      phoc_output_layer_surface_for_each_surface (self, ls, plane_blocker_iterator, &block);
+    }
+  }
+
+  if (block.blocked) {
+    plane_debug ("candidate %dx%d+%d+%d blocked in '%s' by %s '%s', %dx%d, opaque %dx%d+%d+%d",
+                 scan.box.width, scan.box.height, scan.box.x, scan.box.y,
+                 block.phase, block.blocker, block.namespace ?: "",
+                 block.blocker_w, block.blocker_h,
+                 block.blocker_box.width, block.blocker_box.height,
+                 block.blocker_box.x, block.blocker_box.y);
+    return NULL;
+  }
+
+  priv->planed_box = scan.box;
+  *src = scan.src;
+
+  return scan.surface;
+}
+
+/**
+ * phoc_output_get_planed_surface:
+ * @self: the output
+ *
+ * The surface a hardware plane is displaying, which the renderer must not draw.
+ *
+ * Returns: (nullable) (transfer none): the surface, or %NULL
+ */
+struct wlr_surface *
+phoc_output_get_planed_surface (PhocOutput *self)
+{
+  PhocOutputPrivate *priv;
+
+  g_assert (PHOC_IS_OUTPUT (self));
+  priv = phoc_output_get_instance_private (self);
+
+  return priv->planed_surface;
+}
+
+/*
+ * Build this frame's layer state and let the backend judge it.
+ *
+ * Every commit has to carry the state of every layer, so a layer that exists
+ * but has nothing to show is committed with a NULL buffer, which disables it.
+ */
+static struct wlr_surface *
+phoc_output_update_plane (PhocOutput                    *self,
+                          struct wlr_output_state       *pending,
+                          struct wlr_output_layer_state *layer_state)
+{
+  PhocOutputPrivate *priv = phoc_output_get_instance_private (self);
+  gint64 now = g_get_monotonic_time ();
+  struct wlr_surface *surface;
+  struct wlr_fbox src = { 0 };
+
+  if (G_UNLIKELY (g_getenv ("PHOC_NO_OUTPUT_LAYERS")))
+    return NULL;
+
+  if (now < priv->plane_retry_us) {
+    /* Backing off (see below). The layer still has to be committed, disabled,
+     * or the plane would keep scanning out whatever it last accepted. */
+    surface = NULL;
+  } else {
+    if (priv->plane_retry_us && priv->plane_layer) {
+      /* Coming back from a backoff with a NEW layer, so that libliftoff plans
+       * from scratch instead of reusing the allocation it just refused. */
+      g_clear_pointer (&priv->plane_layer, wlr_output_layer_destroy);
+    }
+    priv->plane_retry_us = 0;
+    surface = phoc_output_pick_plane_surface (self, &src);
+  }
+
+  if (surface == NULL && priv->plane_layer == NULL)
+    return NULL;
+
+  if (surface != NULL && priv->plane_layer == NULL) {
+    priv->plane_layer = wlr_output_layer_create (self->wlr_output);
+    if (priv->plane_layer == NULL)
+      return NULL;
+  }
+
+  if (surface == NULL)
+    priv->planed_box = (struct wlr_box) { 0 };
+
+  *layer_state = (struct wlr_output_layer_state) {
+    .layer   = priv->plane_layer,
+    .buffer  = surface ? &surface->buffer->base : NULL,
+    .src_box = src,
+    .dst_box = priv->planed_box,
+  };
+  wlr_output_state_set_layers (pending, layer_state, 1);
+
+  if (!wlr_output_test_state (self->wlr_output, pending)) {
+    /* Rather lose the plane than the frame. */
+    plane_debug ("test refused the whole state for %dx%d+%d+%d",
+                 priv->planed_box.width, priv->planed_box.height,
+                 priv->planed_box.x, priv->planed_box.y);
+    pending->committed &= ~WLR_OUTPUT_STATE_LAYERS;
+    return NULL;
+  }
+
+  if (surface)
+    plane_debug ("%s %dx%d+%d+%d src %.0fx%.0f+%.0f+%.0f",
+                 layer_state->accepted ? "ON A PLANE" : "backend refused",
+                 priv->planed_box.width, priv->planed_box.height,
+                 priv->planed_box.x, priv->planed_box.y,
+                 src.width, src.height, src.x, src.y);
+
+  /* Asking costs an atomic TEST_ONLY every frame -- 5 % of a core on this
+   * phone -- and the backend's answer rarely changes between two frames. After
+   * a second of refusals, stop asking for a second, then try again with a
+   * fresh layer. Without this a page the DPU will not take is measurably worse
+   * off than before the plane path existed. */
+  if (surface && !layer_state->accepted) {
+    if (++priv->plane_refusals >= 60) {
+      priv->plane_refusals = 0;
+      priv->plane_retry_us = now + G_USEC_PER_SEC;
+    }
+  } else {
+    priv->plane_refusals = 0;
+  }
+
+  return layer_state->accepted ? surface : NULL;
+}
+
+
 PHOC_TRACE_NO_INLINE static bool
 scan_out_fullscreen_view (PhocOutput *self, PhocView *view, struct wlr_output_state *pending)
 {
@@ -565,6 +1047,8 @@ phoc_output_draw (PhocOutput *self)
   struct wlr_buffer *buffer;
   struct wlr_render_pass *render_pass;
   struct wlr_output_state pending = { 0 };
+  struct wlr_output_layer_state layer_state;
+  struct wlr_surface *planed = NULL;
   PhocServerDebugFlags flags;
 
   if (!wlr_output->enabled)
@@ -582,6 +1066,21 @@ phoc_output_draw (PhocOutput *self)
 
   wlr_output_state_set_damage (&pending, &priv->damage_ring.current);
 
+  /* Before the scanout attempt below, because every commit has to carry the
+   * state of every layer: a scanout that left the layer state out would keep a
+   * plane on screen showing a stale buffer. The two never both fire -- a view
