+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ *
+ * NOTE (fpc-tz.c is Apache-2.0, from sonyxperiadev/vendor-sony-oss-fingerprint):
+ * combining it with this LGPL-2.1-or-later file is only allowed under the
+ * "or later" arm (LGPL-3.0).  Upstream libfprint has to accept that before
+ * this driver can be submitted; see the workstream report.
+ *
+ * To build inside libfprint, two lines are needed:
+ *   meson.build:          'fpctee' added to default_drivers (no udev
+ *                         helper -- see the FP_DEVICE_TYPE_VIRTUAL note
+ *                         below; this driver does not call into GUdev),
+ *   libfprint/meson.build:'fpctee': files('drivers/fpctee/fpctee.c',
+ *                                         'drivers/fpctee/fpc-tz.c'),
+ */
+
+#include "drivers_api.h"
+#include "fpc-tz.h"
+
+#include <glib-unix.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#define FP_COMPONENT "fpctee"
+
+/* Where the TA-encrypted template database is kept.  The normal world can
+ * neither read nor forge it; from libfprint's side this is device storage. */
+#define FPC_TEE_DB_PATH "/var/lib/fprint/fpctee.db"
+#define FPC_TEE_GID 0
+#define FPC_TEE_FINGER_TIMEOUT_MS 10000
+#define FPC_TEE_MAX_ENROLL_STAGES 25
+
+/* Job return convention: negative is an error, 0 means "ask for the finger
+ * again", and an enrol touch returns remaining_touches + 1. */
+#define FPC_TEE_TOUCH_RETRY 0
+#define FPC_TEE_TOUCH_DONE 1
+
+/*
+ * [BRINGUP] Provisional kernel ABI.
+ *
+ * The kernel half (a QSEECom trusted-application loader plus the FPC IRQ
+ * source) does not exist yet, so this is the shape it is expected to take and
+ * nothing more: one char device, one ioctl carrying a buffer the TA rewrites
+ * in place, and a blocking read() that returns one byte per finger IRQ.
+ * Whatever the kernel side actually lands with, only this block changes.
+ */
+#define FPC_TEE_DEFAULT_NODE "/dev/fpc_tee"
+#define FPC_TEE_IOC_XFER _IOWR ('F', 0x01, struct fpc_tee_xfer)
+
+struct fpc_tee_xfer
+{
+  guint64 buf;
+  guint32 len;
+  guint32 pad;
+};
+
+typedef struct
+{
+  gint fd;
+  gint cancel_pipe[2];
+} FpcTeeTransport;
+
+static int
+fpc_tee_xfer (void *ctx, void *buf, size_t len)
+{
+  FpcTeeTransport *t = ctx;
+  struct fpc_tee_xfer arg = {
+    .buf = (guint64) (uintptr_t) buf,
+    .len = len,
+  };
+
+  if (t->fd < 0)
+    return -ENODEV;
+
+  if (ioctl (t->fd, FPC_TEE_IOC_XFER, &arg) < 0)
+    {
+      fp_err ("trustlet transfer failed: %s", g_strerror (errno));
+      return -errno;
+    }
+
+  return 0;
+}
+
+static int
+fpc_tee_wait_event (void *ctx, int timeout_ms)
+{
+  FpcTeeTransport *t = ctx;
+  GPollFD fds[2] = {
+    { .fd = t->fd, .events = G_IO_IN },
+    { .fd = t->cancel_pipe[0], .events = G_IO_IN },
+  };
+  guint8 evt;
+  gint rc;
+
+  if (t->fd < 0)
+    return -ENODEV;
+
+  rc = g_poll (fds, 2, timeout_ms);
+  if (rc < 0)
+    return -errno;
+  if (rc == 0 || (fds[1].revents & G_IO_IN))
+    return 0;                   /* timed out or cancelled */
+
+  if (read (t->fd, &evt, sizeof (evt)) < 0)
+    return -errno;
+
+  return 1;
+}
+
+static void
+fpc_tee_cancel_wait (void *ctx)
+{
+  FpcTeeTransport *t = ctx;
+  const guint8 byte = 1;
+
+  if (t->cancel_pipe[1] >= 0)
+    (void) !write (t->cancel_pipe[1], &byte, sizeof (byte));
+}
+
+static const fpc_tz_ops fpc_tee_ops = {
+  .xfer       = fpc_tee_xfer,
+  .wait_event = fpc_tee_wait_event,
+  .cancel     = fpc_tee_cancel_wait,
+};
+
+/* ------------------------------------------------------------------ */
+
+typedef enum {
+  FPC_TEE_ENROLL_BEGIN = 0,
+  FPC_TEE_ENROLL_TOUCH,
+  FPC_TEE_ENROLL_END,
+  FPC_TEE_ENROLL_STORE,
+  FPC_TEE_ENROLL_DISCARD,
+  FPC_TEE_ENROLL_NUM_STATES,
+} FpcTeeEnrollState;
+
+typedef enum {
+  FPC_TEE_IDENTIFY_TOUCH = 0,
+  FPC_TEE_IDENTIFY_UPDATE,
+  FPC_TEE_IDENTIFY_CANCEL,
+  FPC_TEE_IDENTIFY_NUM_STATES,
+} FpcTeeIdentifyState;
+
+G_DECLARE_FINAL_TYPE (FpiDeviceFpcTee, fpi_device_fpctee, FPI, DEVICE_FPCTEE, FpDevice)
+
+struct _FpiDeviceFpcTee
+{
+  FpDevice        parent;
+  FpcTeeTransport transport;
+  fpc_tz          tz;
+  FpiSsm         *task_ssm;
+
+  gint            enroll_stage;
+  guint32         enrolled_id;
+  guint32         matched_id;
+  gboolean        enrolling;
+
+  guint32         list_ids[FPC_TZ_MAX_PRINTS];
+  guint32         list_count;
+};
+
+G_DEFINE_TYPE (FpiDeviceFpcTee, fpi_device_fpctee, FP_TYPE_DEVICE)
+
+/*
+ * [BRINGUP->FIXED, 2026-09-12] This was FP_DEVICE_TYPE_UDEV with a
+ * FPI_DEVICE_UDEV_SUBTYPE_SPIDEV id_table entry, copied from fpcmoc without
+ * checking whether the assumption travels. It does not, on two independent
+ * counts:
+ *
+ *  1. fp-context.c's udev discovery enumerates exactly two kernel
+ *     subsystems, "spidev" and "hidraw" (g_udev_client_query_by_subsystem),
+ *     and matches an FPI_DEVICE_UDEV_SUBTYPE_SPIDEV entry's spi_acpi_id as a
+ *     substring of an ALREADY-ENUMERATED spidev device's sysfs path. No
+ *     amount of id_table or udev-rule tuning reaches a device that was
+ *     never in that list to begin with.
+ *  2. On taimen the SPI bus this sensor sits on is architecturally
+ *     invisible to Linux: msm8998-google-taimen.dts's fingerprint@0 comment
+ *     is explicit that "the SPI pads ... are fenced by a signed devcfg and
+ *     are not described here or touched by fpc1020.c". There is no
+ *     /sys/.../spiN.M node for spidev to enumerate, ever, on this hardware
+ *     -- TrustZone owns that bus exclusively. fpc1020.c only exposes a
+ *     platform_device (compatible = "fpc,fpc1020") with a sysfs "irq"
+ *     latch attribute, no spidev, no hidraw, no chardev at all yet.
+ *
+ * So FP_DEVICE_TYPE_UDEV is the wrong model here, not just the wrong
+ * modalias: this driver's real transport is a kernel-mediated SCM call
+ * (qcom_scm_qseecom_app_send(), exported to kernel callers only -- there is
+ * no syscall a udev-visible device node could stand in for) plus an
+ * interrupt latch, not a bus libfprint's udev path already knows how to
+ * discover. taimen has exactly one such sensor, always at a fixed path
+ * once a real kernel-side chardev exists to create it; there is nothing to
+ * dynamically discover. FP_DEVICE_TYPE_VIRTUAL's environment-gated
+ * instantiation is the closest fit libfprint has for "always-present,
+ * fixed path, no bus to enumerate" -- production wires FPCTEE_DEVICE into
+ * fprintd's own unit (see userspace/fprintd-fpctee/ in the taimen repo),
+ * not a human's shell. The real gap this papers over: libfprint has no
+ * first-class "fixed platform device" discovery type, and this ought to be
+ * raised upstream rather than left as a permanent env-var workaround.
+ */
+static const FpIdEntry fpctee_id_table[] = {
+  { .virtual_envvar = "FPCTEE_DEVICE" },
+  { .virtual_envvar = NULL },
+};
+
+static const gchar *
+fpc_tee_node_path (FpDevice *device)
+{
+  const gchar *env = g_getenv ("FPCTEE_DEVICE");
+
+  if (env != NULL)
+    return env;
+
+  return FPC_TEE_DEFAULT_NODE;
+}
+
+static gboolean
+fpc_tee_transport_open (FpiDeviceFpcTee *self, GError **error)
+{
+  const gchar *path = fpc_tee_node_path (FP_DEVICE (self));
+
+  self->transport.fd = open (path, O_RDWR | O_CLOEXEC);
+  if (self->transport.fd < 0)
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_REMOVED,
+                   "cannot open %s: %s", path, g_strerror (errno));
+      return FALSE;
+    }
+
+  if (!g_unix_open_pipe (self->transport.cancel_pipe, FD_CLOEXEC, error))
+    {
+      close (self->transport.fd);
+      self->transport.fd = -1;
+      return FALSE;
+    }
+
+  fpc_tz_init (&self->tz, &fpc_tee_ops, &self->transport);
+  return TRUE;
+}
+
+static void
+fpc_tee_close_fd (gint *fd)
+{
+  if (*fd >= 0)
+    close (*fd);
+  *fd = -1;
+}
+
+static void
+fpc_tee_transport_close (FpiDeviceFpcTee *self)
+{
+  fpc_tee_close_fd (&self->transport.fd);
+  fpc_tee_close_fd (&self->transport.cancel_pipe[0]);
+  fpc_tee_close_fd (&self->transport.cancel_pipe[1]);
+}
+
+static GError *
+fpc_tee_error (int rc, const gchar *what)
+{
+  switch (rc)
+    {
+    case FPC_TZ_ETRANSPORT:
+      return fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                       "%s: the trustlet did not answer", what);
+
+    case FPC_TZ_EGENERATION:
+      return fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                       "%s: this trustlet does not use the "
+                                       "yoshino command numbering", what);
+
+    default:
+      return fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                       "%s failed: %d", what, rc);
+    }
+}
+
+/* ------------------------------------------------------------------ *
+ * Jobs.  Every trustlet call blocks (WAIT_FINGER_DOWN blocks until the
+ * finger arrives), so each one runs on a worker thread and the SSM is
+ * advanced from the main loop in the completion callback.
+ * ------------------------------------------------------------------ */
+
+typedef int (*FpcTeeJobFunc) (FpiDeviceFpcTee *self);
+
+static void
+fpc_tee_job_thread (GTask *task, gpointer source, gpointer data, GCancellable *cancellable)
+{
+  FpcTeeJobFunc job = data;
+
+  (void) cancellable;
+  g_task_return_int (task, job (FPI_DEVICE_FPCTEE (source)));
+}
+
+static void
+fpc_tee_job_run (FpiDeviceFpcTee *self, FpcTeeJobFunc job, GAsyncReadyCallback done)
+{
+  g_autoptr(GTask) task = g_task_new (self, NULL, done, NULL);
+
+  g_task_set_task_data (task, job, NULL);
+  g_task_run_in_thread (task, fpc_tee_job_thread);
+}
+
+static gboolean
+fpc_tee_job_finish (FpiDeviceFpcTee *self, GAsyncResult *res,
+                    const gchar *what, gint *out)
+{
+  GError *error = NULL;
+  gint rc = g_task_propagate_int (G_TASK (res), &error);
+
+  if (error != NULL)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return FALSE;
+    }
+
+  if (rc < 0)
+    {
+      fpi_ssm_mark_failed (self->task_ssm, fpc_tee_error (rc, what));
+      return FALSE;
+    }
+
+  if (out != NULL)
+    *out = rc;
+
+  return TRUE;
+}
+
+/* ------------------------------------------------------------------ *
+ * Prints.  The trustlet stores a u32 id and nothing else, so that id is
+ * the whole of the print's device-side identity.
+ * ------------------------------------------------------------------ */
+
+static FpPrint *
+fpc_tee_print_from_id (FpiDeviceFpcTee *self, guint32 id)
+{
+  FpPrint *print = fp_print_new (FP_DEVICE (self));
+
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  fpi_print_set_device_stored (print, TRUE);
+  g_object_set (print, "fpi-data", g_variant_new ("u", id), NULL);
+
+  return print;
+}
+
+static gboolean
+fpc_tee_id_from_print (FpPrint *print, guint32 *id)
+{
+  g_autoptr(GVariant) data = NULL;
+
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (data == NULL || !g_variant_check_format_string (data, "u", FALSE))
+    return FALSE;
+
+  g_variant_get (data, "u", id);
+  return TRUE;
+}
+
+/* ------------------------------------------------------------------ *
+ * open / close / probe
+ * ------------------------------------------------------------------ */
+
+static int
+job_open (FpiDeviceFpcTee *self)
+{
+  int rc;
+
+  /* fpc_tz_init() cleared the table, so re-run the discriminator: one
+   * non-mutating command, and nothing below it is valid without a table. */
+  rc = fpc_tz_probe (&self->tz, FPC_TEE_DB_PATH, NULL);
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  rc = fpc_tz_load_db (&self->tz, FPC_TEE_DB_PATH);
+
+  /* First boot, or a database the trustlet rejects: start an empty one. */
+  if (rc != FPC_TZ_OK)
+    {
+      fp_dbg ("LOAD_DB failed (%d), loading an empty database", rc);
+      rc = fpc_tz_load_empty_db (&self->tz);
+      if (rc != FPC_TZ_OK)
+        return rc;
+    }
+
+  return fpc_tz_set_gid (&self->tz, FPC_TEE_GID);
+}
+
+static void
+fpc_tee_open_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (source);
+  GError *error = NULL;
+  gint rc = g_task_propagate_int (G_TASK (res), &error);
+
+  (void) user_data;
+  if (error == NULL && rc < 0)
+    error = fpc_tee_error (rc, "open");
+
+  if (error != NULL)
+    fpc_tee_transport_close (self);
+
+  fpi_device_open_complete (FP_DEVICE (self), error);
+}
+
+static void
+fpc_tee_dev_open (FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+  GError *error = NULL;
+
+  if (!fpc_tee_transport_open (self, &error))
+    {
+      fpi_device_open_complete (device, error);
+      return;
+    }
+
+  fpc_tee_job_run (self, job_open, fpc_tee_open_done);
+}
+
+static void
+fpc_tee_dev_close (FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+
+  fpc_tz_deep_sleep (&self->tz);
+  fpc_tee_transport_close (self);
+  fpi_device_close_complete (device, NULL);
+}
+
+static void
+fpc_tee_dev_probe (FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+  g_autofree gchar *serial = NULL;
+  GError *error = NULL;
+  int transport_ok = 0;
+  int rc;
+
+  if (!fpc_tee_transport_open (self, &error))
+    {
+      fpi_device_probe_complete (device, NULL, NULL, error);
+      return;
+    }
+
+  /*
+   * The first command ever sent to this trustlet: INFO 0x09 / GET_FPC_INFO
+   * 0x02.  Group 0x09 does not exist in the older FPC table, so the group id
+   * alone says which generation this is, and it mutates nothing.
+   */
+  rc = fpc_tz_probe (&self->tz, FPC_TEE_DB_PATH, &transport_ok);
+  fpc_tee_transport_close (self);
+
+  if (rc != FPC_TZ_OK)
+    {
+      fp_err ("trustlet probe failed (%d, transport %s)", rc,
+              transport_ok ? "alive" : "dead");
+      fpi_device_probe_complete (device, NULL, NULL, fpc_tee_error (rc, "probe"));
+      return;
+    }
+
+  serial = g_strdup_printf ("fpc-%04x", self->tz.info);
+  fpi_device_probe_complete (device, serial, NULL, NULL);
+}
+
+/* ------------------------------------------------------------------ *
+ * enroll
+ * ------------------------------------------------------------------ */
+
+static int
+job_begin_enrol (FpiDeviceFpcTee *self)
+{
+  return fpc_tz_begin_enrol (&self->tz);
+}
+
+/*
+ * One touch: arm the sensor, wait for the IRQ, let the trustlet capture and
+ * fold the image into the template.  Returns remaining_touches, which is
+ * where nr_enroll_stages comes from — never a constant.
+ */
+static int
+job_enrol_touch (FpiDeviceFpcTee *self)
+{
+  guint32 remaining = 0;
+  int rc;
+
+  rc = fpc_tz_wait_finger_down (&self->tz, FPC_TEE_FINGER_TIMEOUT_MS);
+  if (rc < 0)
+    return rc;
+  if (rc == 0)
+    return FPC_TEE_TOUCH_RETRY; /* cancelled or timed out */
+
+  /*
+   * A non-zero capture code is the trustlet saying "that image was not good
+   * enough", not a failure: ask for the finger again.
+   * ponytail: every non-zero code maps to one generic retry.  The real code
+   * table is only observable on hardware — split it there, not here.
+   */
+  rc = fpc_tz_capture_image (&self->tz);
+  if (rc < 0)
+    return rc;
+  if (rc != 0)
+    return FPC_TEE_TOUCH_RETRY;
+
+  rc = fpc_tz_enrol_step (&self->tz, &remaining);
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  return (int) remaining + 1;
+}
+
+static int
+job_end_enrol (FpiDeviceFpcTee *self)
+{
+  int rc = fpc_tz_end_enrol (&self->tz, &self->enrolled_id);
+
+  self->enrolling = FALSE;
+  return rc;
+}
+
+static int
+job_store_db (FpiDeviceFpcTee *self)
+{
+  return fpc_tz_store_db (&self->tz, FPC_TEE_DB_PATH);
+}
+
+static int
+job_discard_enrol (FpiDeviceFpcTee *self)
+{
+  guint32 unused_id = 0;
+
+  if (!self->enrolling)
+    return FPC_TZ_OK;
+
+  self->enrolling = FALSE;
+  fpc_tz_end_enrol (&self->tz, &unused_id);
+  if (unused_id != 0)
+    fpc_tz_delete_fingerprint (&self->tz, unused_id);
+
+  return FPC_TZ_OK;
+}
+
+static void
+fpc_tee_enroll_step_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (source);
+  gint remaining = 0;
+  gint rc = 0;
+
+  (void) user_data;
+  if (!fpc_tee_job_finish (self, res, "enrol step", &rc))
+    return;
+
+  if (rc == FPC_TEE_TOUCH_RETRY)
+    {
+      fpi_device_enroll_progress (FP_DEVICE (self), self->enroll_stage, NULL,
+                                  fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+      fpi_ssm_jump_to_state (self->task_ssm, FPC_TEE_ENROLL_TOUCH);
+      return;
+    }
+
+  remaining = rc - 1;
+  self->enroll_stage++;
+
+  /* nr_enroll_stages is whatever the trustlet asks for, not a constant. */
+  fpi_device_set_nr_enroll_stages (FP_DEVICE (self), self->enroll_stage + remaining);
+  fpi_device_enroll_progress (FP_DEVICE (self), self->enroll_stage, NULL, NULL);
+
+  if (remaining > 0)
+    fpi_ssm_jump_to_state (self->task_ssm, FPC_TEE_ENROLL_TOUCH);
+  else
+    fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+fpc_tee_ssm_step_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (source);
+
+  if (fpc_tee_job_finish (self, res,
+                          user_data != NULL ? user_data : "trustlet command", NULL))
+    fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+fpc_tee_enroll_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case FPC_TEE_ENROLL_BEGIN:
+      self->enrolling = TRUE;
+      fpc_tee_job_run (self, job_begin_enrol, fpc_tee_ssm_step_done);
+      break;
+
+    case FPC_TEE_ENROLL_TOUCH:
+      fpi_device_report_finger_status_changes (device,
+                                               FP_FINGER_STATUS_NEEDED,
+                                               FP_FINGER_STATUS_NONE);
+      fpc_tee_job_run (self, job_enrol_touch, fpc_tee_enroll_step_done);
+      break;
+
+    case FPC_TEE_ENROLL_END:
+      fpc_tee_job_run (self, job_end_enrol, fpc_tee_ssm_step_done);
+      break;
+
+    case FPC_TEE_ENROLL_STORE:
+      fpc_tee_job_run (self, job_store_db, fpc_tee_ssm_step_done);
+      break;
+
+    case FPC_TEE_ENROLL_DISCARD:
+      fpc_tee_job_run (self, job_discard_enrol, fpc_tee_ssm_step_done);
+      break;
+    }
+}
+
+static void
+fpc_tee_enroll_ssm_done (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (dev);
+  FpPrint *print = NULL;
+
+  (void) ssm;
+  self->task_ssm = NULL;
+
+  if (error != NULL)
+    {
+      fpi_device_enroll_complete (dev, NULL, error);
+      return;
+    }
+
+  fpi_device_get_enroll_data (dev, &print);
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  fpi_print_set_device_stored (print, TRUE);
+  g_object_set (print, "fpi-data", g_variant_new ("u", self->enrolled_id), NULL);
+
+  fpi_device_enroll_complete (dev, g_object_ref (print), NULL);
+}
+
+static void
+fpc_tee_dev_enroll (FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+
+  self->enroll_stage = 0;
+  self->enrolled_id = 0;
+  self->task_ssm = fpi_ssm_new_full (device, fpc_tee_enroll_run_state,
+                                     FPC_TEE_ENROLL_NUM_STATES,
+                                     FPC_TEE_ENROLL_DISCARD,
+                                     "enroll");
+  fpi_ssm_start (self->task_ssm, fpc_tee_enroll_ssm_done);
+}
+
+/* ------------------------------------------------------------------ *
+ * verify / identify — one path, as in fpcmoc
+ * ------------------------------------------------------------------ */
+
+static int
+job_identify (FpiDeviceFpcTee *self)
+{
+  int rc;
+
+  self->matched_id = 0;
+
+  rc = fpc_tz_wait_finger_down (&self->tz, FPC_TEE_FINGER_TIMEOUT_MS);
+  if (rc < 0)
+    return rc;
+  if (rc == 0)
+    return FPC_TEE_TOUCH_RETRY;
+
+  rc = fpc_tz_capture_image (&self->tz);
+  if (rc < 0)
+    return rc;
+  if (rc != 0)
+    return FPC_TEE_TOUCH_RETRY;
+
+  rc = fpc_tz_identify (&self->tz, &self->matched_id);
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  return FPC_TEE_TOUCH_DONE;
+}
+
+/* The trustlet may refine the stored template after a match; persist it. */
+static int
+job_update_template (FpiDeviceFpcTee *self)
+{
+  int changed = 0;
+  int rc = fpc_tz_update_template (&self->tz, &changed);
+
+  if (rc != FPC_TZ_OK || !changed)
+    return rc;
+
+  return fpc_tz_store_db (&self->tz, FPC_TEE_DB_PATH);
+}
+
+static void
+fpc_tee_identify_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (source);
+  FpDevice *device = FP_DEVICE (self);
+
+  g_autoptr(GPtrArray) templates = NULL;
+  FpPrint *scanned = NULL;       /* (transfer floating) to identify_report */
+  guint index;
+  gint rc = 0;
+
+  (void) user_data;
+  if (!fpc_tee_job_finish (self, res, "identify", &rc))
+    return;
+
+  if (rc == FPC_TEE_TOUCH_RETRY)
+    {
+      fpi_device_identify_report (device, NULL, NULL,
+                                  fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+      fpi_ssm_jump_to_state (self->task_ssm, FPC_TEE_IDENTIFY_TOUCH);
+      return;
+    }
+
+  if (self->matched_id == 0)
+    {
+      fpi_device_identify_report (device, NULL, NULL, NULL);
+      fpi_ssm_mark_completed (self->task_ssm);
+      return;
+    }
+
+  scanned = fpc_tee_print_from_id (self, self->matched_id);
+
+  fpi_device_get_identify_data (device, &templates);
+  if (templates != NULL)
+    g_ptr_array_ref (templates);        /* the getter borrows */
+
+  if (templates != NULL &&
+      g_ptr_array_find_with_equal_func (templates, scanned,
+                                        (GEqualFunc) fp_print_equal, &index))
+    fpi_device_identify_report (device, g_ptr_array_index (templates, index),
+                                scanned, NULL);
+  else
+    fpi_device_identify_report (device, NULL, scanned, NULL);
+
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+fpc_tee_identify_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case FPC_TEE_IDENTIFY_TOUCH:
+      fpi_device_report_finger_status_changes (device,
+                                               FP_FINGER_STATUS_NEEDED,
+                                               FP_FINGER_STATUS_NONE);
+      fpc_tee_job_run (self, job_identify, fpc_tee_identify_done);
+      break;
+
+    case FPC_TEE_IDENTIFY_UPDATE:
+      fpc_tee_job_run (self, job_update_template, fpc_tee_ssm_step_done);
+      break;
+
+    case FPC_TEE_IDENTIFY_CANCEL:
+      fpc_tz_cancel (&self->tz);
+      fpi_ssm_mark_completed (ssm);
+      break;
+    }
+}
+
+static void
+fpc_tee_identify_ssm_done (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (dev);
+
+  (void) ssm;
+  self->task_ssm = NULL;
+
+  if (error != NULL && error->domain == FP_DEVICE_RETRY)
+    fpi_device_identify_report (dev, NULL, NULL, g_steal_pointer (&error));
+
+  fpi_device_identify_complete (dev, error);
+}
+
+static void
+fpc_tee_dev_identify (FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+
+  self->task_ssm = fpi_ssm_new_full (device, fpc_tee_identify_run_state,
+                                     FPC_TEE_IDENTIFY_NUM_STATES,
+                                     FPC_TEE_IDENTIFY_CANCEL,
+                                     "identify");
+  fpi_ssm_start (self->task_ssm, fpc_tee_identify_ssm_done);
+}
+
+/* ------------------------------------------------------------------ *
+ * storage: list / delete / clear
+ * ------------------------------------------------------------------ */
+
+static int
+job_list (FpiDeviceFpcTee *self)
+{
+  guint32 ids[FPC_TZ_MAX_PRINTS] = { 0 };
+  guint32 count = 0;
+  int rc = fpc_tz_get_fingerprints (&self->tz, ids, &count);
+
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  /* Stash the ids where the main-thread callback can build the prints. */
+  for (guint32 i = 0; i < count; i++)
+    self->list_ids[i] = ids[i];
+  self->list_count = count;
+
+  return FPC_TZ_OK;
+}
+
+static void
+fpc_tee_list_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (source);
+  g_autoptr(GPtrArray) prints = NULL;
+  GError *error = NULL;
+  gint rc;
+
+  (void) user_data;
+  rc = g_task_propagate_int (G_TASK (res), &error);
+  if (error == NULL && rc < 0)
+    error = fpc_tee_error (rc, "list");
+
+  if (error != NULL)
+    {
+      fpi_device_list_complete (FP_DEVICE (self), NULL, error);
+      return;
+    }
+
+  prints = g_ptr_array_new_with_free_func (g_object_unref);
+  for (guint32 i = 0; i < self->list_count; i++)
+    g_ptr_array_add (prints, fpc_tee_print_from_id (self, self->list_ids[i]));
+
+  fpi_device_list_complete (FP_DEVICE (self), g_steal_pointer (&prints), NULL);
+}
+
+static void
+fpc_tee_dev_list (FpDevice *device)
+{
+  fpc_tee_job_run (FPI_DEVICE_FPCTEE (device), job_list, fpc_tee_list_done);
+}
+
+static int
+job_delete (FpiDeviceFpcTee *self)
+{
+  int rc = fpc_tz_delete_fingerprint (&self->tz, self->matched_id);
+
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  return fpc_tz_store_db (&self->tz, FPC_TEE_DB_PATH);
+}
+
+static void
+fpc_tee_delete_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (source);
+  GError *error = NULL;
+  gint rc = g_task_propagate_int (G_TASK (res), &error);
+
+  (void) user_data;
+  if (error == NULL && rc < 0)
+    error = fpc_tee_error (rc, "delete");
+
+  fpi_device_delete_complete (FP_DEVICE (self), error);
+}
+
+static void
+fpc_tee_dev_delete (FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+  FpPrint *print = NULL;
+
+  fpi_device_get_delete_data (device, &print);
+
+  if (!fpc_tee_id_from_print (print, &self->matched_id) || self->matched_id == 0)
+    {
+      fpi_device_delete_complete (device,
+                                  fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID));
+      return;
+    }
+
+  fpc_tee_job_run (self, job_delete, fpc_tee_delete_done);
+}
+
+static int
+job_clear (FpiDeviceFpcTee *self)
+{
+  int rc = fpc_tz_load_empty_db (&self->tz);
+
+  if (rc != FPC_TZ_OK)
+    return rc;
+
+  return fpc_tz_store_db (&self->tz, FPC_TEE_DB_PATH);
+}
+
+static void
+fpc_tee_clear_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (source);
+  GError *error = NULL;
+  gint rc = g_task_propagate_int (G_TASK (res), &error);
+
+  (void) user_data;
+  if (error == NULL && rc < 0)
+    error = fpc_tee_error (rc, "clear storage");
+
+  fpi_device_clear_storage_complete (FP_DEVICE (self), error);
+}
+
+static void
+fpc_tee_dev_clear_storage (FpDevice *device)
+{
+  fpc_tee_job_run (FPI_DEVICE_FPCTEE (device), job_clear, fpc_tee_clear_done);
+}
+
+/* ------------------------------------------------------------------ *
+ * suspend / resume / cancel
+ * ------------------------------------------------------------------ */
+
+static void
+fpc_tee_dev_suspend (FpDevice *device)
+{
+  FpiDeviceFpcTee *self = FPI_DEVICE_FPCTEE (device);
+
+  fpc_tz_cancel (&self->tz);
+  fpc_tz_deep_sleep (&self->tz);
+  fpi_device_suspend_complete (device, NULL);
+}
+
+static void
+fpc_tee_dev_resume (FpDevice *device)
+{
+  fpi_device_resume_complete (device, NULL);
+}
+
+static void
+fpc_tee_dev_cancel (FpDevice *device)
+{
+  fpc_tz_cancel (&FPI_DEVICE_FPCTEE (device)->tz);
+}
+
+/* ------------------------------------------------------------------ */
+
+static void
+fpi_device_fpctee_init (FpiDeviceFpcTee *self)
+{
+  self->transport.fd = -1;
+  self->transport.cancel_pipe[0] = -1;
+  self->transport.cancel_pipe[1] = -1;
+}
+
+static void
+fpi_device_fpctee_class_init (FpiDeviceFpcTeeClass *klass)
+{
+  FpDeviceClass *dev_class = FP_DEVICE_CLASS (klass);
+
+  dev_class->id =               FP_COMPONENT;
+  dev_class->full_name =        "FPC MOC Fingerprint Sensor (TrustZone)";
+  dev_class->type =             FP_DEVICE_TYPE_VIRTUAL;
+  dev_class->scan_type =        FP_SCAN_TYPE_PRESS;
+  dev_class->id_table =         fpctee_id_table;
+  dev_class->nr_enroll_stages = FPC_TEE_MAX_ENROLL_STAGES;
+  dev_class->temp_hot_seconds = -1;
+
+  dev_class->probe =            fpc_tee_dev_probe;
+  dev_class->open =             fpc_tee_dev_open;
+  dev_class->close =            fpc_tee_dev_close;
+  dev_class->enroll =           fpc_tee_dev_enroll;
+  dev_class->identify =         fpc_tee_dev_identify;
+  dev_class->list =             fpc_tee_dev_list;
+  dev_class->delete =           fpc_tee_dev_delete;
+  dev_class->clear_storage =    fpc_tee_dev_clear_storage;
+  dev_class->suspend =          fpc_tee_dev_suspend;
+  dev_class->resume =           fpc_tee_dev_resume;
+  dev_class->cancel =           fpc_tee_dev_cancel;
+
+  fpi_device_class_auto_initialize_features (dev_class);
+  dev_class->features |= FP_DEVICE_FEATURE_DUPLICATES_CHECK;
+}
