+			 * apply on this DDIC (see lg_panel_enable()).
+			 */
+			ret = mipi_dsi_dcs_write(dsi,
+					MIPI_DCS_WRITE_CONTROL_DISPLAY,
+					(u8[]){ 0x00 }, 1);
+			break;
+		default:
+			ret = mipi_dsi_dcs_write(dsi,
+					MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+					&brightness, sizeof(brightness));
+			break;
+		}
