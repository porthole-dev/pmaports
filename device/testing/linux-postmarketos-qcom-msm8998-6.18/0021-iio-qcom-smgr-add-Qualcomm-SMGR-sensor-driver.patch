+static int qcom_smgr_sensor_postenable(struct iio_dev *iio_dev)
+{
+	struct qcom_smgr *smgr = dev_get_drvdata(iio_dev->dev.parent);
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_sensor *sensor = priv->sensor;
+	struct qcom_smgr_sensor *accel;
+	int ret;
+
+	mutex_lock(&sensor->lock);
+	ret = qcom_smgr_buffering_get(smgr, sensor);
+	mutex_unlock(&sensor->lock);
+	if (ret)
+		return ret;
+
+	/*
+	 * The heading needs gravity, and the accelerometer is a separate SMGR
+	 * sensor with its own stream -- so scanning the compass has to start it
+	 * too, or every report would be computed against a stale sample.
+	 */
+	if (!test_bit(QCOM_SMGR_MAG_SCAN_ROT, iio_dev->active_scan_mask))
+		return 0;
+
+	accel = qcom_smgr_find(smgr, SNS_SMGR_SENSOR_TYPE_ACCEL);
+	if (!accel)
+		return 0;
+
+	mutex_lock(&accel->lock);
+	ret = qcom_smgr_buffering_get(smgr, accel);
+	mutex_unlock(&accel->lock);
+	if (ret) {
+		mutex_lock(&sensor->lock);
+		qcom_smgr_buffering_put(smgr, sensor);
+		mutex_unlock(&sensor->lock);
+		return ret;
+	}
+
+	priv->tilt_ref = true;
+
+	return 0;
+}
+
+static int qcom_smgr_sensor_predisable(struct iio_dev *iio_dev)
+{
+	struct qcom_smgr *smgr = dev_get_drvdata(iio_dev->dev.parent);
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_sensor *sensor = priv->sensor;
+	struct qcom_smgr_sensor *accel;
+
+	if (priv->tilt_ref) {
+		accel = qcom_smgr_find(smgr, SNS_SMGR_SENSOR_TYPE_ACCEL);
+		if (accel) {
+			mutex_lock(&accel->lock);
+			qcom_smgr_buffering_put(smgr, accel);
+			mutex_unlock(&accel->lock);
+		}
+		priv->tilt_ref = false;
+	}
+
+	mutex_lock(&sensor->lock);
+	qcom_smgr_buffering_put(smgr, sensor);
+	mutex_unlock(&sensor->lock);
+
+	return 0;
+}
+
+static const struct iio_buffer_setup_ops qcom_smgr_buffer_ops = {
+	.postenable = &qcom_smgr_sensor_postenable,
+	.predisable = &qcom_smgr_sensor_predisable
+};
+
+/*
+ * MEASURED with tools/tk-mount-cal.py, which names each pose by the edge that
+ * points at the CEILING and checks its own answer against a fourth pose.
+ *
+ * An accelerometer at rest reads +1 g along whatever axis points up, so each
+ * pose simply *is* that device axis expressed in SMGR's frame:
+ *
+ *   screen at the ceiling      SMGR (+0.16, +0.04, -9.82)  =>  smgr -z is device +z
+ *   top edge at the ceiling    SMGR (+9.95, -0.62, +0.43)  =>  smgr +x is device +y
+ *   top edge to your right     SMGR (-0.39, -9.85, +0.23)  =>  smgr +y is device +x
+ *   top edge to your left      SMGR (-0.40, +9.87, +0.40)  =>  agrees, opposite sign
+ *
+ * So SMGR reports (top, right, into-the-screen). x and y are swapped relative
+ * to the device frame and z is inverted, which is a proper rotation with
+ * determinant +1.
+ *
+ * An earlier comment here recorded (right, top, into-the-screen) and insisted
+ * the determinant had to be -1. That measurement was wrong. It came from a
+ * tool that assigned poses by the order it happened to see the phone go still,
+ * so one missed or extra steady moment shifted every pose by one -- and it
+ * expected the wrong sign for its own third pose, so both matrices it scored
+ * failed that pose and the mismatch was read as noise. The result on the
+ * device was a phone iio-sensor-proxy called "normal" while it was physically
+ * in landscape: a 90 degree error, in the direction that comment warned about.
+ *
+ * A reflection would have been suspicious on its own -- a physical mounting
+ * cannot produce one.
+ */
+static const struct iio_mount_matrix qcom_smgr_iio_mount_matrix = {
+	.rotation = {
+		"0", "1", "0",
+		"1", "0", "0",
+		"0", "0", "-1"
+	}
+};
+
+static const struct iio_mount_matrix *
+qcom_smgr_iio_get_mount_matrix(const struct iio_dev *iio_dev,
+			       const struct iio_chan_spec *chan)
+{
+	return &qcom_smgr_iio_mount_matrix;
+}
+
+static const struct iio_chan_spec_ext_info qcom_smgr_iio_ext_info[] = {
+	IIO_MOUNT_MATRIX(IIO_SHARED_BY_DIR, qcom_smgr_iio_get_mount_matrix),
+	{ }
+};
+
+/*
+ * SMGR only pushes, so a raw read has to either piggy-back on a buffer that
+ * is already streaming or briefly subscribe on its own. Enabling buffering
+ * always produces one report immediately, including for the prox/light part,
+ * which otherwise only reports on change.
+ */
+static int qcom_smgr_read_one(struct iio_dev *iio_dev,
+			      struct iio_chan_spec const *chan, int *val)
+{
+	struct qcom_smgr *smgr = dev_get_drvdata(iio_dev->dev.parent);
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_sensor *sensor = priv->sensor;
+	int ret = 0;
+
+	mutex_lock(&sensor->lock);
+
+	/*
+	 * Refcounted, so this no longer has to special-case "already
+	 * streaming": it either starts the stream or joins one, and only the
+	 * last user stops it. Previously a raw read taken while something else
+	 * was streaming returned -EAGAIN until the first report arrived, and a
+	 * raw read taken while the compass held the accelerometer would have
+	 * torn that stream down on the way out.
+	 */
+	reinit_completion(&sensor->report);
+
+	ret = qcom_smgr_buffering_get(smgr, sensor);
+	if (ret)
+		goto out;
+
+	if (!wait_for_completion_timeout(&sensor->report, HZ))
+		ret = -ETIMEDOUT;
+
+	qcom_smgr_buffering_put(smgr, sensor);
+
+	if (ret)
+		goto out;
+
+	*val = sensor->last_values[chan->scan_index];
+
+out:
+	mutex_unlock(&sensor->lock);
+
+	return ret ? ret : IIO_VAL_INT;
+}
+
+static int qcom_smgr_iio_read_raw(struct iio_dev *iio_dev,
+				  struct iio_chan_spec const *chan, int *val,
+				  int *val2, long mask)
+{
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+	case IIO_CHAN_INFO_PROCESSED:
+		return qcom_smgr_read_one(iio_dev, chan, val);
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		*val = priv->sensor->data_types[0].cur_sample_rate;
+		return IIO_VAL_INT;
+	case IIO_CHAN_INFO_CALIBBIAS:
+		*val = priv->sensor->calibbias[chan->scan_index];
+		return IIO_VAL_INT;
+	case IIO_CHAN_INFO_SCALE:
+		if (chan->type == IIO_PRESSURE) {
+			/* SMGR reports hPa; IIO wants kPa */
+			*val = 1;
+			*val2 = (1 << SMGR_VALUE_DECIMAL_OFFSET) * 10;
+			return IIO_VAL_FRACTIONAL;
+		}
+
+		if (chan->type == IIO_TEMP) {
+			/* Q16.16 degrees C; IIO wants millidegrees */
+			*val = 1000;
+			*val2 = 1 << SMGR_VALUE_DECIMAL_OFFSET;
+			return IIO_VAL_FRACTIONAL;
+		}
+
+		*val = 1;
+		*val2 = 1 << SMGR_VALUE_DECIMAL_OFFSET;
+		return IIO_VAL_FRACTIONAL;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int qcom_smgr_iio_write_raw(struct iio_dev *iio_dev,
+				   struct iio_chan_spec const *chan, int val,
+				   int val2, long mask)
+{
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		if (!iio_device_claim_direct(iio_dev))
+			return -EBUSY;
+
+		priv->sensor->data_types[0].cur_sample_rate = val;
+
+		iio_device_release_direct(iio_dev);
+		return 0;
+	case IIO_CHAN_INFO_CALIBBIAS:
+		priv->sensor->calibbias[chan->scan_index] = val;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int qcom_smgr_iio_read_avail(struct iio_dev *iio_dev,
+				    struct iio_chan_spec const *chan,
+				    const int **vals, int *type, int *length,
+				    long mask)
+{
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		*type = IIO_VAL_INT;
+		*vals = priv->samp_freq_vals;
+		*length = ARRAY_SIZE(priv->samp_freq_vals);
+		return IIO_AVAIL_RANGE;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int qcom_smgr_iio_read_event_config(struct iio_dev *iio_dev,
+					   const struct iio_chan_spec *chan,
+					   enum iio_event_type type,
+					   enum iio_event_direction dir)
+{
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	return priv->event_enabled;
+}
+
+/*
+ * Enabling the event is what subscribes. An event-only sensor has no buffer to
+ * turn on, so this is the only path that can start it, and the refcount is
+ * shared with buffered users so the two cannot tread on each other.
+ */
+static int qcom_smgr_iio_write_event_config(struct iio_dev *iio_dev,
+					    const struct iio_chan_spec *chan,
+					    enum iio_event_type type,
+					    enum iio_event_direction dir,
+					    bool state)
+{
+	struct qcom_smgr *smgr = dev_get_drvdata(iio_dev->dev.parent);
+	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_sensor *sensor = priv->sensor;
+	int ret = 0;
+
+	mutex_lock(&sensor->lock);
+
+	if (state == priv->event_enabled)
+		goto out;
+
+	if (state) {
+		ret = qcom_smgr_buffering_get(smgr, sensor);
+		if (ret)
+			goto out;
+	} else {
+		qcom_smgr_buffering_put(smgr, sensor);
+	}
+
+	priv->event_enabled = state;
+out:
+	mutex_unlock(&sensor->lock);
+
+	return ret;
+}
+
+static const struct iio_info qcom_smgr_iio_info = {
+	.read_raw = qcom_smgr_iio_read_raw,
+	.write_raw = qcom_smgr_iio_write_raw,
+	.read_avail = qcom_smgr_iio_read_avail,
+	.read_event_config = qcom_smgr_iio_read_event_config,
+	.write_event_config = qcom_smgr_iio_write_event_config,
+};
