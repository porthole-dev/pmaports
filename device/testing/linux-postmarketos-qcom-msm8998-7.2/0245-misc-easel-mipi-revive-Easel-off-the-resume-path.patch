From 573a73940dbac2bfc27f77ea1003dbe67d534d42 Mon Sep 17 00:00:00 2001
From: jert <joseph96tb@gmail.com>
Date: Sat, 19 Sep 2026 20:17:40 +0200
Subject: [PATCH] misc: easel-mipi: revive Easel off the resume path

The PM_POST_SUSPEND half of easel_pm_notify() powers Easel back on, cycles
PERST#, retrains the PCIe link, polls config space in 20 ms steps and
rescans the bus.  Traced on 2026-09-19 with events/notifier/notifier_run,
that is 328.5 ms of the 353.9 ms window between "Restarting tasks: Done"
and "PM: suspend exit" -- a third of the whole s2idle cycle, and all of it
in front of the user, because the PM_POST_SUSPEND chain runs inside
suspend_finish(), before pm_suspend() returns.

Nothing needs Easel within a third of a second of a resume.  Move the
revival to a work item.  While it runs Easel is absent, which is a state
every caller already handles: a revival that fails leaves Easel absent for
good.  PM_SUSPEND_PREPARE cancel_work_sync()s first so a suspend cannot
race a revival for the link.

Assisted-by: Claude
---
 drivers/misc/easel-mipi.c | 133 +++++++++++++++++++++++---------------
 1 file changed, 80 insertions(+), 53 deletions(-)

diff --git a/drivers/misc/easel-mipi.c b/drivers/misc/easel-mipi.c
index b9269d892e11..b143c9f8076d 100644
--- a/drivers/misc/easel-mipi.c
+++ b/drivers/misc/easel-mipi.c
@@ -28,6 +28,7 @@
 #include <linux/pcie-qcom.h>
 #include <linux/regulator/bcm15602-easel.h>
 #include <linux/suspend.h>
+#include <linux/workqueue.h>
 #include <linux/pci.h>
 #include <linux/limits.h>
 
@@ -1021,15 +1022,90 @@ module_param(sleep_mode, uint, 0644);
 MODULE_PARM_DESC(sleep_mode,
 		 "0 none, 1 off-before-sleep, 2 +revive, 3 +L23 (default)");
 
+/*
+ * Reviving Easel costs ~330 ms: a PERST cycle, a link retrain, a
+ * config-space poll that sleeps in 20 ms steps, and a bus rescan.  Measured
+ * 2026-09-19, it was 328.5 ms of the 353.9 ms the kernel spends between
+ * "Restarting tasks: Done" and "PM: suspend exit" -- because the
+ * PM_POST_SUSPEND chain runs before pm_suspend() returns, every one of those
+ * milliseconds is on the user's resume path.
+ *
+ * Nothing needs Easel that soon.  While the work runs Easel is simply absent,
+ * which every caller already copes with: a revival that FAILS leaves it
+ * absent for good, so the async window is an existing state, not a new one.
+ *
+ * ponytail: no completion to wait on.  If a camera open ever races the
+ * rescan, flush_work(&easel_revive_work) in that open is the upgrade path.
+ */
+static void easel_revive(struct work_struct *work)
+{
+	int i, ret;
+	u32 id;
+
+	if (!easel_parked || !easel_rp || sleep_mode < 2)
+		return;
+
+	ret = bcm15602_easel_power_on_ext();
+	if (ret) {
+		pr_err("easel-mipi: power-on failed (%d), Easel stays off\n",
+		       ret);
+		bcm15602_easel_power_off_ext();
+		return;		/* still parked; retried next cycle */
+	}
+
+	ret = qcom_pcie_rp_wake(easel_rp);
+	if (ret) {
+		pr_err("easel-mipi: link did not retrain (%d), powering Easel off\n",
+		       ret);
+		goto off_parked;
+	}
+
+	/*
+	 * The link is up; make sure config space answers before a rescan
+	 * crosses it (config reads over a dead link are safe, a rescan over
+	 * one is not).
+	 */
+	for (i = 0; i < 25; i++) {
+		if (!pci_bus_read_config_dword(easel_rp->subordinate,
+					       PCI_DEVFN(0, 0),
+					       PCI_VENDOR_ID, &id) &&
+		    (id & 0xffff) == EASEL_VENDOR_INTEL)
+			break;
+		msleep(20);
+	}
+	if (i == 25) {
+		pr_err("easel-mipi: Easel config space silent, powering off\n");
+		goto off_parked;
+	}
+
+	pci_lock_rescan_remove();
+	pci_rescan_bus(easel_rp->bus);
+	pci_unlock_rescan_remove();
+
+	if (!easel_dev) {
+		pr_err("easel-mipi: rescan did not re-probe, powering off\n");
+		goto off_parked;
+	}
+
+	easel_parked = false;
+	pr_info("easel-mipi: Easel revived after resume\n");
+	return;
+off_parked:
+	qcom_pcie_rp_sleep(easel_rp, false);
+	bcm15602_easel_power_off_ext();
+}
+static DECLARE_WORK(easel_revive_work, easel_revive);
+
 static int easel_pm_notify(struct notifier_block *nb, unsigned long action,
 			   void *data)
 {
 	struct pci_dev *pdev;
-	int i, ret;
-	u32 id;
 
 	switch (action) {
 	case PM_SUSPEND_PREPARE:
+		/* A revival still in flight owns the link; let it finish. */
+		cancel_work_sync(&easel_revive_work);
+
 		if (!easel_dev || !easel_rp || easel_parked || sleep_mode < 1)
 			break;
 
@@ -1043,57 +1119,7 @@ static int easel_pm_notify(struct notifier_block *nb, unsigned long action,
 		easel_parked = true;
 		break;
 	case PM_POST_SUSPEND:
-		if (!easel_parked || !easel_rp || sleep_mode < 2)
-			break;
-
-		ret = bcm15602_easel_power_on_ext();
-		if (ret) {
-			pr_err("easel-mipi: power-on failed (%d), Easel stays off\n",
-			       ret);
-			bcm15602_easel_power_off_ext();
-			break;		/* still parked; retried next cycle */
-		}
-
-		ret = qcom_pcie_rp_wake(easel_rp);
-		if (ret) {
-			pr_err("easel-mipi: link did not retrain (%d), powering Easel off\n",
-			       ret);
-			goto off_parked;
-		}
-
-		/*
-		 * The link is up; make sure config space answers before a
-		 * rescan crosses it (config reads over a dead link are safe,
-		 * a rescan over one is not).
-		 */
-		for (i = 0; i < 25; i++) {
-			if (!pci_bus_read_config_dword(easel_rp->subordinate,
-						       PCI_DEVFN(0, 0),
-						       PCI_VENDOR_ID, &id) &&
-			    (id & 0xffff) == EASEL_VENDOR_INTEL)
-				break;
-			msleep(20);
-		}
-		if (i == 25) {
-			pr_err("easel-mipi: Easel config space silent, powering off\n");
-			goto off_parked;
-		}
-
-		pci_lock_rescan_remove();
-		pci_rescan_bus(easel_rp->bus);
-		pci_unlock_rescan_remove();
-
-		if (!easel_dev) {
-			pr_err("easel-mipi: rescan did not re-probe, powering off\n");
-			goto off_parked;
-		}
-
-		easel_parked = false;
-		pr_info("easel-mipi: Easel revived after resume\n");
-		break;
-off_parked:
-		qcom_pcie_rp_sleep(easel_rp, false);
-		bcm15602_easel_power_off_ext();
+		schedule_work(&easel_revive_work);
 		break;
 	}
 
@@ -1120,6 +1146,7 @@ module_init(easel_init);
 static void __exit easel_exit(void)
 {
 	unregister_pm_notifier(&easel_pm_nb);
+	cancel_work_sync(&easel_revive_work);
 	pci_unregister_driver(&easel_driver);
 	if (easel_rp) {
 		pci_dev_put(easel_rp);
