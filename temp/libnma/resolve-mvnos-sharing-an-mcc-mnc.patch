+/* <provider primary="true|false">: whether this provider owns the MCC/MNC or
+ * is an MVNO piggy-backing on whoever does. Most of the database says neither,
+ * which has to sort between the two -- an untagged provider is a better guess
+ * than a self-declared MVNO and a worse one than a self-declared host network.
+ */
+typedef enum {
+	PROVIDER_PRIMACY_MVNO    = 0, /* primary="false"    */
+	PROVIDER_PRIMACY_UNKNOWN = 1, /* attribute absent   */
+	PROVIDER_PRIMACY_HOST    = 2, /* primary="true"     */
+} ProviderPrimacy;
+
