+config REGMAP_ALLOW_WRITE_DEBUGFS
+	bool "Allow writing registers via debugfs"
+	depends on REGMAP && DEBUG_FS
+	help
+	  Make /sys/kernel/debug/regmap/*/registers writable, so a register
+	  can be poked from userspace during board bring-up.
