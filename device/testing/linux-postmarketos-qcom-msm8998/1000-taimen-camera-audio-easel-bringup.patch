+/ {
+	aliases {
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/*
+		 * No bootargs / stdout-path here: the bootloader adds the boot.img
+		 * cmdline with fdt_appendprop_string(), so a pre-existing bootargs
+		 * makes the kernel read only the DTS half and silently drop
+		 * pmos.debug-shell and the pmos_*_uuid args. Let pmOS own the cmdline.
+		 */
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+ 		#size-cells = <2>;
+ 		ranges;
+
+		/*
+		 * Carveout sizes are dictated by the PIL blobs' own program
+		 * headers, not by the stock DT. Each image is relocatable
+		 * (QCOM_MDT_RELOCATABLE), so the loader rebases it onto whatever
+		 * we reserve here - the base is free, but the SIZE must be >= the
+		 * image's full span or qcom_mdt_load bails with "segment outside
+		 * memory range". Measured spans, taimen RP1A.201005.004.a1:
+		 *
+		 *   modem.mdt    0x7800000  120 MiB   (stock reserves only 112)
+		 *   slpi_v2.mdt  0x0f00000   15 MiB
+		 *
+		 * mpss therefore has to run 8 MiB past stock's modem_region, to
+		 * 0x94400000, which pushes venus and mba up behind it. That left
+		 * slpi wedged into the 7 MiB gap below ipa_fw_mem@95200000 - less
+		 * than half what it needs - so SLPI never loaded. There is no
+		 * 15 MiB hole left down here (0x94400000..0x95200000 is 14 MiB
+		 * total and venus+mba take 7 of it), so slpi goes at the bottom
+		 * of free DDR instead, which both stock and mainline leave
+		 * unreserved from 0x95800000 up.
+		 */
+
+		mpss_mem: memory@8cc00000 {
+			reg = <0 0x8cc00000 0 0x7800000>;
+			no-map;
+		};
+
+		venus_mem: memory@94400000 {
+			reg = <0 0x94400000 0 0x500000>;
+			no-map;
+		};
+
+		mba_mem: memory@94900000 {
+			reg = <0 0x94900000 0 0x200000>;
+			no-map;
+		};
+
+		slpi_mem: memory@95800000 {
+			reg = <0 0x95800000 0 0xf00000>;
+			no-map;
+		};
+
+		/*
+		 * Address matched to the downstream TWRP kernel, which attaches
+		 * "ramoops: attached 0x200000@0xb0000000, ecc: 0/0" - that is how we
+		 * read these records back. Do NOT add ecc-size: mismatched geometry
+		 * makes TWRP reject every record. Verified by canary test 2026-07-25.
+		 */
+		ramoops: ramoops@b0000000 {
+			compatible = "ramoops";
+			reg = <0 0xb0000000 0 0x200000>;
+			record-size = <0x20000>;
+			console-size = <0x100000>;
+			pmsg-size = <0x80000>;
+		};
+
+		zap_shader_region: memory@f6900000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0xf6900000 0x0 0x2000>;
+			no-map;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
