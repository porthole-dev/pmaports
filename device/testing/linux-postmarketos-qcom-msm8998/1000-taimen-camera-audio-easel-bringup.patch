+	.set = lg_sw43402_probe_reg_set,
+};
+module_param_cb(probe_reg, &lg_sw43402_probe_reg_ops, NULL, 0200);
+
+/*
+ * Transmit an arbitrary DCS sequence: write space-separated hex bytes, first
+ * byte is the command. Safe while composing as long as msm.cmd_frame_serialize
+ * is on. This is the live sweep tool for the brightness-apply hunt: 0x51
+ * provably latches (0x52 reads back) but emission never changes, so whatever
+ * applies brightness on this DDIC is some other register -- candidates from
+ * the vendor blob: 53 08 (lp-mode dim toggle), 5e (min brightness), e0/e2/
+ * e4/e5/e7 (the ALPM sequences bundle these around their 51 writes).
+ *
+ *   echo "53 08" > /sys/module/panel_lg_sw43402/parameters/probe_write
