#!/bin/sh
# taimen WLAN + modem bring-up. Init-agnostic: driven by an OpenRC init script
# or a systemd unit, both of which just exec this.
#
# WHAT IS LEFT HERE IS IRREDUCIBLY USERSPACE. A Qualcomm modem on mainline
# depends on three userspace daemons that the kernel cannot substitute for:
#
#   rmtfs        serves the modem's EFS. Without it the modem boots "deaf":
#                empty firmware version and an invalid MAC.
#   tqftpserv    serves modem config over TFTP; its readwrite root is on tmpfs,
#                so the ota_firewall ruleset must be recreated every boot or the
#                modem gets fetch rejects.
#   diag-router  drains the DIAG QRTR channel. Without it the modem's diag task
#                starves and dog_hb kills the WLAN PD every ~19 s.
#
# So this is not a workaround for a missing driver -- it is the ordering those
# daemons require. Do not try to move it into the kernel.
#
# REMOVED in pkgrel 18:
#   * `modprobe ipa`. It predated enabling &ipa in the wahoo dtsi; IPA now
#     autoloads. The comment it carried ("IPA must be loaded BEFORE the MSS or
#     the WLAN PD starves") was also already disproved -- see the dtsi's own
#     note: "That theory is WRONG -- measured both ways on 2026-07-28, the
#     dog_hb cadence is identical with the driver loaded and not. The starvation
#     was the modem's diag task with nothing draining the DIAG QRTR channel."
#   * `sleep 8` after starting rmtfs. Replaced with a real readiness condition:
#     rmtfs opens /dev/qcom_rmtfs_mem* once it is actually serving, so wait for
#     that instead of guessing. A sleep standing in for a condition is exactly
#     the bug class that made swclock-offset-boot lose its race with rtc-pm8xxx.
#
# Nothing here is idempotency-sensitive: every step is a no-op if already done,
# so it is safe to re-run.
set -u

log() { echo "taimen-modem-bringup: $*"; }

# Prefer the real service manager; fall back to running the daemon directly so
# this still works on a half-configured rootfs.
ensure_running() {
	svc=$1
	shift
	pgrep -x "$svc" >/dev/null 2>&1 && return 0

	if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
		systemctl start "$svc" >/dev/null 2>&1 && return 0
	elif [ -e "/etc/init.d/$svc" ] && command -v rc-service >/dev/null 2>&1; then
		rc-service "$svc" start >/dev/null 2>&1 && return 0
	fi

	log "starting $svc directly"
	setsid "$@" >"/tmp/$svc.log" 2>&1 </dev/null &
}

# True once rmtfs has the shared-memory device open, i.e. it is serving rather
# than merely started.
rmtfs_serving() {
	p=$(pgrep -x rmtfs 2>/dev/null | head -1)
	[ -n "$p" ] || return 1
	for fd in /proc/"$p"/fd/*; do
		case "$(readlink "$fd" 2>/dev/null)" in
			/dev/qcom_rmtfs_mem*) return 0 ;;
		esac
	done
	return 1
}

# 1. tqftpserv ruleset on tmpfs.
mkdir -p /tmp/tqftpserv/ota_firewall
touch /tmp/tqftpserv/ota_firewall/ruleset

# 2. rmtfs running AND serving before the MSS boots.
ensure_running rmtfs rmtfs -s -P -r
i=0
while [ $i -lt 60 ] && ! rmtfs_serving; do
	sleep 0.5
	i=$((i + 1))
done
if rmtfs_serving; then
	log "rmtfs serving after $(awk "BEGIN{print $i/2}")s"
else
	log "WARNING: rmtfs never opened qcom_rmtfs_mem; modem will boot without EFS"
fi

# 3. Start the MSS remoteproc if something has not already done it.
R=$(grep -l 4080000.remoteproc /sys/class/remoteproc/*/name 2>/dev/null | head -1)
if [ -n "$R" ]; then
	D=$(dirname "$R")
	if [ "$(cat "$D/state" 2>/dev/null)" != "running" ]; then
		log "starting MSS"
		echo start >"$D/state" 2>/dev/null || log "MSS start failed (already running?)"
	fi
fi

# 4. diag-router as soon as the WLAN PD gives us wlan0.
i=0
while [ $i -lt 60 ] && [ ! -e /sys/class/net/wlan0 ]; do
	sleep 1
	i=$((i + 1))
done
ensure_running diag-router diag-router

exit 0
