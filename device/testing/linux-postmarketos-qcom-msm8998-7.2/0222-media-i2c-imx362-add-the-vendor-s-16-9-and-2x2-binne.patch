 };
 
 static inline struct imx362 *to_imx362(struct v4l2_subdev *sd)
@@ -482,7 +714,11 @@ static int imx362_set_fmt(struct v4l2_subdev *sd,
 			  struct v4l2_subdev_format *fmt)
 {
 	struct imx362 *imx362 = to_imx362(sd);
-	const struct imx362_mode *mode = &imx362_modes[0];
+	const struct imx362_mode *mode;
+
+	mode = v4l2_find_nearest_size(imx362_modes, ARRAY_SIZE(imx362_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
 
 	mutex_lock(&imx362->lock);
 
@@ -501,6 +737,25 @@ static int imx362_set_fmt(struct v4l2_subdev *sd,
 		fmt->format = imx362->fmt;
 		__v4l2_ctrl_s_ctrl_int64(imx362->pixel_rate, mode->pixel_rate);
 		__v4l2_ctrl_s_ctrl(imx362->link_freq, 0);
+		__v4l2_ctrl_modify_range(imx362->hblank,
+					 mode->llp - mode->width,
+					 mode->llp - mode->width, 1,
+					 mode->llp - mode->width);
+		__v4l2_ctrl_modify_range(imx362->vblank,
+					 mode->fll_min - mode->height,
+					 IMX362_FLL_MAX - mode->height, 1,
+					 mode->fll - mode->height);
+		/* a new mode starts at its own frame rate, not the last one's */
+		__v4l2_ctrl_s_ctrl(imx362->vblank, mode->fll - mode->height);
+		/*
+		 * Unconditionally: the VBLANK handler only re-ranges exposure when
+		 * the value changes, and an exposure left longer than the new
+		 * frame makes the sensor stretch every frame to fit it -- 2016x1136
+		 * ran at 47 fps on res0's 3102-line maximum.
+		 */
+		__v4l2_ctrl_modify_range(imx362->exposure, IMX362_EXPOSURE_MIN,
+					 mode->fll - IMX362_EXPOSURE_MARGIN, 1,
+					 mode->fll - IMX362_EXPOSURE_MARGIN);
 	}
 
 	mutex_unlock(&imx362->lock);
@@ -560,6 +815,10 @@ static int imx362_set_ctrl(struct v4l2_ctrl *ctrl)
 		ret = imx362_write16(imx362, IMX362_REG_FRM_LENGTH,
 				     imx362->cur_mode->height + ctrl->val);
 		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = imx362_write16(imx362, IMX362_REG_TEST_PATTERN,
+				     ctrl->val);
+		break;
 	default:
 		break;
 	}
@@ -577,12 +836,29 @@ static int imx362_get_selection(struct v4l2_subdev *sd,
 				struct v4l2_subdev_state *state,
 				struct v4l2_subdev_selection *sel)
 {
+	struct imx362 *imx362 = to_imx362(sd);
+
 	switch (sel->target) {
 	case V4L2_SEL_TGT_CROP:
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY) {
+			const struct v4l2_mbus_framefmt *f =
+				v4l2_subdev_state_get_format(state, 0);
+
+			sel->r = v4l2_find_nearest_size(imx362_modes,
+							ARRAY_SIZE(imx362_modes),
+							width, height,
+							f->width,
+							f->height)->crop;
+			return 0;
+		}
+		mutex_lock(&imx362->lock);
+		sel->r = imx362->cur_mode->crop;
+		mutex_unlock(&imx362->lock);
+		return 0;
 	case V4L2_SEL_TGT_NATIVE_SIZE:
 	case V4L2_SEL_TGT_CROP_DEFAULT:
 	case V4L2_SEL_TGT_CROP_BOUNDS:
-		/* single full-array mode; PDAF rows are part of the output */
+		/* the full array; PDAF rows are part of res0's output */
 		sel->r.left = 0;
 		sel->r.top = 0;
 		sel->r.width = IMX362_NATIVE_WIDTH;
@@ -679,6 +955,7 @@ static const struct v4l2_subdev_internal_ops imx362_internal_ops = {
