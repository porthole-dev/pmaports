# Reference: <https://postmarketos.org/devicepkg>
maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=device-google-taimen
pkgdesc="Google Pixel 2 XL"
pkgver=0.1
pkgrel=7
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.mainline.conf
	modules-initfs.mainline
	sudoers-nopasswd
"
subpackages="
	$pkgname-kernel-mainline:kernel_mainline
	$pkgname-nonfree-firmware:nonfree_firmware
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# See the file's header: local bring-up convenience, not for upstream.
	install -Dm440 "$srcdir"/sudoers-nopasswd \
		"$pkgdir"/etc/sudoers.d/50-pmos-dev-nopasswd
}

kernel_mainline() {
	pkgdesc="Close to mainline kernel"
	depends="linux-postmarketos-qcom-msm8998 soc-qcom-msm8998"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

nonfree_firmware() {
	pkgdesc="Firmware for GPU zap shader, WiFi, Bluetooth, ADSP and SLPI"
	depends="firmware-google-taimen"
	mkdir "$subpkgdir"
}

