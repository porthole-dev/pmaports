+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "cc-nfc-page.h"
+
+#include <gio/gio.h>
+#include <gio/gdesktopappinfo.h>
+
+#define NEARD_BUS_NAME      "org.neard"
+#define NEARD_ADAPTER_IFACE "org.neard.Adapter"
+
+#define APP_PERMISSIONS_TABLE "devices"
+#define APP_PERMISSIONS_ID "nfc"
+
+/* Unlike the camera page, this switch is not backed by a GSetting. A camera
+ * cannot be powered off, so org.gnome.desktop.privacy disable-camera stands in
+ * for a switch the hardware does not have; an NFC adapter has a real one, and
+ * making it the single source of truth is what keeps the switch honest when
+ * something else changes the radio.
+ *
+ * The Permitted Apps list below is a separate concern: it is per-app grants
+ * from the freedesktop permission store (table "devices", id "nfc"), written
+ * by org.freedesktop.portal.NFC. "This app may use NFC" and "the radio is on
+ * right now" are different statements -- unlike the camera page's app rows,
+ * these are NOT driven from the radio switch.
+ */
+struct _CcNfcPage
+{
+  AdwNavigationPage parent_instance;
+
+  AdwSwitchRow *nfc_row;
+  GtkListBox   *nfc_apps_list_box;
+
+  GDBusObjectManager *manager;
+  GDBusProxy         *adapter;
+  GCancellable       *cancellable;
+  gboolean            syncing;
+
+  GDBusProxy   *perm_store;
+  GVariant     *nfc_apps_perms;
+  GVariant     *nfc_apps_data;
+  GHashTable   *nfc_app_switches;
+  GHashTable   *nfc_app_rows;
+
+  GtkSizeGroup *nfc_icon_size_group;
+};
+
+G_DEFINE_TYPE (CcNfcPage, cc_nfc_page, ADW_TYPE_NAVIGATION_PAGE)
+
+typedef struct {
+    CcNfcPage *self;
+    GtkWidget *widget;
+    gchar *app_id;
+    gboolean changing_state;
+    gboolean pending_state;
+} NfcAppStateData;
+
+static void
+nfc_app_state_data_free (NfcAppStateData *data, GClosure *closure)
+{
+    g_free (data->app_id);
+    g_slice_free (NfcAppStateData, data);
+}
+
+static void
+on_perm_store_set_done (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+    g_autoptr(GVariant) results = NULL;
+    g_autoptr(GError) error = NULL;
+    NfcAppStateData *data;
+
+    results = g_dbus_proxy_call_finish (G_DBUS_PROXY (source_object), res, &error);
+    if (results == NULL) {
+        if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+            g_warning ("Failed to store permissions: %s", error->message);
+        return;
+    }
+
+    data = (NfcAppStateData *) user_data;
+    data->changing_state = FALSE;
+    gtk_switch_set_state (GTK_SWITCH (data->widget), data->pending_state);
+}
+
+static gboolean
+on_nfc_app_state_set (GtkSwitch *widget, gboolean state, gpointer user_data)
+{
+    NfcAppStateData *data = (NfcAppStateData *) user_data;
+    GVariantBuilder builder;
+    CcNfcPage *self;
+    GVariantIter iter;
+    GVariant *params;
+    const gchar *key;
+    gchar **value;
+
+    self = data->self;
+
+    if (data->changing_state)
+        return TRUE;
+
+    data->changing_state = TRUE;
+    data->pending_state = state;
+
+    g_variant_iter_init (&iter, self->nfc_apps_perms);
+    g_variant_builder_init (&builder, G_VARIANT_TYPE_ARRAY);
+    while (g_variant_iter_loop (&iter, "{&s^a&s}", &key, &value)) {
+        gchar *tmp = NULL;
+
+        /* It's OK to drop the entry if it's not in expected format */
+        if (g_strv_length (value) != 1)
+            continue;
+
+        if (g_strcmp0 (data->app_id, key) == 0) {
+            tmp = value[0];
+            value[0] = state ? "yes" : "no";
+        }
+
+        g_variant_builder_add (&builder, "{s^as}", key, value);
+
+        if (tmp != NULL)
+            value[0] = tmp;
+    }
+
+    params = g_variant_new ("(sbsa{sas}v)", APP_PERMISSIONS_TABLE, TRUE, APP_PERMISSIONS_ID, &builder,
+                            self->nfc_apps_data);
+
+    g_dbus_proxy_call (self->perm_store, "Set", params, G_DBUS_CALL_FLAGS_NONE, -1, self->cancellable,
+                       on_perm_store_set_done, data);
+
+    return TRUE;
+}
+
+static void
+add_nfc_app (CcNfcPage *self, const gchar *app_id, gboolean enabled)
+{
+    g_autofree gchar *desktop_id = NULL;
+    NfcAppStateData *data;
+    g_autoptr(GDesktopAppInfo) app_info = NULL;
+    GtkWidget *row, *w;
+    GIcon *icon;
+
+    w = g_hash_table_lookup (self->nfc_app_switches, app_id);
+    if (w != NULL) {
+        gtk_switch_set_active (GTK_SWITCH (w), enabled);
+        return;
+    }
+
+    desktop_id = g_strdup_printf ("%s.desktop", app_id);
+    app_info = g_desktop_app_info_new (desktop_id);
+    if (!app_info)
+        return;
+
+    row = adw_action_row_new ();
+    gtk_list_box_append (self->nfc_apps_list_box, row);
+
+    icon = g_app_info_get_icon (G_APP_INFO (app_info));
+    w = gtk_image_new_from_gicon (icon);
+    gtk_image_set_icon_size (GTK_IMAGE (w), GTK_ICON_SIZE_LARGE);
+    gtk_widget_set_valign (w, GTK_ALIGN_CENTER);
+    gtk_size_group_add_widget (self->nfc_icon_size_group, w);
+    adw_action_row_add_prefix (ADW_ACTION_ROW (row), w);
+
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), g_app_info_get_name (G_APP_INFO (app_info)));
+
+    w = gtk_switch_new ();
+    gtk_switch_set_active (GTK_SWITCH (w), enabled);
+    gtk_widget_set_valign (w, GTK_ALIGN_CENTER);
+    adw_action_row_add_suffix (ADW_ACTION_ROW (row), w);
+    adw_action_row_set_activatable_widget (ADW_ACTION_ROW (row), w);
+
+    g_hash_table_insert (self->nfc_app_switches, g_strdup (app_id), g_object_ref (w));
+
+    g_hash_table_insert (self->nfc_app_rows, g_strdup (app_id), g_object_ref (row));
+
+    data = g_slice_new (NfcAppStateData);
+    data->self = self;
+    data->app_id = g_strdup (app_id);
+    data->widget = w;
+    data->changing_state = FALSE;
+    g_signal_connect_data (G_OBJECT (w), "state-set", G_CALLBACK (on_nfc_app_state_set), data,
+                           (GClosureNotify) nfc_app_state_data_free, 0);
+}
+
+/* Steals permissions and permissions_data references */
+static void
+update_perm_store (CcNfcPage *self, GVariant *permissions, GVariant *permissions_data)
+{
+    GVariantIter iter;
+    const gchar *key;
+    gchar **value;
+    GHashTableIter row_iter;
+    GtkWidget *row;
+
+    g_clear_pointer (&self->nfc_apps_perms, g_variant_unref);
+    self->nfc_apps_perms = permissions;
+    g_clear_pointer (&self->nfc_apps_data, g_variant_unref);
+    self->nfc_apps_data = permissions_data;
+
+    /* We iterate over all rows, if the permissions do not contain the app id of
+       the row, we remove it. */
+    g_hash_table_iter_init (&row_iter, self->nfc_app_rows);
+    while (g_hash_table_iter_next (&row_iter, (gpointer *) &key, (gpointer *) &row)) {
+        if (!g_variant_lookup_value (permissions, key, NULL)) {
+            gtk_list_box_remove (self->nfc_apps_list_box, row);
+            g_hash_table_remove (self->nfc_app_switches, key);
+            g_hash_table_iter_remove (&row_iter);
+        }
+    }
+
+    g_variant_iter_init (&iter, permissions);
+    while (g_variant_iter_loop (&iter, "{&s^a&s}", &key, &value)) {
+        gboolean enabled;
+
+        if (g_strv_length (value) != 1) {
+            g_debug ("Permissions for %s in incorrect format, ignoring..", key);
+            continue;
+        }
+
+        enabled = (g_strcmp0 (value[0], "no") != 0);
+
+        add_nfc_app (self, key, enabled);
+    }
+}
+
+static void
+on_perm_store_signal (GDBusProxy *proxy, gchar *sender_name, gchar *signal_name, GVariant *parameters,
+                      gpointer user_data)
+{
+    GVariant *permissions, *permissions_data;
+    g_autoptr(GVariant) boxed_permission_data = NULL;
+    g_autoptr(GVariant) table = NULL;
+    g_autoptr(GVariant) id = NULL;
+
+    if (g_strcmp0 (signal_name, "Changed") != 0)
+        return;
+
+    table = g_variant_get_child_value (parameters, 0);
+    id = g_variant_get_child_value (parameters, 1);
+
+    if (g_strcmp0 (g_variant_get_string (table, NULL), "devices") != 0
+        || g_strcmp0 (g_variant_get_string (id, NULL), "nfc") != 0)
+        return;
+
+    permissions = g_variant_get_child_value (parameters, 4);
+    boxed_permission_data = g_variant_get_child_value (parameters, 3);
+    permissions_data = g_variant_get_variant (boxed_permission_data);
+    update_perm_store (user_data, permissions, permissions_data);
+}
+
+static void
+on_perm_store_lookup_done (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+    CcNfcPage *self = user_data;
+    GVariant *ret, *permissions, *permissions_data;
+    g_autoptr(GVariant) boxed_permission_data = NULL;
+    g_autoptr(GError) error = NULL;
+
+    ret = g_dbus_proxy_call_finish (G_DBUS_PROXY (source_object), res, &error);
+    if (ret == NULL) {
+        if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+            g_warning ("Failed fetch permissions from flatpak permission store: %s", error->message);
+        return;
+    }
+
+    permissions = g_variant_get_child_value (ret, 0);
+    boxed_permission_data = g_variant_get_child_value (ret, 1);
+    permissions_data = g_variant_get_variant (boxed_permission_data);
+    update_perm_store (user_data, permissions, permissions_data);
+
+    g_signal_connect_object (source_object, "g-signal", G_CALLBACK (on_perm_store_signal), self, 0);
+}
+
+static void
+on_perm_store_ready (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+    CcNfcPage *self;
+    GVariant *params;
+    g_autoptr(GError) error = NULL;
+    GDBusProxy *proxy;
+
+    proxy = g_dbus_proxy_new_for_bus_finish (res, &error);
+    if (proxy == NULL) {
+        if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+            g_warning ("Failed to connect to flatpak permission store: %s", error->message);
+        return;
+    }
+    self = user_data;
+    self->perm_store = proxy;
+
+    params = g_variant_new ("(ss)", APP_PERMISSIONS_TABLE, APP_PERMISSIONS_ID);
+    g_dbus_proxy_call (self->perm_store, "Lookup", params, G_DBUS_CALL_FLAGS_NONE, -1, self->cancellable,
+                       on_perm_store_lookup_done, self);
+}
+
+static void
+sync_switch (CcNfcPage *self)
+{
+  g_autoptr(GVariant) powered = NULL;
+  gboolean active = FALSE;
+
+  if (self->adapter != NULL)
+    powered = g_dbus_proxy_get_cached_property (self->adapter, "Powered");
+
+  if (powered != NULL)
+    active = g_variant_get_boolean (powered);
+
+  /* Moving the switch ourselves must not be mistaken for the user moving it. */
+  self->syncing = TRUE;
+  adw_switch_row_set_active (self->nfc_row, active);
+  self->syncing = FALSE;
+}
+
+static void
+on_powered_set (GObject      *source_object,
+                GAsyncResult *res,
+                gpointer      user_data)
+{
+  g_autoptr(GVariant) reply = NULL;
+  g_autoptr(GError) error = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source_object),
+                                         res,
+                                         &error);
+  if (reply != NULL)
+    return;
+
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  g_warning ("Failed to change the NFC adapter power state: %s", error->message);
+
+  /* The radio did not move, so the switch must not claim it did. */
+  sync_switch (CC_NFC_PAGE (user_data));
+}
+
+static void
+on_switch_active (GObject    *object,
+                  GParamSpec *pspec,
+                  gpointer    user_data)
+{
+  CcNfcPage *self = user_data;
+  gboolean active;
+
+  if (self->syncing || self->adapter == NULL)
+    return;
+
+  active = adw_switch_row_get_active (self->nfc_row);
+
+  g_dbus_connection_call (g_dbus_proxy_get_connection (self->adapter),
+                          NEARD_BUS_NAME,
+                          g_dbus_proxy_get_object_path (self->adapter),
+                          "org.freedesktop.DBus.Properties",
+                          "Set",
+                          g_variant_new ("(ssv)",
+                                         NEARD_ADAPTER_IFACE,
+                                         "Powered",
+                                         g_variant_new_boolean (active)),
+                          NULL,
+                          G_DBUS_CALL_FLAGS_NONE,
+                          -1,
+                          self->cancellable,
+                          on_powered_set,
+                          self);
+}
+
+static void
+set_adapter (CcNfcPage  *self,
+             GDBusProxy *adapter)
+{
+  g_set_object (&self->adapter, adapter);
+
+  /* Nearly no machine has an NFC adapter. The row in the panel follows this
+     through a property binding, so a desktop never sees a dead entry. */
+  gtk_widget_set_visible (GTK_WIDGET (self), adapter != NULL);
+
+  sync_switch (self);
+}
+
+/* (transfer full) (nullable): the adapter at the lowest object path, so the
+   choice is deterministic on the rare machine that publishes more than
+   one -- GDBusObjectManager has no notion of path order on its own. */
+static GDBusProxy *
+find_adapter (GDBusObjectManager *manager)
+{
+  GList *objects = g_dbus_object_manager_get_objects (manager);
+  GDBusProxy *found = NULL;
+  const gchar *found_path = NULL;
+
+  for (GList *l = objects; l != NULL; l = l->next)
+    {
+      GDBusObject *object = G_DBUS_OBJECT (l->data);
+      GDBusInterface *iface = g_dbus_object_get_interface (object, NEARD_ADAPTER_IFACE);
+
+      if (iface == NULL)
+        continue;
+
+      if (found == NULL ||
+          g_strcmp0 (g_dbus_object_get_object_path (object), found_path) < 0)
+        {
+          g_clear_object (&found);
+          found = G_DBUS_PROXY (iface);
+          found_path = g_dbus_object_get_object_path (object);
+        }
+      else
+        {
+          g_object_unref (iface);
+        }
+    }
+
+  g_list_free_full (objects, g_object_unref);
+
+  return found;
+}
+
+static void
+on_object_added (GDBusObjectManager *manager,
+                 GDBusObject        *object,
+                 gpointer            user_data)
+{
+  CcNfcPage *self = user_data;
+  g_autoptr(GDBusInterface) iface = NULL;
+
+  if (self->adapter != NULL)
+    return;
+
+  iface = g_dbus_object_get_interface (object, NEARD_ADAPTER_IFACE);
+  if (iface != NULL)
+    set_adapter (self, G_DBUS_PROXY (iface));
+}
+
+static void
+on_object_removed (GDBusObjectManager *manager,
+                   GDBusObject        *object,
+                   gpointer            user_data)
+{
+  CcNfcPage *self = user_data;
+  g_autoptr(GDBusProxy) next = NULL;
+
+  if (self->adapter == NULL)
+    return;
+
+  if (g_strcmp0 (g_dbus_object_get_object_path (object),
+                 g_dbus_proxy_get_object_path (self->adapter)) != 0)
+    return;
+
+  next = find_adapter (manager);
+  set_adapter (self, next);
+}
+
+static void
+on_properties_changed (GDBusObjectManagerClient *manager,
+                       GDBusObjectProxy         *object_proxy,
+                       GDBusProxy               *interface_proxy,
+                       GVariant                 *changed_properties,
+                       const gchar * const      *invalidated_properties,
+                       gpointer                  user_data)
+{
+  CcNfcPage *self = user_data;
+
+  if (interface_proxy != self->adapter)
+    return;
+
+  /* The client has already updated the proxy's cached properties. */
+  sync_switch (self);
+}
+
+static void
+on_manager_ready (GObject      *source_object,
+                  GAsyncResult *res,
+                  gpointer      user_data)
+{
+  CcNfcPage *self;
+  GDBusObjectManager *manager;
+  g_autoptr(GDBusProxy) adapter = NULL;
+  g_autoptr(GError) error = NULL;
+
+  manager = g_dbus_object_manager_client_new_for_bus_finish (res, &error);
+  if (manager == NULL)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Failed to connect to neard: %s", error->message);
+      return;
+    }
+
+  self = user_data;
+  self->manager = manager;
+
+  g_signal_connect_object (manager, "object-added",
+                           G_CALLBACK (on_object_added), self, 0);
+  g_signal_connect_object (manager, "object-removed",
+                           G_CALLBACK (on_object_removed), self, 0);
+  g_signal_connect_object (manager, "interface-proxy-properties-changed",
+                           G_CALLBACK (on_properties_changed), self, 0);
+
+  adapter = find_adapter (manager);
+  set_adapter (self, adapter);
+}
+
+static void
+cc_nfc_page_finalize (GObject *object)
+{
+  CcNfcPage *self = CC_NFC_PAGE (object);
+
+  g_cancellable_cancel (self->cancellable);
+  g_clear_object (&self->cancellable);
+
+  g_clear_object (&self->adapter);
+  g_clear_object (&self->manager);
+
+  g_clear_object (&self->perm_store);
+  g_clear_object (&self->nfc_icon_size_group);
+  g_clear_pointer (&self->nfc_apps_perms, g_variant_unref);
+  g_clear_pointer (&self->nfc_apps_data, g_variant_unref);
+  g_clear_pointer (&self->nfc_app_switches, g_hash_table_unref);
+  g_clear_pointer (&self->nfc_app_rows, g_hash_table_unref);
+
+  G_OBJECT_CLASS (cc_nfc_page_parent_class)->finalize (object);
+}
+
+static void
+cc_nfc_page_class_init (CcNfcPageClass *klass)
+{
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = cc_nfc_page_finalize;
+
+  gtk_widget_class_set_template_from_resource (widget_class, "/org/gnome/control-center/privacy/nfc/cc-nfc-page.ui");
+
+  gtk_widget_class_bind_template_child (widget_class, CcNfcPage, nfc_row);
+  gtk_widget_class_bind_template_child (widget_class, CcNfcPage, nfc_apps_list_box);
+}
+
+static void
+cc_nfc_page_init (CcNfcPage *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  /* Hidden until neard says there is an adapter. */
+  gtk_widget_set_visible (GTK_WIDGET (self), FALSE);
+
+  self->cancellable = g_cancellable_new ();
+
+  g_signal_connect (self->nfc_row, "notify::active",
+                    G_CALLBACK (on_switch_active), self);
+
+  g_dbus_object_manager_client_new_for_bus (G_BUS_TYPE_SYSTEM,
+                                            G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_NONE,
+                                            NEARD_BUS_NAME,
+                                            "/",
+                                            NULL, NULL, NULL,
+                                            self->cancellable,
+                                            on_manager_ready,
+                                            self);
+
+  self->nfc_icon_size_group = gtk_size_group_new (GTK_SIZE_GROUP_BOTH);
+
+  self->nfc_app_switches = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+  self->nfc_app_rows = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
+
+  g_dbus_proxy_new_for_bus (
+      G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_NONE, NULL, "org.freedesktop.impl.portal.PermissionStore",
+      "/org/freedesktop/impl/portal/PermissionStore", "org.freedesktop.impl.portal.PermissionStore",
+      self->cancellable, on_perm_store_ready, self);
+}
