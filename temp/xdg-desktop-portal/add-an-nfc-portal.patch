-  g_hash_table_add (nfc->proxies, proxy);
-  g_subprocess_wait_async (proxy->subprocess, NULL,
-                           on_proxy_exited, g_object_ref (nfc));
+  /* Count and insert in one critical section, so that simultaneous calls
+   * cannot each pass the check above and then all insert. Arming the child
+   * watch belongs in here too: from the moment the table holds the proxy, a
+   * peer disconnect on the main context can free it, and proxy->subprocess
