# Tap -- a GTK4/libadwaita app that reads and writes NFC tags through
# org.freedesktop.portal.NFC. It exists to demonstrate that portal from the
# application side, and to be readable next to the two pieces it sits on:
# temp/xdg-desktop-portal (the portal) and temp/gnome-control-center (the
# switch and the Permitted Apps list).
#
# NOT a fork. This is the port's own application; it lives in temp/ because
# that is where this port stages packages that pmaports upstream does not
# have.
#
# TRAP: `porthole pkg build` reports "up-to-date" and skips the build when the
# content changed but pkgrel did not. Bump pkgrel on every rebuild, and check
# the artifact's mtime and hash rather than the exit code.
maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=tap
pkgver=0.1.0
pkgrel=24
pkgdesc="Read and write NFC tags"
url="https://github.com/porthole-dev/tap"
arch="all"
license="GPL-3.0-or-later"
# The app talks to xdg-desktop-portal and to nothing else. neard is not a
# dependency of this package on purpose: the portal is what reaches it, and
# an app that depended on the daemon would be admitting it might not.
depends="xdg-desktop-portal"
makedepends="
	blueprint-compiler
	desktop-file-utils
	gettext-dev
	glib-dev
	gtk4.0-dev
	libadwaita-dev
	meson
	"
checkdepends="appstream"
source="$pkgname-$pkgver.tar.gz::https://github.com/porthole-dev/tap/archive/refs/tags/v$pkgver.tar.gz"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
13e027edb46f77979ac55f9f424b62e6efe4c063013890a47d7abcac19dfcfdbc855083bc3ee6feac37da452eeac8961125825ffb6a370d1c05d7903d39b56e4  tap-0.1.0.tar.gz
"
