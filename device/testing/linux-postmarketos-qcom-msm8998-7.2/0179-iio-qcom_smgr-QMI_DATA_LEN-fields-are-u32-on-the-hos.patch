From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 29 Aug 2026 01:32:41 +0200
Subject: [PATCH] iio: qcom_smgr: QMI_DATA_LEN fields are u32 on the host

Every buffering request has failed with -EINVAL since 7.2, so no sensor whose
stream is armed that way reports anything -- light and proximity most visibly.
The driver is not at fault and nothing reaches the ADSP: qmi_encode() rejects
the message before it is sent.

fe099c387e06 ("soc: qcom: preserve CPU endianness for QMI_DATA_LEN") replaced
the width-aware read of the length field

	val8 = *(u8 *)buf_src;
	data_len_value = (u32)val8;

with an unconditional

	memcpy(&data_len_value, buf_src, sizeof(u32));

on the stated premise that QMI_DATA_LEN "is always of type u32 on the host".
This driver declared those fields as u8, so the read takes the three bytes
that follow -- for sns_smgr_buffering_req.item_len that is the head of
items[0] -- as the high bytes of the length. The result exceeds elem_len and
qmi_encode() returns -EINVAL. The decode path is the mirror image: it does
memcpy(buf_dst, &data_len_value, sizeof(u32)) and would scribble three bytes
past a u8 field, so responses and indications need the same width.

Widen all twelve host fields to u32 and, at the same time, write .elem_size
as the wire size explicitly instead of sizeof_field(). qmi_encode() derives
the on-wire width from it:

	data_len_sz = temp_ei->elem_size == sizeof(u8) ? sizeof(u8) : sizeof(u16);

so widening the field while leaving sizeof_field() in place would silently
promote every one of these from a one-byte to a two-byte length and corrupt
the messages a second time. drivers/soc/qcom/qcom_pdr_msg.c is the in-tree
pattern: u32 in the struct, sizeof(u8) in the ei_array.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../iio/common/qcom_smgr/qmi/qmi_sns_smgr.c   | 38 ++++++-------------
 .../iio/common/qcom_smgr/qmi/qmi_sns_smgr.h   | 24 ++++++------
 2 files changed, 24 insertions(+), 38 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.c b/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.c
index a6957cbf1087..9f705731844b 100644
--- a/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.c
@@ -23,8 +23,7 @@ static struct qmi_elem_info sns_smgr_all_sensor_info_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size =
-			sizeof_field(struct sns_smgr_all_sensor_info, type_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.offset = offsetof(struct sns_smgr_all_sensor_info, type_len),
 	},
@@ -54,8 +53,7 @@ struct qmi_elem_info sns_smgr_all_sensor_info_resp_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(struct sns_smgr_all_sensor_info_resp,
-					  item_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x03,
 		.offset = offsetof(struct sns_smgr_all_sensor_info_resp,
@@ -117,8 +115,7 @@ static struct qmi_elem_info sns_smgr_single_sensor_info_data_type_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_data_type, name_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_data_type,
 				   name_len),
@@ -134,9 +131,7 @@ static struct qmi_elem_info sns_smgr_single_sensor_info_data_type_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_data_type,
-			vendor_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_data_type,
 				   vendor_len),
@@ -215,8 +210,7 @@ static struct qmi_elem_info sns_smgr_single_sensor_info_native_sample_rates_ei[]
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_native_sample_rates, rate_count),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_native_sample_rates,
 				   rate_count),
@@ -248,8 +242,7 @@ struct qmi_elem_info sns_smgr_single_sensor_info_resp_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_resp, data_type_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x03,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_resp,
@@ -269,8 +262,7 @@ struct qmi_elem_info sns_smgr_single_sensor_info_resp_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_resp, data1_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x10,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_resp,
@@ -298,8 +290,7 @@ struct qmi_elem_info sns_smgr_single_sensor_info_resp_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_resp, data3_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x12,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_resp,
@@ -317,9 +308,7 @@ struct qmi_elem_info sns_smgr_single_sensor_info_resp_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_resp,
-			native_sample_rates_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x13,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_resp,
@@ -339,8 +328,7 @@ struct qmi_elem_info sns_smgr_single_sensor_info_resp_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(
-			struct sns_smgr_single_sensor_info_resp, data5_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x14,
 		.offset = offsetof(struct sns_smgr_single_sensor_info_resp,
@@ -469,8 +457,7 @@ struct qmi_elem_info sns_smgr_buffering_req_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size =
-			sizeof_field(struct sns_smgr_buffering_req, item_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x04,
 		.offset = offsetof(struct sns_smgr_buffering_req, item_len),
@@ -654,8 +641,7 @@ struct qmi_elem_info sns_smgr_buffering_report_ind_ei[] = {
 	{
 		.data_type = QMI_DATA_LEN,
 		.elem_len = 1,
-		.elem_size = sizeof_field(struct sns_smgr_buffering_report_ind,
-					  samples_len),
+		.elem_size = sizeof(u8),
 		.array_type = NO_ARRAY,
 		.tlv_type = 0x03,
 		.offset = offsetof(struct sns_smgr_buffering_report_ind,
diff --git a/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.h b/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.h
index 5dc8b394117f..59c765153641 100644
--- a/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.h
+++ b/drivers/iio/common/qcom_smgr/qmi/qmi_sns_smgr.h
@@ -44,13 +44,13 @@ enum sns_smgr_buffering_action {
 
 struct sns_smgr_all_sensor_info {
 	u8 id;
-	u8 type_len;
+	u32 type_len;
 	char type[SNS_SMGR_SENSOR_TYPE_MAX_LEN];
 };
 
 struct sns_smgr_all_sensor_info_resp {
 	u16 result;
-	u8 item_len;
+	u32 item_len;
 	struct sns_smgr_all_sensor_info items[SNS_SMGR_ALL_SENSOR_INFO_MAX_LEN];
 };
 
@@ -61,9 +61,9 @@ struct sns_smgr_single_sensor_info_req {
 struct sns_smgr_single_sensor_info_data_type {
 	u8 sensor_id;
 	u8 data_type;
-	u8 name_len;
+	u32 name_len;
 	char name[0xff];
-	u8 vendor_len;
+	u32 vendor_len;
 	char vendor[0xff];
 	/*
 	 * Might be separate u8 or u16 fields, but taken as a u32 it is seen
@@ -78,23 +78,23 @@ struct sns_smgr_single_sensor_info_data_type {
 };
 
 struct sns_smgr_single_sensor_info_native_sample_rates {
-	u8 rate_count;
+	u32 rate_count;
 	u16 rates[SNS_SMGR_NATIVE_SAMPLE_RATES_MAX_LEN];
 };
 
 struct sns_smgr_single_sensor_info_resp {
 	u16 result;
-	u8 data_type_len;
+	u32 data_type_len;
 	struct sns_smgr_single_sensor_info_data_type data_types[SNS_SMGR_DATA_TYPE_COUNT];
-	u8 data1_len;
+	u32 data1_len;
 	u32 data1[SNS_SMGR_DATA_TYPE_COUNT];
 	u32 data2;
-	u8 data3_len;
+	u32 data3_len;
 	u64 data3[SNS_SMGR_DATA_TYPE_COUNT];
-	u8 native_sample_rates_len;
+	u32 native_sample_rates_len;
 	struct sns_smgr_single_sensor_info_native_sample_rates
 		native_sample_rates[SNS_SMGR_DATA_TYPE_COUNT];
-	u8 data5_len;
+	u32 data5_len;
 	u32 data5[SNS_SMGR_DATA_TYPE_COUNT];
 };
 
@@ -115,7 +115,7 @@ struct sns_smgr_buffering_req {
 	u8 report_id;
 	u8 action;
 	u32 report_rate;
-	u8 item_len;
+	u32 item_len;
 	struct sns_smgr_buffering_req_item items[SNS_SMGR_DATA_TYPE_COUNT];
 	u8 notify_suspend_valid;
 	struct sns_smgr_buffering_req_notify_suspend notify_suspend;
@@ -144,7 +144,7 @@ struct sns_smgr_buffering_report_sample {
 struct sns_smgr_buffering_report_ind {
 	u8 report_id;
 	struct sns_smgr_buffering_report_metadata metadata;
-	u8 samples_len;
+	u32 samples_len;
 	struct sns_smgr_buffering_report_sample samples[SNS_SMGR_SAMPLES_MAX_LEN];
 	u8 val2;
 };
