From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Fri, 11 Sep 2026 23:41:13 +0200
Subject: [PATCH] misc: add fpc1020 driver for the FPC1020/FPC1270 fingerprint
 sensor

Power, reset and interrupt only, modelled on the vendor's own
drivers/misc/fpc1020_platform_tee.c but written for mainline: gpiod
consumer API, dev_err_probe(), devm_ everywhere, one sysfs attribute
instead of six.

The interrupt line is exposed as a LATCH, not a raw GPIO level: the ISR
sets a flag and calls sysfs_notify(); reading "irq" returns the latch;
any write clears it. A stateless level mirror (plain gpiod_get_value())
does not fit the sensor's own protocol -- decompiling taimen's shipped
HAL (android.hardware.biometrics.fingerprint@2.1-service.fpc,
fpc_irq_wait()) showed it opens this same "irq" sysfs attribute, reads
one byte, returns immediately if it already matches the wanted value,
and otherwise polls (POLLPRI|POLLERR) and writes back after waking --
a write-after-poll pattern only a latch, not a level mirror, explains.
On a line that idles high, a level mirror would report "already true"
forever and the wait would never block.

devicetree: a fingerprint@0 node under &soc, compatible "fpc,fpc1020",
reset-gpios on tlmm 128, an interrupt on tlmm 86, vdd-io-supply on
vreg_s4a_1p8 (the vendor's pm8998_s4). Pinctrl states carry the
vendor's own bias (drive-strength 2, bias-pull-down on the interrupt
pin, bias-disable on reset) -- values a bare probe module could never
apply (gpiod_set_config() returns -ENOTSUPP with no DT consumer node
to resolve a named state against), which is the whole reason this
needs a devicetree node rather than another kernel-module workaround.
vcc_spi-supply and vdd_ana-supply are commented out in the vendor's
own taimen node and are not invented here either.

This driver sends the sensor no commands at all, matching the vendor
driver's own stated discipline: arming and every protocol command stay
the trustlet's job over the SCM transport already in place. The SPI
pads (gpio 81-84) are fenced by a signed devcfg and are neither
described nor touched here.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../boot/dts/qcom/msm8998-google-taimen.dts   |  60 +++++
 drivers/misc/Kconfig                          |  15 ++
 drivers/misc/Makefile                         |   1 +
 drivers/misc/fpc1020.c                        | 206 ++++++++++++++++++
 4 files changed, 282 insertions(+)
 create mode 100644 drivers/misc/fpc1020.c

diff --git a/arch/arm64/boot/dts/qcom/msm8998-google-taimen.dts b/arch/arm64/boot/dts/qcom/msm8998-google-taimen.dts
index 78b35ca9053a..130da3c782cf 100644
--- a/arch/arm64/boot/dts/qcom/msm8998-google-taimen.dts
+++ b/arch/arm64/boot/dts/qcom/msm8998-google-taimen.dts
@@ -332,6 +332,40 @@ touchscreen@49 {
 	};
 };
 
+/*
+ * Fingerprint sensor: an FPC1270 + FPC2050 companion chip, match-on-chip,
+ * talking to a TrustZone trustlet over SPI the AP cannot see (the SPI
+ * pads, tlmm 81-84, are fenced by a signed devcfg and are not described
+ * here or touched by fpc1020.c). This node covers only what the AP
+ * genuinely owns: reset (tlmm 128), the interrupt (tlmm 86), and the IO
+ * supply.
+ *
+ * GPIOs and the supply are the vendor's own
+ * (msm8998-taimen-fingerprint.dtsi): fpc,gpio_rst = tlmm 128,
+ * fpc,gpio_irq = tlmm 86 (interrupts = <86 0x0>, i.e. no explicit
+ * trigger type recorded -- fpc1020_platform_tee.c's probe() arms it
+ * IRQF_TRIGGER_RISING regardless of the DT interrupt flags, and that
+ * value is used here too). vcc_spi-supply and vdd_ana-supply are
+ * commented out in the vendor's own taimen node -- not invented here
+ * either; vdd_io-supply = pm8998_s4 (mainline label vreg_s4a_1p8, the
+ * same rail the codec and UFS already use) is the only supply this
+ * board actually wires up in software.
+ */
+&soc {
+	fingerprint@0 {
+		compatible = "fpc,fpc1020";
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <86 IRQ_TYPE_EDGE_RISING>;
+
+		reset-gpios = <&tlmm 128 GPIO_ACTIVE_HIGH>;
+		vdd-io-supply = <&vreg_s4a_1p8>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&fpc1020_reset_default &fpc1020_irq_default>;
+	};
+};
+
 /*
  * NFC. The controller is an NXP PN553-family part; the vendor devicetree
  * describes it as "qcom,nq-nci" on i2c_8, which is BLSP2 QUP2 (i2c@c1b6000)
@@ -592,6 +626,32 @@ nfc_firm_active: nfc-firm-active {
 		drive-strength = <6>;
 		bias-disable;
 	};
+
+	/*
+	 * Fingerprint sensor. Values are the vendor's
+	 * (msm8998-taimen-fingerprint.dtsi, msm_gpio_128 / msm_gpio_86):
+	 * reset actively driven (bias-disable, a pull would be pointless
+	 * on an output), interrupt pulled down (bias-pull-down) so it
+	 * does not float between the sensor powering up and driving it.
+	 * This bias is exactly what could not be applied from a bare
+	 * probe module (gpiod_set_config() returns -ENOTSUPP with no DT
+	 * consumer node to resolve a named pinctrl state against) --
+	 * the whole reason this needs a devicetree node instead of a
+	 * kernel-module workaround.
+	 */
+	fpc1020_reset_default: fpc1020-reset-default {
+		pins = "gpio128";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	fpc1020_irq_default: fpc1020-irq-default {
+		pins = "gpio86";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
 };
 
 /*
diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 6841070b10b5..06d49e0bfe22 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -660,4 +660,19 @@ source "drivers/misc/mchp_pci1xxxx/Kconfig"
 source "drivers/misc/keba/Kconfig"
 source "drivers/misc/amd-sbi/Kconfig"
 source "drivers/misc/rp1/Kconfig"
+
+config FPC1020
+	tristate "FPC1020/FPC1270 fingerprint sensor power/reset/irq driver"
+	depends on OF && GPIOLIB
+	help
+	  Say Y here to support the power, reset and interrupt handling for
+	  an FPC1020 or FPC1270 match-on-chip fingerprint sensor wired to a
+	  TrustZone trustlet over SPI. This driver does not talk to the
+	  sensor itself -- it owns the IO supply, the reset line and the
+	  interrupt only, and exposes the interrupt to userspace as a
+	  latched sysfs attribute.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called fpc1020.
+
 endmenu
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index f543df9a8e23..555a04b3cdad 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -75,3 +75,4 @@ obj-$(CONFIG_MCHP_LAN966X_PCI)	+= lan966x-pci.o
 obj-y				+= keba/
 obj-y				+= amd-sbi/
 obj-$(CONFIG_MISC_RP1)		+= rp1/
+obj-$(CONFIG_FPC1020)		+= fpc1020.o
diff --git a/drivers/misc/fpc1020.c b/drivers/misc/fpc1020.c
new file mode 100644
index 000000000000..bb6c90d1bd22
--- /dev/null
+++ b/drivers/misc/fpc1020.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * FPC1020/FPC1270 fingerprint sensor -- power, reset and interrupt.
+ *
+ * This driver owns exactly three things: the sensor's IO supply, its
+ * reset line, and its interrupt. It sends the sensor no commands at all:
+ * that is the job of the TrustZone trustlet the sensor's SPI bus is
+ * wired to (TrustZone owns the SPI pads; this driver's pads are the
+ * reset and interrupt lines only, and neither is fenced). Matches the
+ * discipline stated outright in the vendor driver this was modelled on,
+ * drivers/misc/fpc1020_platform_tee.c (FPC AB, GPL-2.0): "This driver
+ * will NOT send any commands to the sensor it only controls the
+ * electrical parts."
+ *
+ * The interrupt line (FP_INT_N) is active-low in name but the vendor
+ * arms it IRQF_TRIGGER_RISING, once, for the device's whole lifetime --
+ * not re-armed per touch -- and taimen's own shipped HAL (decompiled,
+ * see the port's bring-up notes) waits on a *latched* status through a
+ * sysfs "irq" attribute: reading it returns the latch, not a raw GPIO
+ * level, and any write clears the latch so the next edge can set it
+ * again. A stateless level mirror does not fit that protocol -- it
+ * would report "already true" forever on a line that idles high and
+ * the sensor's own HAL would never block. So the latch is the point of
+ * this driver, not an incidental detail: it is the one thing a bare
+ * GPIO read from outside the kernel cannot reproduce.
+ *
+ * Copyright (C) 2026 Giuseppe Maggio <jertlok@proton.me>
+ */
+
+#include <linux/atomic.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/sysfs.h>
+
+/* hw_reset() timings, from the vendor driver, unchanged: reset ACTIVE
+ * (high), a short settle, RESET (low), a longer settle, ACTIVE again.
+ * The vendor's own comment applies here too: chip select cannot be
+ * driven from a platform driver, so the trustlet still needs to do its
+ * own soft reset over SPI after this pulse brings the part out of
+ * electrical reset -- this driver only does the electrical part.
+ */
+#define FPC1020_RESET_HIGH1_US_MIN	100
+#define FPC1020_RESET_HIGH1_US_MAX	200
+#define FPC1020_RESET_LOW_US_MIN	5000
+#define FPC1020_RESET_LOW_US_MAX	5100
+#define FPC1020_RESET_HIGH2_US_MIN	5000
+#define FPC1020_RESET_HIGH2_US_MAX	5100
+
+struct fpc1020 {
+	struct device *dev;
+	struct gpio_desc *reset_gpio;
+	struct regulator *vdd_io;
+	int irq;
+	/*
+	 * The latch: set by the ISR, cleared by any write to the "irq"
+	 * sysfs attribute. This is what userspace polls -- not
+	 * gpiod_get_value() -- see the file header.
+	 */
+	atomic_t latched;
+};
+
+static irqreturn_t fpc1020_irq_handler(int irq, void *data)
+{
+	struct fpc1020 *fpc1020 = data;
+
+	atomic_set(&fpc1020->latched, 1);
+	sysfs_notify(&fpc1020->dev->kobj, NULL, "irq");
+
+	return IRQ_HANDLED;
+}
+
+static ssize_t irq_show(struct device *dev, struct device_attribute *attr,
+			char *buf)
+{
+	struct fpc1020 *fpc1020 = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", atomic_read(&fpc1020->latched));
+}
+
+/* Any write clears/re-arms the latch. The value written is not
+ * inspected -- only the act of writing matters, matching what the
+ * sensor's own HAL protocol does after every wakeup. */
+static ssize_t irq_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct fpc1020 *fpc1020 = dev_get_drvdata(dev);
+
+	atomic_set(&fpc1020->latched, 0);
+
+	return count;
+}
+static DEVICE_ATTR_RW(irq);
+
+static struct attribute *fpc1020_attrs[] = {
+	&dev_attr_irq.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(fpc1020);
+
+static void fpc1020_hw_reset(struct fpc1020 *fpc1020)
+{
+	gpiod_set_value_cansleep(fpc1020->reset_gpio, 1);
+	usleep_range(FPC1020_RESET_HIGH1_US_MIN, FPC1020_RESET_HIGH1_US_MAX);
+
+	gpiod_set_value_cansleep(fpc1020->reset_gpio, 0);
+	usleep_range(FPC1020_RESET_LOW_US_MIN, FPC1020_RESET_LOW_US_MAX);
+
+	gpiod_set_value_cansleep(fpc1020->reset_gpio, 1);
+	usleep_range(FPC1020_RESET_HIGH2_US_MIN, FPC1020_RESET_HIGH2_US_MAX);
+}
+
+static void fpc1020_disable_regulator(void *data)
+{
+	regulator_disable(data);
+}
+
+static int fpc1020_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct fpc1020 *fpc1020;
+	int ret;
+
+	fpc1020 = devm_kzalloc(dev, sizeof(*fpc1020), GFP_KERNEL);
+	if (!fpc1020)
+		return -ENOMEM;
+
+	fpc1020->dev = dev;
+	platform_set_drvdata(pdev, fpc1020);
+	atomic_set(&fpc1020->latched, 0);
+
+	fpc1020->vdd_io = devm_regulator_get(dev, "vdd-io");
+	if (IS_ERR(fpc1020->vdd_io))
+		return dev_err_probe(dev, PTR_ERR(fpc1020->vdd_io),
+				     "failed to get vdd-io\n");
+
+	ret = regulator_enable(fpc1020->vdd_io);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable vdd-io\n");
+
+	ret = devm_add_action_or_reset(dev, fpc1020_disable_regulator,
+				       fpc1020->vdd_io);
+	if (ret)
+		return ret;
+
+	/* GPIOD_OUT_HIGH: the sensor's normal operating state (out of
+	 * reset) is where probe should leave it if it does nothing else. */
+	fpc1020->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(fpc1020->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(fpc1020->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	fpc1020->irq = platform_get_irq(pdev, 0);
+	if (fpc1020->irq < 0)
+		return fpc1020->irq;
+
+	fpc1020_hw_reset(fpc1020);
+
+	ret = devm_request_threaded_irq(dev, fpc1020->irq, NULL,
+					fpc1020_irq_handler,
+					IRQF_TRIGGER_RISING | IRQF_ONESHOT,
+					dev_name(dev), fpc1020);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request irq\n");
+
+	device_init_wakeup(dev, true);
+	ret = enable_irq_wake(fpc1020->irq);
+	if (ret)
+		dev_warn(dev, "failed to enable irq wake: %d\n", ret);
+
+	return 0;
+}
+
+static void fpc1020_remove(struct platform_device *pdev)
+{
+	struct fpc1020 *fpc1020 = platform_get_drvdata(pdev);
+
+	disable_irq_wake(fpc1020->irq);
+	device_init_wakeup(&pdev->dev, false);
+}
+
+static const struct of_device_id fpc1020_of_match[] = {
+	{ .compatible = "fpc,fpc1020" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fpc1020_of_match);
+
+static struct platform_driver fpc1020_driver = {
+	.driver = {
+		.name = "fpc1020",
+		.of_match_table = fpc1020_of_match,
+		.dev_groups = fpc1020_groups,
+	},
+	.probe = fpc1020_probe,
+	.remove = fpc1020_remove,
+};
+module_platform_driver(fpc1020_driver);
+
+MODULE_AUTHOR("Giuseppe Maggio <jertlok@proton.me>");
+MODULE_DESCRIPTION("FPC1020/FPC1270 fingerprint sensor power/reset/irq driver");
+MODULE_LICENSE("GPL");
