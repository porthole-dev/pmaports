+			regulator-max-microvolt = <3312000>;
+		};
+		vreg_l26a_1p2: l26 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-allow-set-load;
+		};
+		vreg_l28_3p0: l28 {
+			regulator-min-microvolt = <3008000>;
+			regulator-max-microvolt = <3008000>;
+		};
+
+		vreg_lvs1a_1p8: lvs1 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		vreg_lvs2a_1p8: lvs2 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+	};
+
+	pmi8998-regulators {
+		compatible = "qcom,rpm-pmi8998-regulators";
+
+		vdd_bob-supply = <&vph_pwr>;
+
+		vreg_bob: bob {
+			regulator-min-microvolt = <3312000>;
+			regulator-max-microvolt = <3600000>;
+		};
+	};
+};
+
+&mmcc {
+	status = "okay";
+};
+
+&mmss_smmu {
+	status = "okay";
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_mdp {
+	status = "okay";
+};
+
+&dsi0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	vdd-supply = <&vreg_l1a_0p875>;
+	vdda-supply = <&vreg_l2a_1p2>;
+
+	panel: panel@0 {
+		reg = <0>;
+
+		reset-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
+		/*
+		 * TE is gpio11 on taimen, NOT gpio10: the factory dtbo's panel
+		 * pinctrl (docs/panel-sw43402-vendor.txt, extracted from
+		 * entry 12) configures gpio11, and with gpio10 muxed the DPU
+		 * tearcheck line counter provably free-runs (never resets) --
+		 * kickoffs were pseudo-randomly phased against the panel scan,
+		 * which is what produced the scroll-time tear lines. gpio10
+		 * and gpio11 are the two mdp_vsync_a-capable pads, and
+		 * qcom,mdss-dsi-te-pin-select = <1> in the vendor DT picks
+		 * the second one.
+		 */
+		disp-te-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&panel_ldo_vddio_supply>;
+		vpnl-supply = <&panel_ldo_vpnl_supply>;
+
+		/*
+		 * LAB/IBB are the OLED emission rails (positive AVDD and
+		 * inverting AVEE). vddio/vpnl only power the DDIC's logic, so
+		 * without these the panel initialises, accepts frames, scans
+		 * and reports display-on -- while emitting no light at all.
+		 * The stock DT hangs them off the DSI controller node; the
+		 * panel is the actual consumer, so they go here.
+		 */
+		lab-supply = <&lab>;
+		ibb-supply = <&ibb>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&panel_reset_n &disp_en_default &mdp_vsync_n>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dsi0_out>;
+			};
+		};
+	};
+};
+
+&dsi0_phy {
+	status = "okay";
+	vdds-supply = <&vreg_l1a_0p875>;
+};
+
+&dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+/* Adreno 540 GPU */
+&gpucc {
+	status = "okay";
+};
+
+&gpu_mem {
+	compatible = "shared-dma-pool";
+};
+
+&adreno_gpu {
+	status = "okay";
+
+	/*
+	 * The core rail. With this wired, adreno attaches it to the OPP table
+	 * (see adreno_get_pwrlevels()) and dev_pm_opp_set_rate() scales
+	 * vdd_gfx with frequency using the opp-microvolt ceilings -- which is
+	 * what makes the full 515-710 MHz range usable. The four upper OPPs
+	 * were previously /delete-node/'d here exactly because nothing managed
+	 * this regulator.
+	 */
+	vdd-supply = <&pm8005_s1>;
+
+	zap-shader {
+		memory-region = <&zap_shader_region>; // gpu_mem?
+		firmware-name = "qcom/msm8998/wahoo/a540_zap.mbn";
+	};
+};
+
+&adreno_smmu {
+	status = "okay";
+};
+
+/*
+ * HACK: Shoot GPU voltage high to stabilize Adreno 540 at high frequencies
+ *       until the GPU CPR is brought up.
+ */
+&pm8005_s1 {
+	regulator-min-microvolt = <988000>; /* 0,524V -> 0,988V */
+	//regulator-max-microvolt = <1100000>;
+};
+
+&tlmm {
+	gpio-reserved-ranges = <0 4>, <81 4>;
+
+	disp_en_default: disp-en {
+		pins = "gpio62";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	panel_reset_n: panel-rst-n {
+		pins = "gpio94";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	panel_int_err: panel-int-err {
+		pins = "gpio11";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	mdp_vsync_n: mdp-vsync-n {
+		/* gpio11, not gpio10 -- see disp-te-gpios */
+		pins = "gpio11";
+		function = "mdp_vsync_a";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+/*
+ * The device does contain a USB3 capable type-c port,
+ * however it doesn't seem to work when superspeed mode is
+ * enabled.
+ */
+&usb3 {
+	status = "okay";
+
+	/* Operate "GCC_USB30_MASTER_CLK" in HS mode (>=60 MHz) */
+	assigned-clock-rates = <19200000>, <60000000>;
+
+	/* Disable USB3 pipe_clk requirement */
+	qcom,select-utmi-as-pipe-clk;
+};
+
+&usb3_dwc3 {
+	/* Drop USB 3 SuperSpeed PHY to bring up the "usb0" interface */
+	phys = <&qusb2phy>;
+	phy-names = "usb2-phy";
+
+	/* We can only operate at USB 2.0 speeds */
+	maximum-speed = "high-speed";
+
+	/* Force to peripheral until we have Type-C hooked up */
+	dr_mode = "peripheral";
+};
+
+&ufshc {
+	status = "okay";
+
+	vcc-supply = <&vreg_l20a_2p95>;
+	vccq-supply = <&vreg_l26a_1p2>;
+	vccq2-supply = <&vreg_s4a_1p8>;
+	vcc-max-microamp = <750000>;
+	vccq-max-microamp = <560000>;
+	vccq2-max-microamp = <750000>;
+};
+
+&ufsphy {
+	status = "okay";
+
+	vdda-phy-supply = <&vreg_l1a_0p875>;
+	vdda-pll-supply = <&vreg_l2a_1p2>;
+	vddp-ref-clk-supply = <&vreg_l26a_1p2>;
+	vdda-phy-max-microamp = <51400>;
+	vdda-pll-max-microamp = <14600>;
+	vddp-ref-clk-max-microamp = <100>;
+	vddp-ref-clk-always-on;
+};
+
+/*
+ * The modem's WLAN datapath on msm8998 is IPA-integrated (downstream's icnss
+ * node carries an smmu_iova_ipa region, and the AP side is the modem's
+ * handshake peer over the ipa smp2p pair). Everything the node needs is
+ * already in msm8998.dtsi; it was simply never enabled. modem-init: the modem
+ * loads the GSI firmware on this platform, so no AP-side ipa_fws is needed.
+ *
+ * This was originally enabled on the theory that a missing AP-side IPA peer
+ * was starving the WLAN PD (dog_hb.c:266). That theory is WRONG -- measured
+ * both ways on 2026-07-28, the dog_hb cadence is identical with the driver
+ * loaded and not. The starvation was the modem's diag task with nothing
+ * draining the DIAG QRTR channel; running diag-router fixes it. Keep IPA
+ * enabled anyway: it is correct for the platform and tracks the modem
+ * lifecycle properly.
+ */
+&ipa {
+	status = "okay";
+
+	/*
+	 * The AP loads the GSI firmware here, as msm8998-oneplus-common.dtsi
+	 * already does on this SoC -- NOT modem-init. With modem-init the modem
+	 * is supposed to initialise GSI and raise the "ipa-setup-ready" smp2p
+	 * interrupt; on wahoo that interrupt never arrives, so ipa_qmi_ready()
+	 * never fires, ipa_modem_start() is never called and the rmnet netdev
+	 * is never created. Without that netdev nothing matches
+	 * ModemManager's 77-mm-qcom-soc.rules (SUBSYSTEM=="net",
+	 * DRIVERS=="ipa"), so no modem object is ever exposed.
+	 *
+	 * The vendor ships qcom/msm8998/wahoo/ipa_fws.mbn, and its ELF program
+	 * headers are based at paddr 0 spanning 0x7000, i.e. fully relocatable,
+	 * so qcom_mdt_load places it wherever memory-region points. ipa_fw_mem
+	 * is 0x10000 at 0x95200000 and /proc/iomem confirms 95200000-95214fff
+	 * is reserved and otherwise unused on this device.
+	 */
+	memory-region = <&ipa_fw_mem>;
+	firmware-name = "qcom/msm8998/wahoo/ipa_fws.mbn";
+};
+
+&wifi {
+	status = "okay";
+
+	/*
+	 * The fixed MSA carveout is REQUIRED on wahoo: the dynamic
+	 * dmam_alloc fallback (stock-icnss-style, works on oneplus/sagit)
+	 * was tried 2026-07-28 and this device's WLAN firmware rejects it
+	 * ("msa info req rejected: 68") -- Google's build bakes the fixed
+	 * address. The bootloader-garbage-in-carveout theory for the
+	 * halphy_caldb first-scan assert is instead tested via the
+	 * ath10k.msa_zero param (SCM-mediated zeroing in qmi.c). Never
+	 * memset this region without owning it first: a raw probe-time
+	 * memset hard-bricked a boot (2026-07-26).
+	 */
+
+	/*
+	 * Deliberately NOT setting qcom,no-msa-ready-indicator. This firmware
+	 * does send the MSA_READY indication - we see it arrive - so honouring
+	 * it is correct, and it makes this node identical to the other msm8998
+	 * boards whose WiFi works (oneplus-common, sagit, fxtec-pro1, mtp).
+	 *
+	 * The property was set earlier on the theory that the indication handler
+	 * (fetch board file, then bdf_dnld) was resetting the SoC. That was
+	 * wrong: this tree's ath10k had a local hack calling the same handler
+	 * unconditionally right after server_arrive, so the board file was being
+	 * pushed anyway - just ~5 ms early, before the firmware said it was
+	 * ready. The resets of that era were the crash-looping modem.
+	 */
+	/*
+	 * This board's WLAN firmware has no calibration above channel 165, but
+	 * ath10k_5ghz_channels[] offers 169 (5845 MHz) and 173 (5865 MHz), and
+	 * ath applies its own REGULATORY_CUSTOM_REG domain, so wireless-regdb
+	 * never gets to drop them.
+	 *
+	 * The firmware scans channels in pairs. Once 165 and 169 land in the
+	 * same pair -- which they always do on an unrestricted scan, as the last
+	 * two entries -- the WLAN PD dies with
+	 *   halphy_caldb.c:2822:Assertion 0 failed
+	 * and the following ath10k re-attach usually fails "capability req
+	 * rejected: 119", leaving the radio down until reboot. A scan of just
+	 * those two channels reproduces it; either one alone is harmless.
+	 *
+	 * Cap the usable spectrum at 5835 MHz. A channel survives only if 20 MHz
+	 * centred on it fits a range, so this keeps channel 165 (5815-5835) and
+	 * drops 169 and 173. 5150 MHz is the low edge of channel 36.
+	 */
+	ieee80211-freq-limit = <2400000 2500000>,
+			       <5150000 5835000>;
+
+	vdd-0.8-cx-mx-supply = <&vreg_l5a_0p8>;
+	vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
+	vdd-1.3-rfa-supply = <&vreg_l17a_1p3>;
+	vdd-3.3-ch0-supply = <&vreg_l25a_3p3>;
+};
+
+/*
+ * Battery / charging. The per-device cell parameters live in the board .dts,
+ * since taimen and walleye do not share a battery.
+ */
+&pmi8998_rradc {
+	/* Not optional: pmi8998_charger takes usbin_i/usbin_v from here. */
+	status = "okay";
+};
+
+&pmi8998_fg {
+	status = "okay";
+};
+
+&pmi8998_charger {
+	status = "okay";
+
+	monitored-battery = <&wahoo_batt>;
+};
