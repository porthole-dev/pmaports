diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 000000000..c14419fc0
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Lens shading correction for the GPU software ISP
+ *
+ * The tuning file carries one grid of per-channel gains spanning the sensor's
+ * active area edge to edge, row major, top row first:
+ *
+ *   - Lsc:
+ *       grid: [ 17, 13 ]
+ *       strength: 1.0        # 0 = off, 1 = the full gains
+ *       r: [ ... ]
+ *       g: [ ... ]
+ *       b: [ ... ]
+ *
+ * The GPU debayer applies it after black level subtraction. The CPU debayer
+ * does not apply it.
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+namespace ipa::soft::algorithms {
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	auto grid = tuningData["grid"].get<std::vector<uint32_t>>();
+	if (!grid || grid->size() != 2 ||
+	    (*grid)[0] < 2 || (*grid)[0] > DebayerParams::kLscGridMax ||
+	    (*grid)[1] < 2 || (*grid)[1] > DebayerParams::kLscGridMax) {
+		LOG(IPASoftLsc, Error)
+			<< "'grid' must be [ width, height ], 2 to "
+			<< DebayerParams::kLscGridMax << " points each";
+		return -EINVAL;
+	}
+
+	width_ = (*grid)[0];
+	height_ = (*grid)[1];
+	const size_t points = width_ * height_;
+	const double strength = tuningData["strength"].get<double>(1.0);
+
+	gains_.resize(points * 3);
+	unsigned int c = 0;
+	for (const char *channel : { "r", "g", "b" }) {
+		auto values = tuningData[channel].get<std::vector<double>>();
+		if (!values || values->size() != points) {
+			LOG(IPASoftLsc, Error)
+				<< "'" << channel << "' must hold " << points << " gains";
+			return -EINVAL;
+		}
+
+		for (size_t i = 0; i < points; i++) {
+			const double gain = 1.0 + ((*values)[i] - 1.0) * strength;
+			gains_[i * 3 + c] = static_cast<uint8_t>(std::lround(
+				std::clamp(gain / DebayerParams::kLscGainMax, 0.0, 1.0) * 255));
+		}
+		c++;
+	}
+
+	return 0;
+}
+
+int Lsc::configure(IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	/* The image covers the analogue crop of the active area. */
+	const IPACameraSensorInfo &info = context.sensorInfo;
+	const Rectangle &crop = info.analogCrop;
+	const Size &active = info.activeAreaSize;
+
+	if (active.isNull())
+		return 0;
+
+	crop_ = {
+		static_cast<float>(crop.x) / active.width,
+		static_cast<float>(crop.y) / active.height,
+		static_cast<float>(crop.width) / active.width,
+		static_cast<float>(crop.height) / active.height,
+	};
+
+	LOG(IPASoftLsc, Debug)
+		<< "Crop " << crop << " of " << active;
+
+	return 0;
+}
+
+void Lsc::prepare([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	params->lscWidth = width_;
+	params->lscHeight = height_;
+	std::copy(gains_.begin(), gains_.end(), params->lscGains.begin());
+	params->lscCrop = crop_;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
