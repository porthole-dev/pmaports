+	[SNS_SMGR_SENSOR_TYPE_HALL_EFFECT] = "HALL_EFFECT",
+	/*
+	 * These two are mixed case where every other type SMGR reports is
+	 * upper -- copied from the strings the firmware actually sends, not
+	 * normalised, because the match is a strcmp.
+	 */
+	[SNS_SMGR_SENSOR_TYPE_STEP_DETECTOR] = "StepDetector",
+	[SNS_SMGR_SENSOR_TYPE_STEP_COUNT] = "StepCount",
+	[SNS_SMGR_SENSOR_TYPE_ACTIVITY] = "ACTIVITY",
+	[SNS_SMGR_SENSOR_TYPE_INACTIVITY] = "INACTIVITY",
+	[SNS_SMGR_SENSOR_TYPE_ELMYRA] = "ELMYRA_RAW",
+	/* FTM4 touch controller wake gestures, surfaced through the SLPI */
+	[SNS_SMGR_SENSOR_TYPE_DOUBLE_TAP] = "DOUBLE_TOUCH",
+	[SNS_SMGR_SENSOR_TYPE_LONG_PRESS] = "LONG_PRESS",
+	[SNS_SMGR_SENSOR_TYPE_SWIPE_UP] = "SWIPE_UP"
