From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Mon, 14 Sep 2026 18:26:36 +0200
Subject: [PATCH] dt-bindings: media: i2c: Add ON Semiconductor LC898123F40

The LC898123F40 is a closed-loop optical image stabilisation controller
for camera modules. It runs firmware from its own flash, reads the gyro
itself, and keeps the camera module's calibration data in the same flash.
It needs a logic supply and a supply for its coil drivers.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../bindings/media/i2c/onnn,lc898123f40.yaml  | 51 +++++++++++++++++++
 1 file changed, 51 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/onnn,lc898123f40.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/onnn,lc898123f40.yaml b/Documentation/devicetree/bindings/media/i2c/onnn,lc898123f40.yaml
new file mode 100644
index 000000000000..977c6cb8e917
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/onnn,lc898123f40.yaml
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/onnn,lc898123f40.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: ON Semiconductor LC898123F40 optical image stabilisation controller
+
+maintainers:
+  - Giuseppe Maggio <jertlok@proton.me>
+
+description:
+  Closed-loop OIS controller for camera modules. It runs firmware from its own
+  flash, reads the gyro directly, and stores the camera module's calibration
+  data in the same flash.
+
+properties:
+  compatible:
+    const: onnn,lc898123f40
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: Logic supply.
+
+  vdrv-supply:
+    description: OIS coil driver supply.
+
+required:
+  - compatible
+  - reg
+  - vdd-supply
+  - vdrv-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        ois@3e {
+            compatible = "onnn,lc898123f40";
+            reg = <0x3e>;
+            vdd-supply = <&vreg_1p8>;
+            vdrv-supply = <&vreg_ois_2p8>;
+        };
+    };
+...
