From 40126054eaba9b666f2e68790ce49c89648196e4 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 23 Aug 2026 02:45:00 +0200
Subject: [PATCH] drm/msm: drop the GPU DDR bandwidth vote across suspend

With per-OPP bandwidth votes wired, the GPU parks with its last OPP's
interconnect vote standing while the GPU itself is fully collapsed. On
msm8998 the RPM never applies its sleep set (no APSS power-collapse
handshake), so that active-set vote holds DDR at the voted rate through
every system suspend and through screen-on idle. Drop the OPP entirely
when devfreq suspends - zeroing bandwidth, level and required-opps
votes - and re-establish it on resume before devfreq restarts.
Downstream kgsl likewise zeroes its bus votes on slumber.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/gpu/drm/msm/msm_gpu_devfreq.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/gpu/drm/msm/msm_gpu_devfreq.c b/drivers/gpu/drm/msm/msm_gpu_devfreq.c
index dcfa4b0..9d01c43 100644
--- a/drivers/gpu/drm/msm/msm_gpu_devfreq.c
+++ b/drivers/gpu/drm/msm/msm_gpu_devfreq.c
@@ -239,6 +239,9 @@ void msm_devfreq_resume(struct msm_gpu *gpu)
 	df->suspended = false;
 	mutex_unlock(&df->lock);
 
+	/* Restore the OPP (clock and bandwidth vote) dropped at suspend. */
+	dev_pm_opp_set_rate(&gpu->pdev->dev, df->devfreq->previous_freq);
+
 	devfreq_resume_device(df->devfreq);
 }
 
@@ -257,6 +260,16 @@ void msm_devfreq_suspend(struct msm_gpu *gpu)
 
 	cancel_idle_work(df);
 	cancel_boost_work(df);
+
+	/*
+	 * Drop the OPP entirely so the interconnect vote goes to zero while
+	 * the GPU is collapsed.  On msm8998 the RPM never applies its sleep
+	 * set (no APSS power-collapse handshake), so a bandwidth vote left
+	 * standing here holds DDR at that rate through every system suspend
+	 * and through screen-on idle.  Downstream kgsl likewise zeroes its
+	 * bus votes on slumber.
+	 */
+	dev_pm_opp_set_opp(&gpu->pdev->dev, NULL);
 }
 
 static void msm_devfreq_boost_work(struct kthread_work *work)
-- 
2.55.0

