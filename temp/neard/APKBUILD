# TEMPORARY FORK of community/neard.
#
# Upstream neard can be started by neither mechanism a system service is
# normally started by: it ships no D-Bus activation file, and its unit's
# [Install] has only Alias=, so `systemctl enable neard` exits 0 and creates
# no symlink. Alpine inherits both, so the package installs an NFC daemon that
# nothing can start. device-google-taimen carried a neard.service.d drop-in to
# work around the second half; this fixes both, for every device.
#
# pkgrel is 50 so this build outranks Alpine's 0.20-r0 from any repo, while an
# upstream 0.21 still outranks it by design.
#
# NOT YET SUBMITTED upstream: linux-nfc@lists.01.org is dead, 01.org was
# retired by Intel in 2022. neard's own README (0.20 tarball) gives the live
# addresses: the mailing list is oe-linux-nfc@lists.linux.dev, and the project
# also takes GitHub pull requests at https://github.com/linux-nfc/neard --
# probably the better route now. Also needs an Alpine aports MR. Drop this
# fork the day either lands and Alpine rebuilds.
#
# url= below is the same dead 01.org address, inherited byte-for-byte from
# Alpine's aport -- that belongs in the Alpine MR, not a reason to diverge
# this fork.

maintainer="Giuseppe Maggio <jertlok@proton.me>"
# Contributor: Minecrell <minecrell@minecrell.net>
# Contributor: Achill Gilgenast <achill@achill.org>
pkgname=neard
pkgver=0.20
pkgrel=52
pkgdesc="Near Field Communication manager"
url="https://01.org/linux-nfc/"
arch="all"
license="GPL-2.0-only"
makedepends="
	autoconf
	autoconf-archive
	automake
	dbus-dev
	glib-dev
	libnl3-dev
	libtool
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-openrc
	$pkgname-systemd
	"
source="
	https://git.kernel.org/pub/scm/network/nfc/neard.git/snapshot/neard-$pkgver.tar.gz
	0001-build-install-a-D-Bus-system-service-activation-file.patch
	0002-build-enable-neard.service-by-default.patch
	0003-mifare-an-unreadable-MAD-is-a-tag-without-NDEF.patch
	0004-adapter-make-the-presence-check-period-a-setting.patch
	0005-adapter-switching-the-radio-off-stops-the-poll-loop.patch
	neard.initd
	"

prepare() {
	default_prepare
	./bootstrap
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-systemd \
		--with-systemdsystemunitdir=/usr/lib/systemd/system \
		--with-systemduserunitdir=/usr/lib/systemd/user \
		--enable-tools
	make
}

check() {
	make check
}

# Upstream ships src/main.conf as dist_noinst_DATA, so `make install` never
# puts it anywhere and neard runs on its built in defaults. This phone needs
# exactly one value changed from those: a tag lifted off the antenna is not
# noticed until the next presence check, so upstream's 2000ms puts a second of
# lag on every removal. 300ms reads as immediate and costs a few more
# transactions, and only while a tag is actually present.
_check_presence_period=300

package() {
	make DESTDIR="$pkgdir" install

	# Only this one key. Upstream's sample main.conf also carries
	# DefaultPowered = true, which would switch the NFC radio on by itself
	# at every boot -- the opposite of the design this device ships, where
	# the radio is the user's switch and nothing else may touch it. Every
	# other setting stays at neard's built in default by not being here.
	mkdir -p "$pkgdir"/etc/neard
	cat > "$pkgdir"/etc/neard/main.conf <<-EOF
		[General]

		# How often, in milliseconds, to ask a tag that is in the field
		# whether it is still there. A tag taken away is not noticed
		# until the next check, so this is the floor on how quickly a
		# removal can be reported. Upstream's default is 2000, which
		# puts a second of lag on every removal.
		CheckPresencePeriod = $_check_presence_period
	EOF

	# Avoid conflicts with other packages
	mv "$pkgdir"/usr/include/version.h "$pkgdir"/usr/include/near/version.h

	install -m755 -D "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname

	mkdir -p "$pkgdir"/usr/share/dbus-1/system.d/
	mv "$pkgdir"/etc/dbus-1/system.d/* "$pkgdir"/usr/share/dbus-1/system.d/
}

