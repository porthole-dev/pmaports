#!/sbin/openrc-run

name="taimen-bt-reload"
description="Re-probe hci_uart when the BT controller never reaches mgmt (workaround)"

command="/usr/bin/taimen-bt-reload"

depend() {
	# bluetoothd must already be running so it adopts the controller as soon
	# as the re-probe emits Index Added
	after bluetooth
}

start() {
	ebegin "Checking the Bluetooth controller reached mgmt"
	$command
	eend 0
}
