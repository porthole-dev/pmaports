+#define RX_CSI2_RESETN		0x008
+#define RX_PHY_SHUTDOWNZ	0x040
+#define RX_DPHY_RSTZ		0x044
+#define RX_PHY_TEST_CTRL0	0x050
+#define RX_PHY_TEST_CTRL1	0x054
+#define RX_INT_MSK_PHY_FATAL	0x0e4
+#define RX_INT_MSK_PKT_FATAL	0x0f4
+#define RX_INT_MSK_FRAME_FATAL	0x104
