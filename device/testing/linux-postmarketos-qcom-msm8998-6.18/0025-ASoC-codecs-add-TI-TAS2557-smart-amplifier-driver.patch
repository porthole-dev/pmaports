diff --git a/sound/soc/codecs/tas2557.c b/sound/soc/codecs/tas2557.c
new file mode 100644
index 000000000000..00e923126643
--- /dev/null
+++ b/sound/soc/codecs/tas2557.c
@@ -0,0 +1,1347 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// TI TAS2557 smart amplifier, dual-mono pair
+//
+// Ported from the wahoo downstream driver (sound/soc/codecs/tas2557/, ~7100
+// lines) down to the part that makes sound. Dropped: the misc/tiload debug
+// character devices, the YRAM (coefficient) CRC verification, die-temperature
+// and VBoost management, and per-unit calibration -- taimen's /persist copy of
+// tas2557_cal.bin is a 30-byte symlink, so there is nothing to apply.
+//
+// Two things about this part shape the whole driver:
+//
+//   1. Registers are addressed by book/page/offset, and the selects live at
+//      fixed offsets *inside* the current page, so every access is up to three
+//      i2c writes. The current book and page are cached per device.
+//   2. It cannot be brought up by writing registers. The PLL setup and the DSP
+//      program exist only inside a firmware blob; without one parsed, the part
+//      stays mute. taimen's is tas2557s_PG21_uCDSP.bin -- see tools/tk-tas-fw.py.
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/soc-dapm.h>
+#include <sound/tlv.h>
+
+#define TAS2557_REG(book, page, reg)	(((book) * 256 * 128) + ((page) * 128) + (reg))
+#define TAS2557_BOOK(reg)		((u8)((reg) / (256 * 128)))
+#define TAS2557_PAGE(reg)		((u8)(((reg) % (256 * 128)) / 128))
+#define TAS2557_OFFSET(reg)		((u8)(((reg) % (256 * 128)) % 128))
+
+/* Selects. PAGECTL lives in every page; BOOKCTL only in page 0. */
+#define TAS2557_PAGECTL_REG		0
+#define TAS2557_BOOKCTL_REG		127
+
+#define TAS2557_SW_RESET_REG		TAS2557_REG(0, 0, 1)
+#define TAS2557_SAR_ADC2_REG		TAS2557_REG(0, 0, 21)
+#define TAS2557_REV_PGID_REG		TAS2557_REG(0, 0, 3)
+#define TAS2557_POWER_CTRL1_REG		TAS2557_REG(0, 0, 4)
+#define TAS2557_POWER_CTRL2_REG		TAS2557_REG(0, 0, 5)
+#define TAS2557_MUTE_REG		TAS2557_REG(0, 0, 7)
+#define TAS2557_CRC_CHECKSUM_REG	TAS2557_REG(0, 0, 32)
+#define TAS2557_CRC_RESET_REG		TAS2557_REG(0, 0, 33)
+#define TAS2557_SAFE_GUARD_REG		TAS2557_REG(0, 0, 37)
+#define TAS2557_CLK_ERR_CTRL		TAS2557_REG(0, 0, 44)
+#define TAS2557_CLK_ERR_CTRL2		TAS2557_REG(0, 0, 45)
+#define TAS2557_CLK_ERR_CTRL3		TAS2557_REG(0, 0, 46)
+#define TAS2557_ASI1_DAC_FORMAT_REG	TAS2557_REG(0, 1, 1)
+#define TAS2557_ASI1_WORD_LEN_MASK	GENMASK(4, 3)
+#define TAS2557_GPIO1_PIN_REG		TAS2557_REG(0, 1, 61)
+#define TAS2557_GPIO2_PIN_REG		TAS2557_REG(0, 1, 62)
+#define TAS2557_GPI_PIN_REG		TAS2557_REG(0, 1, 77)
+#define TAS2557_TEST_MODE_REG		TAS2557_REG(0, 253, 13)
+#define TAS2557_BROADCAST_REG		TAS2557_REG(0, 253, 54)
+#define TAS2557_SOFT_MUTE_REG		TAS2557_REG(100, 0, 7)
+
+#define TAS2557_SAFE_GUARD_PATTERN	0x5a
+#define TAS2557_PG_VERSION_2P1		0xa0
+
+/* Pseudo-registers in the power sequences below */
+#define TAS2557_UDELAY			0xfffffffe
+#define TAS2557_END			0xffffffff
+
+/* Broadcast writes go to the left device's address; both listen once armed. */
+#define TAS2557_BROADCAST_ADDR		0x4c
+
+/* Channel selectors, matching the firmware's own encoding */
+#define TAS_CHAN_LEFT			BIT(0)
+#define TAS_CHAN_RIGHT			BIT(1)
+#define TAS_CHAN_BOTH			(TAS_CHAN_LEFT | TAS_CHAN_RIGHT)
+#define TAS_CHAN_BROADCAST		BIT(2)
+
+/* Firmware block types */
+#define TAS2557_BLOCK_PLL		0x00
+#define TAS2557_BLOCK_PGM_DEV_A		0x01
+#define TAS2557_BLOCK_CFG_COEFF_DEV_A	0x03
+#define TAS2557_BLOCK_CFG_PRE_DEV_A	0x04
+#define TAS2557_BLOCK_PGM_DEV_B		0x08
+#define TAS2557_BLOCK_CFG_COEFF_DEV_B	0x0a
+#define TAS2557_BLOCK_CFG_PRE_DEV_B	0x0b
+#define TAS2557_BLOCK_PGM_ALL		0x0d
+
+/* Blocks gained four checksum bytes at this firmware driver version */
+#define TAS2557_PPC_DRIVER_CRCCHK	0x00000200
+#define TAS2557_PPC_DRIVER_CONFDEV	0x00000300
+
+struct tas2557_block {
+	u32 type;
+	u32 ncommands;
+	bool pcrc_present;
+	u8 pcrc;		/* PRAM checksum the image expects */
+	const u8 *data;		/* points into the firmware image */
+};
+
+struct tas2557_data {
+	char name[65];
+	u16 nblocks;
+	struct tas2557_block *blocks;
+};
+
+struct tas2557_pll {
+	char name[65];
+	struct tas2557_block block;
+};
+
+struct tas2557_program {
+	char name[65];
+	struct tas2557_data data;
+};
+
+struct tas2557_config {
+	char name[65];
+	u16 devices;
+	u8 program;
+	u8 pll;
+	u32 rate;
+	struct tas2557_data data;
+};
+
+struct tas2557_fw {
+	u32 driver_version;
+	u16 npll, nprogram, nconfig;
+	struct tas2557_pll *plls;
+	struct tas2557_program *programs;
+	struct tas2557_config *configs;
+};
+
+struct tas2557 {
+	struct device *dev;
+	struct i2c_client *client[2];	/* [0] left 0x4c, [1] right 0x4d */
+	struct i2c_client *broadcast;
+	struct gpio_desc *reset_gpio;
+
+	u8 cur_book[2], cur_page[2];
+	u8 broadcast_set[2];
+
+	const struct firmware *fw_entry;
+	struct tas2557_fw fw;
+
+	int cur_program;
+	int cur_config;
+	int loaded_config;
+	unsigned int width;
+	bool powered;
+};
+
+/* ------------------------------------------------------------------ i2c */
+
+static int tas2557_select(struct tas2557 *tas, int idx, u32 reg)
+{
+	struct i2c_client *c = tas->client[idx];
+	u8 book = TAS2557_BOOK(reg), page = TAS2557_PAGE(reg);
+	int ret;
+
+	if (tas->cur_book[idx] != book) {
+		ret = i2c_smbus_write_byte_data(c, TAS2557_PAGECTL_REG, 0);
+		if (ret < 0)
+			return ret;
+		tas->cur_page[idx] = 0;
+
+		ret = i2c_smbus_write_byte_data(c, TAS2557_BOOKCTL_REG, book);
+		if (ret < 0)
+			return ret;
+		tas->cur_book[idx] = book;
+	}
+
+	if (tas->cur_page[idx] != page) {
+		ret = i2c_smbus_write_byte_data(c, TAS2557_PAGECTL_REG, page);
+		if (ret < 0)
+			return ret;
+		tas->cur_page[idx] = page;
+	}
+
+	return 0;
+}
+
+/*
+ * A broadcast write reaches both devices, so neither device's cached book/page
+ * can be trusted afterwards -- invalidate both rather than track them.
+ */
+static int tas2557_select_broadcast(struct tas2557 *tas, u32 reg)
+{
+	int ret;
+
+	ret = i2c_smbus_write_byte_data(tas->broadcast, TAS2557_PAGECTL_REG, 0);
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_smbus_write_byte_data(tas->broadcast, TAS2557_BOOKCTL_REG,
+					TAS2557_BOOK(reg));
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_smbus_write_byte_data(tas->broadcast, TAS2557_PAGECTL_REG,
+					TAS2557_PAGE(reg));
+	if (ret < 0)
+		return ret;
+
+	tas->cur_book[0] = tas->cur_book[1] = TAS2557_BOOK(reg);
+	tas->cur_page[0] = tas->cur_page[1] = TAS2557_PAGE(reg);
+
+	return 0;
+}
+
+static int tas2557_write(struct tas2557 *tas, unsigned int chan, u32 reg, u8 val)
+{
+	int idx, ret;
+
+	if (chan & TAS_CHAN_BROADCAST) {
+		ret = tas2557_select_broadcast(tas, reg);
+		if (ret < 0)
+			return ret;
+
+		return i2c_smbus_write_byte_data(tas->broadcast,
+						 TAS2557_OFFSET(reg), val);
+	}
+
+	for (idx = 0; idx < 2; idx++) {
+		if (!(chan & BIT(idx)))
+			continue;
+
+		ret = tas2557_select(tas, idx, reg);
+		if (ret < 0)
+			return ret;
+
+		ret = i2c_smbus_write_byte_data(tas->client[idx],
+						TAS2557_OFFSET(reg), val);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Not i2c_smbus_write_i2c_block_data(): that caps at I2C_SMBUS_BLOCK_MAX (32)
+ * bytes and would silently truncate the firmware's longer bulk writes. Build
+ * the offset+payload buffer and hand it to the adapter directly.
+ */
+static int tas2557_bulk_write(struct tas2557 *tas, unsigned int chan, u32 reg,
+			      const u8 *data, u32 len)
+{
+	u8 *buf;
+	int idx, ret = 0;
+
+	buf = kmalloc(len + 1, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	buf[0] = TAS2557_OFFSET(reg);
+	memcpy(buf + 1, data, len);
+
+	if (chan & TAS_CHAN_BROADCAST) {
+		ret = tas2557_select_broadcast(tas, reg);
+		if (ret < 0)
+			goto out;
+
+		ret = i2c_master_send(tas->broadcast, buf, len + 1);
+		goto out;
+	}
+
+	for (idx = 0; idx < 2; idx++) {
+		if (!(chan & BIT(idx)))
+			continue;
+
+		ret = tas2557_select(tas, idx, reg);
+		if (ret < 0)
+			goto out;
+
+		ret = i2c_master_send(tas->client[idx], buf, len + 1);
+		if (ret < 0)
+			goto out;
+	}
+
+	ret = 0;
+out:
+	kfree(buf);
+
+	return ret < 0 ? ret : 0;
+}
+
+static int tas2557_update_bits(struct tas2557 *tas, unsigned int chan, u32 reg,
+			       u8 mask, u8 val);
+static int tas2557_set_word_len(struct tas2557 *tas, unsigned int width);
+
+static int tas2557_read(struct tas2557 *tas, int idx, u32 reg, u8 *val)
+{
+	int ret;
+
+	/*
+	 * Always re-select rather than trusting the cache. Reads are rare, and
+	 * the cache only tracks writes this driver made -- a broadcast write,
+	 * or anything else that has touched the part, leaves it stale, and a
+	 * read from the wrong page silently returns a plausible wrong value
+	 * instead of failing.
+	 */
+	tas->cur_book[idx] = 0xff;
+	tas->cur_page[idx] = 0xff;
+
+	ret = tas2557_select(tas, idx, reg);
+	if (ret < 0)
+		return ret;
+
+	ret = i2c_smbus_read_byte_data(tas->client[idx], TAS2557_OFFSET(reg));
+	if (ret < 0)
+		return ret;
+
+	*val = ret;
+
+	return 0;
+}
+
+static int tas2557_update_bits(struct tas2557 *tas, unsigned int chan, u32 reg,
+			       u8 mask, u8 val)
+{
+	int idx, ret;
+	u8 old;
+
+	for (idx = 0; idx < 2; idx++) {
+		if (!(chan & BIT(idx)))
+			continue;
+
+		ret = tas2557_read(tas, idx, reg, &old);
+		if (ret < 0)
+			return ret;
+
+		ret = tas2557_write(tas, BIT(idx), reg, (old & ~mask) | (val & mask));
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* --------------------------------------------------- register sequences */
+
+/*
+ * Written once after reset. The safe-guard register is the interesting one: it
+ * is not a status bit but a scratch register that the driver stamps with a
+ * known pattern and reads back before each power-up, so a device that has
+ * silently reset or fallen off the bus is caught before it is driven.
+ */
+static const u32 tas2557_init_seq[] = {
+	TAS2557_SAR_ADC2_REG,	0x05,	/* enable SAR ADC */
+	TAS2557_CLK_ERR_CTRL2,	0x21,	/* clock hysteresis and halt timing */
+	TAS2557_CLK_ERR_CTRL3,	0x21,
+	TAS2557_SAFE_GUARD_REG,	TAS2557_SAFE_GUARD_PATTERN,
+	TAS2557_END,		TAS2557_END,
+};
+
+static const u32 tas2557_startup_seq[] = {
+	TAS2557_GPI_PIN_REG,	0x15,	/* DIN, MCLK, CCI */
+	TAS2557_GPIO1_PIN_REG,	0x01,	/* BCLK */
+	TAS2557_GPIO2_PIN_REG,	0x01,	/* WCLK */
+	TAS2557_POWER_CTRL2_REG, 0xa0,	/* class-D and boost up */
+	TAS2557_POWER_CTRL2_REG, 0xa3,	/* plus IV sense */
+	TAS2557_POWER_CTRL1_REG, 0xf8,	/* PLL, DSP, dividers up */
+	TAS2557_UDELAY,		2000,
+	TAS2557_CLK_ERR_CTRL,	0x2b,	/* clock error detection on */
+	TAS2557_END,		TAS2557_END,
+};
+
+static const u32 tas2557_unmute_seq[] = {
+	TAS2557_MUTE_REG,	0x00,
+	TAS2557_SOFT_MUTE_REG,	0x00,
+	TAS2557_END,		TAS2557_END,
+};
+
+static const u32 tas2557_shutdown_seq[] = {
+	TAS2557_CLK_ERR_CTRL,	0x00,
+	TAS2557_SOFT_MUTE_REG,	0x01,
+	TAS2557_UDELAY,		10000,
+	TAS2557_MUTE_REG,	0x03,
+	TAS2557_POWER_CTRL1_REG, 0x60,	/* DSP down */
+	TAS2557_UDELAY,		2000,
+	TAS2557_POWER_CTRL2_REG, 0x00,
+	TAS2557_POWER_CTRL1_REG, 0x00,
+	TAS2557_GPIO1_PIN_REG,	0x00,
+	TAS2557_GPIO2_PIN_REG,	0x00,
+	TAS2557_GPI_PIN_REG,	0x00,
+	TAS2557_END,		TAS2557_END,
+};
+
+static int tas2557_run_seq(struct tas2557 *tas, unsigned int chan,
+			   const u32 *seq)
+{
+	int i, ret;
+
+	for (i = 0; seq[i] != TAS2557_END; i += 2) {
+		if (seq[i] == TAS2557_UDELAY) {
+			usleep_range(seq[i + 1], seq[i + 1] + 100);
+			continue;
+		}
+
+		ret = tas2557_write(tas, chan, seq[i], seq[i + 1]);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* ------------------------------------------------------ firmware parsing */
+
+struct tas2557_parser {
+	const u8 *data;
+	size_t size;
+	size_t pos;
+	struct device *dev;
+};
+
+static int tas2557_need(struct tas2557_parser *p, size_t n)
+{
+	if (p->pos + n > p->size) {
+		dev_err(p->dev, "firmware truncated at %zu\n", p->pos);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static u32 tas2557_get_u32(struct tas2557_parser *p)
+{
+	u32 v = get_unaligned_be32(p->data + p->pos);
+
+	p->pos += 4;
+
+	return v;
+}
+
+static u16 tas2557_get_u16(struct tas2557_parser *p)
+{
+	u16 v = get_unaligned_be16(p->data + p->pos);
+
+	p->pos += 2;
+
+	return v;
+}
+
+static void tas2557_get_name(struct tas2557_parser *p, char *dst)
+{
+	memcpy(dst, p->data + p->pos, 64);
+	dst[64] = '\0';
+	p->pos += 64;
+}
+
+/* Descriptions are NUL-terminated and unbounded; skip rather than keep them. */
+static int tas2557_skip_string(struct tas2557_parser *p)
+{
+	while (p->pos < p->size && p->data[p->pos])
+		p->pos++;
+
+	if (p->pos >= p->size)
+		return -EINVAL;
+
+	p->pos++;
+
+	return 0;
+}
+
+static int tas2557_parse_block(struct tas2557_parser *p, u32 driver_version,
+			       struct tas2557_block *b)
+{
+	int ret;
+
+	ret = tas2557_need(p, 8);
+	if (ret)
+		return ret;
+
+	b->type = tas2557_get_u32(p);
+
+	if (driver_version >= TAS2557_PPC_DRIVER_CRCCHK) {
+		/* P-present, P-checksum, Y-present, Y-checksum */
+		b->pcrc_present = p->data[p->pos];
+		b->pcrc = p->data[p->pos + 1];
+		p->pos += 4;
+	}
+
+	ret = tas2557_need(p, 4);
+	if (ret)
+		return ret;
+
+	b->ncommands = tas2557_get_u32(p);
+
+	ret = tas2557_need(p, (size_t)b->ncommands * 4);
+	if (ret)
+		return ret;
+
+	b->data = p->data + p->pos;
+	p->pos += (size_t)b->ncommands * 4;
+
+	return 0;
+}
+
+static int tas2557_parse_data(struct tas2557_parser *p, u32 driver_version,
+			      struct tas2557_data *d, struct device *dev)
+{
+	int i, ret;
+
+	ret = tas2557_need(p, 64);
+	if (ret)
+		return ret;
+
+	tas2557_get_name(p, d->name);
+
+	ret = tas2557_skip_string(p);
+	if (ret)
+		return ret;
+
+	ret = tas2557_need(p, 2);
+	if (ret)
+		return ret;
+
+	d->nblocks = tas2557_get_u16(p);
+
+	d->blocks = devm_kcalloc(dev, d->nblocks, sizeof(*d->blocks), GFP_KERNEL);
+	if (!d->blocks)
+		return -ENOMEM;
+
+	for (i = 0; i < d->nblocks; i++) {
+		ret = tas2557_parse_block(p, driver_version, &d->blocks[i]);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int tas2557_parse_fw(struct tas2557 *tas, const struct firmware *fw)
+{
+	static const u8 magic[4] = { 0x35, 0x35, 0x35, 0x32 };
+	struct tas2557_parser p = {
+		.data = fw->data,
+		.size = fw->size,
+		.dev = tas->dev,
+	};
+	struct tas2557_fw *f = &tas->fw;
+	u32 size, family, device;
+	char ddc[65];
+	int i, ret;
+
+	if (fw->size < 104 || memcmp(fw->data, magic, sizeof(magic))) {
+		dev_err(tas->dev, "not a TAS firmware image\n");
+		return -EINVAL;
+	}
+
+	p.pos = 4;
+	size = tas2557_get_u32(&p);
+	if (size != fw->size)
+		dev_warn(tas->dev, "header says %u bytes, file is %zu\n",
+			 size, fw->size);
+
+	tas2557_get_u32(&p);				/* checksum */
+	tas2557_get_u32(&p);				/* PPC version */
+	tas2557_get_u32(&p);				/* firmware version */
+	f->driver_version = tas2557_get_u32(&p);
+	tas2557_get_u32(&p);				/* timestamp */
+
+	tas2557_get_name(&p, ddc);
+
+	ret = tas2557_skip_string(&p);			/* description */
+	if (ret)
+		return ret;
+
+	family = tas2557_get_u32(&p);
+	device = tas2557_get_u32(&p);
+	if (family != 0 || device != 3) {
+		dev_err(tas->dev, "family %u device %u, not a TAS2557 dual mono\n",
+			family, device);
+		return -EINVAL;
+	}
+
+	/* PLLs */
+	f->npll = tas2557_get_u16(&p);
+	f->plls = devm_kcalloc(tas->dev, f->npll, sizeof(*f->plls), GFP_KERNEL);
+	if (!f->plls)
+		return -ENOMEM;
+
+	for (i = 0; i < f->npll; i++) {
+		tas2557_get_name(&p, f->plls[i].name);
+
+		ret = tas2557_skip_string(&p);
+		if (ret)
+			return ret;
+
+		ret = tas2557_parse_block(&p, f->driver_version,
+					  &f->plls[i].block);
+		if (ret)
+			return ret;
+	}
+
+	/* programs */
+	f->nprogram = tas2557_get_u16(&p);
+	f->programs = devm_kcalloc(tas->dev, f->nprogram, sizeof(*f->programs),
+				   GFP_KERNEL);
+	if (!f->programs)
+		return -ENOMEM;
+
+	for (i = 0; i < f->nprogram; i++) {
+		tas2557_get_name(&p, f->programs[i].name);
+
+		ret = tas2557_skip_string(&p);
+		if (ret)
+			return ret;
+
+		p.pos += 1;		/* app mode */
+		p.pos += 2;		/* boost */
+
+		ret = tas2557_parse_data(&p, f->driver_version,
+					 &f->programs[i].data, tas->dev);
+		if (ret)
+			return ret;
+	}
+
+	/* configurations */
+	f->nconfig = tas2557_get_u16(&p);
+	f->configs = devm_kcalloc(tas->dev, f->nconfig, sizeof(*f->configs),
+				  GFP_KERNEL);
+	if (!f->configs)
+		return -ENOMEM;
+
+	for (i = 0; i < f->nconfig; i++) {
+		struct tas2557_config *c = &f->configs[i];
+
+		tas2557_get_name(&p, c->name);
+
+		ret = tas2557_skip_string(&p);
+		if (ret)
+			return ret;
+
+		if (f->driver_version >= TAS2557_PPC_DRIVER_CONFDEV)
+			c->devices = tas2557_get_u16(&p);
+		else
+			c->devices = TAS_CHAN_BOTH;
+
+		c->program = p.data[p.pos++];
+		c->pll = p.data[p.pos++];
+		c->rate = tas2557_get_u32(&p);
+
+		ret = tas2557_parse_data(&p, f->driver_version, &c->data,
+					 tas->dev);
+		if (ret)
+			return ret;
+	}
+
+	dev_info(tas->dev, "firmware %s: %u PLLs, %u programs, %u configurations\n",
+		 ddc, f->npll, f->nprogram, f->nconfig);
+
+	if (!f->nprogram || !f->nconfig) {
+		dev_err(tas->dev, "firmware has no program or no configuration\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/* ------------------------------------------------------ firmware download */
+
+static unsigned int tas2557_block_channel(struct tas2557 *tas,
+					  const struct tas2557_block *b)
+{
+	switch (b->type) {
+	case TAS2557_BLOCK_PGM_DEV_A:
+	case TAS2557_BLOCK_CFG_COEFF_DEV_A:
+	case TAS2557_BLOCK_CFG_PRE_DEV_A:
+		return TAS_CHAN_LEFT;
+	case TAS2557_BLOCK_PGM_DEV_B:
+	case TAS2557_BLOCK_CFG_COEFF_DEV_B:
+	case TAS2557_BLOCK_CFG_PRE_DEV_B:
+		return TAS_CHAN_RIGHT;
+	case TAS2557_BLOCK_PGM_ALL:
+		return TAS_CHAN_BROADCAST;
+	case TAS2557_BLOCK_PLL:
+		return tas->fw.configs[tas->cur_config].devices;
+	default:
+		return 0;
+	}
+}
+
+/*
+ * BROADCAST_REG is behind a test-mode unlock. Without this write the register
+ * simply ignores what you put in it, and the effect is asymmetric and silent:
+ * broadcast writes still reach 0x4c because that IS the broadcast address, so
+ * the left amp looks fine while the right one is never armed and receives no
+ * DSP program at all. Nothing reports an error -- it surfaces only as the
+ * right block's PRAM checksum reading back 0x00.
+ */
+static int tas2557_unlock_test_mode(struct tas2557 *tas, unsigned int chan)
+{
+	return tas2557_write(tas, chan, TAS2557_TEST_MODE_REG, 0x0d);
+}
+
+static int tas2557_enter_broadcast(struct tas2557 *tas)
+{
+	int idx, ret;
+
+	ret = tas2557_unlock_test_mode(tas, TAS_CHAN_BOTH);
+	if (ret < 0)
+		return ret;
+
+	for (idx = 0; idx < 2; idx++) {
+		ret = tas2557_write(tas, BIT(idx), TAS2557_BROADCAST_REG,
+				    (tas->broadcast_set[idx] & 0x1f) | 0x80);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int tas2557_exit_broadcast(struct tas2557 *tas)
+{
+	int idx, ret;
+
+	ret = tas2557_unlock_test_mode(tas, TAS_CHAN_BROADCAST);
+	if (ret < 0)
+		return ret;
+
+	ret = tas2557_write(tas, TAS_CHAN_BROADCAST, TAS2557_BROADCAST_REG, 0x01);
+	if (ret < 0)
+		return ret;
+
+	ret = tas2557_unlock_test_mode(tas, TAS_CHAN_BOTH);
+	if (ret < 0)
+		return ret;
+
+	for (idx = 0; idx < 2; idx++) {
+		ret = tas2557_write(tas, BIT(idx), TAS2557_BROADCAST_REG,
+				    tas->broadcast_set[idx] & 0x1f);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * A block is a list of 4-byte commands: book, page, offset, data. Offset is
+ * overloaded -- 0x81 is a sleep and 0x85 introduces a bulk write whose length
+ * is carried in the book/page bytes, which is also why commands cannot simply
+ * be indexed.
+ */
+/*
+ * Verify what actually landed in program RAM.
+ *
+ * This is not optional hygiene. The part accepts a corrupt download without
+ * complaint: POWER_CTRL comes up, the class-D powers on, no fault flag is
+ * raised, and the DSP simply emits silence -- which reads exactly like a
+ * missing clock or a dead amp and cost this project a full session. The image
+ * carries a per-block PRAM checksum; the part computes its own into
+ * CRC_CHECKSUM as the block is written. Compare them, and retry the block if
+ * they differ, the way downstream does.
+ */
+static int tas2557_check_pcrc(struct tas2557 *tas, unsigned int chan,
+			      const struct tas2557_block *b)
+{
+	int idx, ret;
+	u8 v;
+
+	for (idx = 0; idx < 2; idx++) {
+		/* broadcast wrote to both, so both have to be checked */
+		if (!(chan & (TAS_CHAN_BROADCAST | BIT(idx))))
+			continue;
+
+		ret = tas2557_read(tas, idx, TAS2557_CRC_CHECKSUM_REG, &v);
+		if (ret < 0)
+			return ret;
+
+		if (v != b->pcrc) {
+			dev_err(tas->dev,
+				"block 0x%x PRAM checksum on %s: image 0x%02x, part 0x%02x\n",
+				b->type, idx ? "right" : "left", b->pcrc, v);
+			return -EAGAIN;
+		}
+	}
+
+	return 0;
+}
+
+static int tas2557_load_block_once(struct tas2557 *tas,
+				   const struct tas2557_block *b)
+{
+	unsigned int chan = tas2557_block_channel(tas, b);
+	unsigned int cmd = 0;
+	int ret = 0;
+
+	if (!chan) {
+		dev_err(tas->dev, "unknown block type 0x%x\n", b->type);
+		return -EINVAL;
+	}
+
+	if (b->pcrc_present) {
+		ret = tas2557_write(tas, chan & TAS_CHAN_BROADCAST ? TAS_CHAN_BOTH : chan,
+				    TAS2557_CRC_RESET_REG, 1);
+		if (ret < 0)
+			return ret;
+	}
+
+	if (chan & TAS_CHAN_BROADCAST) {
+		ret = tas2557_enter_broadcast(tas);
+		if (ret < 0)
+			return ret;
+	}
+
+	while (cmd < b->ncommands) {
+		const u8 *d = b->data + cmd * 4;
+		u8 book = d[0], page = d[1], offset = d[2], val = d[3];
+		u32 len;
+
+		cmd++;
+
+		if (offset <= 0x7f) {
+			ret = tas2557_write(tas, chan,
+					    TAS2557_REG(book, page, offset), val);
+			if (ret < 0)
+				goto out;
+			continue;
+		}
+
+		if (offset == 0x81) {
+			msleep((book << 8) + page);
+			continue;
+		}
+
+		if (offset != 0x85) {
+			dev_err(tas->dev, "unknown command offset 0x%x\n", offset);
+			ret = -EINVAL;
+			goto out;
+		}
+
+		len = (book << 8) + page;
+		d += 4;
+		book = d[0];
+		page = d[1];
+		offset = d[2];
+
+		if (len > 1) {
+			ret = tas2557_bulk_write(tas, chan,
+						 TAS2557_REG(book, page, offset),
+						 d + 3, len);
+		} else {
+			ret = tas2557_write(tas, chan,
+					    TAS2557_REG(book, page, offset), d[3]);
+		}
+		if (ret < 0)
+			goto out;
+
+		cmd++;
+		if (len >= 2)
+			cmd += ((len - 2) / 4) + 1;
+	}
+
+out:
+	if (chan & TAS_CHAN_BROADCAST) {
+		int ret2 = tas2557_exit_broadcast(tas);
+
+		if (!ret)
+			ret = ret2;
+	}
+
+	if (!ret && b->pcrc_present)
+		ret = tas2557_check_pcrc(tas, chan, b);
+
+	return ret;
+}
+
+static int tas2557_load_block(struct tas2557 *tas, const struct tas2557_block *b)
+{
+	int try, ret = 0;
+
+	for (try = 0; try < 6; try++) {
+		ret = tas2557_load_block_once(tas, b);
+		if (ret != -EAGAIN)
+			return ret;
+	}
+
+	dev_err(tas->dev, "block 0x%x still corrupt after 6 tries\n", b->type);
+	return ret;
+}
+
+static int tas2557_load_data(struct tas2557 *tas, const struct tas2557_data *d)
+{
+	int i, ret;
+
+	for (i = 0; i < d->nblocks; i++) {
+		ret = tas2557_load_block(tas, &d->blocks[i]);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* ------------------------------------------------------------- power path */
+
+static int tas2557_hw_reset(struct tas2557 *tas)
+{
+	int idx, ret;
+
+	if (tas->reset_gpio) {
+		gpiod_set_value_cansleep(tas->reset_gpio, 0);
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(tas->reset_gpio, 1);
+		usleep_range(1000, 2000);
+	}
+
+	tas->cur_book[0] = tas->cur_book[1] = 0xff;
+	tas->cur_page[0] = tas->cur_page[1] = 0xff;
+
+	for (idx = 0; idx < 2; idx++) {
+		ret = tas2557_write(tas, BIT(idx), TAS2557_SW_RESET_REG, 0x01);
+		if (ret < 0)
+			return ret;
+	}
+
+	usleep_range(1000, 2000);
+
+	return 0;
+}
+
+/*
+ * Reset the pair and put it back in the state a program download expects.
+ *
+ * The reset is not optional on a RE-download. Writing a second DSP program
+ * into a part that is still running leaves it with a program that checksums
+ * correctly and produces silence -- measured: the first playback after a boot
+ * was loud and every one after it was mute, with identical logs. Downstream
+ * resets on every set_program for exactly this reason.
+ */
+static int tas2557_reset_and_init(struct tas2557 *tas)
+{
+	int idx, ret;
+
+	ret = tas2557_hw_reset(tas);
+	if (ret < 0)
+		return ret;
+
+	tas->powered = false;
+
+	ret = tas2557_run_seq(tas, TAS_CHAN_BOTH, tas2557_init_seq);
+	if (ret < 0)
+		return ret;
+
+	/* the per-device broadcast trim below is behind a test-mode unlock */
+	ret = tas2557_unlock_test_mode(tas, TAS_CHAN_BOTH);
+	if (ret < 0)
+		return ret;
+
+	for (idx = 0; idx < 2; idx++) {
+		ret = tas2557_read(tas, idx, TAS2557_BROADCAST_REG,
+				   &tas->broadcast_set[idx]);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Which firmware configuration to load. -1 picks by rate and name as below;
+ * an explicit index is how the DSP tuning program gets taken out of the
+ * picture -- index 10 in taimen's image is FactoryCalibration ROMMode2, which
+ * bypasses it, so it separates "the DSP is not producing output" from "nothing
+ * reaches the part".
+ */
+static int force_config = -1;
+module_param(force_config, int, 0644);
+MODULE_PARM_DESC(force_config, "firmware configuration index, -1 = pick by rate");
+
+static int tas2557_pick_config(struct tas2557 *tas, unsigned int rate)
+{
+	struct tas2557_fw *f = &tas->fw;
+	int i;
+
+	if (force_config >= 0 && force_config < f->nconfig)
+		return force_config;
+
+	/*
+	 * Configuration names carry their purpose: the calibration ones are for
+	 * factory use and must not be selected for playback.
+	 */
+	for (i = 0; i < f->nconfig; i++) {
+		if (f->configs[i].rate != rate)
+			continue;
+		if (strncmp(f->configs[i].name, "configuration_", 14))
+			continue;
+
+		return i;
+	}
+
+	return -EINVAL;
+}
+
+/*
+ * Downloading the DSP program is ~3000 i2c commands and takes far too long to
+ * sit in trigger(), which runs under the PCM stream lock -- doing it there made
+ * every playback fail with EIO before a sample moved. It happens here instead,
+ * once per configuration change, and trigger() is left with just the short
+ * power sequences.
+ */
+static int tas2557_setup(struct tas2557 *tas, unsigned int rate)
+{
+	struct tas2557_fw *f = &tas->fw;
+	struct tas2557_config *cfg;
+	u8 guard;
+	int cfg_idx, idx, ret;
+
+	cfg_idx = tas2557_pick_config(tas, rate);
+	if (cfg_idx < 0) {
+		dev_err(tas->dev, "no configuration for %u Hz\n", rate);
+		return cfg_idx;
+	}
+
+	if (tas->loaded_config == cfg_idx)
+		return 0;
+
+	tas->cur_config = cfg_idx;
+	cfg = &f->configs[cfg_idx];
+
+	ret = tas2557_reset_and_init(tas);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * The safe-guard register reads back a fixed pattern only while the
+	 * device is answering properly; downstream treats a mismatch as the
+	 * device having fallen off the bus.
+	 */
+	for (idx = 0; idx < 2; idx++) {
+		ret = tas2557_read(tas, idx, TAS2557_SAFE_GUARD_REG, &guard);
+		if (ret < 0)
+			return ret;
+
+		if (guard != TAS2557_SAFE_GUARD_PATTERN) {
+			dev_err(tas->dev, "%s safe guard reads 0x%02x, want 0x%02x\n",
+				idx ? "right" : "left", guard,
+				TAS2557_SAFE_GUARD_PATTERN);
+			return -EPIPE;
+		}
+	}
+
+	dev_dbg(tas->dev, "loading program %u and configuration %s\n",
+		cfg->program, cfg->name);
+
+	ret = tas2557_load_data(tas, &f->programs[cfg->program].data);
+	if (ret < 0)
+		return ret;
+
+	tas->cur_program = cfg->program;
+
+	ret = tas2557_load_block(tas, &f->plls[cfg->pll].block);
+	if (ret < 0)
+		return ret;
+
+	ret = tas2557_load_data(tas, &cfg->data);
+	if (ret < 0)
+		return ret;
+
+	tas->loaded_config = cfg_idx;
+
+	dev_info(tas->dev, "loaded %s\n", cfg->name);
+
+	return 0;
+}
+
+static int tas2557_power_up(struct tas2557 *tas)
+{
+	struct tas2557_config *cfg;
+	int ret;
+
+	if (tas->powered || tas->loaded_config < 0)
+		return 0;
+
+	cfg = &tas->fw.configs[tas->loaded_config];
+
+	ret = tas2557_run_seq(tas, cfg->devices, tas2557_startup_seq);
+	if (ret < 0)
+		return ret;
+
+	/*
+	 * After the DSP comes up, not before: powering it re-applies the port
+	 * settings from the downloaded program, which puts the word length back
+	 * to the 24 bits the firmware was built for and silently drops
+	 * everything the SoC sends at any other width.
+	 */
+	ret = tas2557_set_word_len(tas, tas->width);
+	if (ret < 0)
+		return ret;
+
+	ret = tas2557_run_seq(tas, cfg->devices, tas2557_unmute_seq);
+	if (ret < 0)
+		return ret;
+
+	tas->powered = true;
+
+	return 0;
+}
+
+static int tas2557_power_down(struct tas2557 *tas)
+{
+	int ret;
+
+	if (!tas->powered)
+		return 0;
+
+
+	ret = tas2557_run_seq(tas, TAS_CHAN_BOTH, tas2557_shutdown_seq);
+	tas->powered = false;
+
+	/*
+	 * Shutting down takes POWER_CTRL1 to 0, which drops the DSP and with it
+	 * the downloaded program -- so it has to be sent again next time. Without
+	 * this the first playback after a reload works and every later one fails
+	 * with EIO, which is a confusing way to find out.
+	 */
+	tas->loaded_config = -1;
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------ ASoC */
+
+/*
+ * The firmware configuration leaves the serial port at 24-bit -- that is what
+ * the vendor devicetree asks for with ti,i2s-bits. Anything else on the wire is
+ * simply not framed, and the part sits there powered, unmuted and silent with
+ * nothing to complain about. So the width has to follow the stream, and it has
+ * to be written after the configuration is loaded, not before.
+ */
+static int tas2557_set_word_len(struct tas2557 *tas, unsigned int width)
+{
+	u8 val;
+	int ret;
+
+	switch (width) {
+	case 16:
+		val = 0;
+		break;
+	case 20:
+		val = 1;
+		break;
+	case 24:
+		val = 2;
+		break;
+	case 32:
+		val = 3;
+		break;
+	default:
+		dev_err(tas->dev, "unsupported sample width %u\n", width);
+		return -EINVAL;
+	}
+
+	ret = tas2557_update_bits(tas, TAS_CHAN_BOTH, TAS2557_ASI1_DAC_FORMAT_REG,
+				  TAS2557_ASI1_WORD_LEN_MASK,
+				  FIELD_PREP(TAS2557_ASI1_WORD_LEN_MASK, val));
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int tas2557_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct tas2557 *tas = snd_soc_component_get_drvdata(dai->component);
+	int ret;
+
+	tas->width = params_width(params);
+
+	return tas2557_setup(tas, params_rate(params));
+}
+
+static int tas2557_trigger(struct snd_pcm_substream *substream, int cmd,
+			   struct snd_soc_dai *dai)
+{
+	struct tas2557 *tas = snd_soc_component_get_drvdata(dai->component);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		return tas2557_power_up(tas);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		return tas2557_power_down(tas);
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops tas2557_dai_ops = {
+	.hw_params = tas2557_hw_params,
+	.trigger = tas2557_trigger,
+};
+
+static struct snd_soc_dai_driver tas2557_dai = {
+	.name = "tas2557-asi1",
+	.playback = {
+		.stream_name = "ASI1 Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE,
+	},
+	.ops = &tas2557_dai_ops,
+};
