--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -416,6 +416,17 @@ config DRM_PANEL_LG_LG4573
 	  Say Y here if you want to enable support for LG4573 RGB panel.
 	  To compile this driver as a module, choose M here.
 
+config DRM_PANEL_LG_SW43402
+	tristate "LG SW43402 DSI cmd mode panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	select DRM_DISPLAY_HELPER
+	select VIDEOMODE_HELPERS
+	help
+	  Say Y here if you want to enable support for the LG SW43402 DSI
+	  command mode panel found in the Google Pixel 2 XL. The panel
+	  resolution is 1440x2880@60Hz.
+
