95e3d1ec34eee3af40edcc0d655d43724dce6ec003a88d4a4c0d388e1711619b2727c1656d2b491480155bed799fecd6ae3edb2044f272b21d2ca3ae4552d809  overview-thumbnail-from-the-visible-region.patch
"
