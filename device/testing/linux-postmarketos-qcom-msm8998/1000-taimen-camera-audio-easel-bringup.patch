+static int lg_sw43402_probe_reg_set(const char *val,
+				    const struct kernel_param *kp)
+{
+	struct lg_sw43402 *ctx = READ_ONCE(lg_sw43402_probe_ctx);
+	u8 reg, data = 0xaa;
+	int ret;
