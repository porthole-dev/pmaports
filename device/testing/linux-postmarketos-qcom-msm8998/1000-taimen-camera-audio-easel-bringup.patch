+static const struct iio_chan_spec_ext_info qcom_smgr_iio_ext_info[] = {
+	IIO_MOUNT_MATRIX(IIO_SHARED_BY_DIR, qcom_smgr_iio_get_mount_matrix),
+	{ }
+};
