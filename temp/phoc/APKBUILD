# Forked from Alpine to carry upstream-bound fixes:
#
#   0001  phoc segfaults in the thumbnail render path when a surface texture
#         has been dropped by a GPU reset (has_buffer() != get_texture()).
#   0002  recreate_renderer() never damages the outputs it re-inits, so after a
#         reset the screen keeps whatever the dead renderer left behind. Static
#         layer-surfaces -- the panel, the OSK -- never repaint and stay visibly
#         corrupt until something else forces a full repaint.
#   0003  bundled wlroots collapses {LINEAR, INVALID} to INVALID-only in the
#         v3 dmabuf modifier events (an XWayland workaround); on freedreno
#         every format is exactly that pair, and GStreamer waylandsink drops
#         INVALID by policy, so hardware video falls back to 5 fps CPU
#         convert. See the patch header; root-caused 2026-09-01.
#   0004  a wlr_client_buffer's texture is dropped when the renderer that
#         imported it is destroyed, and nothing ever puts it back, so after a
#         GPU reset every static layer-surface stays blank for the session.
#   0005  phoc never touches wlr_output_layer, so every frame of an offloaded
#         browser or video surface is textured through the GPU. On msm8998
#         that pins the Adreno 540 at 710 MHz and the die at 77 C even with
#         the video PAUSED. Put it on one of the DPU's seven idle planes.
#         Needs libliftoff: wlroots implements DRM layers only there, which
#         is why -Dwlroots:libliftoff=enabled is not optional.
#
# Verified still missing upstream in 0.57.0: src/render.c calls
# wlr_output_init_render() at line 141 and the string "damage_whole" does not
# appear in the file at all.
#
# WHY pkgrel IS 50 AND NOT 3
#   Alpine/pmOS ship phoc from the same pkgver. apk installs the HIGHEST
#   version it can see regardless of which repo it came from, so a local build
#   at -r3 loses to a stock -r4 and the patches vanish with no warning. This is
#   not hypothetical: on 2026-08-29 a fresh install pulled stock 0.57.0-r0 over
#   the local patched 0.56.0-r2 and both patches were silently dropped, which
#   cost most of a session on 2026-08-30 chasing the resulting corruption as if
#   it were a WebKit/Skia bug. A deliberately high pkgrel keeps this build
#   winning for the whole life of a pkgver.
#
#   It does NOT survive a pkgver bump -- upstream 0.58.0 outranks 0.57.0-r50,
#   by design, because silently pinning a compositor forever is worse. That
#   transition is what tools/tk-phoccheck.sh exists to catch.
#
# Drop this fork once both patches are in a phoc release.
maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=phoc
pkgver=0.57.0
pkgrel=62
pkgdesc="wlroots based Phone compositor for the Phosh shell"
arch="all"
url="https://gitlab.gnome.org/World/Phosh/phoc"
license="GPL-3.0-only"
depends="
	$pkgname-schemas
	dbus
	gsettings-desktop-schemas
	mutter-schemas
	"
_wlrootsmakedepends="
	eudev-dev
	libliftoff-dev
	glslang
	hwdata-dev
	libcap-dev
	libdisplay-info-dev
	libseat-dev
	libxcb-dev
	xcb-util-image-dev
	xcb-util-renderutil-dev
	xcb-util-wm-dev
	xkeyboard-config-dev
	xwayland-dev
	"
makedepends="
	glib-dev
	gmobile-dev
	gnome-desktop-dev
	json-glib-dev
	libdrm-dev
	libinput-dev
	libxkbcommon-dev
	mesa-dev
	meson
	pixman-dev
	py3-docutils
	wayland-dev
	wayland-protocols
	$_wlrootsmakedepends
	"
checkdepends="xvfb-run"
subpackages="
	$pkgname-dbg
	$pkgname-doc
	$pkgname-lang
	$pkgname-schemas::noarch
	"
options="!check" # Needs fullblown EGL
source="https://sources.phosh.mobi/releases/phoc/phoc-${pkgver/_/.}.tar.xz
	0001-render-don-t-hand-a-NULL-texture-to-the-thumbnail-ren.patch
	0002-render-repaint-every-output-after-recreating-the-rend.patch
	0003-linux-dmabuf-v1-send-the-explicit-LINEAR-modifier-to-v3.patch
	0004-wlroots-compositor-re-import-a-texture-lost-with-its-.patch
	0005-output-hand-a-hole-punched-surface-to-a-hardware-pla.patch
	"
replaces="wlroots-phosh"
builddir="$srcdir/$pkgname-${pkgver/_/.}"

prepare() {
	default_prepare

	patch -Np1 < subprojects/packagefiles/wlroots/0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch \
		-d subprojects/wlroots-0.20.x
}

build() {
	abuild-meson \
		-Db_lto=true \
		-Dwlroots:libliftoff=enabled \
		-Dembed-wlroots=enabled \
		-Dman=true \
		-Dtests="$(want_check && echo true || echo false)" \
		--default-library=static \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir/" meson install --no-rebuild -C output
	install -Dm755 tools/scale-to-fit \
		-t "$pkgdir"/usr/bin

	# remove unneeded wlroots dev. files
	rm -r "$pkgdir"/usr/include
	rm -r "$pkgdir"/usr/lib/libwlroots-*.a
	rm -r "$pkgdir"/usr/lib/pkgconfig
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=

	amove usr/share/glib-2.0/schemas
}

