5997cb0e3bfc0f625a0803d2d59fa55ce34baf7aee7c4fb3d82c74ea680d916a4e1294bbaf97a4567053672f1115d51f2a8b887927af063e2750e6a0e40d8d64  hack-generate-rules-instead-of-hwdb.patch
3d886f4333938d2444988967dc91c648db2e60829f0a6458edcb5c52cce9454b9398b8b2b959e643bce4d2afcf483f4141683cab15e0d4ec545399ade87803db  0001-drivers-add-fpctee-FPC-match-on-chip-sensors-behind-.patch
