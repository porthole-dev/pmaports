+        for child in (task / "children").read_text().split():
+            try:
+                comm = pathlib.Path(f"/proc/{child}/comm").read_text().strip()
+            except OSError:
+                continue
+            if comm == "xdg-dbus-proxy":
+                found.append(int(child))
