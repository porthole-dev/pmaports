index be97e6c..fc843bc 100644
--- a/src/nfc.c
+++ b/src/nfc.c
@@ -63,6 +63,11 @@ struct _Nfc
    * from it -- a proxy exiting, and the caller leaving the bus -- run on a
    * main context. */
   GHashTable *proxies;
+
+  /* Watches the permission store, so that revoking NFC in Settings closes the
+   * connections an application already holds instead of only refusing its
+   * next request. */
+  guint permissions_changed_id;
 };
 
 /* The tree's convention for a table reached from more than one thread; see
@@ -308,6 +313,7 @@ typedef struct
   GSubprocess *subprocess;
   int sync_fd;
   char *sender;
+  char *app_id;
