@@ -698,6 +762,12 @@ void DebayerEGL::stop()
 
 	if (programId_)
 		glDeleteProgram(programId_);
+
+	if (lscTexture_) {
+		glDeleteTextures(1, &lscTexture_);
+		lscTexture_ = 0;
+		lscUploaded_.clear();
+	}
 }
 
