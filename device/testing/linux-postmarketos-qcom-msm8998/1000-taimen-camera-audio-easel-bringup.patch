+&cci_i2c1 {
+	/*
+	 * Address is a bring-up guess: the vendor DT does NOT carry it (the
+	 * downstream camera framework gets the slave address from the userspace
+	 * sensor library, not from DT), and 0x10 is the usual IMX179 7-bit
+	 * address. If the driver reports it cannot read the chip ID, scan this
+	 * bus WITH THE RAILS UP -- a scan while unpowered proves nothing, which
+	 * is why the M1 comment above forbids the naive version.
+	 */
+	imx179: camera@10 {
+		compatible = "sony,imx179";
+		reg = <0x10>;
+
+		/*
+		 * 0 = FRONT; see the imx362 node for why these matter.
+		 * rotation 90 (owner-verified on the live viewfinder). Selfie
+		 * previews are MIRRORED by apps, and mirror(rot270) == rot90 --
+		 * that mirror confound is how 270 once looked right in an
+		 * unmirrored capture. Trust the live preview.
+		 */
+		orientation = <0>;
+		rotation = <90>;
+
+		/*
+		 * The rate goes on the RCG SOURCE, not on the leaf branch.
+		 * The vendor node names both -- clk_mclk1_clk_src as
+		 * "cam_src_clk" with qcom,clock-rates = <24000000 0>, and the
+		 * branch as "cam_clk" with rate 0 -- and cam_soc_api.c
+		 * round_rate/set_rate's each clock before enabling it. Setting
+		 * 24 MHz on the branch and relying on CLK_SET_RATE_PARENT does
+		 * NOT stick: clk_set_rate() returns 0 and the clock stays at its
+		 * 300 MHz power-on default (GPLL0_DIV straight through), and the
+		 * sensor then never answers on I2C -- which reads as a wrong
+		 * address, not as a clock fault.
+		 */
+		/*
+		 * Deliberately NO assigned-clocks here. mclk1_clk_src is a plain
+		 * clk_rcg2: configuring it writes the new M/N and then polls the
+		 * UPDATE bit, which only clears once the RCG root is running. At
+		 * probe time nothing has enabled the branch yet, so that poll
+		 * times out, the RCG is left half-configured, and the subsequent
+		 * clk_prepare_enable() fails with -EBUSY. The driver sets the
+		 * rate itself, after enabling the branch.
+		 */
+		clocks = <&mmcc CAMSS_MCLK1_CLK>;
+
+		/*
+		 * MCLK1 is inside the CAMSS domain. Without this, writes to the
+		 * mmcc RCG are silently dropped -- clk_set_rate() returns 0 and
+		 * the clock stays at 300 MHz. CCI only works because it takes
+		 * the same domain (see the cci node); nothing else was holding
+		 * it on for the sensor's clock.
+		 */
+		power-domains = <&mmcc CAMSS_TOP_GDSC>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk1_default>;
+
+		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+
+		vio-supply = <&vreg_lvs1a_1p8>;
+		vdig-supply = <&cam1_dvdd>;
+		vana-supply = <&cam1_avdd>;
+
+		port {
+			imx179_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				/*
+				 * From the vendor's sensor_lib_out_info_t in
+				 * libmmcamera_imx179.so (0xa8bc8): op_pixel_clk
+				 * is 136 / 216 / 259.2 MHz, and link_freq =
+				 * op_pixel_clk * 10 bpp / (2 * 4 lanes). These
+				 * are DOUBLE what was here before -- the old
+				 * derivation divided by an extra 2 and then
+				 * read "lands on pll_multiplier MHz" as
+				 * confirmation. It lands on 2x that.
+				 */
+				link-frequencies = /bits/ 64 <170000000 270000000 324000000>;
+				remote-endpoint = <&camss_ep_front>;
+			};
+		};
+	};
+};
