From 1ccdd7246efb32be791de78885e939ef58cd3a77 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Mon, 10 Aug 2026 15:58:46 +0200
Subject: [PATCH 106/115] misc: easel-mipi: drop the open-coded BAR assignment

The BARs were left unplaced because Easel's zero class code kept the
PCI core from sizing a bridge window for them; assigning them from
probe could never have worked, and now that the class is quirked the
core places them before the driver is bound.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/misc/easel-mipi.c | 21 +--------------------
 1 file changed, 1 insertion(+), 20 deletions(-)

diff --git a/drivers/misc/easel-mipi.c b/drivers/misc/easel-mipi.c
index 0d8a24636c4d..c8c99d909db8 100644
--- a/drivers/misc/easel-mipi.c
+++ b/drivers/misc/easel-mipi.c
@@ -825,7 +825,7 @@ static int easel_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 {
 	struct easel *easel;
 	u32 ctrl2, off;
-	int i, ret;
+	int ret;
 
 	easel = devm_kzalloc(&pdev->dev, sizeof(*easel), GFP_KERNEL);
 	if (!easel)
@@ -834,25 +834,6 @@ static int easel_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	easel->pdev = pdev;
 	easel->window = ~0;
 
-	/*
-	 * The PCI core sizes this port's bridge windows to fit Easel but never
-	 * places the endpoint's own BARs -- they stay at address 0 with
-	 * COMMAND=0x0000, so pci_enable_device() fails with "BAR 0 not
-	 * claimed" and any MMIO to them hangs the fabric. Assign them here.
-	 */
-	for (i = 0; i < PCI_STD_NUM_BARS; i++) {
-		struct resource *r = &pdev->resource[i];
-
-		if (!r->flags || r->parent || resource_size(r) == 0)
-			continue;
-		ret = pci_assign_resource(pdev, i);
-		if (ret)
-			dev_warn(&pdev->dev, "BAR %d assign failed: %d\n",
-				 i, ret);
-		else
-			dev_info(&pdev->dev, "BAR %d assigned %pr\n", i, r);
-	}
-
 	ret = pcim_enable_device(pdev);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "cannot enable device\n");
