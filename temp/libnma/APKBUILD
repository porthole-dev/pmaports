4ff69c52296a436c1ec58bc004d47aa6da89e1ea235d3fa2b043eb3ccee484899c51c3309b8df3c80c34c051029d265396d3cdde19ac17fdf3d49a2adebf95d4  resolve-mvnos-sharing-an-mcc-mnc.patch
"
