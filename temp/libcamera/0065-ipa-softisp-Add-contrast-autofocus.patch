new file mode 100644
index 000000000..06902b02c
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast autofocus
+ */
+
+#pragma once
+
+#include <libcamera/control_ids.h>
+
+#include <libipa/pwl.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Scan { Idle, Coarse, Fine, Locked };
+
+	void startScan();
+	void step(uint64_t sharpness);
+
+	/* Lens position in dioptres to actuator code, and back. */
+	Pwl map_;
+	Pwl inverseMap_;
+	int32_t codeMin_ = 0;
+	int32_t codeMax_ = 0;
+	int32_t coarseStep_ = 0;
+	int32_t fineStep_ = 0;
+
+	controls::AfModeEnum mode_ = controls::AfModeContinuous;
+	controls::AfStateEnum state_ = controls::AfStateIdle;
+	Scan scan_ = Scan::Idle;
+
+	int32_t code_ = 0;
+	int32_t bestCode_ = 0;
+	uint64_t bestSharpness_ = 0;
+	uint64_t worstSharpness_ = 0;
+	int32_t fineDir_ = 0;
+	uint64_t lockedSharpness_ = 0;
+	unsigned int lowFrames_ = 0;
+	unsigned int warmup_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
