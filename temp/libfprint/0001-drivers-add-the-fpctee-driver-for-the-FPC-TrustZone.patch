+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ */
+
+#ifndef FPC_TZ_H
+#define FPC_TZ_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Command numbering is NOT vendor-stable.  Sony needed two tables for their
+ * own devices (CAPTURE_IMAGE 0x0F -> 0x03, WAIT_FINGER_DOWN 0x07 -> 0x02,
+ * GET_FINGERPRINTS 0x0D -> 0x07), so the numbering lives here as data and is
+ * selected at runtime by fpc_tz_probe().  Never hardcode a command id.
+ */
+#define FPC_TZ_ABSENT 0xffu     /* command/group does not exist in this table */
+
+typedef struct
+{
+  const char *name;
+
+  /* groups */
+  uint8_t grp_normal;           /* loire only: everything lives here */
+  uint8_t grp_db;
+  uint8_t grp_fpcdata;
+  uint8_t grp_qc;
+  uint8_t grp_info;             /* absent on loire — this is the discriminator */
+  uint8_t grp_sensor;
+  uint8_t grp_template;
+
+  /* grp_db */
+  uint8_t load_db;
+  uint8_t store_db;
+
+  /* grp_info */
+  uint8_t get_fpc_info;
+
+  /* grp_sensor */
+  uint8_t wait_finger_lost;
+  uint8_t wait_finger_down;
+  uint8_t capture_image;
+  uint8_t deep_sleep;
+  uint8_t get_otp_info;
+
+  /* grp_template */
+  uint8_t begin_enrol;
+  uint8_t enrol_step;
+  uint8_t end_enrol;
+  uint8_t identify;
+  uint8_t update_template;
+  uint8_t load_empty_db;
+  uint8_t get_fingerprints;
+  uint8_t set_gid;
+  uint8_t delete_fingerprint;
+  uint8_t get_template_id;
+} fpc_tz_table;
+
+/* yoshino/nile/tama generation — the one taimen is expected to be on */
+extern const fpc_tz_table fpc_tz_table_yoshino;
+/* loire/tone generation — kept so a mismatch has somewhere to land */
+extern const fpc_tz_table fpc_tz_table_loire;
+
+/* Look a table up by name ("yoshino", "loire"); NULL if unknown. */
+const fpc_tz_table *fpc_tz_table_by_name (const char *name);
+
+/*
+ * Transport.
+ *
+ * xfer() is the "modified command": the caller hands over a buffer holding a
+ * request struct, the TA reads it, writes its response into the same buffer
+ * in place, and the call returns 0 on success or negative on a transport/TA
+ * fault (which is NOT the same thing as a command that ran and failed).
+ *
+ * wait_event() blocks until the sensor IRQ fires after WAIT_FINGER_DOWN /
+ * WAIT_FINGER_LOST have armed it.  Returns 1 on a finger event, 0 if
+ * cancelled or timed out, negative on error.  May be NULL only if the caller
+ * never uses the finger-detect helpers.
+ *
+ * cancel() unblocks a pending wait_event() from another thread.  Optional.
+ */
+typedef struct
+{
+  int (*xfer) (void *ctx, void *buf, size_t len);
+  int (*wait_event) (void *ctx, int timeout_ms);
+  void (*cancel) (void *ctx);
+} fpc_tz_ops;
+
+typedef struct
+{
+  const fpc_tz_ops   *ops;
+  void               *ctx;
+  const fpc_tz_table *tab;      /* NULL until fpc_tz_probe()/select() */
+  uint32_t            info;     /* whatever GET_FPC_INFO returned */
+} fpc_tz;
+
+/* Errors.  Kept distinct because they route to different humans. */
+#define FPC_TZ_OK            0
+#define FPC_TZ_ETRANSPORT  (-1) /* no answer at all: QSEECom/TA problem */
+#define FPC_TZ_EGENERATION (-2) /* answered, but not with this numbering */
+#define FPC_TZ_ESTATUS     (-3) /* command ran and reported failure */
+#define FPC_TZ_EINVAL      (-4)
+
+#define FPC_TZ_MAX_PRINTS  5    /* FINGERPRINT_MAX_COUNT */
+
+void fpc_tz_init (fpc_tz *s, const fpc_tz_ops *ops, void *ctx);
+
+/*
+ * The first command ever sent to the TA: INFO 0x09 / GET_FPC_INFO 0x02.
+ * Group 0x09 does not exist in the loire table, so the group id alone
+ * discriminates the generation, and the command is non-mutating.
+ *
+ *   FPC_TZ_OK          -> yoshino numbering, tab is set, proceed
+ *   FPC_TZ_EGENERATION -> the TA answered but not to group 0x09.  db_path is
+ *                         then used for a DB 0x2 / LOAD_DB 0x0B fallback,
+ *                         which is stable across both tables, purely to prove
+ *                         the transport before anyone blames the numbering.
+ *                         *transport_ok tells the two apart.  No table is
+ *                         guessed: recovering the numbering is RE work.
+ *   FPC_TZ_ETRANSPORT  -> nothing answered.  Debug QSEECom, not the protocol.
+ *
+ * db_path may be NULL to skip the fallback; transport_ok may be NULL.
+ */
+int fpc_tz_probe (fpc_tz *s, const char *db_path, int *transport_ok);
+
+/* Bring-up escape hatch for when probe says "not yoshino". */
+int fpc_tz_select_table (fpc_tz *s, const char *name);
+
+/* Template database (opaque, TA-encrypted; the normal world only stores it). */
+int fpc_tz_load_db (fpc_tz *s, const char *path);
+int fpc_tz_store_db (fpc_tz *s, const char *path);
+int fpc_tz_load_empty_db (fpc_tz *s);
+int fpc_tz_set_gid (fpc_tz *s, uint32_t gid);
+
+/* Sensor. */
+int fpc_tz_wait_finger_down (fpc_tz *s, int timeout_ms);
+int fpc_tz_wait_finger_lost (fpc_tz *s, int timeout_ms);
+int fpc_tz_capture_image (fpc_tz *s);
+int fpc_tz_deep_sleep (fpc_tz *s);
+void fpc_tz_cancel (fpc_tz *s);
+
+/* Enrol. */
+int fpc_tz_begin_enrol (fpc_tz *s);
+int fpc_tz_enrol_step (fpc_tz *s, uint32_t *remaining_touches);
+int fpc_tz_end_enrol (fpc_tz *s, uint32_t *print_id);
+
+/* Match on chip. */
+int fpc_tz_identify (fpc_tz *s, uint32_t *print_id);
+int fpc_tz_update_template (fpc_tz *s, int *changed);
+
+/* Storage. */
+int fpc_tz_get_fingerprints (fpc_tz *s, uint32_t *ids, uint32_t *count);
+int fpc_tz_delete_fingerprint (fpc_tz *s, uint32_t id);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* FPC_TZ_H */
