+/*
+ * Elmyra, the squeeze sensor along the lower edges. Three values per report,
+ * measured: squeezing moves the first by roughly 4600 counts on a ~67062400
+ * offset, which is a strain gauge bridge with a large DC bias, not a scaled
+ * quantity. What the three are individually is NOT established -- plausibly
+ * two gauges and something fused, but that is a guess -- so they are exposed
+ * raw and unnamed rather than given units this driver cannot justify.
+ *
+ * Squeeze detection is a threshold, and a threshold is policy: it belongs in
+ * userspace, which can also calibrate out the bias.
+ */
+static const struct iio_chan_spec qcom_smgr_elmyra_iio_channels[] = {
+	QCOM_SMGR_INDEX_CHANNEL(0),
