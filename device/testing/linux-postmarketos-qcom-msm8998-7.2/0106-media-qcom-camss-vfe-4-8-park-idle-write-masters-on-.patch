From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Tue, 18 Aug 2026 13:08:10 +0200
Subject: [PATCH] media: qcom: camss: vfe-4-8: park idle write masters on a
 scratch page

When a write master is disabled the driver leaves the last frame
buffer's IOVA in its ping and pong address registers. Once userspace
closes the video node that buffer is unmapped from the camera SMMU, and
any straggler write the master still had in flight faults against an
unmapped address.

The fault is silent: stream stop completes normally, and a few seconds
later the display controller -- which shares the NoC -- begins timing
out frame-done, and the watchdog resets the SoC. On msm8998 this
reproduces every time a camera application switches between the front
and rear sensor.

Downstream parks idle write masters on a scratch buffer. Do the same:
one coherent page per VFE, pointed at by both addresses, with the
address limits holding any oversized write on that page. The page is
allocated at subdev init rather than on first use, because
vfe_disable_output() disables the write masters with output_lock held
and nothing may sleep there.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 .../media/platform/qcom/camss/camss-vfe-4-8.c | 39 +++++++++++++++++++
 drivers/media/platform/qcom/camss/camss-vfe.h |  3 ++
 2 files changed, 42 insertions(+)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
index ecc775729412..1968e8fd4353 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-8.c
@@ -9,6 +9,7 @@
  */
 
 #include <linux/device.h>
+#include <linux/dma-mapping.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
@@ -1048,6 +1049,35 @@ static u16 vfe_get_ub_size(u8 vfe_id)
 	return MSM_VFE_VFE0_UB_SIZE_RDI;
 }
 
+/*
+ * Park a write master's ping/pong addresses on an always-mapped scratch page.
+ *
+ * Downstream keeps a scratch buffer for idle write masters; mainline leaves the
+ * last frame buffer's IOVA in the write master instead. Once userspace closes
+ * the video node those IOVAs are unmapped from the camera SMMU, and a straggler
+ * write from the disabled master faults. The fault stalls the fabric silently:
+ * stream stop completes, then a few seconds later the display controller -- on
+ * the same NoC -- starts timing out frame-done, and the watchdog resets the SoC.
+ * The address limit keeps anything larger than the page on the page.
+ *
+ * Register writes only: vfe_disable_output() calls this with output_lock held,
+ * so the page itself is allocated once at subdev init.
+ */
+static void vfe_wm_park(struct vfe_device *vfe, u8 wm)
+{
+	u32 iova = lower_32_bits(vfe->scratch_iova);
+
+	if (!vfe->scratch)
+		return;
+
+	writel_relaxed(iova, vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR(wm));
+	writel_relaxed(iova + PAGE_SIZE,
+		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PING_ADDR_LIMIT(wm));
+	writel_relaxed(iova, vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR(wm));
+	writel_relaxed(iova + PAGE_SIZE,
+		       vfe->base + VFE_0_BUS_IMAGE_MASTER_n_WR_PONG_ADDR_LIMIT(wm));
+}
+
 static void vfe_wm_enable(struct vfe_device *vfe, u8 wm, u8 enable)
 {
 	if (enable)
@@ -1059,6 +1089,9 @@ static void vfe_wm_enable(struct vfe_device *vfe, u8 wm, u8 enable)
 
 	/* The WM must be enabled before sending other commands */
 	wmb();
+
+	if (!enable)
+		vfe_wm_park(vfe, wm);
 }
 
 static void vfe_set_qos(struct vfe_device *vfe)
@@ -1161,6 +1194,12 @@ static const struct vfe_hw_ops_gen1 vfe_ops_gen1_4_8 = {
 
 static void vfe_subdev_init(struct device *dev, struct vfe_device *vfe)
 {
+	vfe->scratch = dmam_alloc_coherent(dev, PAGE_SIZE, &vfe->scratch_iova,
+					   GFP_KERNEL);
+	if (!vfe->scratch)
+		dev_warn(dev,
+			 "no scratch page, idle write masters keep the last buffer\n");
+
 	vfe->isr_ops = vfe_isr_ops_gen1;
 	vfe->ops_gen1 = &vfe_ops_gen1_4_8;
 	vfe->video_ops = vfe_video_ops_gen1;
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.h b/drivers/media/platform/qcom/camss/camss-vfe.h
index d95659b840dd..39ec27f4a58e 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.h
+++ b/drivers/media/platform/qcom/camss/camss-vfe.h
@@ -154,6 +154,9 @@ struct vfe_device {
 	 * are only handed an address.
 	 */
 	u32 sizeimage;
+	/* One always-mapped page that idle write masters are parked on. */
+	void *scratch;
+	dma_addr_t scratch_iova;
 	u32 irq;
 	char irq_name[30];
 	struct camss_clock *clock;
