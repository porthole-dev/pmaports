From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Tue, 25 Aug 2026 20:58:07 +0200
Subject: [PATCH] regulator: qcom_smd: Add RPM sleep-set support via suspend
 states

The driver has only ever written the RPM active set.  Per the RPM
interface contract (documented in the downstream rpm-smd-regulator
binding), an active-set request with no corresponding sleep-set request
stays in effect across APSS power collapse: every rail this driver has
ever enabled is pinned at its active vote even while the SoC sleeps,
and the RPM can never turn it off or lower it, which blocks the
VDD_MIN/XO-shutdown system states.

Add sleep-set writes with deliberately conservative semantics:

 - By default nothing changes.  No sleep-set request is ever sent for a
   rail unless its board DT declares a suspend state
   (regulator-state-mem etc.), so the active vote keeps ruling across
   power collapse exactly as before.

 - set_suspend_enable/disable/voltage write the requested state into
   the RPM sleep set.  The RPM only applies the sleep set while the
   APSS is in RPM-assisted power collapse, so writing it from the
   regulator suspend path is safe at any point of the suspend
   sequence.

 - Since the RPM retains sleep-set requests across suspend cycles, the
   resume op and every subsequent active-set update rewrite the sleep
   set to mirror the active set ("mirror maintenance").  A sleep-set
   request that equals the active request is semantically identical to
   not having one, so this restores the pre-suspend behaviour while
   guaranteeing that a future idle-time power collapse can never apply
   a stale suspend request.

This mirrors the in-tree precedent for dual-set SMD-RPM writes in
rpmpd (which unconditionally posts both sets, with an active-only twin
carrying the sleep=0 vote) and the downstream rpm-smd-regulator, which
only sends sleep-set requests that differ from the active set.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/regulator/qcom_smd-regulator.c | 136 +++++++++++++++++++++++++
 1 file changed, 136 insertions(+)

diff --git a/drivers/regulator/qcom_smd-regulator.c b/drivers/regulator/qcom_smd-regulator.c
index 23ed594b574e..6f7792d1594d 100644
--- a/drivers/regulator/qcom_smd-regulator.c
+++ b/drivers/regulator/qcom_smd-regulator.c
@@ -23,10 +23,14 @@ struct qcom_rpm_reg {
 	int is_enabled;
 	int uV;
 	u32 load;
+	int suspend_uV;
 
 	unsigned int enabled_updated:1;
 	unsigned int uv_updated:1;
 	unsigned int load_updated:1;
+	unsigned int sleep_written:1;
+	unsigned int sleep_enabled:1;
+	unsigned int sleep_enabled_valid:1;
 };
 
 struct rpm_regulator_req {
@@ -81,6 +85,65 @@ static int rpm_reg_write_active(struct qcom_rpm_reg *vreg)
 	return ret;
 }
 
+/*
+ * RPM regulator requests are made in two sets: the active set, which is in
+ * effect while the application processor is running, and the sleep set,
+ * which is in effect while it is in RPM-assisted power collapse.  When no
+ * sleep set request exists for a resource, RPM keeps the active set
+ * request in effect across power collapse, so never writing the sleep set
+ * (the historic behaviour of this driver) is safe, but pins every rail at
+ * its active vote while the SoC sleeps.
+ *
+ * A sleep set request is therefore only sent for rails whose board DT
+ * declares a suspend state, and only diverges from the active set between
+ * the suspend and resume callbacks.  Once the sleep set of a rail has been
+ * written, it is kept mirroring the active set at all other times so that
+ * a power collapse can never apply a stale request.
+ */
+static int rpm_reg_write_sleep(struct qcom_rpm_reg *vreg, int enabled,
+			       int uV, u32 load)
+{
+	struct rpm_regulator_req req[3];
+	int reqlen = 0;
+	int ret;
+
+	req[reqlen].key = cpu_to_le32(RPM_KEY_SWEN);
+	req[reqlen].nbytes = cpu_to_le32(sizeof(u32));
+	req[reqlen].value = cpu_to_le32(enabled);
+	reqlen++;
+
+	if (enabled && uV > 0) {
+		req[reqlen].key = cpu_to_le32(RPM_KEY_UV);
+		req[reqlen].nbytes = cpu_to_le32(sizeof(u32));
+		req[reqlen].value = cpu_to_le32(uV);
+		reqlen++;
+	}
+
+	if (enabled && load) {
+		req[reqlen].key = cpu_to_le32(RPM_KEY_MA);
+		req[reqlen].nbytes = cpu_to_le32(sizeof(u32));
+		req[reqlen].value = cpu_to_le32(load / 1000);
+		reqlen++;
+	}
+
+	ret = qcom_rpm_smd_write(smd_vreg_rpm, QCOM_SMD_RPM_SLEEP_STATE,
+				 vreg->type, vreg->id,
+				 req, sizeof(req[0]) * reqlen);
+	if (!ret)
+		vreg->sleep_written = 1;
+
+	return ret;
+}
+
+static int rpm_reg_mirror_sleep(struct qcom_rpm_reg *vreg)
+{
+	if (!vreg->sleep_written)
+		return 0;
+
+	return rpm_reg_write_sleep(vreg, vreg->is_enabled, vreg->uV,
+				   vreg->load);
+}
+
 static int rpm_reg_enable(struct regulator_dev *rdev)
 {
 	struct qcom_rpm_reg *vreg = rdev_get_drvdata(rdev);
@@ -92,6 +155,8 @@ static int rpm_reg_enable(struct regulator_dev *rdev)
 	ret = rpm_reg_write_active(vreg);
 	if (ret)
 		vreg->is_enabled = 0;
+	else
+		ret = rpm_reg_mirror_sleep(vreg);
 
 	return ret;
 }
@@ -114,6 +179,8 @@ static int rpm_reg_disable(struct regulator_dev *rdev)
 	ret = rpm_reg_write_active(vreg);
 	if (ret)
 		vreg->is_enabled = 1;
+	else
+		ret = rpm_reg_mirror_sleep(vreg);
 
 	return ret;
 }
@@ -140,6 +207,8 @@ static int rpm_reg_set_voltage(struct regulator_dev *rdev,
 	ret = rpm_reg_write_active(vreg);
 	if (ret)
 		vreg->uV = old_uV;
+	else
+		ret = rpm_reg_mirror_sleep(vreg);
 
 	return ret;
 }
@@ -155,10 +224,58 @@ static int rpm_reg_set_load(struct regulator_dev *rdev, int load_uA)
 	ret = rpm_reg_write_active(vreg);
 	if (ret)
 		vreg->load = old_load;
+	else
+		ret = rpm_reg_mirror_sleep(vreg);
 
 	return ret;
 }
 
+static int rpm_reg_set_suspend_enable(struct regulator_dev *rdev)
+{
+	struct qcom_rpm_reg *vreg = rdev_get_drvdata(rdev);
+
+	vreg->sleep_enabled = 1;
+	vreg->sleep_enabled_valid = 1;
+
+	return rpm_reg_write_sleep(vreg, 1,
+				   vreg->suspend_uV ?: vreg->uV, vreg->load);
+}
+
+static int rpm_reg_set_suspend_disable(struct regulator_dev *rdev)
+{
+	struct qcom_rpm_reg *vreg = rdev_get_drvdata(rdev);
+
+	vreg->sleep_enabled = 0;
+	vreg->sleep_enabled_valid = 1;
+
+	return rpm_reg_write_sleep(vreg, 0, 0, 0);
+}
+
+static int rpm_reg_set_suspend_voltage(struct regulator_dev *rdev, int uV)
+{
+	struct qcom_rpm_reg *vreg = rdev_get_drvdata(rdev);
+	int enabled = vreg->sleep_enabled_valid ? vreg->sleep_enabled :
+						  vreg->is_enabled;
+
+	vreg->suspend_uV = uV;
+
+	return rpm_reg_write_sleep(vreg, enabled, uV, vreg->load);
+}
+
+static int rpm_reg_resume(struct regulator_dev *rdev)
+{
+	struct qcom_rpm_reg *vreg = rdev_get_drvdata(rdev);
+
+	vreg->suspend_uV = 0;
+	vreg->sleep_enabled_valid = 0;
+
+	/*
+	 * Re-mirror the active set so that an idle-time power collapse
+	 * after resume cannot apply the suspend request again.
+	 */
+	return rpm_reg_mirror_sleep(vreg);
+}
+
 static const struct regulator_ops rpm_smps_ldo_ops = {
 	.enable = rpm_reg_enable,
 	.disable = rpm_reg_disable,
@@ -169,6 +286,11 @@ static const struct regulator_ops rpm_smps_ldo_ops = {
 	.set_voltage = rpm_reg_set_voltage,
 
 	.set_load = rpm_reg_set_load,
+
+	.set_suspend_enable = rpm_reg_set_suspend_enable,
+	.set_suspend_disable = rpm_reg_set_suspend_disable,
+	.set_suspend_voltage = rpm_reg_set_suspend_voltage,
+	.resume = rpm_reg_resume,
 };
 
 static const struct regulator_ops rpm_smps_ldo_ops_fixed = {
@@ -180,12 +302,21 @@ static const struct regulator_ops rpm_smps_ldo_ops_fixed = {
 	.set_voltage = rpm_reg_set_voltage,
 
 	.set_load = rpm_reg_set_load,
+
+	.set_suspend_enable = rpm_reg_set_suspend_enable,
+	.set_suspend_disable = rpm_reg_set_suspend_disable,
+	.set_suspend_voltage = rpm_reg_set_suspend_voltage,
+	.resume = rpm_reg_resume,
 };
 
 static const struct regulator_ops rpm_switch_ops = {
 	.enable = rpm_reg_enable,
 	.disable = rpm_reg_disable,
 	.is_enabled = rpm_reg_is_enabled,
+
+	.set_suspend_enable = rpm_reg_set_suspend_enable,
+	.set_suspend_disable = rpm_reg_set_suspend_disable,
+	.resume = rpm_reg_resume,
 };
 
 static const struct regulator_ops rpm_bob_ops = {
@@ -195,6 +326,11 @@ static const struct regulator_ops rpm_bob_ops = {
 
 	.get_voltage = rpm_reg_get_voltage,
 	.set_voltage = rpm_reg_set_voltage,
+
+	.set_suspend_enable = rpm_reg_set_suspend_enable,
+	.set_suspend_disable = rpm_reg_set_suspend_disable,
+	.set_suspend_voltage = rpm_reg_set_suspend_voltage,
+	.resume = rpm_reg_resume,
 };
 
 static const struct regulator_ops rpm_mp5496_ops = {
