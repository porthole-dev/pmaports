#!/bin/sh
# Set the WiFi regulatory country automatically, the way Android does.
#
# Background: taimen's WLAN board data hardcodes regdomain 0x8348 (country
# 840 = US) even on EU units, and that domain is applied before wiphy
# registration, which freezes chan->orig_flags -- so 2.4 ch 12-13 and the whole
# 5470-5725 ETSI midband (ch 100-140) end up permanently disabled. The BDF
# cannot be edited (the WLAN firmware checksum-validates it), so the kernel is
# started with `ath.regd_override=0x67`, a permissive *world* SKU that pins no
# country at all and leaves every channel available.
#
# The country itself must then come from somewhere at runtime. Two sources, in
# order of preference:
#
#   1. The country IE in AP beacons. A world SKU gets
#      REGULATORY_COUNTRY_IE_FOLLOW_POWER, so the kernel adopts this on its own
#      with no help from us -- but only once an AP is actually heard.
#   2. The SIM's MCC, which is what Android uses and which works before any
#      association. This script supplies that.
#
# Deliberately does nothing if the MCC is unknown or unmapped: staying on the
# permissive world domain is the safe default, and the country IE may still
# arrive later.
set -u

log() { echo "taimen-wifi-country: $*"; }

command -v iw >/dev/null 2>&1 || { log "iw not installed"; exit 0; }

# If the kernel already learned a country (e.g. from a beacon), leave it alone.
CUR=$(iw reg get 2>/dev/null | awk '/^global/{getline; print substr($2,1,2); exit}')
case "${CUR:-00}" in
	00|99|"") ;;
	*) log "country already set to $CUR, nothing to do"; exit 0 ;;
esac

# Wait briefly for ModemManager to have a registered modem.
MCCMNC=""
i=0
while [ $i -lt 30 ]; do
	MCCMNC=$(mmcli -m any 2>/dev/null | sed -n 's/.*operator id: *\([0-9]\{5,6\}\).*/\1/p' | head -1)
	[ -n "$MCCMNC" ] && break
	sleep 2
	i=$((i + 1))
done

if [ -z "$MCCMNC" ]; then
	log "no registered modem/operator id; leaving world regulatory domain"
	exit 0
fi

MCC=$(echo "$MCCMNC" | cut -c1-3)

# MCC -> ISO 3166-1 alpha-2. Covers Europe plus the common non-EU codes; an
# unmapped MCC intentionally falls through to "leave it alone".
case "$MCC" in
	202) CC=GR ;; 204) CC=NL ;; 206) CC=BE ;; 208) CC=FR ;; 212) CC=MC ;;
	213) CC=AD ;; 214) CC=ES ;; 216) CC=HU ;; 218) CC=BA ;; 219) CC=HR ;;
	220) CC=RS ;; 221) CC=XK ;; 222) CC=IT ;; 226) CC=RO ;; 228) CC=CH ;;
	230) CC=CZ ;; 231) CC=SK ;; 232) CC=AT ;; 234|235) CC=GB ;; 238) CC=DK ;;
	240) CC=SE ;; 242) CC=NO ;; 244) CC=FI ;; 246) CC=LT ;; 247) CC=LV ;;
	248) CC=EE ;; 250) CC=RU ;; 255) CC=UA ;; 257) CC=BY ;; 259) CC=MD ;;
	260) CC=PL ;; 262) CC=DE ;; 266) CC=GI ;; 268) CC=PT ;; 270) CC=LU ;;
	272) CC=IE ;; 274) CC=IS ;; 276) CC=AL ;; 278) CC=MT ;; 280) CC=CY ;;
	282) CC=GE ;; 283) CC=AM ;; 284) CC=BG ;; 286) CC=TR ;; 288) CC=FO ;;
	293) CC=SI ;; 294) CC=MK ;; 295) CC=LI ;; 297) CC=ME ;;
	302) CC=CA ;; 310|311|312|313|314|315|316) CC=US ;; 334) CC=MX ;;
	404|405|406) CC=IN ;; 440|441) CC=JP ;; 450) CC=KR ;; 460) CC=CN ;;
	505) CC=AU ;; 530) CC=NZ ;; 655) CC=ZA ;; 724) CC=BR ;;
	*) log "MCC $MCC not mapped; leaving world regulatory domain"; exit 0 ;;
esac

log "SIM MCC $MCC -> country $CC"
iw reg set "$CC" 2>/dev/null || log "iw reg set $CC failed"
sleep 2
NOW=$(iw reg get 2>/dev/null | awk '/^global/{getline; print substr($2,1,2); exit}')
log "regulatory domain is now ${NOW:-unknown}"
exit 0
