From 12490ebd59e5d1821b207b311f2c3789144278c7 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sun, 9 Aug 2026 11:57:21 +0200
Subject: [PATCH 39/41] arm64: configs: taimen: fix symbols v6.18 Kconfig
 silently drops

Repair four more casualties of the 6.0-to-6.18 config migration, all of
the same class as the earlier QFPROM rename: olddefconfig drops a
symbol whose name or dependencies changed and the feature goes missing
with no error.

- RPMSG_QCOM_SMD=y: QCOM_SMD_RPM now depends on it (=m demoted the
  whole RPM chain to modules, on a rootfs whose UFS needs RPM
  regulators to probe - the 6.18 dark-boot root cause)
- ZRAM_BACKEND_LZ4=y: ZRAM_DEF_COMP_LZ4 is now gated behind the new
  per-backend symbols, so zram silently fell back to lzo-rle while
  deviceinfo asks for lz4 and zramctl failed with EINVAL
- drop stale BASE_SMALL=0 and CRYPTO_LIB_POLY1305_GENERIC=m lines,
  which are type-invalid on 6.18 and warn on every build
- drop USB_G_SERIAL: the dark-boot diagnostic instrument is no longer
  needed and conflicts with the configfs gadget (only one may own the
  UDC), which costs ssh over USB

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 arch/arm64/configs/taimen_defconfig | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/taimen_defconfig b/arch/arm64/configs/taimen_defconfig
index 8bab36dee1be..a200b8b08a58 100644
--- a/arch/arm64/configs/taimen_defconfig
+++ b/arch/arm64/configs/taimen_defconfig
@@ -687,7 +687,6 @@ CONFIG_HAVE_GCC_PLUGINS=y
 # end of General architecture-dependent options
 
 CONFIG_RT_MUTEXES=y
-CONFIG_BASE_SMALL=0
 CONFIG_MODULES=y
 # CONFIG_MODULE_FORCE_LOAD is not set
 CONFIG_MODULE_UNLOAD=y
@@ -1539,6 +1538,7 @@ CONFIG_OF_RESERVED_MEM=y
 CONFIG_BLK_DEV=y
 # CONFIG_BLK_DEV_NULL_BLK is not set
 CONFIG_ZRAM=m
+CONFIG_ZRAM_BACKEND_LZ4=y
 CONFIG_ZRAM_DEF_COMP_LZ4=y
 CONFIG_ZRAM_DEF_COMP="lz4"
 # CONFIG_ZRAM_WRITEBACK is not set
@@ -3719,7 +3719,7 @@ CONFIG_USB_FUNCTIONFS=m
 # CONFIG_USB_FUNCTIONFS_RNDIS is not set
 CONFIG_USB_FUNCTIONFS_GENERIC=y
 # CONFIG_USB_MASS_STORAGE is not set
-CONFIG_USB_G_SERIAL=y
+# CONFIG_USB_G_SERIAL is not set
 # CONFIG_USB_MIDI_GADGET is not set
 # CONFIG_USB_G_PRINTER is not set
 # CONFIG_USB_CDC_COMPOSITE is not set
@@ -4292,7 +4292,7 @@ CONFIG_RPMSG_NS=m
 CONFIG_RPMSG_QCOM_GLINK=y
 CONFIG_RPMSG_QCOM_GLINK_RPM=y
 CONFIG_RPMSG_QCOM_GLINK_SMEM=y
-CONFIG_RPMSG_QCOM_SMD=m
+CONFIG_RPMSG_QCOM_SMD=y
 # CONFIG_RPMSG_VIRTIO is not set
 # end of Rpmsg drivers
 
@@ -5437,7 +5437,6 @@ CONFIG_CRYPTO_LIB_CHACHA_GENERIC=m
 CONFIG_CRYPTO_LIB_DES=m
 CONFIG_CRYPTO_LIB_POLY1305_RSIZE=9
 CONFIG_CRYPTO_ARCH_HAVE_LIB_POLY1305=m
-CONFIG_CRYPTO_LIB_POLY1305_GENERIC=m
 # CONFIG_CRYPTO_LIB_POLY1305 is not set
 # CONFIG_CRYPTO_LIB_CHACHA20POLY1305 is not set
 CONFIG_CRYPTO_LIB_SHA1=y
