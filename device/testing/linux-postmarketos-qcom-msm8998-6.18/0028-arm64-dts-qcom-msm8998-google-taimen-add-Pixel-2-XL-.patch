+/*
+ * CAMERA MILESTONE 2 (2026-08-02): bring up CAMSS itself. Still no sensors.
+ *
+ * M2 asks exactly one question: does the media graph enumerate and do the
+ * hardware version registers read? Everything else about the camera port is
+ * downstream of that answer, and it needs no sensor to ask -- see
+ * docs/CAMERA-M2-PREP.md §5.
+ *
+ * The driver side is already in this tree (media: camss: add msm8998 support).
+ * msm8998 is sdm660 minus two clocks, so it groups with CAMSS_660 at all nine
+ * dispatch sites, which also means it runs WITHOUT programming ISPIF -- mainline
+ * allocates camss->ispif only for 8x16 and 8x96, and ispif_res_660 sits unused.
+ * If the graph will not link CSID->VFE, that fork is where to look; the 8x96
+ * table is already written. (PREP §4.)
+ *
+ * RAM-BOOT THIS. `fastboot boot`, never `fastboot flash`. Skipping that on the
+ * M1 DTB cost three bootloops and left slot _b marked unbootable.
+ *
+ * The node's power-domains order VFE0-then-VFE1 is load-bearing: camss-vfe-4-8.c
+ * indexes camss->genpd[id] by VFE number. Do not "tidy" it.
+ */
+&camss {
+	status = "okay";
+
+	/*
+	 * MIPI CSI PHY analog rails. Downstream enables both from the CSID
+	 * driver before any PHY programming: qcom,mipi-csi-vdd = pm8998 l2
+	 * (1.2 V, with a 12 mA load vote -- see camss-csid.c) and vdd_sec =
+	 * pm8998 l1 (0.88 V). Mainline never requested either; captures only
+	 * worked at all because the display's DSI PHY holds l2 on.
+	 */
+	vdda-supply = <&vreg_l2a_1p2>;
+	vdd_sec-supply = <&vreg_l1a_0p875>;
+
+	ports {
+		/*
+		 * Front sensor only, for now. CSIPHY1/CSID1 per the vendor DT
+		 * (qcom,csiphy-sd-index = <1>, qcom,csid-sd-index = <1>).
+		 * IMX179 is 4-lane -- CONFIRMED, do not "fix" this to 2.
+		 * Sony's IMX179QQH5-C datasheet §2-1.2.1 gives the lane
+		 * registers: CSI_LANE_MODE is 0x3364 (0 = 4 lane, 2 = 2 lane)
+		 * and OPPXCK_DIV 0x0309 is 0x05 for 4 lane, 0x0A for 2. The
+		 * vendor mode tables write 0x3364 = 0x00 and 0x0309 = 0x05, and
+		 * the live sensor reads back both, so it transmits on four.
+		 * (A csi_lane_mask = 0x07 "2 lane" found by pattern search in
+		 * libmmcamera_imx179.so was a false positive; the datasheet's
+		 * 750 Mbps/lane ceiling also rules 2 lanes out, since full res
+		 * would need 1296 Mbps/lane.)
+		 * data-lanes must match or CSID reports a
+		 * lane-count mismatch rather than anything about the sensor.
+		 */
+		/*
+		 * REAR sensor (IMX362) on CSIPHY0/CSID0 per the factory DTBO
+		 * (fragment@127 camera@0: csiphy-sd-index 0, csid-sd-index 0).
+		 * 4-lane: vendor XML LaneMask 0x1F, mode table 0x0114 = 0x03.
+		 */
+		port@0 {
+			reg = <0>;
+			camss_ep_rear: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx362_ep>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			camss_ep_front: endpoint {
+				clock-lanes = <7>;
+				/*
+				 * §46: reversed order was TESTED against a live
+				 * Easel link and is no better -- and note it is
+				 * a weak test anyway: permuting data-lanes
+				 * keeps the same lane set, so CMN_CTRL5 stays
+				 * 0x8f and the clock lane block (0x700) does
+				 * not move. A genuine clock/data pad swap is
+				 * not expressible here.
+				 */
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&imx179_ep>;
+			};
+		};
+	};
+};
+
+/*
+ * CAMERA MILESTONE 4, front sensor (IMX179).
+ *
+ * THE NON-OBVIOUS TRANSLATION, and the whole reason this block looks like this:
+ * the vendor enables the sensor rails with RAW PMIC GPIOs
+ * (msm8998-taimen-camera.dtsi:216 -- gpios = <&pmi8998_gpios 6>, <&pmi8998_gpios 3>),
+ * but mainline sensor drivers take REGULATOR supplies. So each of those becomes
+ * a regulator-fixed with enable-active-high. Miss this and the driver probes,
+ * finds no supply, and either fails or -- worse -- runs with the rail off and
+ * reads all-zero registers, which looks like a dead sensor rather than a DT
+ * omission. (docs/CAMERA-M2-PREP.md, "The one non-obvious translation".)
+ *
+ * PMIC GPIO numbering is 1-based on both sides: pmic_gpio_of_xlate() subtracts
+ * PMIC_GPIO_PHYSICAL_OFFSET = 1, so the vendor's `pmi8998_gpios 6` really is
+ * <&pmi8998_gpios 6> here (our 6.0 base spelled the label "pmi8998_gpio",
+ * singular; 6.18's pmi8998.dtsi renamed the node to plural "pmi8998_gpios",
+ * matching the vendor's own name -- coincidence, not a fix for this), and the
+ * pinctrl pin really is "gpio6". Do not "fix" this to 5.
+ *
+ * VIO is not GPIO-switched -- it is pm8998 LVS1, always available.
+ */
+/ {
+	cam1_dvdd: regulator-cam1-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_dvdd_1v2";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		gpio = <&pmi8998_gpios 6 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_dvdd_en>;
+	};
+
+	cam1_avdd: regulator-cam1-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_avdd_2v7";
+		regulator-min-microvolt = <2700000>;
+		regulator-max-microvolt = <2700000>;
+		gpio = <&pmi8998_gpios 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_avdd_en>;
+	};
+};
+
+/*
+ * REAR camera (IMX362) rails. Factory DTBO fragment@127 camera@0 + downstream
+ * msm8998-taimen-camera.dtsi:170-183: all rails except VIO are pm8998
+ * GPIO-switched (1-based numbering, same xlate rule as the pmi8998 note
+ * above). Voltages from the vendor node: dvdd 1.05 V, avdd 2.8 V, the rest
+ * from the downstream labels.
+ */
+/ {
+	cam0_dvdd: regulator-cam0-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_dvdd_1v05";
+		regulator-min-microvolt = <1050000>;
+		regulator-max-microvolt = <1050000>;
+		gpio = <&pm8998_gpios 20 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_dvdd_en>;
+	};
+
+	cam0_avdd: regulator-cam0-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_avdd_2v8";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pm8998_gpios 15 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_avdd_en>;
+	};
+
+	cam0_avdd2: regulator-cam0-avdd2 {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_avdd2_1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pm8998_gpios 19 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_avdd2_en>;
+	};
+
+	cam0_drv: regulator-cam0-drv {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_ois_drv_2v8";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		gpio = <&pm8998_gpios 9 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_drv_en>;
+	};
+
+	cam0_vaf: regulator-cam0-vaf {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_vaf_2v85";
+		regulator-min-microvolt = <2850000>;
+		regulator-max-microvolt = <2850000>;
+		gpio = <&pm8998_gpios 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_vaf_en>;
+	};
+};
+
+&pm8998_gpios {
+	cam0_dvdd_en: cam0-dvdd-en-state {
+		pins = "gpio20";
+		function = "normal";
+		bias-disable;
+		drive-push-pull;
+		output-low;
+		power-source = <0>;
+		qcom,drive-strength = <1>;
+	};
+
+	cam0_avdd_en: cam0-avdd-en-state {
+		pins = "gpio15";
+		function = "normal";
+		bias-disable;
+		drive-push-pull;
+		output-low;
+		power-source = <0>;
+		qcom,drive-strength = <1>;
+	};
+
+	cam0_avdd2_en: cam0-avdd2-en-state {
+		pins = "gpio19";
+		function = "normal";
+		bias-disable;
+		drive-push-pull;
+		output-low;
+		power-source = <0>;
+		qcom,drive-strength = <1>;
+	};
+
+	cam0_drv_en: cam0-drv-en-state {
+		pins = "gpio9";
+		function = "normal";
+		bias-disable;
+		drive-push-pull;
+		output-low;
+		power-source = <0>;
+		qcom,drive-strength = <1>;
+	};
+
+	cam0_vaf_en: cam0-vaf-en-state {
+		pins = "gpio10";
+		function = "normal";
+		bias-disable;
+		drive-push-pull;
+		output-low;
+		power-source = <0>;
+		qcom,drive-strength = <1>;
+	};
+};
+
+&cci_i2c0 {
+	/*
+	 * Rear AF actuator. Vendor slave 0xE4 (8-bit) -> 0x72; closed-loop
+	 * part that self-initialises from internal EEPROM on standby release.
+	 * Verified live over CCI i2c 2026-08-04: ACKs at 0x72, target regs
+	 * 0xA0/0xA1 move the lens (sharpness sweep responded).
+	 */
+	af_lens: lens@72 {
+		compatible = "onnn,lc898214xd";
+		reg = <0x72>;
+	};
+
+	/*
+	 * Vendor slave_info: 8-bit addr 0x34 -> 7-bit 0x1a. Same MCLK-rate and
+	 * CAMSS_TOP-domain traps as the front sensor -- see the imx179 node.
+	 */
+	imx362: camera@1a {
+		compatible = "sony,imx362";
+		reg = <0x1a>;
+		lens-focus = <&af_lens>;
+
+		/*
+		 * libcamera reads both of these (v4l2_fwnode_device_parse) and
+		 * without them logs "Failed to retrieve the camera location" /
+		 * "Rotation control not available" and renders the viewfinder
+		 * unrotated. 1 = BACK. The sensor is mounted with its rows
+		 * along the phone's long edge; rotation is the calibration
+		 * knob if the preview comes out sideways.
+		 */
+		orientation = <1>;
+		rotation = <90>;
+
+		clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		power-domains = <&mmcc CAMSS_TOP_GDSC>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk0_default>;
+
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+
+		vdrv-supply = <&cam0_drv>;
+		vaf-supply = <&cam0_vaf>;
+		vdig-supply = <&cam0_dvdd>;
+		vio-supply = <&vreg_lvs1a_1p8>;
+		vana-supply = <&cam0_avdd>;
+		vana2-supply = <&cam0_avdd2>;
+
+		port {
+			imx362_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				/*
+				 * res0: op_pixel_clk 548 MHz (vendor
+				 * out_info) * 10 bpp / (2 * 4 lanes).
+				 */
+				link-frequencies = /bits/ 64 <685000000>;
+				remote-endpoint = <&camss_ep_rear>;
+			};
+		};
+	};
+};
+
+&pmi8998_gpios {
+	cam1_dvdd_en: cam1-dvdd-en-state {
+		pins = "gpio6";
+		function = "normal";
+		bias-disable;
+		drive-push-pull;
+		output-low;
+		power-source = <0>;
+		qcom,drive-strength = <1>;
+	};
+
+	cam1_avdd_en: cam1-avdd-en-state {
+		pins = "gpio3";
+		function = "normal";
+		bias-disable;
+		drive-push-pull;
+		output-low;
+		power-source = <0>;
+		qcom,drive-strength = <1>;
+	};
+};
+
+&cci_i2c1 {
+	/*
+	 * Address is a bring-up guess: the vendor DT does NOT carry it (the
+	 * downstream camera framework gets the slave address from the userspace
+	 * sensor library, not from DT), and 0x10 is the usual IMX179 7-bit
+	 * address. If the driver reports it cannot read the chip ID, scan this
+	 * bus WITH THE RAILS UP -- a scan while unpowered proves nothing, which
+	 * is why the M1 comment above forbids the naive version.
+	 */
+	imx179: camera@10 {
+		compatible = "sony,imx179";
+		reg = <0x10>;
+
+		/*
+		 * 0 = FRONT; see the imx362 node for why these matter.
+		 * rotation 90 (owner-verified on the live viewfinder). Selfie
+		 * previews are MIRRORED by apps, and mirror(rot270) == rot90 --
+		 * that mirror confound is how 270 once looked right in an
+		 * unmirrored capture. Trust the live preview.
+		 */
+		orientation = <0>;
+		rotation = <90>;
+
+		/*
+		 * The rate goes on the RCG SOURCE, not on the leaf branch.
+		 * The vendor node names both -- clk_mclk1_clk_src as
+		 * "cam_src_clk" with qcom,clock-rates = <24000000 0>, and the
+		 * branch as "cam_clk" with rate 0 -- and cam_soc_api.c
+		 * round_rate/set_rate's each clock before enabling it. Setting
+		 * 24 MHz on the branch and relying on CLK_SET_RATE_PARENT does
+		 * NOT stick: clk_set_rate() returns 0 and the clock stays at its
+		 * 300 MHz power-on default (GPLL0_DIV straight through), and the
+		 * sensor then never answers on I2C -- which reads as a wrong
+		 * address, not as a clock fault.
+		 */
+		/*
+		 * Deliberately NO assigned-clocks here. mclk1_clk_src is a plain
+		 * clk_rcg2: configuring it writes the new M/N and then polls the
+		 * UPDATE bit, which only clears once the RCG root is running. At
+		 * probe time nothing has enabled the branch yet, so that poll
+		 * times out, the RCG is left half-configured, and the subsequent
+		 * clk_prepare_enable() fails with -EBUSY. The driver sets the
+		 * rate itself, after enabling the branch.
+		 */
+		clocks = <&mmcc CAMSS_MCLK1_CLK>;
+
+		/*
+		 * MCLK1 is inside the CAMSS domain. Without this, writes to the
+		 * mmcc RCG are silently dropped -- clk_set_rate() returns 0 and
+		 * the clock stays at 300 MHz. CCI only works because it takes
+		 * the same domain (see the cci node); nothing else was holding
+		 * it on for the sensor's clock.
+		 */
+		power-domains = <&mmcc CAMSS_TOP_GDSC>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_mclk1_default>;
+
+		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+
+		vio-supply = <&vreg_lvs1a_1p8>;
+		vdig-supply = <&cam1_dvdd>;
+		vana-supply = <&cam1_avdd>;
+
+		port {
+			imx179_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				/*
+				 * From the vendor's sensor_lib_out_info_t in
+				 * libmmcamera_imx179.so (0xa8bc8): op_pixel_clk
+				 * is 136 / 216 / 259.2 MHz, and link_freq =
+				 * op_pixel_clk * 10 bpp / (2 * 4 lanes). These
+				 * are DOUBLE what was here before -- the old
+				 * derivation divided by an extra 2 and then
+				 * read "lands on pll_multiplier MHz" as
+				 * confirmation. It lands on 2x that.
+				 */
+				link-frequencies = /bits/ 64 <170000000 270000000 324000000>;
+				remote-endpoint = <&camss_ep_front>;
+			};
+		};
+	};
+};
