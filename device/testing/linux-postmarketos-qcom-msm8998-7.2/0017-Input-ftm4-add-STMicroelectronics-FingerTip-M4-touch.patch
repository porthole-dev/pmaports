diff --git a/drivers/input/touchscreen/ftm4.c b/drivers/input/touchscreen/ftm4.c
new file mode 100644
index 000000000000..43f64daa519c
--- /dev/null
+++ b/drivers/input/touchscreen/ftm4.c
@@ -0,0 +1,815 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * STMicroelectronics FingerTip M4 (FTM4) touchscreen driver
+ *
+ * Copyright (c) 2026 Giuseppe Maggio <jertlok@proton.me>
+ *
+ * Written against the controller in the Google Pixel 2 XL (taimen), where the
+ * part answers at i2c 0x49 on QUP5. The register map, init sequence and event
+ * layout below were characterised on that hardware and cross-checked against
+ * the vendor driver in android-msm-wahoo-4.4-android10
+ * (drivers/input/touchscreen/stm/ftm4_ts.c).
+ *
+ * The part is a relative of the FingerTip S handled by stmfts.c, but it is not
+ * the same device: the command set is only partly shared and the pointer
+ * payload is packed differently.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bitmap.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/devm-helpers.h>
+#include <linux/errno.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/kernel.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/regulator/consumer.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+/* Commands, written as a single byte. */
+#define FTM4_CMD_READ_ONE_EVENT		0x85
+#define FTM4_CMD_SENSE_OFF		0x92
+#define FTM4_CMD_SENSE_ON		0x93
+#define FTM4_CMD_FLUSH_BUFFER		0xa1
+
+/*
+ * Register access. Writes are {0xb6, 0x00, offset, value}; reads are a write
+ * of {0xb6, 0x00, offset} followed by a read in the same transfer.
+ */
+#define FTM4_REG_WRITE			0xb6
+#define FTM4_REG_CHIP_ID		0x04
+#define FTM4_REG_WBCRC			0x1e
+#define FTM4_REG_SYSTEM_RESET		0x28
+#define FTM4_REG_INTERRUPT		0x2c
+
+#define FTM4_WBCRC_ENABLE		0x20
+#define FTM4_SYSTEM_RESET		0x80
+#define FTM4_INTERRUPT_ENABLE		0x48
+#define FTM4_INTERRUPT_DISABLE		0x08
+
+/* Chip id read: 7 bytes, of which val[1..2] identify the part. */
+#define FTM4_CHIP_ID_LEN		7
+#define FTM4_CHIP_ID0			0x36
+#define FTM4_CHIP_ID1			0x70
+
+/*
+ * Events, read one at a time with FTM4_CMD_READ_ONE_EVENT. Reading an empty
+ * FIFO is harmless and yields FTM4_EV_NO_EVENT, which is what terminates the
+ * drain loop in the interrupt handler.
+ *
+ * Event ids are decoded two different ways, and picking the wrong one is the
+ * classic way to break this part:
+ *
+ *  - the codes below are matched against the WHOLE first byte;
+ *  - pointer events split that byte into a touch id (high nibble) and an
+ *    event id (low nibble).
+ *
+ * The two spaces overlap, so only codes that cannot be a pointer event may be
+ * matched whole. 0x0f, 0x10, 0x11 and 0x16 are safe: as pointer events they
+ * would decode to event ids 0xf, 0x0, 0x1 and 0x6, none of which the part
+ * emits. 0x12..0x15 are NOT safe -- the vendor names them RESULT_READ_REGISTER,
+ * STATUS_REQUEST_COMP and INTERNAL/EXTERNAL_RELEASE_INFO, but they are also
+ * exactly ENTER/LEAVE/MOTION for touch id 1, so matching them whole makes the
+ * second finger disappear. They are answers to requests this driver never
+ * issues, and anything the controller queued on its own is dropped by the
+ * FTM4_CMD_FLUSH_BUFFER in ftm4_start(), so treating them as pointer events is
+ * both correct and safe. stmfts.c splits the space the same way.
+ */
+#define FTM4_EV_NO_EVENT		0x00
+#define FTM4_EV_ERROR			0x0f
+#define FTM4_EV_CONTROLLER_READY	0x10
+#define FTM4_EV_SLEEPOUT_READY		0x11
+#define FTM4_EV_STATUS			0x16
+
+/* Pointer events, in the low nibble of the first byte. */
+#define FTM4_EV_POINTER_ENTER		0x03
+#define FTM4_EV_POINTER_LEAVE		0x04
+#define FTM4_EV_POINTER_MOTION		0x05
+
+#define FTM4_MASK_EVENT_ID		GENMASK(3, 0)
+#define FTM4_MASK_TOUCH_ID		GENMASK(7, 4)
+
+#define FTM4_EVENT_SIZE			8
+#define FTM4_MAX_FINGERS		10
+
+/*
+ * Upper bound on events consumed per interrupt. The line is level triggered,
+ * so bailing out early on a burst simply re-triggers the handler rather than
+ * losing anything.
+ */
+#define FTM4_EVENTS_PER_IRQ		64
+
+/* Longest command in use is {0xb6, 0x00, offset, value}. */
+#define FTM4_CMD_MAX_LEN		4
+
+/*
+ * Touch area is reported as a 10-bit width and a 6-bit height ratio; both are
+ * scaled to the same 0..1023 range before being handed to userspace.
+ */
+#define FTM4_MAX_AREA			1023
+
+/* Panel geometry, overridable from the device tree. */
+#define FTM4_DEFAULT_SIZE_X		1440
+#define FTM4_DEFAULT_SIZE_Y		2880
+
+/* Delays, all from the vendor driver. */
+#define FTM4_POWER_SETTLE_US		5000
+#define FTM4_RESET_ASSERT_US		10000
+#define FTM4_REG_SETTLE_US		10000
+#define FTM4_FLUSH_US			10000
+#define FTM4_SENSE_ON_MS		50
+#define FTM4_RESET_SETTLE_MS		90
+
+/* Bound on the wait for FTM4_EV_CONTROLLER_READY after a system reset. */
+#define FTM4_READY_POLL_US		5000
+#define FTM4_READY_TIMEOUT_US		500000
+
+/*
+ * How often to check that the controller is still the one we configured.
+ *
+ * The part reboots itself when it detects an electrostatic discharge -- the
+ * vendor driver calls this STATUS_EVENT_REBOOT_BY_ESD -- and comes back in its
+ * power-on state, with sensing off and its interrupt output disabled. It does
+ * queue a FTM4_EV_CONTROLLER_READY, but with interrupts disabled it never
+ * asserts the line to say so, so a purely interrupt-driven driver never finds
+ * out: the part sits there answering i2c while reporting nothing, and only a
+ * rebind brings it back. Observed on taimen, and reproducible by issuing the
+ * system reset of ftm4_start() without the SENSE_ON that normally follows it.
+ *
+ * Polling is therefore the only way to notice. Reading the interrupt register
+ * is cheap and, unlike reading the event FIFO, cannot steal an event from the
+ * interrupt handler.
+ */
+#define FTM4_HEALTH_POLL_MS		2000
+
+/* Offset of the payload in a register read; the first byte is padding. */
+#define FTM4_REG_VALUE_OFFSET		1
+
+enum ftm4_regulator {
+	FTM4_REGULATOR_VDD,
+	FTM4_REGULATOR_AVDD,
+	FTM4_NUM_REGULATORS,
+};
+
+struct ftm4_ts {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct touchscreen_properties prop;
+
+	struct regulator_bulk_data regulators[FTM4_NUM_REGULATORS];
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *switch_gpio;
+
+	/*
+	 * Serialises the two things that talk to the controller: the interrupt
+	 * thread draining the event FIFO, and the health check re-running the
+	 * init sequence underneath it.
+	 */
+	struct mutex lock;
+	struct delayed_work health_work;
+
+	/* Slots currently down, used to derive BTN_TOUCH. */
+	DECLARE_BITMAP(slots, FTM4_MAX_FINGERS);
+
+	/* i2c transfer buffers, kept off the stack so they are DMA-safe. */
+	u8 cmd[FTM4_CMD_MAX_LEN];
+	u8 data[FTM4_EVENT_SIZE];
+};
+
+static_assert(FTM4_CHIP_ID_LEN <= FTM4_EVENT_SIZE);
+
+static int ftm4_write(struct ftm4_ts *ts, const u8 *data, size_t len)
+{
+	int ret;
+
+	if (WARN_ON(len > sizeof(ts->cmd)))
+		return -EINVAL;
+
+	memcpy(ts->cmd, data, len);
+
+	ret = i2c_master_send(ts->client, ts->cmd, len);
+	if (ret < 0)
+		return ret;
+
+	return (size_t)ret == len ? 0 : -EIO;
+}
+
+static int ftm4_command(struct ftm4_ts *ts, u8 cmd)
+{
+	return ftm4_write(ts, &cmd, sizeof(cmd));
+}
+
+static int ftm4_write_reg(struct ftm4_ts *ts, u8 offset, u8 value)
+{
+	const u8 buf[] = { FTM4_REG_WRITE, 0x00, offset, value };
+
+	return ftm4_write(ts, buf, sizeof(buf));
+}
+
+/*
+ * A read is a write of the command bytes and a read of the answer within one
+ * transfer, i.e. with a repeated start. Splitting it into two transfers does
+ * not work: the controller drops the pending read.
+ */
+static int ftm4_read(struct ftm4_ts *ts, const u8 *cmd, size_t cmd_len,
+		     u8 *val, size_t val_len)
+{
+	struct i2c_msg msgs[2];
+	int ret;
+
+	if (WARN_ON(cmd_len > sizeof(ts->cmd)))
+		return -EINVAL;
+
+	memcpy(ts->cmd, cmd, cmd_len);
+
+	msgs[0] = (struct i2c_msg) {
+		.addr	= ts->client->addr,
+		.len	= cmd_len,
+		.buf	= ts->cmd,
+	};
+	msgs[1] = (struct i2c_msg) {
+		.addr	= ts->client->addr,
+		.flags	= I2C_M_RD,
+		.len	= val_len,
+		.buf	= val,
+	};
+
+	ret = i2c_transfer(ts->client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret < 0)
+		return ret;
+
+	return ret == ARRAY_SIZE(msgs) ? 0 : -EIO;
+}
+
+static int ftm4_read_reg(struct ftm4_ts *ts, u8 offset, u8 *val, size_t len)
+{
+	const u8 cmd[] = { FTM4_REG_WRITE, 0x00, offset };
+
+	return ftm4_read(ts, cmd, sizeof(cmd), val, len);
+}
+
+static int ftm4_read_event(struct ftm4_ts *ts)
+{
+	const u8 cmd = FTM4_CMD_READ_ONE_EVENT;
+
+	return ftm4_read(ts, &cmd, sizeof(cmd), ts->data, FTM4_EVENT_SIZE);
+}
+
+static int ftm4_check_chip_id(struct ftm4_ts *ts)
+{
+	u8 *val = ts->data;
+	int error;
+
+	error = ftm4_read_reg(ts, FTM4_REG_CHIP_ID, val, FTM4_CHIP_ID_LEN);
+	if (error) {
+		dev_err(&ts->client->dev, "failed to read chip id: %d\n", error);
+		return error;
+	}
+
+	if (val[1] != FTM4_CHIP_ID0 || val[2] != FTM4_CHIP_ID1) {
+		dev_err(&ts->client->dev, "unexpected chip id %02x %02x\n",
+			val[1], val[2]);
+		return -ENODEV;
+	}
+
+	/* Both zero means the controller came up without usable firmware. */
+	if (!val[5] && !val[6]) {
+		dev_err(&ts->client->dev, "controller reports no firmware\n");
+		return -ENODEV;
+	}
+
+	dev_dbg(&ts->client->dev, "FTM4 chip id %02x %02x, firmware %02x %02x\n",
+		val[1], val[2], val[5], val[6]);
+
+	return 0;
+}
+
+static int ftm4_wait_for_ready(struct ftm4_ts *ts)
+{
+	int elapsed_us;
+	int error;
+
+	for (elapsed_us = 0; elapsed_us < FTM4_READY_TIMEOUT_US;
+	     elapsed_us += FTM4_READY_POLL_US) {
+		error = ftm4_read_event(ts);
+		if (error)
+			return error;
+
+		if (ts->data[0] == FTM4_EV_CONTROLLER_READY)
+			return 0;
+
+		if (ts->data[0] == FTM4_EV_ERROR)
+			dev_dbg(&ts->client->dev, "error event: %*ph\n",
+				FTM4_EVENT_SIZE, ts->data);
+
+		fsleep(FTM4_READY_POLL_US);
+	}
+
+	dev_err(&ts->client->dev, "timed out waiting for controller ready\n");
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * Bring the controller from "powered" to "reporting". This mirrors the vendor
+ * fts_reinit() and the order matters throughout.
+ */
+static int ftm4_start(struct ftm4_ts *ts)
+{
+	int error;
+
+	error = ftm4_write_reg(ts, FTM4_REG_INTERRUPT, FTM4_INTERRUPT_DISABLE);
+	if (error)
+		return error;
+
+	error = ftm4_write_reg(ts, FTM4_REG_WBCRC, FTM4_WBCRC_ENABLE);
+	if (error)
+		return error;
+	fsleep(FTM4_REG_SETTLE_US);
+
+	error = ftm4_write_reg(ts, FTM4_REG_SYSTEM_RESET, FTM4_SYSTEM_RESET);
+	if (error)
+		return error;
+	fsleep(FTM4_REG_SETTLE_US);
+
+	error = ftm4_wait_for_ready(ts);
+	if (error)
+		return error;
+
+	error = ftm4_command(ts, FTM4_CMD_SENSE_ON);
+	if (error)
+		return error;
+	msleep(FTM4_SENSE_ON_MS);
+
+	/*
+	 * Load-bearing, and not obviously so. Without this flush the part
+	 * finishes initialising, emits its force-calibration status events and
+	 * then never reports a single pointer event again.
+	 */
+	error = ftm4_command(ts, FTM4_CMD_FLUSH_BUFFER);
+	if (error)
+		return error;
+	fsleep(FTM4_FLUSH_US);
+
+	return ftm4_write_reg(ts, FTM4_REG_INTERRUPT, FTM4_INTERRUPT_ENABLE);
+}
+
+static void ftm4_stop(struct ftm4_ts *ts)
+{
+	int error;
+
+	error = ftm4_command(ts, FTM4_CMD_SENSE_OFF);
+	if (error)
+		dev_warn(&ts->client->dev, "failed to stop sensing: %d\n",
+			 error);
+}
+
+/* Bring up the supplies, claim the bus and take the controller out of reset. */
+static int ftm4_power_up(struct ftm4_ts *ts)
+{
+	int error;
+
+	error = regulator_bulk_enable(FTM4_NUM_REGULATORS, ts->regulators);
+	if (error) {
+		dev_err(&ts->client->dev, "failed to enable supplies: %d\n",
+			error);
+		return error;
+	}
+	fsleep(FTM4_POWER_SETTLE_US);
+
+	/* Take the shared bus away from the sensor DSP before talking. */
+	gpiod_set_value_cansleep(ts->switch_gpio, 1);
+
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+	fsleep(FTM4_RESET_ASSERT_US);
+	gpiod_set_value_cansleep(ts->reset_gpio, 0);
+	msleep(FTM4_RESET_SETTLE_MS);
+
+	return 0;
+}
+
+static void ftm4_power_down(struct ftm4_ts *ts)
+{
+	int error;
+
+	gpiod_set_value_cansleep(ts->reset_gpio, 1);
+
+	/* Hand the shared bus back to the sensor DSP. */
+	gpiod_set_value_cansleep(ts->switch_gpio, 0);
+
+	error = regulator_bulk_disable(FTM4_NUM_REGULATORS, ts->regulators);
+	if (error)
+		dev_warn(&ts->client->dev, "failed to disable supplies: %d\n",
+			 error);
+}
+
+/*
+ * Only powers down: asserting reset and dropping the supplies stops the
+ * controller by itself, and this also runs on probe failures where sensing was
+ * never turned on in the first place.
+ */
+static void ftm4_power_down_action(void *data)
+{
+	ftm4_power_down(data);
+}
+
+static void ftm4_report_contact(struct ftm4_ts *ts, const u8 *event)
+{
+	unsigned int slot = FIELD_GET(FTM4_MASK_TOUCH_ID, event[0]);
+	unsigned int x = (event[1] << 4) | (event[3] >> 4);
+	unsigned int y = (event[2] << 4) | (event[3] & 0x0f);
+	unsigned int pressure = event[4];
+	int orientation = (s8)event[5];
+	unsigned int major = (event[6] << 2) | (event[7] >> 6);
+	unsigned int minor = (event[7] & GENMASK(5, 0)) * major / 63;
+
+	if (slot >= FTM4_MAX_FINGERS) {
+		dev_dbg(&ts->client->dev, "touch id %u out of range\n", slot);
+		return;
+	}
+
+	input_mt_slot(ts->input, slot);
+	input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+	touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+	input_report_abs(ts->input, ABS_MT_PRESSURE, pressure);
+	input_report_abs(ts->input, ABS_MT_ORIENTATION, orientation);
+	input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, major);
+	input_report_abs(ts->input, ABS_MT_TOUCH_MINOR, minor);
+
+	__set_bit(slot, ts->slots);
+}
+
+static void ftm4_report_release(struct ftm4_ts *ts, const u8 *event)
+{
+	unsigned int slot = FIELD_GET(FTM4_MASK_TOUCH_ID, event[0]);
+
+	if (slot >= FTM4_MAX_FINGERS) {
+		dev_dbg(&ts->client->dev, "touch id %u out of range\n", slot);
+		return;
+	}
+
+	input_mt_slot(ts->input, slot);
+	input_mt_report_slot_inactive(ts->input);
+
+	__clear_bit(slot, ts->slots);
+}
+
+/* Returns true if the event changed the reported input state. */
+static bool ftm4_handle_event(struct ftm4_ts *ts, const u8 *event)
+{
+	struct device *dev = &ts->client->dev;
+
+	/* Status codes match the whole first byte -- see the event comment. */
+	switch (event[0]) {
+	case FTM4_EV_ERROR:
+		dev_dbg(dev, "error event: %*ph\n", FTM4_EVENT_SIZE, event);
+		return false;
+	case FTM4_EV_CONTROLLER_READY:
+		/*
+		 * The controller only reports itself ready after a reset, and
+		 * this driver resets it only from ftm4_start(), which consumes
+		 * that event itself. Seeing one here therefore means the part
+		 * rebooted on its own and has dropped back to sensing off, so
+		 * run the health check now rather than waiting out the poll.
+		 */
+		dev_dbg(dev, "controller ready: %*ph\n", FTM4_EVENT_SIZE, event);
+		mod_delayed_work(system_long_wq, &ts->health_work, 0);
+		return false;
+	case FTM4_EV_SLEEPOUT_READY:
+	case FTM4_EV_STATUS:
+		dev_dbg(dev, "status event: %*ph\n", FTM4_EVENT_SIZE, event);
+		return false;
+	}
+
+	/* Everything else is a pointer event, id in the low nibble. */
+	switch (event[0] & FTM4_MASK_EVENT_ID) {
+	case FTM4_EV_POINTER_ENTER:
+	case FTM4_EV_POINTER_MOTION:
+		ftm4_report_contact(ts, event);
+		return true;
+	case FTM4_EV_POINTER_LEAVE:
+		ftm4_report_release(ts, event);
+		return true;
+	}
+
+	dev_dbg(dev, "unhandled event: %*ph\n", FTM4_EVENT_SIZE, event);
+
+	return false;
+}
+
+static irqreturn_t ftm4_irq(int irq, void *dev_id)
+{
+	struct ftm4_ts *ts = dev_id;
+	bool sync = false;
+	int error;
+	int i;
+
+	/* The health check may be re-running the init sequence right now. */
+	mutex_lock(&ts->lock);
+
+	for (i = 0; i < FTM4_EVENTS_PER_IRQ; i++) {
+		error = ftm4_read_event(ts);
+		if (error) {
+			dev_err_ratelimited(&ts->client->dev,
+					    "failed to read event: %d\n",
+					    error);
+			break;
+		}
+
+		if (ts->data[0] == FTM4_EV_NO_EVENT)
+			break;
+
+		sync |= ftm4_handle_event(ts, ts->data);
+	}
+
+	mutex_unlock(&ts->lock);
+
+	if (sync) {
+		input_report_key(ts->input, BTN_TOUCH,
+				 !bitmap_empty(ts->slots, FTM4_MAX_FINGERS));
+		input_sync(ts->input);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static void ftm4_release_all(struct ftm4_ts *ts)
+{
+	unsigned int slot;
+
+	for_each_set_bit(slot, ts->slots, FTM4_MAX_FINGERS) {
+		input_mt_slot(ts->input, slot);
+		input_mt_report_slot_inactive(ts->input);
+	}
+
+	bitmap_zero(ts->slots, FTM4_MAX_FINGERS);
+
+	input_report_key(ts->input, BTN_TOUCH, 0);
+	input_sync(ts->input);
+}
+
+/*
+ * Ask the controller whether its interrupt output is still enabled. That bit
+ * survives nothing: a reset clears it, so it doubles as "are you still the
+ * device ftm4_start() configured?".
+ */
+static int ftm4_check_alive(struct ftm4_ts *ts, bool *alive)
+{
+	u8 val[FTM4_REG_VALUE_OFFSET + 1];
+	int error;
+
+	error = ftm4_read_reg(ts, FTM4_REG_INTERRUPT, val, sizeof(val));
+	if (error)
+		return error;
+
+	*alive = val[FTM4_REG_VALUE_OFFSET] == FTM4_INTERRUPT_ENABLE;
+
+	return 0;
+}
+
+static void ftm4_health_work(struct work_struct *work)
+{
+	struct ftm4_ts *ts = container_of(work, struct ftm4_ts,
+					  health_work.work);
+	struct device *dev = &ts->client->dev;
+	bool alive;
+	int error;
+
+	mutex_lock(&ts->lock);
+
+	error = ftm4_check_alive(ts, &alive);
+	if (error) {
+		dev_warn_ratelimited(dev, "health check failed: %d\n", error);
+	} else if (!alive) {
+		dev_warn(dev, "controller reset itself, reinitialising\n");
+
+		/*
+		 * Whatever was on the glass before the reset is gone as far as
+		 * the controller is concerned, and it will not send a LEAVE for
+		 * it, so drop the contacts before they become permanent.
+		 */
+		ftm4_release_all(ts);
+
+		error = ftm4_start(ts);
+		if (error)
+			dev_err(dev, "failed to reinitialise: %d\n", error);
+	}
+
+	mutex_unlock(&ts->lock);
+
+	queue_delayed_work(system_long_wq, &ts->health_work,
+			   msecs_to_jiffies(FTM4_HEALTH_POLL_MS));
+}
+
+static int ftm4_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ftm4_ts *ts;
+	int error;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return -ENODEV;
+
+	if (!client->irq)
+		return dev_err_probe(dev, -EINVAL, "no interrupt assigned\n");
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+
+	ts->client = client;
+	i2c_set_clientdata(client, ts);
+
+	mutex_init(&ts->lock);
+
+	error = devm_delayed_work_autocancel(dev, &ts->health_work,
+					     ftm4_health_work);
+	if (error)
+		return error;
+
+	ts->regulators[FTM4_REGULATOR_VDD].supply = "vdd";
+	ts->regulators[FTM4_REGULATOR_AVDD].supply = "avdd";
+	error = devm_regulator_bulk_get(dev, FTM4_NUM_REGULATORS,
+					ts->regulators);
+	if (error)
+		return dev_err_probe(dev, error, "failed to get supplies\n");
+
+	/*
+	 * The reset line has no bias configured, so the descriptor has to stay
+	 * claimed for the lifetime of the driver -- dropping it lets the pin
+	 * float and the controller resets itself at random.
+	 */
+	ts->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ts->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	/*
+	 * Optional: on taimen this bus is shared with the sensor DSP and an
+	 * external mux decides who drives it. Designs that do not share the
+	 * bus simply omit the property.
+	 */
+	ts->switch_gpio = devm_gpiod_get_optional(dev, "st,i2c-switch",
+						  GPIOD_OUT_HIGH);
+	if (IS_ERR(ts->switch_gpio))
+		return dev_err_probe(dev, PTR_ERR(ts->switch_gpio),
+				     "failed to get i2c switch gpio\n");
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+
+	ts->input->name = "stmicroelectronics ftm4";
+	ts->input->id.bustype = BUS_I2C;
+
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X,
+			     0, FTM4_DEFAULT_SIZE_X - 1, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y,
+			     0, FTM4_DEFAULT_SIZE_Y - 1, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+
+	input_set_abs_params(ts->input, ABS_MT_PRESSURE, 0, 255, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_ORIENTATION, -128, 127, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MAJOR,
+			     0, FTM4_MAX_AREA, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_TOUCH_MINOR,
+			     0, FTM4_MAX_AREA, 0, 0);
+
+	/* input_mt_init_slots() declares BTN_TOUCH for us, but not the axes. */
+	error = input_mt_init_slots(ts->input, FTM4_MAX_FINGERS,
+				    INPUT_MT_DIRECT);
+	if (error)
+		return dev_err_probe(dev, error, "failed to init mt slots\n");
+
+	input_set_drvdata(ts->input, ts);
+
+	error = ftm4_power_up(ts);
+	if (error)
+		return error;
+
+	/*
+	 * Registered before the chip is identified so that every later failure
+	 * drops the supplies again. It runs before the interrupt is freed,
+	 * which is why the interrupt is requested further down.
+	 */
+	error = devm_add_action_or_reset(dev, ftm4_power_down_action, ts);
+	if (error)
+		return error;
+
+	error = ftm4_check_chip_id(ts);
+	if (error)
+		return error;
+
+	error = ftm4_start(ts);
+	if (error)
+		return dev_err_probe(dev, error, "failed to start sensing\n");
+
+	/*
+	 * The interrupt is level triggered and the controller holds it
+	 * asserted while its event FIFO is non-empty, so it stays masked until
+	 * there is a registered input device to report the drained events to.
+	 */
+	error = devm_request_threaded_irq(dev, client->irq, NULL, ftm4_irq,
+					  IRQF_ONESHOT | IRQF_NO_AUTOEN,
+					  "ftm4", ts);
+	if (error)
+		return dev_err_probe(dev, error, "failed to request irq\n");
+
+	error = input_register_device(ts->input);
+	if (error)
+		return dev_err_probe(dev, error,
+				     "failed to register input device\n");
+
+	enable_irq(client->irq);
+
+	queue_delayed_work(system_long_wq, &ts->health_work,
+			   msecs_to_jiffies(FTM4_HEALTH_POLL_MS));
+
+	return 0;
+}
+
+static int ftm4_suspend(struct device *dev)
+{
+	struct ftm4_ts *ts = dev_get_drvdata(dev);
+
+	/*
+	 * Must not be left running: it would talk to a controller whose
+	 * supplies are about to go away, and find it "reset" every time.
+	 */
+	cancel_delayed_work_sync(&ts->health_work);
+
+	disable_irq(ts->client->irq);
+	ftm4_stop(ts);
+	ftm4_power_down(ts);
+
+	/* The controller will not send a LEAVE for fingers that were down. */
+	ftm4_release_all(ts);
+
+	return 0;
+}
+
+static int ftm4_resume(struct device *dev)
+{
+	struct ftm4_ts *ts = dev_get_drvdata(dev);
+	int error;
+
+	error = ftm4_power_up(ts);
+	if (error)
+		return error;
+
+	error = ftm4_start(ts);
+	if (error) {
+		dev_err(dev, "failed to restart sensing: %d\n", error);
+		ftm4_power_down(ts);
+		return error;
+	}
+
+	enable_irq(ts->client->irq);
+
+	queue_delayed_work(system_long_wq, &ts->health_work,
+			   msecs_to_jiffies(FTM4_HEALTH_POLL_MS));
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(ftm4_pm_ops, ftm4_suspend, ftm4_resume);
+
+static const struct of_device_id ftm4_of_match[] = {
+	{ .compatible = "st,ftm4" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ftm4_of_match);
+
+static const struct i2c_device_id ftm4_id[] = {
+	{ "ftm4", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, ftm4_id);
+
+static struct i2c_driver ftm4_driver = {
+	.driver = {
+		.name = "ftm4",
+		.of_match_table = ftm4_of_match,
+		.pm = pm_sleep_ptr(&ftm4_pm_ops),
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+	},
+	.probe = ftm4_probe,
+	.id_table = ftm4_id,
+};
+module_i2c_driver(ftm4_driver);
+
+MODULE_AUTHOR("Giuseppe Maggio <jertlok@proton.me>");
+MODULE_DESCRIPTION("STMicroelectronics FingerTip M4 touchscreen driver");
+MODULE_LICENSE("GPL");
