+static void
+update_unlock_hint (PhoshLockscreen *self)
+{
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+  gboolean fingerprint = priv->fingerprint &&
+                         phosh_fingerprint_unlock_get_active (priv->fingerprint);
+
+  gtk_label_set_label (GTK_LABEL (priv->lbl_unlock_hint),
+                       fingerprint ? _("Touch the sensor or slide up to unlock") :
+                                     _("Slide up to unlock"));
+}
+
+
+static gboolean
+on_fingerprint_status_timeout (gpointer user_data)
+{
+  PhoshLockscreen *self = PHOSH_LOCKSCREEN (user_data);
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+
+  priv->fingerprint_status_id = 0;
+  phosh_lockscreen_set_unlock_status (self, _("Enter Passcode"));
+  update_unlock_hint (self);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+on_fingerprint_status (PhoshLockscreen        *self,
+                       const char             *message,
+                       PhoshFingerprintUnlock *fingerprint)
+{
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+
+  if (priv->auth)
+    return;
+
+  /* Show it where the finger was: on either page. */
+  phosh_lockscreen_set_unlock_status (self, message);
+  gtk_label_set_label (GTK_LABEL (priv->lbl_unlock_hint), message);
+  g_signal_emit (self, signals[WAKEUP_OUTPUT], 0);
+
+  g_clear_handle_id (&priv->fingerprint_status_id, g_source_remove);
+  priv->fingerprint_status_id = g_timeout_add_seconds (3, on_fingerprint_status_timeout, self);
+  g_source_set_name_by_id (priv->fingerprint_status_id, "[PhoshLockscreen] fingerprint status");
+}
+
