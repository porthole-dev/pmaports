@@ -1391,6 +1518,58 @@ blsp2_i2c6_sleep: blsp2-i2c6-sleep-state {
 				bias-pull-up;
 			};
 
+			/*
+			 * Camera Control Interface. Vendor msm8998-pinctrl.dtsi
+			 * cci0_active :899 (gpio17,18), cci1_active :927
+			 * (gpio19,20), function "cci_i2c", bias-pull-up, ds 2.
+			 * The vendor's "CLK, DATA" comment on those nodes is
+			 * WRONG -- the CCI node's own qcom,gpio-tbl-label
+			 * (msm8998-camera.dtsi:744-748) orders them DATA0, CLK0,
+			 * DATA1, CLK1. Irrelevant to the mux (both pins take the
+			 * same config); do not propagate the wrong comment.
+			 */
+			cci0_default: cci0-default-state {
+				pins = "gpio17", "gpio18";
+				function = "cci_i2c";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
+			cci1_default: cci1-default-state {
+				pins = "gpio19", "gpio20";
+				function = "cci_i2c";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
+			/*
+			 * Sensor master clocks. Vendor cam_sensor_mclk0_active
+			 * :1009 (gpio13), cam_sensor_mclk1_active :1318
+			 * (gpio14), function "cam_mclk", bias-disable.
+			 * drive-strength is 2 mA, not 4 -- read the vendor
+			 * config block, not the summary.
+			 */
+			cam_mclk0_default: cam-mclk0-default-state {
+				pins = "gpio13";
+				function = "cam_mclk";
+				drive-strength = <2>;
+				bias-disable;
+			};
+
+			cam_mclk1_default: cam-mclk1-default-state {
+				pins = "gpio14";
+				function = "cam_mclk";
+				drive-strength = <2>;
+				bias-disable;
+			};
+			/*
+			 * No *_sleep states on purpose: i2c-qcom-cci.c makes no
+			 * pinctrl calls at all, so only "default" is ever
+			 * selected (by the driver core). sdm630.dtsi:2068
+			 * declares only "default" for the same reason. Add them
+			 * when something actually selects them.
+			 */
+
 			blsp2_spi1_default: blsp2-spi1-default-state {
 				pins = "gpio53", "gpio54", "gpio55", "gpio56";
 				function = "blsp_spi7";
@@ -1546,47 +1725,78 @@ adreno_gpu: gpu@5000000 {
 			operating-points-v2 = <&gpu_opp_table>;
 			power-domains = <&rpmpd RPMPD_VDDMX>;
 			status = "disabled";
+			#cooling-cells = <2>;
 
+			/*
+			 * opp-microvolt is the vdd_gfx (core rail) voltage,
+			 * taken from downstream's GFX CPR4 open-loop ceilings
+			 * (msm-4.4 msm8998-v2.dtsi: SVS 828 mV, NOM 900 mV,
+			 * TURBO 1056 mV) with the freq->corner map from
+			 * qcom,gfxfreq-speedbin0: <=414 SVS, 515/596 NOM,
+			 * 670/710 TURBO. Ceiling values, so safe on any bin
+			 * without CPR. Consumed only when the board wires
+			 * vdd-supply on the GPU node.
+			 *
+			 * Triplets <target min max> with max at the rail
+			 * ceiling, because pm8005 s1 has discrete voltage
+			 * steps and an exact min==max value that is not a
+			 * step multiple makes _opp_supported_by_regulators()
+			 * reject the whole OPP at boot (828/900 mV both hit
+			 * this; 1056 mV happened to be a real step). The
+			 * regulator picks the lowest supported step >= min.
+			 *
+			 * opp-level (VDDMX vote) follows the same downstream
+			 * table's MX column: NOM for 515/596, TURBO for
+			 * 670/710. The earlier SVS_PLUS/NOM_PLUS values were
+			 * below downstream's minimum for those rates.
+			 */
 			gpu_opp_table: opp-table {
 				compatible = "operating-points-v2";
 				opp-710000097 {
 					opp-hz = /bits/ 64 <710000097>;
+					opp-microvolt = <1056000 1056000 1100000>;
 					opp-level = <RPM_SMD_LEVEL_TURBO>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-670000048 {
 					opp-hz = /bits/ 64 <670000048>;
-					opp-level = <RPM_SMD_LEVEL_NOM_PLUS>;
+					opp-microvolt = <1056000 1056000 1100000>;
+					opp-level = <RPM_SMD_LEVEL_TURBO>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-596000097 {
 					opp-hz = /bits/ 64 <596000097>;
+					opp-microvolt = <900000 900000 1100000>;
 					opp-level = <RPM_SMD_LEVEL_NOM>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-515000097 {
 					opp-hz = /bits/ 64 <515000097>;
-					opp-level = <RPM_SMD_LEVEL_SVS_PLUS>;
+					opp-microvolt = <900000 900000 1100000>;
+					opp-level = <RPM_SMD_LEVEL_NOM>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-414000000 {
 					opp-hz = /bits/ 64 <414000000>;
+					opp-microvolt = <828000 828000 1100000>;
 					opp-level = <RPM_SMD_LEVEL_SVS>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-342000000 {
 					opp-hz = /bits/ 64 <342000000>;
+					opp-microvolt = <828000 828000 1100000>;
 					opp-level = <RPM_SMD_LEVEL_LOW_SVS>;
 					opp-supported-hw = <0xff>;
 				};
 
 				opp-257000000 {
 					opp-hz = /bits/ 64 <257000000>;
+					opp-microvolt = <828000 828000 1100000>;
 					opp-level = <RPM_SMD_LEVEL_MIN_SVS>;
 					opp-supported-hw = <0xff>;
 				};
@@ -1594,8 +1804,17 @@ opp-257000000 {
 		};
 
 		adreno_smmu: iommu@5040000 {
-			compatible = "qcom,msm8998-smmu-v2", "qcom,smmu-v2",
-				     "qcom,adreno-smmu";
+			/*
+			 * Deliberately NOT "qcom,adreno-smmu": that opts the
+			 * A540 into split-TTBR per-process pagetables, and the
+			 * CP_SMMU_TABLE_UPDATE context switching faults on
+			 * this part (49-bit-truncated global VAs in the FAR,
+			 * e.g. 0x1800000016000), wedging the GPU on app
+			 * launches and eventually the whole SoC via a stuck
+			 * gcc_gpu_bimc_gfx_clk. Plain pagetables keep every
+			 * engine in low TTBR0 space.
+			 */
+			compatible = "qcom,msm8998-smmu-v2", "qcom,smmu-v2";
 			reg = <0x05040000 0x10000>;
 			clocks = <&gcc GCC_GPU_CFG_AHB_CLK>,
 				 <&gcc GCC_BIMC_GFX_CLK>,
@@ -3220,6 +3439,276 @@ video-encoder {
 			};
 		};
 
+		/*
+		 * CAMSS. Kept `disabled`; enabled per-board.
+		 *
+		 * NOTE "qcom,msm8998-camss" has NO driver match yet -- camss.c
+		 * knows only msm8996/sdm660/sdm845. This node is deliberately
+		 * inert until the driver half lands; it binds to nothing.
+		 *
+		 * msm8998 and sdm660 CAMSS are the same IP at the same
+		 * addresses. The ONLY register-base delta is the CSIPHY:
+		 * msm8998 v5.0 @ca34000/5000/6000 vs sdm660 v3.5 @c824000/...
+		 *
+		 * THREE TRAPS, all deliberate, do not "fix" them back:
+		 *  1. csi_clk_mux size is 0x10, NOT the vendor's 0x4.
+		 *     camss-ispif.c writes CSI_PIX_CLK_MUX_SEL 0x000 AND
+		 *     CSI_RDI_CLK_MUX_SEL 0x008; a 4-byte map puts 0x008
+		 *     outside the ioremap. sdm630.dtsi:1901 also uses 0x10.
+		 *  2. NO csiphyN_clk_mux reg entries. msm8998 has no such
+		 *     register, and camss-csiphy.c:584-592 only ioremaps
+		 *     res->reg[1] for 8x16/8x96, leaving base_clk_mux NULL
+		 *     otherwise; csiphy_stream_on skips the mux write when it
+		 *     is NULL. No code change needed.
+		 *  3. power-domains must be exactly VFE0_GDSC then VFE1_GDSC in
+		 *     THAT ORDER and nothing else -- camss-vfe-4-8.c indexes
+		 *     camss->genpd[id] by VFE number. camss_top is already
+		 *     their parent, so do NOT add a third entry.
+		 *
+		 * Full per-value witnesses (every reg size, IRQ and clock, with
+		 * the vendor line it came from) are in the corpus:
+		 * deep-camera-dt.json step 3.
+		 *
+		 * EXPECTED dtc WARNING, do not "fix" it:
+		 *   simple-bus unit address format error, expected "ca00020"
+		 * dtc wants the unit address to match reg[0], which is the
+		 * csi_clk_mux at 0xca00020. sdm630.dtsi:1899 does exactly the
+		 * same thing (camss@ca00000 with reg[0] = 0x0ca00020), so this
+		 * warning is inherent to the upstream CAMSS naming convention.
+		 * Renaming to camss@ca00020 would diverge from every other
+		 * mainline CAMSS node for no benefit.
+		 */
+		camss: camss@ca00000 {
+			compatible = "qcom,msm8998-camss";
+
+			reg = <0x0ca00020 0x10>,
+			      <0x0ca30000 0x100>,
+			      <0x0ca30400 0x100>,
+			      <0x0ca30800 0x100>,
+			      <0x0ca30c00 0x100>,
+			      <0x0ca34000 0x1000>,
+			      <0x0ca35000 0x1000>,
+			      <0x0ca36000 0x1000>,
+			      <0x0ca31000 0x500>,
+			      <0x0ca10000 0x1000>,
+			      <0x0ca14000 0x1000>;
+			reg-names = "csi_clk_mux",
+				    "csid0", "csid1", "csid2", "csid3",
+				    "csiphy0", "csiphy1", "csiphy2",
+				    "ispif",
+				    "vfe0", "vfe1";
+
+			interrupts = <GIC_SPI 296 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 297 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 298 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 299 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 78 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 79 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 80 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 309 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 314 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 315 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "csid0", "csid1", "csid2", "csid3",
+					  "csiphy0", "csiphy1", "csiphy2",
+					  "ispif",
+					  "vfe0", "vfe1";
+
+			clocks = <&mmcc CAMSS_AHB_CLK>,
