From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Sat, 22 Aug 2026 19:10:01 +0200
Subject: [PATCH] misc: easel-mipi: own Easel's system-sleep lifecycle,
 vendor-shaped

Easel loses power across s2idle no matter what the AP does: its
BCM15602 rails survive, but the chip comes back unreachable (D3cold,
config space dead), a bus reset cannot revive a powerless chip ("not
ready 1023ms after bus reset"), and a controller left facing the dead
link wedges the SoC interconnect -- which is why qcom-pcie now leaves
the controller untouched across sleep on this board
(endpoint-powered-off-in-suspend).  That keeps suspend safe but the
camera dead after the first sleep.

The vendor never fights the power loss: mnh-sm has Easel fully off
(link in L2, PERST# asserted, rails down -- mnh_pwr_down) before
Android ever sleeps, and fully re-powers + re-enumerates on demand.
Do the same, in the vendor's order, from PM-notifier task context
(bus-device removal deadlocks against the PM core from any suspend
callback, and this SoC's noirq phases are measured-forbidden for link
work):

  PM_SUSPEND_PREPARE: remove the endpoint, quiesce and drop the link
  at the RC while the chip is still powered (PME_Turn_Off/L23 ack,
  PERST# asserted -- qcom_pcie_rp_sleep()), then the BCM15602 rails
  off.  The controller sleeps fully powered facing a link it took
  down itself: a deliberate version of the state the noirq skip
  already validated for 85/85 cycles with a dead partner.

  PM_POST_SUSPEND: rails + refclks + soc_pwr_good with PERST# still
  held, PLL settle (bcm15602_easel_power_on_ext()), PERST# release +
  T_PVPERL + LTSSM + link-retrain wait (qcom_pcie_rp_wake()), a
  bounded vendor-ID readiness poll (config reads over a dead link are
  safe; a rescan over one is not), then rescan -- which re-runs
  easel_probe() and rebuilds the iATU window, SCU test clock, MUX
  reset and both bypass links from scratch.  The vendor's
  pci_load_saved_state() restore is deliberately not used: it would
  restore config space but none of Easel's internal state; probe
  rebuilds both.

An earlier attempt asserted PERST# after the sleep, against a link
that had died underneath a controller still believing it up, with no
quiesce -- and regressed the stable first cycle.  Here PERST# moves
pre-sleep, against an agreed-down link.  Every failure path leaves
Easel fully OFF behind an asserted PERST# (stable;
powered-but-unlinked wedged the next suspend, measured 2026-08-20),
still parked, retried at the next resume.

sleep_mode is the bisection ladder for the arms that previously cost
hands-on power presses: 0 none (shipped behaviour), 1 off-before-
sleep only, 2 +revival, 3 +L23 quiesce (default, full vendor shape;
the L23 timeout is logged, not fatal).

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/misc/easel-mipi.c | 172 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 171 insertions(+), 1 deletion(-)

diff --git a/drivers/misc/easel-mipi.c b/drivers/misc/easel-mipi.c
index c8c99d909db8..4831795bf1fa 100644
--- a/drivers/misc/easel-mipi.c
+++ b/drivers/misc/easel-mipi.c
@@ -25,6 +25,9 @@
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/pcie-qcom.h>
+#include <linux/regulator/bcm15602-easel.h>
+#include <linux/suspend.h>
 #include <linux/pci.h>
 #include <linux/limits.h>
 
@@ -821,6 +824,9 @@ void easel_mipi_kick(unsigned int txdev)
 }
 EXPORT_SYMBOL_GPL(easel_mipi_kick);
 
+static struct pci_dev *easel_rp;
+static bool easel_parked;
+
 static int easel_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 {
 	struct easel *easel;
@@ -847,6 +853,8 @@ static int easel_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	easel->cfg = pcim_iomap_table(pdev)[EASEL_BAR_CONFIG];
 	pci_set_drvdata(pdev, easel);
 	easel_dev = easel;
+	if (!easel_rp && pci_upstream_bridge(pdev))
+		easel_rp = pci_dev_get(pci_upstream_bridge(pdev));
 
 	dev_info(&pdev->dev, "Easel BAR2 mapped at %pa, len 0x%llx\n",
 		 &pdev->resource[EASEL_BAR_CONFIG].start,
@@ -901,7 +909,169 @@ static struct pci_driver easel_driver = {
 	.probe = easel_probe,
 	.remove = easel_remove,
 };
-module_pci_driver(easel_driver);
+
+/*
+ * Easel's system-sleep lifecycle, owned here, vendor-shaped.
+ *
+ * Easel loses power across s2idle no matter what the AP does: its BCM15602
+ * rails survive, but the chip comes back unreachable (D3cold, config space
+ * dead), and a bus reset cannot revive a powerless chip ("not ready 1023ms
+ * after bus reset").  The vendor's mnh-sm never keeps Easel up across AP
+ * sleep either -- the HAL has powered it fully down (mnh_pwr_down: link to
+ * L2, PERST asserted, rails off) before Android ever suspends.  So do the
+ * same, deliberately, from PM-notifier task context (bus-device removal
+ * deadlocks against the PM core from any suspend callback, and this SoC's
+ * noirq phases are measured-forbidden for link work):
+ *
+ *   PM_SUSPEND_PREPARE -- power Easel down the vendor way, in vendor order:
+ *   remove our endpoint (nothing may reference the link once it drops),
+ *   quiesce and take the link down at the RC while the chip is still
+ *   powered (PME_Turn_Off/L23 ack, then PERST# asserted -- the reverted
+ *   b6c8661cff7c pulsed PERST *after* the sleep against a link that had
+ *   died underneath the RC, and regressed; pre-sleep, both ends still
+ *   agree about the link state), then the BCM15602 rails off.  The
+ *   controller then sleeps fully powered facing a link it took down
+ *   itself -- a deliberate version of the state the
+ *   endpoint-powered-off-in-suspend noirq skip in qcom-pcie already
+ *   validated for 85/85 cycles with a *dead* partner.
+ *
+ *   PM_POST_SUSPEND -- vendor power-up order (mnh_pwr_up): rails + refclks
+ *   + soc_pwr_good with PERST# still held, PLL settling time, then release
+ *   PERST# (T_PVPERL held by the RC helper), re-enable the LTSSM and wait
+ *   for the link to retrain, confirm the vendor ID answers, and rescan --
+ *   which re-runs easel_probe() and rebuilds the iATU window, SCU clocks,
+ *   MUX reset and both bypass links from scratch.  The saved-state restore
+ *   the vendor uses (pci_load_saved_state) is deliberately not: it would
+ *   restore config space but not one byte of Easel's internal state, and
+ *   probe rebuilds both.
+ *
+ *   Any gate failing leaves Easel fully OFF behind an asserted PERST# --
+ *   a stable link-down state (a powered-but-unlinked partner is what
+ *   wedged cycle 2 on 2026-08-20) -- and parked, to be retried at the
+ *   next resume.  Camera lost until then; suspend unharmed.
+ *
+ * sleep_mode is the bisection ladder for exactly the failure modes that
+ * cost hands-on power presses before; each rung isolates one new step:
+ *   0  nothing (shipped behaviour: the qcom-pcie noirq skip keeps suspend
+ *      safe, camera dead after the first sleep)
+ *   1  power-down before sleep only, no revival (must make EVERY cycle as
+ *      stable as the branch's measured cycle 1)
+ *   2  + revival at resume (PERST cycle, retrain, rescan)
+ *   3  + PME_Turn_Off/L23 quiesce before PERST (full vendor shape, default)
+ * Change it only while unparked (i.e. not between a failed revival and the
+ * next suspend).
+ */
+static unsigned int sleep_mode = 2;
+module_param(sleep_mode, uint, 0644);
+MODULE_PARM_DESC(sleep_mode,
+		 "0 none, 1 off-before-sleep, 2 +revive, 3 +L23 (default)");
+
+static int easel_pm_notify(struct notifier_block *nb, unsigned long action,
+			   void *data)
+{
+	struct pci_dev *pdev;
+	int i, ret;
+	u32 id;
+
+	switch (action) {
+	case PM_SUSPEND_PREPARE:
+		if (!easel_dev || !easel_rp || easel_parked || sleep_mode < 1)
+			break;
+
+		pdev = easel_dev->pdev;
+		pci_lock_rescan_remove();
+		pci_stop_and_remove_bus_device(pdev);
+		pci_unlock_rescan_remove();
+
+		qcom_pcie_rp_sleep(easel_rp, sleep_mode >= 3);
+		bcm15602_easel_power_off_ext();
+		easel_parked = true;
+		break;
+	case PM_POST_SUSPEND:
+		if (!easel_parked || !easel_rp || sleep_mode < 2)
+			break;
+
+		ret = bcm15602_easel_power_on_ext();
+		if (ret) {
+			pr_err("easel-mipi: power-on failed (%d), Easel stays off\n",
+			       ret);
+			bcm15602_easel_power_off_ext();
+			break;		/* still parked; retried next cycle */
+		}
+
+		ret = qcom_pcie_rp_wake(easel_rp);
+		if (ret) {
+			pr_err("easel-mipi: link did not retrain (%d), powering Easel off\n",
+			       ret);
+			goto off_parked;
+		}
+
+		/*
+		 * The link is up; make sure config space answers before a
+		 * rescan crosses it (config reads over a dead link are safe,
+		 * a rescan over one is not).
+		 */
+		for (i = 0; i < 25; i++) {
+			if (!pci_bus_read_config_dword(easel_rp->subordinate,
+						       PCI_DEVFN(0, 0),
+						       PCI_VENDOR_ID, &id) &&
+			    (id & 0xffff) == EASEL_VENDOR_INTEL)
+				break;
+			msleep(20);
+		}
+		if (i == 25) {
+			pr_err("easel-mipi: Easel config space silent, powering off\n");
+			goto off_parked;
+		}
+
+		pci_lock_rescan_remove();
+		pci_rescan_bus(easel_rp->bus);
+		pci_unlock_rescan_remove();
+
+		if (!easel_dev) {
+			pr_err("easel-mipi: rescan did not re-probe, powering off\n");
+			goto off_parked;
+		}
+
+		easel_parked = false;
+		pr_info("easel-mipi: Easel revived after resume\n");
+		break;
+off_parked:
+		qcom_pcie_rp_sleep(easel_rp, false);
+		bcm15602_easel_power_off_ext();
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block easel_pm_nb = {
+	.notifier_call = easel_pm_notify,
+};
+
+static int __init easel_init(void)
+{
+	int ret;
+
+	ret = pci_register_driver(&easel_driver);
+	if (ret)
+		return ret;
+
+	register_pm_notifier(&easel_pm_nb);
+	return 0;
+}
+module_init(easel_init);
+
+static void __exit easel_exit(void)
+{
+	unregister_pm_notifier(&easel_pm_nb);
+	pci_unregister_driver(&easel_driver);
+	if (easel_rp) {
+		pci_dev_put(easel_rp);
+		easel_rp = NULL;
+	}
+}
+module_exit(easel_exit);
 
 MODULE_DESCRIPTION("Easel (Pixel Visual Core) MIPI bridge");
 MODULE_LICENSE("GPL");
