diff --git a/panels/privacy/nfc/cc-nfc-page.blp b/panels/privacy/nfc/cc-nfc-page.blp
new file mode 100644
index 0000000..a50b48a
--- /dev/null
+++ b/panels/privacy/nfc/cc-nfc-page.blp
@@ -0,0 +1,47 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $CcNfcPage: Adw.NavigationPage {
+  title: _("NFC");
+  tag: "nfc";
+
+  child: Adw.ToolbarView {
+    [top]
+    Adw.HeaderBar {}
+
+    content: Adw.PreferencesPage {
+      Adw.PreferencesGroup {
+        Adw.SwitchRow nfc_row {
+          title: _("_NFC Reader");
+          subtitle: _("Use the NFC radio to read and write nearby tags");
+          use-underline: true;
+        }
+      }
+
+      Adw.PreferencesGroup {
+        title: _("Permitted Apps");
+        description: _("The following sandboxed apps have been given permission to use NFC. Apps that are not sandboxed can use NFC without asking for permission.");
+
+        ListBox nfc_apps_list_box {
+          selection-mode: none;
+
+          styles [
+            "boxed-list",
+          ]
+
+          [placeholder]
+          Label {
+            label: _("No sandboxed apps have asked for NFC access");
+            wrap: true;
+            max-width-chars: 50;
+
+            styles [
+              "dim-label",
+              "cc-placeholder-row",
+            ]
+          }
+        }
+      }
+    };
+  };
+}
diff --git a/panels/privacy/nfc/cc-nfc-page.c b/panels/privacy/nfc/cc-nfc-page.c
new file mode 100644
index 0000000..cbf3779
--- /dev/null
+++ b/panels/privacy/nfc/cc-nfc-page.c
@@ -0,0 +1,581 @@
+/* -*- mode: C; c-file-style: "gnu"; indent-tabs-mode: nil; -*-
+ *
