+				};
 			};
 		};
 
@@ -667,11 +775,30 @@ gpu-top-thermal {
 			thermal-sensors = <&tsens0 13>;
 
 			trips {
+				/*
+				 * The pre-existing 90C trip is type "hot", and
+				 * of_thermal_ops has no .hot member -- it executes
+				 * nothing. Keep it for parity with the other zones and
+				 * add a passive trip that a cooling map can bind to.
