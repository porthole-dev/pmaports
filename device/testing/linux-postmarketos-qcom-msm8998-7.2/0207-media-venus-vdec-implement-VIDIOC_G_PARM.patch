From 4c1041824e6c92a6e089786eaf7fc942a3b28108 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Wed, 2 Sep 2026 10:09:35 +0200
Subject: [PATCH] media: venus: vdec: implement VIDIOC_G_PARM

The decoder registers vidioc_s_parm but no vidioc_g_parm, so a G_PARM on
either queue fails with ENOTTY. GStreamer's v4l2 element probes G_PARM
before it will issue S_PARM, and treats the failure as "no
V4L2_CAP_TIMEPERFRAME": it never tells the driver the stream's frame
rate. inst->fps then stays at its default of 30 and load_scale picks
the clock for a 30 fps stream.

On msm8998 that is 269 MHz for 1440p60 and 4K60 VP9, and the firmware
decodes at almost exactly real time with no headroom -- every VP9
superframe (a hidden alt-ref plus the shown frame) overruns a frame
period and repeats a frame on the panel, once per second at 1440p and
five times per second at 4K.

Report the capability and the current timeperframe the same way the
encoder does, so userspace can set the frame rate and the clock follows
the real load.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 drivers/media/platform/qcom/venus/vdec.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 6a43ea191da1..f9d9df4dabaf 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -492,6 +492,22 @@ static int vdec_s_parm(struct file *file, void *fh, struct v4l2_streamparm *a)
 	return 0;
 }
 
+static int vdec_g_parm(struct file *file, void *fh, struct v4l2_streamparm *a)
+{
+	struct venus_inst *inst = to_inst(file);
+	struct v4l2_captureparm *cap = &a->parm.capture;
+
+	if (a->type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
+	    a->type != V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		return -EINVAL;
+
+	memset(cap, 0, sizeof(*cap));
+	cap->capability = V4L2_CAP_TIMEPERFRAME;
+	cap->timeperframe = inst->timeperframe;
+
+	return 0;
+}
+
 static int vdec_enum_framesizes(struct file *file, void *fh,
 				struct v4l2_frmsizeenum *fsize)
 {
@@ -620,6 +636,7 @@ static const struct v4l2_ioctl_ops vdec_ioctl_ops = {
 	.vidioc_streamon = v4l2_m2m_ioctl_streamon,
 	.vidioc_streamoff = v4l2_m2m_ioctl_streamoff,
 	.vidioc_s_parm = vdec_s_parm,
+	.vidioc_g_parm = vdec_g_parm,
 	.vidioc_enum_framesizes = vdec_enum_framesizes,
 	.vidioc_subscribe_event = vdec_subscribe_event,
 	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
-- 
