+void DebayerEGL::setLensShading(const DebayerParams &params)
+{
+	const unsigned int w = params.lscWidth;
+	const unsigned int h = params.lscHeight;
+	const bool enable = w >= 2 && h >= 2 &&
+			    w <= DebayerParams::kLscGridMax &&
+			    h <= DebayerParams::kLscGridMax;
+
+	glUniform1f(lscEnableUniform_, enable ? 1.0f : 0.0f);
+	glUniform1f(lscGainMaxUniform_, DebayerParams::kLscGainMax);
+	/* The sampler is always bound, to unit 1, so the program stays valid. */
+	glUniform1i(lscUniform_, 1);
+
+	glActiveTexture(GL_TEXTURE1);
+	if (!lscTexture_) {
+		glGenTextures(1, &lscTexture_);
+		glBindTexture(GL_TEXTURE_2D, lscTexture_);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		const uint8_t unity[3] = { 64, 64, 64 };
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, 1, 1, 0, GL_RGB,
+			     GL_UNSIGNED_BYTE, unity);
+	} else {
+		glBindTexture(GL_TEXTURE_2D, lscTexture_);
+	}
+
+	if (enable) {
+		const size_t size = w * h * 3;
+		if (lscUploaded_.size() != size ||
+		    !std::equal(lscUploaded_.begin(), lscUploaded_.end(),
+				params.lscGains.begin())) {
+			glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, w, h, 0, GL_RGB,
+				     GL_UNSIGNED_BYTE, params.lscGains.data());
+			glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+			lscUploaded_.assign(params.lscGains.begin(),
+					    params.lscGains.begin() + size);
+		}
+
+		/*
+		 * Grid points sit on texel centres: grid position p maps to
+		 * texture coordinate (p * (n - 1) + 0.5) / n.
+		 */
+		const float sx = (w - 1.0f) / w;
+		const float sy = (h - 1.0f) / h;
+		glUniform4f(lscCropUniform_,
+			    params.lscCrop[0] * sx + 0.5f / w,
+			    params.lscCrop[1] * sy + 0.5f / h,
+			    params.lscCrop[2] * sx, params.lscCrop[3] * sy);
+	} else {
+		glUniform4f(lscCropUniform_, 0.0f, 0.0f, 1.0f, 1.0f);
+	}
+
+	glActiveTexture(GL_TEXTURE0);
+}
