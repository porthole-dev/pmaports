+static void easel_lprxpon_wa(struct easel *easel, unsigned int dev, bool on)
+{
+	static const u16 regs[] = { 0x1ae, 0x1ad, 0x305, 0x505,
+				    0x705, 0x905, 0xb05 };
+	static const u8 vals[] = { 0x07, 0xe0, 0x06, 0x06, 0x06, 0x06, 0x06 };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		rx_dphy(easel, dev, regs[i], on ? vals[i] : 0x00);
+}
