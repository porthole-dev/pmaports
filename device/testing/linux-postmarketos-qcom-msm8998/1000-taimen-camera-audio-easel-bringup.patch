+/*
+ * DMIC clock pad drive strength. Sweepable (0..3) because the pad drive is not
+ * observable from the register side -- a wrong value looks identical to a
+ * working one everywhere except in the captured audio.
+ */
+static unsigned int dmic_clk_drive = WCD934X_DMIC_CLK_DRIVE_DEFAULT;
+module_param(dmic_clk_drive, uint, 0644);
+MODULE_PARM_DESC(dmic_clk_drive, "wcd934x DMIC clock pad drive strength (0-3)");
+
+/*
+ * The SLIM port IRQ handler disables a port's over/underflow interrupt the
+ * first time it fires, so a port that is erroring on every superframe reports
+ * exactly one line and then looks healthy for the rest of the stream. Clear
+ * this to leave it armed and see the true rate; the counts in slim_port_err[]
+ * are kept either way.
+ */
+static bool slim_irq_mask_on_err = true;
+module_param(slim_irq_mask_on_err, bool, 0644);
+MODULE_PARM_DESC(slim_irq_mask_on_err,
+		 "mask a SLIM port's interrupt after its first over/underflow");
+
+/*
+ * Bring the SLIMbus data channel up in hw_params instead of trigger.
+ *
+ * ASoC runs the CPU DAI's .prepare before the codec DAI's .trigger, so
+ * q6afe_port_start() -- where the ADSP binds its own SLIMbus port to the
+ * shared channel -- happened ~250ms BEFORE slim_stream_enable() defined and
+ * activated that channel. Downstream configures the channel from hw_params,
+ * which is before any prepare, and never has this window.
+ *
+ * A capture then reads one latched sample forever: the ADSP's receive port
+ * bound to a channel that did not yet exist. Playback survives the same
+ * ordering because a sink simply underflows until data shows up.
+ *
+ * MEASURED, and it is NOT the fix: with this on the capture is a clean,
+ * unvarying ZERO every time; with it off it is a latched garbage constant.
+ * Both are broken. Defaults OFF because that is upstream's ordering and
+ * nothing justifies changing it. Kept as a knob because the two failure modes
+ * differ, which is itself a clue: forcing the channel up first produces
+ * silence rather than a latch.
+ */
+static bool slim_enable_in_hw_params;	/* default: upstream ordering */
+module_param(slim_enable_in_hw_params, bool, 0644);
+MODULE_PARM_DESC(slim_enable_in_hw_params,
+		 "activate the SLIM channel in hw_params (1) or in trigger (0)");
+
+/*
+ * Tear the SLIMbus stream down and re-establish it this many ms after it
+ * starts. 0 disables.
+ *
+ * A diagnostic, not a feature. Configuration is now confirmed correct at every
+ * endpoint including inside the ADSP (TKGETP), yet the data transfer only
+ * works about one start in sixteen. The open question is whether a failed
+ * start is STICKY -- the channel/port association is lost until the stream is
+ * torn down -- or RECOVERABLE by simply doing the bus setup again. If audio
+ * appears partway through a capture when this fires, the failure is a
+ * recoverable start-up race and a verified-start retry is a legitimate fix;
+ * if nothing changes, the association is lost somewhere a re-setup cannot
+ * reach.
+ */
+static unsigned int slim_restart_ms;
+module_param(slim_restart_ms, uint, 0644);
+MODULE_PARM_DESC(slim_restart_ms,
+		 "ms after stream start to tear down and re-establish the SLIM stream (0=off)");
+
+/*
+ * Program the slave port registers where downstream does -- back to back with
+ * CONNECT_SOURCE and channel activation -- instead of in hw_params.
+ *
+ * TX_PORT_CFG's enable bit is what opens the codec's path into the port FIFO.
+ * Upstream sets it from hw_params, and the channel that gives the bus something
+ * to drain it with is only activated in trigger: measured on taimen, ~250ms
+ * later. A 12-byte FIFO at 48kHz/16-bit fills in ~125us, so the port errors
+ * before the stream it belongs to has started -- and that error is terminal
+ * (see slim_tx_auto_recovery). Exactly one over/underflow at stream start
+ * followed by one latched sample for the rest of the capture is the symptom.
+ *
+ * Downstream has no such window: wcd9xxx_cfg_slim_sch_tx() writes
+ * MULTI_CHNL/PORT_CFG, then slim_connect_src(), then slim_control_ch(ACTIVATE),
+ * all inside tavil_codec_enable_slimtx()'s POST_PMU with the codec already
+ * powered.
+ *
+ * Clear this to get upstream's ordering back for an A/B.
+ */
+static bool slim_port_cfg_at_start = true;
+module_param(slim_port_cfg_at_start, bool, 0644);
+MODULE_PARM_DESC(slim_port_cfg_at_start,
+		 "write the SLIM slave port config at stream start (1) or in hw_params (0)");
+
+/*
+ * Value written to the per-port TX over/underflow auto-recovery register.
