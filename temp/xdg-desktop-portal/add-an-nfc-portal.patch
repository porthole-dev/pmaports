+  /* Deliberately with no lock held: this spawns a process and then waits up
+   * to NFC_PROXY_READY_TIMEOUT_MS for it. Holding a global lock across that
+   * would put every other caller behind the slowest spawn. */
   proxy = nfc_proxy_new (sender, &fd, &error);
   if (proxy == NULL)
     {
@@ -662,9 +701,29 @@ handle_open_nfc_remote (XdpDbusNFC            *object,
       return G_DBUS_METHOD_INVOCATION_HANDLED;
