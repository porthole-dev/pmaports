+/* ----------------------------------------------------------------- probe */
+
+static int tas2557_i2c_probe(struct i2c_client *client)
+{
+	struct tas2557 *tas;
+	u8 pgid;
+	const char *fw_name;
+	int idx, ret;
+
+	tas = devm_kzalloc(&client->dev, sizeof(*tas), GFP_KERNEL);
+	if (!tas)
+		return -ENOMEM;
+
+	tas->dev = &client->dev;
+	tas->cur_program = -1;
+	tas->cur_config = -1;
+	tas->loaded_config = -1;
+	i2c_set_clientdata(client, tas);
+
+	/*
+	 * One devicetree node describes the pair, matching downstream: this
+	 * client is the right channel, and the left is created here. The
+	 * broadcast address happens to be the left one, so it needs no client
+	 * of its own.
+	 */
+	tas->client[1] = client;
+	tas->client[0] = devm_i2c_new_dummy_device(&client->dev,
+						   client->adapter,
+						   TAS2557_BROADCAST_ADDR);
+	if (IS_ERR(tas->client[0]))
+		return dev_err_probe(&client->dev, PTR_ERR(tas->client[0]),
+				     "cannot claim the left channel at 0x%02x\n",
+				     TAS2557_BROADCAST_ADDR);
+
+	tas->broadcast = tas->client[0];
+
+	tas->reset_gpio = devm_gpiod_get_optional(&client->dev, "reset",
+						  GPIOD_OUT_HIGH);
+	if (IS_ERR(tas->reset_gpio))
+		return dev_err_probe(&client->dev, PTR_ERR(tas->reset_gpio),
+				     "cannot get the reset gpio\n");
+
+	ret = tas2557_reset_and_init(tas);
+	if (ret < 0)
+		return dev_err_probe(&client->dev, ret, "reset/init failed\n");
+
+	for (idx = 0; idx < 2; idx++) {
+		ret = tas2557_read(tas, idx, TAS2557_REV_PGID_REG, &pgid);
+		if (ret < 0)
+			return dev_err_probe(&client->dev, ret,
+					     "%s channel does not answer\n",
+					     idx ? "right" : "left");
+
+		dev_info(&client->dev, "%s channel PGID 0x%02x\n",
+			 idx ? "right" : "left", pgid);
+	}
+
+	/*
+	 * The PLL setup and DSP program live only in the firmware image, and
+	 * the image differs by silicon revision, so the part has to be asked
+	 * which one it is rather than told.
+	 */
+	fw_name = (pgid == TAS2557_PG_VERSION_2P1) ?
+		"tas2557s_PG21_uCDSP.bin" : "tas2557s_uCDSP.bin";
+
+	ret = request_firmware(&tas->fw_entry, fw_name, &client->dev);
+	if (ret) {
+		dev_err(&client->dev, "cannot load %s: %d\n", fw_name, ret);
+		return ret;
+	}
+
+	ret = tas2557_parse_fw(tas, tas->fw_entry);
+	if (ret) {
+		release_firmware(tas->fw_entry);
+		return ret;
+	}
+
+	return devm_snd_soc_register_component(&client->dev, &tas2557_component,
+					       &tas2557_dai, 1);
+}
+
+static void tas2557_i2c_remove(struct i2c_client *client)
+{
+	struct tas2557 *tas = i2c_get_clientdata(client);
+
+	tas2557_power_down(tas);
+	release_firmware(tas->fw_entry);
+}
