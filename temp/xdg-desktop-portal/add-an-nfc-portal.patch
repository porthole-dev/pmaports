new file mode 100644
index 0000000..084bd84
--- /dev/null
+++ b/src/nfc.c
@@ -0,0 +1,276 @@
+/*
+ * Copyright © 2026 Giuseppe Maggio
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#include "nfc.h"
+
+#include <gio/gunixfdlist.h>
+#include <glib/gi18n.h>
+
+#include "xdp-context.h"
+#include "xdp-dbus.h"
+#include "xdp-impl-dbus.h"
+#include "xdp-permissions.h"
+#include "xdp-request.h"
+#include "xdp-utils.h"
+
+#define NFC_PERMISSION_TABLE "devices"
+#define NFC_PERMISSION_DEVICE_NFC "nfc"
+
+typedef struct _Nfc Nfc;
+typedef struct _NfcClass NfcClass;
+
+struct _Nfc
+{
+  XdpDbusNFCSkeleton parent_instance;
+
+  XdpDbusImplAccess *access_impl;
+};
+
+struct _NfcClass
+{
+  XdpDbusNFCSkeletonClass parent_class;
+};
+
+GType nfc_get_type (void);
+static void nfc_iface_init (XdpDbusNFCIface *iface);
+
+G_DEFINE_TYPE_WITH_CODE (Nfc, nfc, XDP_DBUS_TYPE_NFC_SKELETON,
+                         G_IMPLEMENT_INTERFACE (XDP_DBUS_TYPE_NFC,
+                                                nfc_iface_init));
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (Nfc, g_object_unref)
+
+/* There is deliberately no lockdown check here. Unlike the camera, the NFC
+ * radio has a real power switch (org.neard.Adapter Powered), and the design
+ * makes that the single source of truth rather than adding a second one that
+ * could only disagree with it. */
+static gboolean
+query_permission_sync (Nfc        *nfc,
+                       XdpRequest *request)
+{
+  XdpPermission permission;
+  XdpAppInfo *app_info = request->app_info;
+  gboolean allowed;
+
+  permission = xdp_get_permission_sync (app_info,
+                                        NFC_PERMISSION_TABLE,
+                                        NFC_PERMISSION_DEVICE_NFC);
+  if (permission == XDP_PERMISSION_ASK || permission == XDP_PERMISSION_UNSET)
+    {
+      g_auto(GVariantBuilder) opt_builder =
+        G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+      g_autofree char *title = NULL;
+      g_autofree char *subtitle = NULL;
+      const char *body;
+      guint32 response = 2;
+      g_autoptr(GVariant) results = NULL;
+      g_autoptr(GError) error = NULL;
+      g_autoptr(XdpDbusImplRequest) impl_request = NULL;
+      const char *app_id = xdp_app_info_get_id (app_info);
+      const char *app_name = xdp_app_info_get_app_display_name (app_info);
+
+      g_variant_builder_add (&opt_builder, "{sv}", "icon",
+                             g_variant_new_string ("nfc-symbolic"));
+
+      if (app_name)
+        {
+          title = g_strdup_printf (_("Allow %s to Use NFC?"), app_name);
+          subtitle = g_strdup_printf (_("%s wants to read and write NFC tags"),
+                                      app_name);
+        }
+      else
+        {
+          title = g_strdup (_("Allow Apps to Use NFC?"));
+          subtitle = g_strdup (_("An app wants to read and write NFC tags"));
+        }
+
+      body = _("This permission can be changed at any time from the privacy settings");
+
+      impl_request = xdp_dbus_impl_request_proxy_new_sync (
+        g_dbus_proxy_get_connection (G_DBUS_PROXY (nfc->access_impl)),
+        G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+        g_dbus_proxy_get_name (G_DBUS_PROXY (nfc->access_impl)),
+        request->id,
+        NULL, &error);
+
+      if (!impl_request)
+        return FALSE;
+
+      xdp_request_set_impl_request (request, impl_request);
+
+      g_debug ("Calling backend for device access to NFC");
+
+      if (!xdp_dbus_impl_access_call_access_dialog_sync (nfc->access_impl,
+                                                        request->id,
+                                                        app_id,
+                                                        "",
+                                                        title,
+                                                        subtitle,
+                                                        body,
+                                                        g_variant_builder_end (&opt_builder),
+                                                        &response,
+                                                        &results,
+                                                        NULL,
+                                                        &error))
+        {
+          g_warning ("A backend call failed: %s", error->message);
+          /* Do not record a permission when the call itself failed: a
+           * permission may only be set from real user input. */
+          return FALSE;
+        }
+
+      allowed = response == 0;
+
+      if (permission == XDP_PERMISSION_UNSET)
+        {
+          xdp_set_permission_sync (app_info,
+                                   NFC_PERMISSION_TABLE,
+                                   NFC_PERMISSION_DEVICE_NFC,
+                                   allowed ? XDP_PERMISSION_YES : XDP_PERMISSION_NO);
+        }
+    }
+  else
+    allowed = permission == XDP_PERMISSION_YES ? TRUE : FALSE;
+
+  return allowed;
+}
+
+static void
+handle_access_nfc_in_thread_func (GTask        *task,
+                                  gpointer      source_object,
+                                  gpointer      task_data,
+                                  GCancellable *cancellable)
+{
+  Nfc *nfc = (Nfc *) source_object;
+  XdpRequest *request = XDP_REQUEST (task_data);
+  gboolean allowed;
+
+  allowed = query_permission_sync (nfc, request);
+
+  REQUEST_AUTOLOCK (request);
+
+  if (request->exported)
+    {
+      g_auto(GVariantBuilder) results =
+        G_VARIANT_BUILDER_INIT (G_VARIANT_TYPE_VARDICT);
+      guint32 response;
+
+      response = allowed ? XDG_DESKTOP_PORTAL_RESPONSE_SUCCESS
+                         : XDG_DESKTOP_PORTAL_RESPONSE_CANCELLED;
+      g_debug ("NFC: sending response %d", response);
+      xdp_dbus_request_emit_response (XDP_DBUS_REQUEST (request),
+                                      response,
+                                      g_variant_builder_end (&results));
+      xdp_request_unexport (request);
+    }
+}
+
+static gboolean
+handle_access_nfc (XdpDbusNFC            *object,
+                   GDBusMethodInvocation *invocation,
+                   GVariant              *arg_options)
+{
+  Nfc *nfc = (Nfc *) object;
+  XdpRequest *request = xdp_request_from_invocation (invocation);
+  g_autoptr(GTask) task = NULL;
+
+  REQUEST_AUTOLOCK (request);
+
+  xdp_request_export (request, g_dbus_method_invocation_get_connection (invocation));
+
+  xdp_dbus_nfc_complete_access_nfc (object, invocation, request->id);
+
+  task = g_task_new (nfc, NULL, NULL, NULL);
+  g_task_set_source_tag (task, handle_access_nfc);
+  g_task_set_task_data (task, g_object_ref (request), g_object_unref);
+  g_task_run_in_thread (task, handle_access_nfc_in_thread_func);
+
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+static gboolean
+handle_open_nfc_remote (XdpDbusNFC            *object,
+                        GDBusMethodInvocation *invocation,
+                        GUnixFDList           *in_fd_list,
+                        GVariant              *arg_options)
+{
+  /* Task 3 replaces this with the filtered xdg-dbus-proxy connection. Until
+   * then the method exists and refuses, so the interface is stable and no
+   * caller can mistake a stub for a working connection. */
+  g_dbus_method_invocation_return_error (invocation,
+                                         XDG_DESKTOP_PORTAL_ERROR,
+                                         XDG_DESKTOP_PORTAL_ERROR_NOT_ALLOWED,
+                                         "Permission denied");
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+static void
+nfc_iface_init (XdpDbusNFCIface *iface)
+{
+  iface->handle_access_nfc = handle_access_nfc;
+  iface->handle_open_nfcremote = handle_open_nfc_remote;
+}
+
+static void
+nfc_finalize (GObject *object)
+{
+  Nfc *nfc = (Nfc *) object;
+
+  g_clear_object (&nfc->access_impl);
+
+  G_OBJECT_CLASS (nfc_parent_class)->finalize (object);
+}
+
+static void
+nfc_init (Nfc *nfc)
+{
+}
+
+static void
+nfc_class_init (NfcClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->finalize = nfc_finalize;
+}
+
+static Nfc *
+nfc_new (XdpDbusImplAccess *access_impl)
+{
+  Nfc *nfc;
+
+  nfc = g_object_new (nfc_get_type (), NULL);
+  nfc->access_impl = g_object_ref (access_impl);
+
+  xdp_dbus_nfc_set_version (XDP_DBUS_NFC (nfc), 1);
+  /* Task 2 makes this track neard. Hardcoded false until then: a machine with
+   * no adapter is the common case, so false is the safe stub. */
+  xdp_dbus_nfc_set_is_nfcpresent (XDP_DBUS_NFC (nfc), FALSE);
+
+  return nfc;
+}
+
+void
+init_nfc (XdpContext *context)
+{
+  g_autoptr(Nfc) nfc = NULL;
+  XdpDbusImplAccess *access_impl;
+
+  access_impl = xdp_context_get_access_impl (context);
+  if (access_impl == NULL)
+    {
+      g_warning ("The NFC portal requires an access impl");
+      return;
+    }
+
+  nfc = nfc_new (access_impl);
+
+  xdp_context_take_and_export_portal (context,
+                                      G_DBUS_INTERFACE_SKELETON (g_steal_pointer (&nfc)),
+                                      XDP_CONTEXT_EXPORT_FLAGS_NONE);
+}
