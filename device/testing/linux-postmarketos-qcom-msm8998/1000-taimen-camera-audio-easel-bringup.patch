+				      const struct kernel_param *kp)
+{
+	struct lg_sw43402 *ctx = READ_ONCE(lg_sw43402_probe_ctx);
+	u8 buf[32];
+	char tok[8];
+	int n = 0, off = 0, adv;
+	ssize_t ret;
+
+	if (!ctx || !ctx->enabled)
+		return -ENODEV;
+
+	while (n < ARRAY_SIZE(buf) &&
+	       sscanf(val + off, "%7s%n", tok, &adv) == 1) {
+		int rc = kstrtou8(tok, 16, &buf[n]);
+
+		if (rc)
+			return rc;
+		n++;
+		off += adv;
+	}
+	if (!n)
+		return -EINVAL;
+
+	ret = mipi_dsi_dcs_write_buffer(ctx->dsi, buf, n);
+	pr_info("sw43402-write: cmd=0x%02x len=%d ret=%zd\n", buf[0], n, ret);
+
+	return ret < 0 ? ret : 0;
+}
