# systemd preset policy for this device's bring-up unit.
#
# Why this file has to exist: postmarketOS ships
# /usr/lib/systemd/system-preset/99-default.preset containing "disable *", and
# something in the install path runs `systemctl preset-all`. That wipes any
# multi-user.target.wants symlink whose unit is not explicitly enabled by a
# preset rule -- so without a matching `enable` line here, the symlink
# preset would otherwise create never gets made, and the device boots with
# NO modem, while `systemctl status` reports the unit as merely
# "disabled; preset: disabled".
#
# qbootctl survived exactly because pmOS lists it in 90-base.preset. This is
# the same treatment for ours.
#
# Preset files are read in lexicographic order and the FIRST matching rule
# wins, so this must sort before 99-default.preset -- hence the 91- prefix at
# install time. Do not renumber it above 99.
#
# taimen-wifi-country.service used to be listed here too. It was deleted in
# pkgrel 18: the kernel learns the regulatory country from the AP beacon
# country IE on its own. See the APKBUILD's ath-regd-override.conf comment.
enable taimen-modem-bringup.service

# taimen-rescue.service, added in pkgrel 28. CONFIRMED the hard way on the
# r24->r28 upgrade: the post-upgrade hook created
# /etc/systemd/system/sysinit.target.wants/taimen-rescue.service, then
# postmarketos-base-systemd's trigger applied presets and printed
#   * Removed '/etc/systemd/system/sysinit.target.wants/taimen-rescue.service'.
# ANY unit this package ships without a line here WILL be silently disabled.
enable taimen-rescue.service

# sns-reg, enabled here since pkgrel 43: the sensor registry server must be
# up before qcom_smgr asks the SLPI for sensors; on a fresh install it was
# left disabled and every SSC sensor silently stayed absent.
enable sns-reg.service

# neard, moved here from a post-install symlink in pkgrel 52. neard's own
# [Install] has no WantedBy (see neard-install.conf, the drop-in that adds
# one) -- without a line here it is silently disabled the same way
# taimen-rescue.service was on the r24->r28 upgrade (see above). No OpenRC
# counterpart exists for neard: Alpine's neard package ships no /etc/init.d
# script at all, so there is nothing to enable there (tracked separately).
enable neard.service

# tuned / tuned-ppd: do not start them at boot.
#
# tuned.service is the only unit on this device ordered both After=network.target
# and before graphical.target, so it dragged NetworkManager and the modem
# bring-up onto the path to the user session. Measured 2026-08-20:
#
#   graphical.target @18.910s
#   +-tuned-ppd.service @16.823s +2.084s
#     +-tuned.service @14.281s +2.501s
#       +-network.target @14.188s
#         +-NetworkManager.service @13.971s
#           +-taimen-modem-bringup.service @12.156s +1.757s
#
# Nothing needs them before a user asks for a power profile, and both
# PowerProfiles bus names are D-Bus activatable straight back to tuned-ppd:
#   /usr/share/dbus-1/system-services/org.freedesktop.UPower.PowerProfiles.service
#   /usr/share/dbus-1/system-services/net.hadess.PowerProfiles.service
#   -> SystemdService=tuned-ppd.service   (which Requires=tuned.service)
# so GNOME Settings still gets its power profiles, just on demand.
#
# tuned-ppd is pulled in by postmarketos-base-ui-gnome, so it cannot simply be
# removed from depends.
#
# NOTE: an earlier attempt shipped a tuned.service.d drop-in doing
#   [Unit]
#   After=
#   After=basic.target
# That does NOT work -- verified on this device's systemd: the empty After=
# did not reset the list, the original After=...network.target survived, and
# basic.target was merely appended. Disabling the unit is what actually works.
disable tuned.service
disable tuned-ppd.service

# powerhintd, packaged in pkgrel 39. Same reason as every other line here:
# 99-default.preset says "disable *", so a unit this package ships without a
# rule is silently disabled and the phone quietly loses its touch boost.
enable powerhintd.service
