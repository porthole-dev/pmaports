+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-based autofocus
+ */
+
+#pragma once
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void process(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State { Scan, Fine, Locked };
+
+	void startScan(int32_t from);
+
+	State state_ = State::Scan;
+	int32_t scanPos_ = 0;
+	int32_t bestPos_ = 0;
+	uint64_t bestSharpness_ = 0;
+	int32_t fineStep_ = 0;
+	uint64_t lockedSharpness_ = 0;
+	unsigned int lowFrames_ = 0;
+	bool settle_ = false;
+	unsigned int warmup_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-based autofocus for the software ISP.
+ *
+ * A plain hill-climb over the sharpness statistic (sum of absolute
+ * horizontal green gradients): coarse scan across the whole focus range,
+ * fine scan around the best coarse position, then lock and monitor. A
+ * sustained sharpness drop triggers a rescan. Positions are raw actuator
+ * units as exposed by the lens driver (taimen LC898214XD: 0..4095,
+ * infinity ~324, macro ~3839).
+ */
+
+#include "af.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+/* Focus range and step sizes, in raw actuator units. */
+static constexpr int32_t kPosMin = 200;
+static constexpr int32_t kPosMax = 3900;
+static constexpr int32_t kCoarseStep = 370;
+static constexpr int32_t kFineStep = 90;
+/* Rescan when sharpness stays below this fraction of the locked value. */
+static constexpr float kRescanRatio = 0.55f;
+static constexpr unsigned int kRescanFrames = 6;
+/* Valid-stats frames to wait for AE before (re)scanning. */
+static constexpr unsigned int kWarmupFrames = 10;
+
+int Af::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.activeState.af.enabled = true;
+	context.activeState.af.position = kPosMin;
+	startScan(kPosMin);
+
+	return 0;
+}
+
+void Af::startScan(int32_t from)
+{
+	warmup_ = kWarmupFrames;
+	state_ = State::Scan;
+	scanPos_ = from;
+	bestPos_ = from;
+	bestSharpness_ = 0;
+	settle_ = true;
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	auto &af = context.activeState.af;
+
+	/*
+	 * Always report the target position; the pipeline handler drives the
+	 * lens from this metadata.
+	 */
+	metadata.set(controls::LensPosition, static_cast<float>(af.position));
+
+	if (!stats->valid)
+		return;
+
+	/*
+	 * Let AE settle before judging sharpness: the raw gradient metric
+	 * scales with scene brightness, so comparing positions while the
+	 * exposure is still ramping picks whichever position AE happened to
+	 * be brightest at.
+	 */
+	if (warmup_ > 0) {
+		warmup_--;
+		return;
+	}
+
+	/*
+	 * Skip the first valid stats after every lens move: the frame that
+	 * produced them may have been captured while the lens was still
+	 * travelling.
+	 */
+	if (settle_) {
+		settle_ = false;
+		return;
+	}
+
+	/*
+	 * Normalise the gradient sum by mean luminance so the measure tracks
+	 * focus, not exposure.
+	 */
+	uint64_t num = 0;
+	uint64_t den = 0;
+	for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++) {
+		num += static_cast<uint64_t>(stats->yHistogram[i]) * i;
+		den += stats->yHistogram[i];
+	}
+	const uint64_t meanY = den ? std::max<uint64_t>(num / den, 1) : 1;
+	const uint64_t sharpness = stats->sharpness * 32 / meanY;
+
+	switch (state_) {
+	case State::Scan:
+		if (sharpness > bestSharpness_) {
+			bestSharpness_ = sharpness;
+			bestPos_ = scanPos_;
+		}
+
+		if (scanPos_ >= kPosMax) {
+			state_ = State::Fine;
+			fineStep_ = -kFineStep;
+			af.position = bestPos_ + fineStep_;
+			settle_ = true;
+			break;
+		}
+
+		scanPos_ = std::min(scanPos_ + kCoarseStep, kPosMax);
+		af.position = scanPos_;
+		settle_ = true;
+		break;
+
+	case State::Fine:
+		if (sharpness > bestSharpness_) {
+			bestSharpness_ = sharpness;
+			bestPos_ = af.position;
+		}
+
+		if (fineStep_ < 0) {
+			/* Tried below best; now try above. */
+			fineStep_ = kFineStep;
+			af.position = bestPos_ + fineStep_;
+			settle_ = true;
+		} else {
+			/* Done: settle on the best position found. */
+			af.position = bestPos_;
+			lockedSharpness_ = bestSharpness_;
+			lowFrames_ = 0;
+			state_ = State::Locked;
+			settle_ = true;
+			LOG(IPASoftAf, Debug)
+				<< "Locked at " << bestPos_
+				<< " sharpness " << bestSharpness_;
+		}
+		break;
+
+	case State::Locked:
+		if (sharpness <
+		    static_cast<uint64_t>(lockedSharpness_ * kRescanRatio)) {
+			if (++lowFrames_ >= kRescanFrames) {
+				LOG(IPASoftAf, Debug)
+					<< "Sharpness dropped, rescanning";
+				startScan(kPosMin);
+				af.position = kPosMin;
+			}
+		} else {
+			lowFrames_ = 0;
+			/* Track slow scene drift. */
+			lockedSharpness_ =
+				(lockedSharpness_ * 15 + sharpness) / 16;
+		}
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
