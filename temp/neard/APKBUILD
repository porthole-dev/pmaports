# TEMPORARY FORK of community/neard.
#
# Upstream neard can be started by neither mechanism a system service is
# normally started by: it ships no D-Bus activation file, and its unit's
# [Install] has only Alias=, so `systemctl enable neard` exits 0 and creates
# no symlink. Alpine inherits both, so the package installs an NFC daemon that
# nothing can start. device-google-taimen carried a neard.service.d drop-in to
# work around the second half; this fixes both, for every device.
#
# pkgrel is 50 so this build outranks Alpine's 0.20-r0 from any repo, while an
# upstream 0.21 still outranks it by design.
#
# NOT YET SUBMITTED upstream: this needs to go to linux-nfc@lists.01.org
# (neard) and an Alpine aports MR. Drop this fork the day either lands and
# Alpine rebuilds.

maintainer="Giuseppe Maggio <jertlok@proton.me>"
# Contributor: Minecrell <minecrell@minecrell.net>
pkgname=neard
pkgver=0.20
pkgrel=50
pkgdesc="Near Field Communication manager"
url="https://01.org/linux-nfc/"
arch="all"
license="GPL-2.0-only"
makedepends="
	autoconf
	autoconf-archive
	automake
	dbus-dev
	glib-dev
	libnl3-dev
	libtool
	"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-openrc
	$pkgname-systemd
	"
source="
	https://git.kernel.org/pub/scm/network/nfc/neard.git/snapshot/neard-$pkgver.tar.gz
	dbus-activation-and-wantedby.patch
	neard.initd
	"

prepare() {
	default_prepare
	./bootstrap
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-systemd \
		--with-systemdsystemunitdir=/usr/lib/systemd/system \
		--with-systemduserunitdir=/usr/lib/systemd/user \
		--enable-tools
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install

	# Avoid conflicts with other packages
	mv "$pkgdir"/usr/include/version.h "$pkgdir"/usr/include/near/version.h

	install -m755 -D "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname

	mkdir -p "$pkgdir"/usr/share/dbus-1/system.d/
	mv "$pkgdir"/etc/dbus-1/system.d/* "$pkgdir"/usr/share/dbus-1/system.d/
}

sha512sums="
