@@ -160,6 +244,8 @@ int Agc::init(IPAContext &context, const ValueNode &tuningData)
 	context.ctrlMap[&controls::ExposureValue] = ControlInfo(-8.0f, 8.0f, 0.0f);
 	context.ctrlMap.merge(controls());
 
+	reconfigure(context);
