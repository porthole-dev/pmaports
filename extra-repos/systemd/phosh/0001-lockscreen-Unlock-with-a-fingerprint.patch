+#pragma once
+
+#include <glib-object.h>
+
+G_BEGIN_DECLS
+
+#define PHOSH_TYPE_FINGERPRINT_UNLOCK (phosh_fingerprint_unlock_get_type ())
+
+G_DECLARE_FINAL_TYPE (PhoshFingerprintUnlock, phosh_fingerprint_unlock, PHOSH, FINGERPRINT_UNLOCK, GObject)
+
+PhoshFingerprintUnlock *phosh_fingerprint_unlock_new   (void);
+void                    phosh_fingerprint_unlock_start (PhoshFingerprintUnlock *self);
+void                    phosh_fingerprint_unlock_stop  (PhoshFingerprintUnlock *self);
+gboolean                phosh_fingerprint_unlock_get_active (PhoshFingerprintUnlock *self);
+
+G_END_DECLS
