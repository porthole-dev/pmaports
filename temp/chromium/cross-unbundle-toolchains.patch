Cross compile with the unbundled toolchains: a real host toolchain, a V8
snapshot toolchain, and the target's clang and Rust runtimes from its sysroot.

build/toolchain/linux/unbundle/README.md suggests host_toolchain=:host and
v8_snapshot_toolchain=:host for a cross build, but neither works as shipped:

- toolchain BUILD.gn files are evaluated in the default toolchain, so the
  host toolchain's `current_cpu = current_cpu` inherits the TARGET cpu and
  every host tool is built for the target (and then run under emulation).
- V8's snapshot must be generated by a host binary that targets the target
  cpu (v8_current_cpu), which :host is not; gcc_toolchain() defaults
  v8_current_cpu to the toolchain's current_cpu.
- the unbundled clang and rustc are the build machine's, and a distribution
  installs the target's compiler-rt builtins and Rust standard library in the
  target sysroot, not beside the host compiler.

Adopted from Void Linux, which cross builds Chromium this way
(void-packages srcpkgs/chromium/patches):
  unbundled-cross-toolchain.patch
  chromium-146-unbundle-v8-cross-snapshot.patch
  chromium-146-clang-cross-libdir.patch
  chromium-153-cross-rust-toolchain.patch (rustflags and find_std_rlibs.py
    hunks; the C sysroot reaches bindgen through target_sysroot instead)
One change from Void: clang_cross_path defaults to clang_base_path, so a
native build that does not set it is unchanged.

diff --git a/build/config/clang/BUILD.gn b/build/config/clang/BUILD.gn
index cc3bdbf..1933ba7 100644
--- a/build/config/clang/BUILD.gn
+++ b/build/config/clang/BUILD.gn
@@ -235,7 +235,11 @@ template("clang_lib") {
         assert(false)  # Unhandled target platform
       }
 
-      _clang_lib_dir = "$clang_base_path/lib/clang/$clang_version/lib"
+      if (current_cpu != target_cpu) {
+        _clang_lib_dir = "$clang_base_path/lib/clang/$clang_version/lib"
+      } else {
+        _clang_lib_dir = "$clang_cross_path/lib/clang/$clang_version/lib"
+      }
       _lib_file = "${_prefix}clang_rt.${_libname}${_suffix}.${_ext}"
       libs = [ "$_clang_lib_dir/$_dir/$_lib_file" ]
     }
diff --git a/build/config/clang/clang.gni b/build/config/clang/clang.gni
index ebb47e2..cf7a612 100644
--- a/build/config/clang/clang.gni
+++ b/build/config/clang/clang.gni
@@ -89,6 +89,13 @@ declare_args() {
   lld_emit_indexes_and_imports = false
 }
 
+declare_args() {
+  # The clang installation whose runtime libraries (clang_rt.*) are linked into
+  # the target toolchain when cross compiling, e.g. the one in the target
+  # sysroot. The host toolchains keep using clang_base_path.
+  clang_cross_path = clang_base_path
+}
+
 # Siso's remote execution rules are based off the prefix
 # "../../third_party/llvm-build/Release+Asserts/bin/clang++".
 # Thus, when using a custom clang base path, we cannot use remote execution.
diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index 4dccd50..ab016cb 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -972,6 +972,12 @@ config("compiler") {
   if (rust_abi_target != "") {
     rustflags += [ "--target=$rust_abi_target" ]
   }
+  if (current_cpu != host_cpu && rust_cross_sysroot_absolute != "") {
+    rustflags += [
+      "--sysroot",
+      rust_cross_sysroot_absolute,
+    ]
+  }
   if (!use_thin_lto || !toolchain_supports_rust_thin_lto) {
     # Don't include bitcode if it won't be used.
     rustflags += [ "-Cembed-bitcode=no" ]
diff --git a/build/config/rust.gni b/build/config/rust.gni
index 590d5e8..b3f444a 100644
--- a/build/config/rust.gni
+++ b/build/config/rust.gni
@@ -59,6 +59,10 @@ declare_args() {
   # V8) may be compatible with the stable version of Rust toolchain.
   rust_sysroot_absolute = ""
 
+  # The Rust sysroot holding the standard library for the target when it is
+  # not installed alongside the host compiler in rust_sysroot_absolute.
+  rust_cross_sysroot_absolute = ""
+
   # Directory under which to find `bin/bindgen` (a `bin` directory containing
   # the bindgen exectuable).
   rust_bindgen_root = "//third_party/rust-toolchain"
diff --git a/build/rust/std/BUILD.gn b/build/rust/std/BUILD.gn
index 105a1d5..e2caf8a 100644
--- a/build/rust/std/BUILD.gn
+++ b/build/rust/std/BUILD.gn
@@ -309,6 +309,13 @@ if (toolchain_has_rust) {
         rust_abi_target,
       ]
 
+      if (current_cpu == target_cpu && rust_cross_sysroot_absolute != "") {
+        args += [
+          "--sysroot",
+          rust_cross_sysroot_absolute,
+        ]
+      }
+
       outputs = []
       foreach(lib, all_stdlibs_to_copy) {
         outputs += [ "$target_out_dir/lib$lib.rlib" ]
diff --git a/build/rust/std/find_std_rlibs.py b/build/rust/std/find_std_rlibs.py
index f35ae44..1e27281 100755
--- a/build/rust/std/find_std_rlibs.py
+++ b/build/rust/std/find_std_rlibs.py
@@ -26,6 +26,7 @@ def main():
                       help="Path to Rust binaries",
                       required=True),
   parser.add_argument("--target", help="Rust target triple", required=False),
+  parser.add_argument("--sysroot", help="Rust sysroot", required=False)
   parser.add_argument("--output",
                       help="Path to rlibs without suffixes",
                       required=True)
@@ -50,6 +51,8 @@ def main():
   rustc_args = [rustc, "--print", "target-libdir"]
   if args.target:
     rustc_args.extend(["--target", args.target])
+  if args.sysroot:
+    rustc_args.extend(["--sysroot", args.sysroot])
   rustlib_dir = subprocess.check_output(rustc_args).rstrip().decode()
   # crbug.com/467351944 - rustc --print target-libdir loses Windows subst paths
   # due to calling GetFinalPathNameByHandle() during canonicalization. This
diff --git a/build/toolchain/linux/unbundle/BUILD.gn b/build/toolchain/linux/unbundle/BUILD.gn
index a091491..f2e2a14 100644
--- a/build/toolchain/linux/unbundle/BUILD.gn
+++ b/build/toolchain/linux/unbundle/BUILD.gn
@@ -35,7 +35,26 @@ gcc_toolchain("host") {
   extra_ldflags = getenv("BUILD_LDFLAGS")
 
   toolchain_args = {
-    current_cpu = current_cpu
-    current_os = current_os
+    current_cpu = host_cpu
+    current_os = host_os
+  }
+}
+
+gcc_toolchain("v8_snapshot_cross") {
+  cc = getenv("BUILD_CC")
+  cxx = getenv("BUILD_CXX")
+  ar = getenv("BUILD_AR")
+  nm = getenv("BUILD_NM")
+  ld = cxx
+
+  extra_cflags = getenv("BUILD_CFLAGS")
+  extra_cppflags = getenv("BUILD_CPPFLAGS")
+  extra_cxxflags = getenv("BUILD_CXXFLAGS")
+  extra_ldflags = getenv("BUILD_LDFLAGS")
+
+  toolchain_args = {
+    current_cpu = host_cpu
+    current_os = host_os
+    v8_current_cpu = target_cpu
   }
 }
