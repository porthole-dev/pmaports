+/* Match quality tiers, mirroring the scoring in Android's CarrierResolver: a
+ * match at a higher tier beats any match that does not reach that tier, so the
+ * result is deterministic no matter what order the database is parsed in.
+ *
+ * Everything the database does not state about a provider is a wildcard, which
+ * is what keeps this working against older data: with no MVNO information at
+ * all every candidate scores the same, and the lookup degrades to the MCC/MNC
+ * match it has always been.
+ */
+#define MATCH_SCORE_GID1          (1 << 4) /* <gid1> matched the SIM's EF_GID1  */
+#define MATCH_SCORE_SPN           (1 << 3) /* <name> matched the SIM's EF_SPN   */
+#define MATCH_SCORE_PRIMACY_SHIFT 1        /* bits 1-2: primary="true|false"    */
+#define MATCH_SCORE_MNC3          (1 << 0) /* 3-digit MNC beats 2-digit         */
+
+/* Returns 2 for a 3-digit MNC match, 1 for a 2-digit one, 0 for no match. */
+static guint
+provider_match_3gpp_mcc_mnc (NMAMobileProvider *provider,
+                             const gchar *mccmnc,
+                             guint mccmnc_len)
+{
+	guint best = 0;
+	guint i;
+
+	if (!provider->mcc_mnc)
+		return 0;
+
+	for (i = 0; i < provider->mcc_mnc->len; i++) {
+		const gchar *mccmnc_iter = provider->mcc_mnc->pdata[i];
+		guint mccmnc_iter_len;
+
+		/* The array is NULL-terminated for nma_mobile_provider_get_3gpp_mcc_mnc(). */
+		if (!mccmnc_iter)
+			break;
+
+		if (strncmp (mccmnc_iter, mccmnc, 3))
+			/* MCC was wrong */
+			continue;
+
+		/* Match both 2-digit and 3-digit MNC; prefer a 3-digit match if
+		 * found, otherwise a 2-digit one. The cases, with examples:
+		 *  a) input: 123/456 --> iter: 123/456 (3-digit match)
+		 *  b) input: 123/45  --> iter: 123/045 (3-digit match)
+		 *  c) input: 123/045 --> iter: 123/45  (2-digit match)
+		 *  d) input: 123/45  --> iter: 123/45  (2-digit match)
+		 */
+		mccmnc_iter_len = strlen (mccmnc_iter);
+
+		if (mccmnc_iter_len == 6) {
+			/* Covers cases a) and b) */
+			if (   (mccmnc_len == 6 && !strncmp (mccmnc + 3, mccmnc_iter + 3, 3))
+			    || (mccmnc_len == 5 && mccmnc_iter[3] == '0' && !strncmp (mccmnc + 3, mccmnc_iter + 4, 2)))
+				return 2;
+			continue;
+		}
+
+		if (mccmnc_iter_len == 5) {
+			/* Covers cases c) and d) */
+			if (   (mccmnc_len == 5 && !strncmp (mccmnc + 3, mccmnc_iter + 3, 2))
+			    || (mccmnc_len == 6 && mccmnc[3] == '0' && !strncmp (mccmnc + 4, mccmnc_iter + 3, 2)))
+				best = 1;
+		}
+	}
+
+	return best;
+}
+
+static gboolean
+provider_match_gid1 (NMAMobileProvider *provider, const gchar *gid1)
+{
+	guint i;
+
+	/* Android matches EF_GID1 as a case-insensitive *prefix*, because SIMs are
+	 * known to pad the field with filler bytes the database does not record.
+	 */
+	for (i = 0; i < provider->gid1->len; i++) {
+		const gchar *iter = provider->gid1->pdata[i];
+
+		if (iter && !g_ascii_strncasecmp (gid1, iter, strlen (iter)))
+			return TRUE;
+	}
+
+	return FALSE;
+}
+
+/* Returns the match score, or -1 if @provider is not a candidate at all. */
+static int
+provider_match_score (NMAMobileProvider *provider,
+                      const gchar *mccmnc,
+                      guint mccmnc_len,
+                      const gchar *spn,
+                      const gchar *gid1)
+{
+	guint mnc_match;
+	int score;
+
+	mnc_match = provider_match_3gpp_mcc_mnc (provider, mccmnc, mccmnc_len);
+	if (!mnc_match)
+		return -1;
+
+	score = (mnc_match == 2 ? MATCH_SCORE_MNC3 : 0);
+	score += provider->primacy << MATCH_SCORE_PRIMACY_SHIFT;
+
+	/* <gid1> is a matcher the database states deliberately, so a disagreement
+	 * rules the provider out at any score: these SIMs are not its subscribers.
+	 * A caller that does not know the SIM's EF_GID1 leaves it a wildcard
+	 * rather than discarding data it cannot evaluate.
+	 */
+	if (provider->gid1 && gid1 && gid1[0]) {
+		if (!provider_match_gid1 (provider, gid1))
+			return -1;
+		score += MATCH_SCORE_GID1;
+	}
+
+	/* <name> is a display name rather than a declared matcher, so a mismatch
+	 * only fails to earn the tier -- it never rules the provider out. It
+	 * discriminates because MVNOs are named for the EF_SPN their SIMs carry
+	 * ("PosteMobile", "ho."), while the host network's own subscribers
+	 * usually present no service provider name at all.
+	 */
+	if (   spn && spn[0]
+	    && provider->name
+	    && !g_ascii_strcasecmp (spn, provider->name))
+		score += MATCH_SCORE_SPN;
+
+	return score;
+}
+
 /**
  * nma_mobile_providers_database_lookup_3gpp_mcc_mnc:
  * @self: a #NMAMobileProvidersDatabase.
  * @mccmnc: the MCC/MNC string to look for.
  *
+ * Looks up the provider for a MCC/MNC pair. Where several providers share it --
+ * a host network and the MVNOs riding on it -- the one flagged
+ * <literal>primary</literal> in the database wins.
+ *
+ * Callers that can read the SIM should prefer
+ * nma_mobile_providers_database_lookup_3gpp_sim(), which can tell the MVNOs
+ * apart instead of assuming the subscriber is on the host network.
+ *
  * Returns: (transfer none): a #NMAMobileProvider or %NULL if not found.
  */
 NMAMobileProvider *
 nma_mobile_providers_database_lookup_3gpp_mcc_mnc (NMAMobileProvidersDatabase *self,
                                                    const gchar *mccmnc)
+{
+	return nma_mobile_providers_database_lookup_3gpp_sim (self, mccmnc, NULL, NULL);
+}
+
+/**
+ * nma_mobile_providers_database_lookup_3gpp_sim:
+ * @self: a #NMAMobileProvidersDatabase.
+ * @mccmnc: the MCC/MNC string to look for.
+ * @spn: (allow-none): the SIM's service provider name (EF_SPN), or %NULL if unknown.
+ * @gid1: (allow-none): the SIM's group identifier level 1 (EF_GID1) as a hex
+ *   string, or %NULL if unknown.
+ *
+ * Looks up the provider a SIM belongs to.
+ *
+ * An MCC/MNC pair identifies a network, not a provider: every MVNO reselling
+ * that network reports the same one, so matching on it alone cannot say which
+ * of them issued the SIM. The extra fields disambiguate, and each is optional --
+ * whatever the caller cannot supply is treated as a wildcard, and a provider
+ * the database says nothing about still matches on MCC/MNC as before.
+ *
+ * Returns: (transfer none): a #NMAMobileProvider or %NULL if not found.
+ *
+ * Since: 1.10.8
+ */
+NMAMobileProvider *
+nma_mobile_providers_database_lookup_3gpp_sim (NMAMobileProvidersDatabase *self,
+                                               const gchar *mccmnc,
+                                               const gchar *spn,
+                                               const gchar *gid1)
 {
 	GHashTableIter iter;
 	gpointer value;
 	GSList *piter;
-	NMAMobileProvider *provider_match_2mnc = NULL;
+	NMAMobileProvider *best_provider = NULL;
+	int best_score = -1;
 	guint mccmnc_len;
 
 	g_return_val_if_fail (NMA_IS_MOBILE_PROVIDERS_DATABASE (self), NULL);
@@ -1285,65 +1490,17 @@ nma_mobile_providers_database_lookup_3gpp_mcc_mnc (NMAMobileProvidersDatabase *s
 		     piter;
 		     piter = g_slist_next (piter)) {
 			NMAMobileProvider *provider = piter->data;
-			const gchar **mccmnc_list;
-			guint i;
+			int score;
 
-			/* Search through MCC/MNC list */
-			mccmnc_list = nma_mobile_provider_get_3gpp_mcc_mnc (provider);
-			if (!mccmnc_list)
-				continue;
-
-			for (i = 0; mccmnc_list[i]; i++) {
-				const gchar *mccmnc_iter;
-				guint mccmnc_iter_len;
-
-				mccmnc_iter = mccmnc_list[i];
-				mccmnc_iter_len = strlen (mccmnc_iter);
-
-				/* Match both 2-digit and 3-digit MNC; prefer a
-				 * 3-digit match if found, otherwise a 2-digit one.
-				 */
-
-				if (strncmp (mccmnc_iter, mccmnc, 3))
-					/* MCC was wrong */
-					continue;
-
-				/* Now we have the following match cases, examples given:
-				 *  a) input: 123/456 --> iter: 123/456 (3-digit match)
-				 *  b) input: 123/45  --> iter: 123/045 (3-digit match)
-				 *  c) input: 123/045 --> iter: 123/45  (2-digit match)
-				 *  d) input: 123/45  --> iter: 123/45  (2-digit match)
-				 */
-
-				if (mccmnc_iter_len == 6) {
-					/* Covers cases a) and b) */
-					if (   (mccmnc_len == 6 && !strncmp (mccmnc + 3, mccmnc_iter + 3, 3))
-					    || (mccmnc_len == 5 && mccmnc_iter[3] == '0' && !strncmp (mccmnc + 3, mccmnc_iter + 4, 2)))
-						/* 3-digit MNC match! */
-						return provider;
-
-					/* MNC was wrong */
-					continue;
-				}
-
-				if (   !provider_match_2mnc
-				    && mccmnc_iter_len == 5) {
-					if (   (mccmnc_len == 5 && !strncmp (mccmnc + 3, mccmnc_iter + 3, 2))
-					    || (mccmnc_len == 6 && mccmnc[3] == '0' && !strncmp (mccmnc + 4, mccmnc_iter + 3, 2))) {
-						/* Store the 2-digit MNC match, but keep looking,
-						 * we may have a 3-digit MNC match */
-						provider_match_2mnc = provider;
-						continue;
-					}
-
-					/* MNC was wrong */
-					continue;
-				}
+			score = provider_match_score (provider, mccmnc, mccmnc_len, spn, gid1);
+			if (score > best_score) {
+				best_score = score;
+				best_provider = provider;
 			}
 		}
 	}
 
-	return provider_match_2mnc;
+	return best_provider;
 }
 
