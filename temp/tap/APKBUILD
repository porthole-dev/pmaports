# Tap -- a GTK4/libadwaita app that reads and writes NFC tags through
# org.freedesktop.portal.NFC. It exists to demonstrate that portal from the
# application side, and to be readable next to the two pieces it sits on:
# temp/xdg-desktop-portal (the portal) and temp/gnome-control-center (the
# switch and the Permitted Apps list).
#
# NOT a fork. This is the port's own application; it lives in temp/ because
# that is where this port stages packages that pmaports upstream does not
# have. Its source is userspace/tap in the taimen repo.
#
# The source is a tarball made from that tree rather than fetched from a URL,
# because the app has not been published yet: run userspace/tap/pack.sh to
# refresh the tarball and the checksum below before building. When the source
# lands in a repo of its own, replace source= with the usual github tarball
# and delete that script.
#
# TRAP: `porthole pkg build` reports "up-to-date" and skips the build when the
# content changed but pkgrel did not. Bump pkgrel on every rebuild, and check
# the artifact's mtime and hash rather than the exit code.
maintainer="Giuseppe Maggio <jertlok@proton.me>"
pkgname=tap
pkgver=0.1.0
pkgrel=23
pkgdesc="Read and write NFC tags"
url="https://github.com/Jertlok/tap"
arch="all"
license="GPL-3.0-or-later"
# The app talks to xdg-desktop-portal and to nothing else. neard is not a
# dependency of this package on purpose: the portal is what reaches it, and
# an app that depended on the daemon would be admitting it might not.
depends="xdg-desktop-portal"
makedepends="
	blueprint-compiler
	desktop-file-utils
	gettext-dev
	glib-dev
	gtk4.0-dev
	libadwaita-dev
	meson
	"
checkdepends="appstream"
# The tarball next to this file is the source, committed because there is
# nowhere to fetch it from yet: it lives in userspace/tap in the
# taimen repo, and that repo is private, so a github archive URL would not
# resolve in a build chroot. Regenerate it with that directory's pack.sh,
# which also refreshes the checksum below. When the source is published,
# this becomes an ordinary URL in source= and the tarball leaves the tree.
source="tap-$pkgver.tar.gz"
builddir="$srcdir/tap-$pkgver"

build() {
	abuild-meson . output
	meson compile -C output
}

check() {
	meson test --no-rebuild --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="ef4ec120e1ede4f2788a8e0adf5ec4f866801617559028abfa8e16b18e5580a3c932015bd48b9b04334283a2230feb4199555b78209113e279149514af253fed  tap-0.1.0.tar.gz"
