From 925b518d54854b4a679cf269e932d79507618ad8 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Thu, 10 Sep 2026 16:52:34 +0200
Subject: [PATCH 3/9] nfc: IsNFCPresent follows neard

Nearly no machine has an NFC adapter, so an application needs to be able to
hide its NFC UI rather than call into a portal that will fail. The property is
true exactly when neard publishes an org.neard.Adapter object, tracked with an
object-manager client so it follows the adapter appearing and disappearing.

Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 src/nfc.c                | 91 +++++++++++++++++++++++++++++++++++++++-
 tests/templates/neard.py | 58 +++++++++++++++++++++++++
 tests/test_nfc.py        | 23 ++++++++++
 3 files changed, 170 insertions(+), 2 deletions(-)
 create mode 100644 tests/templates/neard.py

diff --git a/src/nfc.c b/src/nfc.c
index 4e60652..689e76e 100644
--- a/src/nfc.c
+++ b/src/nfc.c
@@ -35,6 +35,10 @@
 #define NFC_PERMISSION_TABLE "devices"
 #define NFC_PERMISSION_DEVICE_NFC "nfc"
 
+#define NEARD_BUS_NAME "org.neard"
+#define NEARD_OBJECT_PATH "/"
+#define NEARD_ADAPTER_IFACE "org.neard.Adapter"
+
 typedef struct _Nfc Nfc;
 typedef struct _NfcClass NfcClass;
 
@@ -43,6 +47,9 @@ struct _Nfc
   XdpDbusNFCSkeleton parent_instance;
 
   XdpDbusImplAccess *access_impl;
+
+  GCancellable *neard_cancellable;
+  GDBusObjectManager *neard_manager;
 };
 
 struct _NfcClass
@@ -235,6 +242,10 @@ nfc_finalize (GObject *object)
 {
   Nfc *nfc = (Nfc *) object;
 
+  if (nfc->neard_cancellable)
+    g_cancellable_cancel (nfc->neard_cancellable);
+  g_clear_object (&nfc->neard_cancellable);
+  g_clear_object (&nfc->neard_manager);
   g_clear_object (&nfc->access_impl);
 
   G_OBJECT_CLASS (nfc_parent_class)->finalize (object);
@@ -253,6 +264,66 @@ nfc_class_init (NfcClass *klass)
   object_class->finalize = nfc_finalize;
 }
 
+static void
+nfc_set_present (Nfc *nfc, gboolean present)
+{
+  xdp_dbus_nfc_set_is_nfcpresent (XDP_DBUS_NFC (nfc), present);
+}
+
+static gboolean
+neard_has_adapter (GDBusObjectManager *manager)
+{
+  GList *objects = g_dbus_object_manager_get_objects (manager);
+  gboolean found = FALSE;
+
+  for (GList *l = objects; l != NULL && !found; l = l->next)
+    {
+      g_autoptr(GDBusInterface) iface =
+        g_dbus_object_get_interface (G_DBUS_OBJECT (l->data), NEARD_ADAPTER_IFACE);
+
+      found = iface != NULL;
+    }
+
+  g_list_free_full (objects, g_object_unref);
+
+  return found;
+}
+
+static void
+on_neard_objects_changed (GDBusObjectManager *manager,
+                          GDBusObject        *object,
+                          gpointer            user_data)
+{
+  nfc_set_present ((Nfc *) user_data, neard_has_adapter (manager));
+}
+
+static void
+on_neard_manager_ready (GObject      *source,
+                        GAsyncResult *res,
+                        gpointer      user_data)
+{
+  g_autoptr(Nfc) nfc = (Nfc *) user_data;
+  g_autoptr(GError) error = NULL;
+  GDBusObjectManager *manager;
+
+  manager = g_dbus_object_manager_client_new_for_bus_finish (res, &error);
+  if (manager == NULL)
+    {
+      if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        g_warning ("Failed to watch neard: %s", error->message);
+      return;
+    }
+
+  nfc->neard_manager = manager;
+
+  g_signal_connect_object (manager, "object-added",
+                           G_CALLBACK (on_neard_objects_changed), nfc, G_CONNECT_DEFAULT);
+  g_signal_connect_object (manager, "object-removed",
+                           G_CALLBACK (on_neard_objects_changed), nfc, G_CONNECT_DEFAULT);
+
+  nfc_set_present (nfc, neard_has_adapter (manager));
+}
+
 static Nfc *
 nfc_new (XdpDbusImplAccess *access_impl)
 {
@@ -262,10 +333,26 @@ nfc_new (XdpDbusImplAccess *access_impl)
   nfc->access_impl = g_object_ref (access_impl);
 
   xdp_dbus_nfc_set_version (XDP_DBUS_NFC (nfc), 1);
-  /* Task 2 makes this track neard. Hardcoded false until then: a machine with
-   * no adapter is the common case, so false is the safe stub. */
+  /* False until the neard object manager is up, which is the safe default:
+   * a machine with no adapter is the common case. on_neard_manager_ready
+   * sets the real answer once the async round trip to the system bus
+   * returns, and object-added/object-removed keep it current after that. */
   xdp_dbus_nfc_set_is_nfcpresent (XDP_DBUS_NFC (nfc), FALSE);
 
+  nfc->neard_cancellable = g_cancellable_new ();
+  /* No G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_DO_NOT_AUTO_START: asking whether
+   * NFC exists is a good enough reason to let the bus start neard, and it
+   * is what makes the property true on a machine where the daemon is not
+   * yet running. */
+  g_dbus_object_manager_client_new_for_bus (G_BUS_TYPE_SYSTEM,
+                                            G_DBUS_OBJECT_MANAGER_CLIENT_FLAGS_NONE,
+                                            NEARD_BUS_NAME,
+                                            NEARD_OBJECT_PATH,
+                                            NULL, NULL, NULL,
+                                            nfc->neard_cancellable,
+                                            on_neard_manager_ready,
+                                            g_object_ref (nfc));
+
   return nfc;
 }
 
diff --git a/tests/templates/neard.py b/tests/templates/neard.py
new file mode 100644
index 0000000..29464b0
--- /dev/null
+++ b/tests/templates/neard.py
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# This file is formatted with Python Black
+# mypy: disable-error-code="misc"
+
+import dbus
+import dbus.service
+
+# neard's real ObjectManager lives at "/", but dbusmock's own automatic
+# object-manager support (IS_OBJECT_MANAGER = True) is wired up at
+# "/dbusmock", not at MAIN_OBJ -- so GetManagedObjects below is hand-written
+# to answer at "/", and it does not emit InterfacesAdded/InterfacesRemoved.
+# That makes the object-added/object-removed path in src/nfc.c untestable
+# against this template as written. A future dynamic-adapter test must
+# REPLACE this template (e.g. with IS_OBJECT_MANAGER plus explicit
+# object_manager_emit_added()/_removed() calls), not extend it in place.
+
+BUS_NAME = "org.neard"
+MAIN_OBJ = "/"
+MAIN_IFACE = "org.freedesktop.DBus.ObjectManager"
+SYSTEM_BUS = True
+
+ADAPTER_PATH = "/org/neard/nfc0"
+ADAPTER_IFACE = "org.neard.Adapter"
+
+
+def load(mock, parameters=None):
+    parameters = parameters or {}
+    mock.adapter_present = parameters.get("adapter", True)
+
+    if mock.adapter_present:
+        mock.AddObject(
+            ADAPTER_PATH,
+            ADAPTER_IFACE,
+            {
+                "Powered": dbus.Boolean(False),
+                "Polling": dbus.Boolean(False),
+                "Mode": dbus.String("Idle"),
+                "Protocols": dbus.Array(["ISO-DEP"], signature="s"),
+            },
+            [],
+        )
+
+
+@dbus.service.method(MAIN_IFACE, in_signature="", out_signature="a{oa{sa{sv}}}")
+def GetManagedObjects(self):
+    if not self.adapter_present:
+        return {}
+    return {
+        dbus.ObjectPath(ADAPTER_PATH): {
+            ADAPTER_IFACE: {
+                "Powered": dbus.Boolean(False),
+                "Polling": dbus.Boolean(False),
+                "Mode": dbus.String("Idle"),
+                "Protocols": dbus.Array(["ISO-DEP"], signature="s"),
+            }
+        }
+    }
