# OpenRC counterpart of taimen-gnome-software-prewarm.service. See
# taimen-ambient-nudge.desktop's header for why an XDG autostart entry is the
# right mechanism under OpenRC (no systemd --user to hang a
# graphical-session.target unit off of), and why it is shipped unconditionally
# with an Exec= guard rather than split by init system.
#
# The command -v guard is the ConditionPathExists= of the systemd unit: this
# package does not depend on gnome-software, and an image without it should
# start nothing rather than log a failure every login.
[Desktop Entry]
Type=Application
Name=taimen gnome-software prewarm
Comment=Pay GNOME Software's 19.7 MB AppStream parse at login, not on every tap
Exec=sh -c 'test -d /run/systemd/system || { command -v gnome-software >/dev/null && sleep 20 && exec gnome-software --gapplication-service; }'
NoDisplay=true
Terminal=false
