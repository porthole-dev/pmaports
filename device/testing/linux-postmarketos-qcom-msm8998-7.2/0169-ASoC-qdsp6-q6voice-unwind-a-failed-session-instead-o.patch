From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giuseppe Maggio <jertlok@proton.me>
Date: Wed, 26 Aug 2026 18:23:54 +0200
Subject: [PATCH] ASoC: qdsp6: q6voice: unwind a failed session instead of
 leaking it

q6voice_start() had one error label for the whole sequence and it did
nothing but log and unlock, so every command after CVP_CREATE leaked the
vocproc it had just made. Nothing recovers it: q6voice_stop() returns
early unless the session reached v->running, so the handle is lost for
the boot. The ADSP's pool is small enough that a few failed experiments
are all it takes -- CREATE then answers ADSP_ENORESOURCE and no call can
be set up until the DSP restarts. That is a reboot per failed
experiment, on a bug whose only test is a carrier call.

Unwind in the order q6voice_stop() would have: detach the vocproc,
disable it, destroy it.

The control session needs the opposite treatment. Destroying an MVM or a
CVS is what silences every later call -- the modem builds them once
during its own init -- so a half-built one is forgotten rather than
destroyed. Leaving the handle set, which is what happened before, is
worse than either: the setup block is skipped from then on, so the
stream stays unattached and the policy unset for the rest of the boot
while every call reports success at every step. Zeroing both handles
sends the next call back through the sequence, where a CREATE against a
session the modem owns answers EALREADY.

Also drop the claim that q6voice_stop() destroys a control session this
driver created. It does not, deliberately, and says so in its own
comment.

Assisted-by: LLM
Signed-off-by: Giuseppe Maggio <jertlok@proton.me>
---
 sound/soc/qcom/qdsp6/q6voice.c | 75 ++++++++++++++++++++++++----------
 1 file changed, 54 insertions(+), 21 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
index 74c9fe4b6054..95b1e47005fc 100644
--- a/sound/soc/qcom/qdsp6/q6voice.c
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -222,8 +222,8 @@ int q6voice_start(u16 rx_port, u16 tx_port)
 	mutex_lock(&v->lock);
 
 	if (v->running) {
-		ret = 0;
-		goto out;
+		mutex_unlock(&v->lock);
+		return 0;
 	}
 
 	/*
@@ -231,11 +231,10 @@ int q6voice_start(u16 rx_port, u16 tx_port)
 	 * CREATE does not re-join what the modem built, it allocates a fresh
 	 * one and answers status 0 for it, and a session that is not the
 	 * modem's carries no call audio while reporting success at every step.
-	 * So a joined control session is set up once and every later call
-	 * reuses it, rebuilding the vocproc alone -- which is also how a call
-	 * is moved between devices downstream. One this driver created instead
-	 * is destroyed and forgotten by q6voice_stop(), so the next call gets
-	 * another chance to join.
+	 * So the control session is set up once and every later call reuses it,
+	 * rebuilding the vocproc alone -- which is also how a call is moved
+	 * between devices downstream. It is never destroyed, whoever made it;
+	 * q6voice_stop() explains why.
 	 */
 	if (!v->mvm.handle) {
 		q6voice_name(name);
@@ -243,24 +242,24 @@ int q6voice_start(u16 rx_port, u16 tx_port)
 		ret = q6voice_cmd(v, &v->mvm, VSS_IMVM_CMD_CREATE_PASSIVE_CONTROL_SESSION,
 				  0, name, sizeof(name), &v->mvm.joined);
 		if (ret < 0)
-			goto out;
+			goto err;
 		v->mvm.handle = ret;
 
 		ret = q6voice_cmd(v, &v->cvs, VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION,
 				  0, name, sizeof(name), &v->cvs.joined);
 		if (ret < 0)
-			goto out;
+			goto err_control;
 		v->cvs.handle = ret;
 
 		ret = q6voice_cmd(v, &v->mvm, VSS_IMVM_CMD_ATTACH_STREAM, v->mvm.handle,
 				  &v->cvs.handle, sizeof(v->cvs.handle), NULL);
 		if (ret < 0)
-			goto out;
+			goto err_control;
 
 		ret = q6voice_cmd(v, &v->mvm, VSS_IMVM_CMD_SET_POLICY_DUAL_CONTROL,
 				  v->mvm.handle, "\x01", 1, NULL);
 		if (ret < 0)
-			goto out;
+			goto err_control;
 	}
 
 	cvp_cfg.direction = 2;
@@ -275,23 +274,23 @@ int q6voice_start(u16 rx_port, u16 tx_port)
 	ret = q6voice_cmd(v, &v->cvp, VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V2,
 			  0, &cvp_cfg, sizeof(cvp_cfg), NULL);
 	if (ret < 0)
-		goto out;
+		goto err;
 	v->cvp.handle = ret;
 
 	ret = q6voice_cmd(v, &v->cvp, VSS_IVOCPROC_CMD_ENABLE, v->cvp.handle,
 			  NULL, 0, NULL);
 	if (ret < 0)
-		goto out;
+		goto err_cvp_created;
 
 	ret = q6voice_cmd(v, &v->mvm, VSS_IMVM_CMD_ATTACH_VOCPROC, v->mvm.handle,
 			  &v->cvp.handle, sizeof(v->cvp.handle), NULL);
 	if (ret < 0)
-		goto out;
+		goto err_cvp_enabled;
 
 	ret = q6voice_cmd(v, &v->mvm, VSS_IMVM_CMD_START_VOICE, v->mvm.handle,
 			  NULL, 0, NULL);
 	if (ret < 0)
-		goto out;
+		goto err_cvp_attached;
 
 	v->running = true;
 	dev_info(&v->mvm.adev->dev,
@@ -299,12 +298,46 @@ int q6voice_start(u16 rx_port, u16 tx_port)
 		 v->mvm.handle, v->mvm.joined ? " (joined)" : " (created)",
 		 v->cvs.handle, v->cvs.joined ? " (joined)" : " (created)",
 		 v->cvp.handle, rx_port, tx_port);
-	ret = 0;
-out:
-	if (ret)
-		dev_err(&v->mvm.adev->dev,
-			"voice session failed at rx=0x%04x tx=0x%04x: %d\n",
-			rx_port, tx_port, ret);
+	mutex_unlock(&v->lock);
+
+	return 0;
+
+	/*
+	 * Unwind in the order q6voice_stop() would have. A vocproc left behind
+	 * by a rejected command is not recovered by anything: q6voice_stop()
+	 * runs only for a session that reached v->running, so the handle is
+	 * simply lost, and the ADSP's pool is small enough that a few failed
+	 * experiments answer the next CREATE with ADSP_ENORESOURCE and no call
+	 * can be set up until the DSP restarts.
+	 */
+err_cvp_attached:
+	q6voice_cmd(v, &v->mvm, VSS_IMVM_CMD_DETACH_VOCPROC, v->mvm.handle,
+		    &v->cvp.handle, sizeof(v->cvp.handle), NULL);
+err_cvp_enabled:
+	q6voice_cmd(v, &v->cvp, VSS_IVOCPROC_CMD_DISABLE, v->cvp.handle,
+		    NULL, 0, NULL);
+err_cvp_created:
+	q6voice_cmd(v, &v->cvp, APRV2_IBASIC_CMD_DESTROY_SESSION, v->cvp.handle,
+		    NULL, 0, NULL);
+	v->cvp.handle = 0;
+	goto err;
+
+	/*
+	 * The control session is half built. Forget it rather than destroy it,
+	 * because destroying an MVM or a CVS is what silences every later call
+	 * (see q6voice_stop()) -- and leaving the handle set is worse than
+	 * either: the block above is skipped from then on, so the stream stays
+	 * unattached and the policy unset for the rest of the boot while every
+	 * call reports success. The next call re-runs the sequence, and a
+	 * CREATE against a session the modem owns answers EALREADY.
+	 */
+err_control:
+	v->mvm.handle = 0;
+	v->cvs.handle = 0;
+err:
+	dev_err(&v->mvm.adev->dev,
+		"voice session failed at rx=0x%04x tx=0x%04x: %d\n",
+		rx_port, tx_port, ret);
 	mutex_unlock(&v->lock);
 
 	return ret;
